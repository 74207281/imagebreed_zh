<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'brapi.Table' ] &>

<h4>研究搜尋(Studies Search)</h4>

<div id="brapi_studies_search_home_div">

<input name="brapi_studies_programDbId" id="brapi_studies_programDbId" class="form-control" type="text" placeholder="計畫資料庫 ID(ProgramDbId)" />
<input name="brapi_studies_programName" id="brapi_studies_programName" class="form-control" type="text" placeholder="計畫名稱(ProgramName)" />
<input name="brapi_studies_locationDbId" id="brapi_studies_locationDbId" class="form-control" type="text" placeholder="地點資料庫 ID(LocationDbId)" />
<input name="brapi_studies_locationName" id="brapi_studies_locationName" class="form-control" type="text" placeholder="地點名稱(LocationName)" />
<input name="brapi_studies_studyTypeName" id="brapi_studies_studyTypeName" class="form-control" type="text" placeholder="研究類型名稱(StudyTypeName)" />
<input name="brapi_studies_studyDbId" id="brapi_studies_studyDbId" class="form-control" type="text" placeholder="研究資料庫 ID(StudyDbId)" />
<input name="brapi_studies_studyName" id="brapi_studies_studyName" class="form-control" type="text" placeholder="研究名稱(StudyName)" />
<input name="brapi_studies_germplasmDbId" id="brapi_studies_germplasmDbId" class="form-control" type="text" placeholder="種原資料庫 ID(GermplasmDbId)" />
<input name="brapi_studies_germplasmName" id="brapi_studies_germplasmName" class="form-control" type="text" placeholder="種原名稱(GermplasmName)" />
<input name="brapi_studies_variableDbId" id="brapi_studies_variableDbId" class="form-control" type="text" placeholder="觀測變數資料庫 ID(ObservationVariableDbId)" />
<input name="brapi_studies_variableName" id="brapi_studies_variableName" class="form-control" type="text" placeholder="觀測變數名稱(ObservationVariableName)" />
<button class="btn btn-primary" name="brapi_studies_search_submit" id="brapi_studies_search_submit">搜尋(Search)</button>

<br/><br/>

<div id="brapi_studies_search_result_div">

</div>

</div>

<script>

jQuery(document).ready(function() {
    jQuery("#brapi_studies_search_submit").click(function() {
        jQuery.ajax( {
          'url': jQuery('#brapi_home_url_select').val()+'/brapi/v1/studies-search',
          'method': 'POST',
          'data': { 
            'programDbIds' :  jQuery("#brapi_studies_programDbId").val(),
            'programNames' :  jQuery("#brapi_studies_programName").val(),
            'locationDbId' : jQuery("#brapi_studies_locationDbId").val(),
            'locationNames' : jQuery("#brapi_studies_locationName").val(),
            'studyTypeName' : jQuery("#brapi_studies_studyTypeName").val(),
            'studyDbIds' : jQuery("#brapi_studies_studyDbId").val(),
            'studyNames' : jQuery("#brapi_studies_studyName").val(),
            'germplasmDbIds' : jQuery("#brapi_studies_germplasmDbId").val(),
            'germplasmNames' : jQuery("#brapi_studies_germplasmName").val(),
            'observationVariableDbIds' : jQuery("#brapi_studies_variableDbId").val(),
            'observationVariableNames' : jQuery("#brapi_studies_variableName").val(),
          },
          'success': function(response) {
            console.log(response);
            brapi_create_paginated_table(response.result.data, response.metadata.pagination, 'brapi_studies_search_result_div', jQuery('#brapi_home_url_select').val()+'/brapi/v1/studies-search', undefined);

          },
          error: function(response) {
            alert('發生錯誤(An error occurred)');
          }
        });
    });
});


</script>