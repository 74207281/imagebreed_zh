<%args>
    $feature
    $blast_url => undef
    $xrefs     => []
    $featurelocs
</%args>
<%once>
    use SGN::View::Feature 'mrna_cds_protein_sequence';
</%once>
<%perl>
    #my $reference   = $featurelocs ? $featurelocs->single->srcfeature : undef ;
    #getting only for primary featureloc
    my $reference   = $featurelocs ? $featurelocs->search({locgroup => 0,},)->single()->srcfeature() : undef ;
    my @mrnas       = grep $_->type->name eq 'mRNA', $feature->child_features;
    my $current_loc = $featurelocs ? $featurelocs->search({locgroup => 0,},)->single() : undef ; 
</%perl>

<& /feature/page_title.mas, feature => $feature &>

<&| /page/info_section.mas,
    title       => '基因(Gene)',
    subtitle    => $feature->is_obsolete ? '警告：此特徵已廢棄，有新資料可用。(WARNING: This feature is obsolete, new data is available.)' : '',
    collapsible => 1,
&>
  <& /feature/feature_data.mas,
      feature          => $feature,
      description_from => \@mrnas,
      featurelocs      => $featurelocs,
  &>

  <& /feature/properties.mas,
     feature => $feature,
   &>

</&>

<&| /page/info_section.mas,
   title       => '基因組檢視器(Genome Viewer)',
   collapsible => 1,
&>

	<& /feature/jbrowse_exact_match.mas, feature => $feature , src_feature => $reference &>

</&>


<&| /page/info_section.mas,
   title       => '相關特徵(Related features)',
   collapsible => 1,
&>
  <& /feature/related_features.mas,
      reference => $reference,
      feature   => $feature,
      omit_columns => ['organism'],
  &>

</&>


<&| /page/info_section.mas,
        title       => '基因組序列(Genomic sequence)',
        subtitle    => '此基因下方的未處理基因組序列區域(unprocessed genomic sequence region underlying this gene)',
        empty_message => '不可用(Not available)',
        collapsible => 1,
        collapsed   => 1,
&>

   <& /feature/region_sequence.mas,
       feature   => $feature,
       blast_url => $blast_url,
   &>

</&>

% for my $mrna ( @mrnas ) {

  <&| /page/info_section.mas,
          title       => 'mRNA '. $mrna->name,
          collapsible => 1,
  &>

    <&| /page/info_section.mas,
       title => '本體術語(Ontology terms)',
       subtitle => '與此 mRNA 相關的術語(terms associated with this mRNA)',
       collapsible => 1,
       is_subsection => 1,
    &>

      <& /feature/feature_cvterms.mas,
          feature   => $mrna,
      &>

    </&>

%   my ( $mrna_sequence, $cds_sequence, $protein_sequence ) = @{(mrna_cds_protein_sequence( $mrna ))[0] || [] };

    <&| /page/info_section.mas,
            title         => 'cDNA 序列(cDNA sequence)',
            is_subsection => 1,
            subtitle      => '剪接後的 cDNA 序列，包括 UTR(spliced cDNA sequence, including UTRs)',
            empty_message => '不可用(Not available)',
            collapsible   => 1,
            collapsed     => 1,
    &>

%  if( $mrna_sequence ) {

     <div style="margin-left: 3em">
       <& /sequence/with_markup.mas,
          seq       => $mrna_sequence,
          width     => 80,
          subdiv    => 10,
          blast_url => $blast_url,
        &>
     </div>
     <div style="margin-top: 1em">
        <& /feature/sequence_download.mas,
             feature => $mrna,
         &>
     </div>
% }

    </&>

    <&| /page/info_section.mas,
            title         => '蛋白質序列(Protein sequence)',
            is_subsection => 1,
            subtitle      => '轉譯後的多肽序列(translated polypeptide sequence)',
            empty_message => '不可用(Not available)',
            collapsible   => 1,
            collapsed     => 1,
    &>

%  if( $protein_sequence ) {

     <div style="margin-left: 3em">
       <& /sequence/with_markup.mas,
          seq       => $protein_sequence,
          width     => 80,
          subdiv    => 10,
          blast_url => $blast_url,
        &>
     </div>
%    if( $protein_sequence->can('feature_id') ) {
     <div style="margin-top: 1em">
        <& /feature/sequence_download.mas,
             feature => $protein_sequence,
         &>
     </div>
%    }
% }

    </&>

    <&| /page/info_section.mas,
        title         => '相關特徵(Related features)',
        is_subsection => 1,
        collapsible   => 1,
     &>

       <& /feature/related_features.mas,
             feature   => $mrna,
             omit_columns => ['organism'],
       &>

    </&>

  </&>
% }

<&| /page/info_section.mas,
     title       => '相關檢視(Related views)',
     collapsible => 1,
 &>
     <& /sitefeatures/mixed/xref_set/link.mas,
        xrefs   => $xrefs,
        exclude => 'gbrowse2',
      &>
</&>
