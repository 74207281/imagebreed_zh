<%args>
    $feature
    $featurelocs
    $blast_url => undef
    $xrefs     => []
    $protein_fasta => '';
</%args>

<%once>
    use SGN::View::Feature qw/ type_name /;
</%once>

<& /feature/page_title.mas, feature => $feature &>

<&| /page/info_section.mas,
    title       => type_name($feature,'caps').' 詳細資訊(details)',
    subtitle    => $feature->is_obsolete ? '警告：此特徵已廢棄，有新資料可用。(WARNING: This feature is obsolete, new data is available.)' : '',
    collapsible => 1,
&>
   <& /feature/feature_data.mas,
      feature     => $feature,
      featurelocs => $featurelocs,
    &>
    <& /feature/properties.mas,
       feature => $feature,
    &>
</&>

<&| /page/info_section.mas,
    title       => '樹狀圖與比對(Tree and alignment)',
    collapsible => 1,
&>

  <& /feature/gene_group_export_to_alignment_viewer.mas, feature => $feature &>

</&>

<&| /page/info_section.mas,
   title => '相關特徵(Related features)',
   collapsible => 1,
   hide_if_empty => 1,
&>

  <& /feature/related_features.mas,
      feature   => $feature,
      omit_columns => ['phase'],
      frequency_tables => ['type','organism'],
  &>
</&>

<&| /page/info_section.mas,
     title => '相關檢視(Related views)',
     empty_message => '未找到(None found)',
     collapsible => 1,
     is_empty => ! scalar @$xrefs,
 &>
     <& /sitefeatures/mixed/xref_set/link.mas,
        xrefs => $xrefs,
        empty_message => '',
      &>
</&>
