<%args>
    $feature
    $featurelocs
    $blast_url => undef
    $xrefs     => []
</%args>

<%once>
    use SGN::View::Feature qw/ type_name /;
</%once>

<& /feature/page_title.mas, feature => $feature &>

<&| /page/info_section.mas,
    title       => type_name($feature,'caps').' 詳細資訊(details)',
    subtitle    => $feature->is_obsolete ? '警告：此特徵已廢棄，有新資料可用。(WARNING: This feature is obsolete, new data is available.)' : '',
    collapsible => 1,
&>
   <& /feature/feature_data.mas,
      feature     => $feature,
      featurelocs => $featurelocs,
    &>
    <& /feature/properties.mas,
       feature => $feature,
    &>
</&>

%    for my $seqs ( mrna_cds_protein_sequence( $feature ) ) {
%       if( $seqs->[2] ) {
        <&| /page/info_section.mas,
                title         => '多肽序列(Polypeptide sequence)',
                subtitle      => '轉譯後的多肽序列(translated polypeptide sequence)',
                collapsible   => 1,
                collapsed     => 0,
        &>
          <div style="margin-left: 1em">
            <& /sequence/with_markup.mas,
               seq       => $seqs->[2],
               width     => 80,
               subdiv    => 10,
               blast_url => $blast_url,
             &>
             <div style="margin-top: 1em">
               <& /feature/sequence_download.mas,
                    feature  => $feature,
                &>
             </div>
          </div>
        </&>
%       }
%    }

<&| /page/info_section.mas,
     title         => '基因組序列(Genomic sequence(s))',
     subtitle      => "此多肽每個位置下方的未處理基因組序列(unprocessed genomic sequence underlying each location of this polypeptide)",
     collapsible   => 1,
     collapsed     => 1,
     hide_if_empty => 1,
 &>
    <& /feature/region_sequence.mas,
            feature   => $feature,
            blast_url => $blast_url,
    &>
</&>

<&| /page/info_section.mas,
   title => '相關特徵(Related features)',
   collapsible => 1,
   hide_if_empty => 1,
&>

  <& /feature/related_features.mas,
      feature   => $feature,
      omit_columns => ['organism'],
  &>

</&>

<&| /page/info_section.mas,
     title => '相關檢視(Related views)',
     empty_message => '未找到(None found)',
     collapsible => 1,
     is_empty => ! scalar @$xrefs,
 &>
     <& /sitefeatures/mixed/xref_set/link.mas,
        xrefs => $xrefs,
      &>
</&>


<%once>
   use SGN::View::Feature qw/ mrna_cds_protein_sequence /;
</%once>
