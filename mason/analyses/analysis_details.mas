<%args>
$trial_id
$trial_name
$trial_description
$breeding_program_name
$breeding_program_id
$year
$identifier_prefix
$trial_stock_type
$analysis_metadata
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>分析名稱(Analysis Name)</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[無分析名稱, No Analysis Name]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>育種計畫(Breeding Program)</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print "<span class='text-danger'>[無育種計畫, No Breeding Program]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>年份(Year)</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[無年份, No Year]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>描述(Description)</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[無描述, No Description]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>實驗方案(Protocol)</b></td>
                <td>
                    <div id="analysis_protocol">
%  print $analysis_metadata->analysis_protocol;
                    </div>
                </td>
            </tr>

            <tr><td><b>資料集 ID (Dataset ID)</b></td>
                <td>
                    <div id="analysis_dataset_id">
%  print $analysis_metadata->dataset_id;
                    </div>
                </td>
            </tr>

            <tr><td><b>建立時間(Created)</b></td>
                <td>
                    <div id="analysis_create_timestamp">
%  print $analysis_metadata->create_timestamp;
                    </div>
                </td>
            </tr>

            <tr><td><b>結果摘要(Result Summary)</b></td>
                <td>
                    <div id="analysis_result_summary">
%  if ($analysis_metadata->result_summary) {
%    while (my($k,$v) = each %{$analysis_metadata->result_summary}) {
%       print $k." : ".$v."<br/>";
%    }
%  }
                    </div>
                </td>
            </tr>

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
