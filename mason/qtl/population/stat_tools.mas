<%doc>

=head1 NAME
qtl/population/stat_tools.mas - a mason component for the interactive qtl analysis interface

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$referer
$guideline
$userid

</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<div id="statTools">
  <form>
    <table>
      <tr>
        <td>
          <input type="radio"
                 onclick="Qtl.toggleStatOptions('default');Qtl.setUserStatOption(<% $pop_id %>, 'default')"
                 name="stat_options"
                 value="default qtl parameters"> 使用預設 QTL 參數(Use default QTL parameters)
        </td>
        <td>
          <input type="radio"
                 onclick="Qtl.setUserStatOption(<% $pop_id %>, 'user_params');Qtl.logUser(<% $userid %>)"
                 name="stat_options"
                 value="user qtl parameters"> 設定您自己的 QTL 分析參數(Set your own QTL analysis parameters)
        </td>
% if (0)
%{
       <td>
          <input type="radio"
                 onclick="Qtl.toggleStatOptions('diagnosticTests')"
                 name="stat_options"
                 value="diagnostic tests"> 診斷測試(Diagnostic tests)
     </td>
%}
      </tr>
    </table>
  </form>

  <div id="default"  style="display:none; color:blue">
       請繼續進行您感興趣性狀的 QTL 分析(Please proceed with your QTL analysis of your trait of interest)。<br />
       QTL 分析的預設參數將顯示在分析輸出的圖例上(The default parameters for QTL analysis are displayed on the legend of the analysis output)。<br />
  </div>
  <div id="qtlParameters" style="display:none">
    <table align="center">
     <tr>
       <td>
          <% $guideline %>
        </td>
      </tr>
    </table>

    <& /qtl/qtl_form/stat_form.mas,
     pop_id  => $pop_id,
     referer => $referer,
     guide   => $guideline
  &>
 </div>

% if (0)
%{
  <div id="diagnosticTests"
       style="display:none;
              color:blue;
              text-align:right
              ">
    Under development.
  </div>
%}
</div>

 <& /qtl/waitmessage.mas &>
