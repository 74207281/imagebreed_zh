<%doc>

=head1 NAME

missing_data.mas - a mason component for displaying missing data from 
qtl data submission forms

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$missing_data
$guide

</%args>

<%perl>

my ( $messages, $count );

if ( @{$missing_data} ) 
{
       
$messages .= "缺少以下欄位的資料(Data for the following field(s) is missing): <br /><br />";
my $count = 1;
foreach my $e (@{$missing_data}) {

$messages .= $count . ")" . "\t" . $e . "." . "<br />";
$count++;
}

$messages .= qq | <p><a href="javascript:history.go(-1)">
   請返回並填寫遺漏的資訊(Please go back and fill in the missing information)。</a> </p>|;
}

</%perl>

<& /page/page_title.mas, title => "缺少資料(Missing Data):" &>
<&| /page/info_section.mas, title => ' ', 
  subtitle => $guide &>
 <% $messages %>  
</&>
