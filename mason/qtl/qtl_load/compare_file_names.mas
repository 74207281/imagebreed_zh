<%doc>

=head1 NAME

compare_file_names.mas - a mason component for displaying message 
when a user tries to submit the same files for two different dataset fields...
=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$file1
$file2
$guide

</%args>

<%perl>
my $message = qq | <p>您嘗試在此步驟和之前的步驟中上傳同名的檔案(You are trying to upload file(s) with the same name) 
                     <b>($file1 與(and) $file2)</b>。
                   </p>

                   <p>請<a href="javascript:history.go(-1)"><b>返回(back)</b></a> 
                     並檢查您嘗試上傳的檔案，或者如果您持續遇到問題請聯繫我們(and check the file you are trying to upload or if you keep having problem with it contact us)。
                   </p>
                | ;


</%perl>

<& /page/page_title.mas, title => '資料檔案(Data files)' &>
<&| /page/info_section.mas, title => '', subtitle => $guide &>
  <% $message %>  
</&>
