<%doc>

=head1 NAME
qtl/qtl_form/pop_form.mas - a mason component for the qtl pop detail webform

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$guide

</%args>

<%perl>

use CXGN::Phenome::Qtl::Tools;
use CXGN::Page::FormattingHelpers qw | tooltipped_text |;

my $organism = qq| <a href="javascript:Qtl.toggleAssociateTaxon()">[選擇生物體(Select Organism)]</a> |;
my $required = qq | <font color="red"><sup>*</sup></font>|;
my $qtltools = CXGN::Phenome::Qtl::Tools->new();

my %cross_types =  $qtltools->cross_types();
my $cross_options;
foreach my $key (keys %cross_types) {
	$cross_options .= qq |<option value="$key">$cross_types{$key} |;
    }

my $parent_m = tooltipped_text('父本(Male parent)', '格式範例：(format eg.) Solanum lycopersicum cv moneymaker');
my $parent_f = tooltipped_text('母本(Female parent)', '格式範例：(format eg.) Solanum lycopersicum cv micro tom');

</%perl>

<& /util/import_javascript.mas, classes => [ ] &>

<& /page/page_title.mas, title => "步驟 1：提交 QTL 群體詳細資訊(Step 1: Submit QTL Population Details)" &>
<&| /page/info_section.mas, title => $organism, subtitle => $guide &>
<& organism_form.mas &>
</&>

<&| /page/info_section.mas,
  title => "群體詳細資訊(Population Details)",
&>
<% $required %> <span><i>為必填欄位(must be filled)。</i><br/><br/></span>
<form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">
     <table>
     <tr>
       <td>雜交類型(Cross type)<% $required %></td>
	 <td> <select name="pop_type">
	          <% $cross_options %>
             </select>
         </td>
     </tr>
     <tr>
	<td>群體名稱(Population name)<% $required %></td>
	<td><input type="text" name="pop_name" size=42></td>
     </tr>
     <tr>
         <td>群體描述(Population description)<% $required %></td>
         <td><textarea name="pop_desc" rows = 5 cols=44></textarea></td>
     </tr>
     <tr>
	<td><% $parent_f%><%$required %> </td>
	<td><input type="text" name="pop_female_parent" size=24></td>
	<td><% $parent_m %><% $required %> </td>
	<td><input type="text" name="pop_male_parent" size=24></td>
     </tr>
     <tr>
	<td>輪迴親本(Recurrent parent)</td>
	<td><input type="text" name="pop_recurrent_parent" size=24></td>
	<td>供體親本(Donor parent)</td>
	<td><input type="text" name="pop_donor_parent" size=24></td>
     </tr>
     <tr>
      <td>您希望將資料公開嗎？(Do you want to make the data public?)</td>
      <td><input type="radio" name="pop_is_public" value="true" checked />是(Yes)</td>
      <td><input type="radio" name="pop_is_public" value="false" />否(No)</td>
     </tr>
     <tr>
       <td>&nbsp;</td><td>&nbsp;</td>
       <td><input type="hidden" name="type" value="pop_form"></td>
       <td><input type="submit" value="提交(Submit)"></td>
     </tr>
     </table>
     </form>

</&>
