<%doc>

=head1 NAME 
qtl/qtl_form/stat_form.mas - a mason component for a QTL stat parameters 
submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide
$referer

</%args>

<%perl>

use CXGN::Page::FormattingHelpers qw | tooltipped_text |;

my $no_draws = tooltipped_text('插補次數(No. of imputations):', '僅在 QTL 基因型機率計算方法選擇模擬法與多重插補時需要(required only if the Simulate method is selected for the calculation of QTL genotype probability method and Multiple Imputation)');
my $permu_level = tooltipped_text('置換檢定顯著水準(Significance level of permutation test):', '僅在運行置換分析 (LOD 閾值) 時需要(required only if permutation analysis (LOD threshold) is run)');
my $genome_scan = tooltipped_text('全基因組掃描間距 (cM)(Genome scan size (cM)):', '標記迴歸不需要(not required for Marker Regression)');
my $qtl_prob = tooltipped_text('QTL 基因型機率方法(QTL genotype probablity method):', '標記迴歸不需要(not required for Marker Regression)');

</%perl>


% if ( $referer =~ /qtl\/form\/stat_form/) 
%{
<& /page/page_title.mas, 
   title => "步驟 5：提交統計參數(Step 5: Submit Statistical Parameters)" 
&>
<& /page/info_section.mas, 
   title => "統計參數(Statistical Parameters)", 
   subtitle => $guide 
&> 
%}

  <form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">  
    <table cellspacing=20>
      <tr>
        <td>QTL 模型(QTL model): 
        </td>
	<td>
          <select name="stat_qtl_model">
	    <option value="">
            <option value="Single-QTL Scan">單 QTL 掃描(Single-QTL Scan)	    
          </select>
	</td>
        <td>QTL 定位方法(QTL mapping method):</td>
	<td>
          <select name="stat_qtl_method">	         
	    <option value="">
            <option value="Marker Regression">標記迴歸(Marker Regression)
            <option value="Maximum Likelihood">最大概似法(Maximum Likelihood) 
	    <option value="Haley-Knott Regression">Haley-Knott 迴歸(Haley-Knott Regression)
            <option value="Multiple Imputation">多重插補(Multiple Imputation)
	  </select>
	</td>
      </tr>
      <tr>
        <td><% $qtl_prob %>
        </td>
        <td>
          <select name="stat_prob_method">
            <option value="">
	    <option value="Calculate">計算(Calculate)
            <option value="Simulate">模擬(Simulate)
	  </select>
	</td>
        <td>QTL 基因型機率顯著水準(QTL genotype probability significance level):
        </td>
        <td>
          <select name="stat_prob_level">
	    <option value="">
            <option value="0.001">0.001
            <option value="0.05">0.05
	    <option value="0.1">0.1		    
	  </select>	
        </td>
      </tr>
      <tr>
        <td><% $genome_scan %>
        </td>
        <td>
          <select name="stat_step_size">
            <option value="">
	    <option value="zero">零(zero)
	    <option value="1">1
            <option value="2.5">2.5
	    <option value="5">5
	    <option value="10">10
	  </select>
	</td>    
        <td><% $no_draws %>
        </td>
	<td>
          <select name="stat_no_draws">
	    <option value="">
	    <option value="5">5
            <option value="10">10
	    <option value="15">15
	    <option value="20">20
	  </select>	
        </td>       
      </tr>
      <tr>
        <td>置換次數(No. of permutations):
        </td>
        <td>
          <select name="stat_permu_test">
	    <option value="">
            <option value="None">無(None)
            <option value="100">100
	    <option value="1000">1000		    
	  </select>
        </td>
        <td><% $permu_level %>
        </td>
        <td> 
          <select name="stat_permu_level">
	    <option value="">
            <option value="0.05">0.05
            <option value="0.001">0.001
	    <option value="0.1">0.1		    
	  </select>
        </td>
      </tr>
      <tr>      
        <td> 
          <input type="hidden" name="type" value="stat_form">
        </td>  
        <td> 
          <input type="hidden" name="pop_id" value = <% $pop_id %> >
        </td>
      </tr>
      <tr>      
        <td>
        </td>
        <td>
          <input type="submit" value="提交(Submit)"> 
        </td>
        <td>
        </td> 
        <td> 
          <input type="reset"  value="重設(Reset)">
        </td>      
      </tr>
    </table>
  </form>

