<%doc>
QTL search results view.
</%doc>

<%args>

$data
$pager
$page_links
$query

</%args>

<& /page/page_title.mas,
    title => 'QTL 搜尋結果(QTL search results)',
&>
  
% if ($data) 
% { 

<&| /page/info_section.mas,
      title => '搜尋結果(Search Results)',
&>
  <& /page/columnar_table.mas,
     headings    => [ '性狀名稱(Trait name)', '定義(Definition)', 'QTL' ],
    data         => $data,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
  &>
  </&>
  <& /page/pagination_control.mas, 
     pager     => $pager, 
    link_maker => $page_links 
  &> 
%}
%else
%{
<&| /page/info_section.mas,
      title => '搜尋結果(Search Results)',
&>
%if ( $query )
%{
<br>未找到 <i><strong>'<% $query %>'</strong></i> 的結果(No results found for '<% $query %>')。<br />
%}
%else
%{
<br>無結果。請使用性狀名稱重新搜尋(No results. Search again with a trait name)。<br />
%}
</&>
%}

<&| /page/info_section.mas,
    title       => '搜尋(Search)',
    collapsible => '1',
    collapsed   => 1
 &>

<& /search/phenotypes/qtl.mas &>

</&>


