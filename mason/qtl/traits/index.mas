<%doc>
QTL traits list.
</%doc>

<%args>
$index
$traits_list
</%args>

<& /page/page_title.mas, 
   title=>'具 QTL 的性狀清單(List of traits with QTLs)'
&>

<&| /page/info_section.mas, 
   title    => qq |以 "$index" 開頭的性狀(Traits beginning with "$index") |
&>

<&/page/columnar_table.mas,
   data         => $traits_list,
  __align       => 'l',
  __alt_freq    => 2,
  __alt_width   => 1,
  __cellpadding => 20,
 &>

</&>
