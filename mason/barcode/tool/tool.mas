
<%args>
$cvterm
$cvterm_name
$cvterm_definition=>undef
$cvterm_values
$cvterm_synonym => ''
$tool_version => 0
</%args>

<%perl>

use Tie::UrlEncoder;
our %urlencode;

my @values = split /,/,$cvterm_values;

my $hash = $urlencode{'#'};
</%perl>

<center>
<h1>CASSAVABASE 條碼工具(CASSAVABASE BARCODE TOOL)</h1>

工具版本(Tool version)：<% $tool_version %>
<br />
<br />

% my $version_string = "V$tool_version-$cvterm";

<!-- img src="/barcode/code128png/<% $version_string %>/<% $version_string %>" /><br / -->

<font size="6"><% $cvterm %> - <% $cvterm_name %> <br /><% $cvterm_synonym %></font><br /><br />
<div class="boxbgcolor5"><font size="4"><% $cvterm_definition %></font></div>

% if ($cvterm_values eq "numeric") { 
<center>
<br />
<div class="boxbgcolor7"><font size="3"><b>注意(Note)</b> 請掃描下方的主條碼，然後使用「數字鍵盤」掃描數字以產生數值。<br /></font></div>
<img src="/barcode/code128png/<% $cvterm %><% $hash %>/<% $cvterm_name %>" />
<br />
<br />
<& /barcode/tool/numberpad.mas &>
% }
% else { 
<table border="0">
%   foreach my $v (@values) { 
<tr><td style="vertical-align:middle"><font size="6">數值(value) = <% $v %></font></td><td><img src="/barcode/code128png/<% $cvterm %><% $hash %><% $v %>/<% $cvterm_name %>" /></td></tr>

%   }
% }
</table>
