
<%args>
$operator
$date
$project
$location
$size => 'large'
</%args>

<%perl>
use Tie::UrlEncoder;

our %urlencode;
my $encoded_operator = $urlencode{$operator};
my $encoded_date     = $urlencode{$date};

</%perl>

<center>
<h1>CASSAVABASE 元資料條碼單(CASSAVABASE METADATA BARCODE SHEET)</h1>
<font size="7">操作人員(Operator)</font><br />

<img src="/barcode/image/?code=O:<% $encoded_operator %>&size=<% $size %>" />

<br />
<br />

<font size="7">今日日期(Today's Date)</font>
<br />
<img src="/barcode/image/?code=D:<% $encoded_date %>&size=<% $size %>" />

<br />
<br />

<font size="7">專案/試驗(Project)</font>
<br />
<img src="/barcode/image/?code=P:<% $project %>&size=<% $size %>" />

<br />
<br />

<font size="7">地點(Location)</font>
<br />
<img src="/barcode/image/?code=L:<% $location %>&size=<% $size %>" />


</center>
