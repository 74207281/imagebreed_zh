

<%args>
$error => undef
@found => ()
@not_found => ()
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>'下載條碼(Download Barcodes)' &>

% if (!@not_found && !$error) {
  清單中的所有材料均已在資料庫中找到。請點擊下方連結下載條碼標籤檔案。<br />
% }
% elsif ($error){
    <b>下載小區表型條碼(Download Plot Phenotyping Barcode)</b> <%$error%>。如需一般條碼列印，請使用<b>下載材料條碼(Download Stock Barcodes)區段</b>。
% }
% else {
  在資料庫中找不到下列 <% scalar(@not_found) %> 個材料：<br />
%   foreach my $nf (@not_found) {
      <b><% $nf %></b>
%   }
    <br /><br />
%   if (@found > 0) {

    其他 <% scalar(@found) %> 個條碼可從下方連結下載。

%   }
%   else {
    未找到任何材料。請確認您的輸入並重試。
%   }


% }

% if (@found > 0) {
<br /><br />
<a target="_blank" href="<% $file %>" >下載 <% $filetype %> 檔案(Download <% $filetype %> file)</a>
%}
