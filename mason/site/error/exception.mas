<%args>
 $exception
 $show_dev_message => 0
 $project_name => ''
 $contact_email => ''
</%args>

% $exception = [ $exception ] unless ref $exception eq 'ARRAY';
% for my $e (@$exception) {

<h1 style="text-align: center">
   <% $e->title || ( $e->is_server_error ? '伺服器錯誤(Server Error)' : $e->is_client_error ? '錯誤(Error)' : '訊息(Message)' ) %>
</h1>

<div style="margin: auto; width: 60%">
    <p>
% if( $e->public_message ) {
    <% $e->public_message . ( $e->public_message =~ /\.\s*$/ ? '' : '.' ) %>
% } else {
    很抱歉，處理您的請求時發生錯誤。
% }
    </p>

    <p>
% if( $e->notify ) {
    錯誤報告已發送給 <% $project_name %> 開發團隊。
% }

% if( $e->is_client_error || $e->is_server_error and $contact_email ) {

    如果問題持續存在，歡迎隨時透過 <a href="mailto:<% $contact_email %>">
    <% $contact_email %></a> 與我們聯繫，
%   if( $e->is_server_error ) {
      我們將隨時向您通知解決進度。
%   } else {
      我們將與您一起解決此問題。
%   }
   </p>

% }

</div>

%   if( $show_dev_message && $e->can('developer_message') && defined $e->developer_message ) {
    <style>
       pre {
            white-space: pre-wrap;       /* css-3 */
            white-space: -moz-pre-wrap;  /* Mozilla, since 1999 */
            white-space: -pre-wrap;      /* Opera 4-6 */
            white-space: -o-pre-wrap;    /* Opera 7 */
            word-wrap: break-word;       /* Internet Explorer 5.5+ */
        }
     </style>

    <div style="margin: 1em 0; border: 2px solid orange; padding: 0 1em 1em 1em">
      <h3>開發者訊息(Developer message)：</h3>
        <pre><% defined $e->developer_message ? $e->developer_message : '未提供' | h %></pre>
    </div>
%   }
% }
