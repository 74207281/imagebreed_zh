
<%doc>

=head1 NAME

File viewer - displays the contents of a file

=head1 DESCRIPTION

Arguments: file. Fully qualified path to the file.

=head1 AUTHOR

Lukas Mueller

=cut

</%doc>


<%args>

$file

</%args>

<%perl>

use File::Slurp qw | slurp |;

my $contents = '無法取得內容(Content not available)。';

eval { 
  $contents = slurp($file);
};

</%perl>

<% $contents %>



