<%args>
$itag_releases
</%args>

<& /page/page_title.mas, title => '可批量下載之 ITAG 發布版本(ITAG Releases Available for Bulk Download)' &>

% if ( @$itag_releases ) {

<ul>
%   for my $rel ( @$itag_releases ) {

  <li><a href="/itag/release/<% $rel->release_number %>/list_files"><% $rel->release_name %></a></li>

%   }
</ul>

% } else {

<span class="ghosted">暫時無法使用(temporarily unavailable)</span>

% }
