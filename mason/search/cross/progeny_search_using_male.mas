
<& /page/page_title.mas, title=>'搜尋父本/群體後代(Search Progenies of Male Parents / Populations)' &>
<br>
<&| /page/info_section.mas, title => '搜尋(Search)', collapsible=>1, collapsed=>0&>
    <div class="row" id="progeny_search_form_male_parent" >
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-horizontal">
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3">父本/群體(Male Parent / Population):</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="male_parent" placeholder="輸入父本名稱(Enter male parent)">
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_pedigree_female_parents"><i class="glyphicon glyphicon-search"></i> 母本(Female Parent) </button>
                                        <button class="btn btn-primary" id="search_all_progenies_using_male"><i class="glyphicon glyphicon-search"></i> 此父本的所有後代(All Progenies of this Male Parent) </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3">母本(Female Parent):</label>
                            <div class="col-sm-9" >
                                <div class="input-group">
                                    <select class="form-control" id="female_parent">
                                        <option value="">請先選擇父本(Choose male parent first)</option>
                                    </select>
                                    </select>
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_pedigree_male_female"><i class="glyphicon glyphicon-search"></i> 這些親本的後代(Progenies of these Parents) </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>
<&| /page/info_section.mas, title => '搜尋結果(Search Results)', collapsible=>1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="pedigree_male_female_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>母本(Female Parent)</th>
                            <th>父本/群體(Male Parent / Population)</th>
                            <th>後代(Progeny)</th>
                            <th>雜交類型(Cross Type)</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-body">
                <&| /page/info_section.mas, title => '複製後代至清單(Copy Progenies to a List)', collapsible=>1, collapsed=>1, subtitle=>'<i>將表格中顯示的後代名稱複製到新清單或現有清單中</i>'&>
                    <br>
                    <div style="text-align:right" id="progenies_to_list_menu"></div>
                    <div id="progeny_names" style="display: none;"></div>
                </&>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function (){

    jQuery("#male_parent").autocomplete({
        source:'/ajax/stock/pedigree_male_parent_autocomplete',
    });


    jQuery("#search_pedigree_female_parents").click(function(){

        jQuery.ajax({
            url:'/ajax/search/pedigree_female_parents',
            data:{'pedigree_male_parent':jQuery('#male_parent').val()},
            success: function(response){
                console.log(response);
                var html = '<select id = "female_parent" >';
                for (var i=0; i<response.data.length; i++) {
                    html = html + "<option value='"+response.data[i][0]+ "'>" + response.data[i][0] + "</option>";
                }
                html = html + "</select>";
                console.log(html);
                if(i ==''){
                    alert("無符合的母本！(No female parent)");
                    return;
                }

                jQuery('#female_parent').html(html);
            },
            error:function(response){
                alert("發生錯誤！(An error occurred)");
            }
        });
    });


    jQuery('#search_all_progenies_using_male').click(function(){

        var table = jQuery('#pedigree_male_female_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy': true,
            'ajax': {'url':'/ajax/search/progenies',
                data:{'pedigree_male_parent':jQuery('#male_parent').val()},
            }
        });

        jQuery('#pedigree_male_female_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) {
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }
            jQuery('#progeny_names').html(names);

            addToListMenu('progenies_to_list_menu', 'progeny_names',{
                listType:'accessions'
            });
        });
    });


    jQuery('#search_pedigree_male_female').click(function(){

        var table = jQuery('#pedigree_male_female_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy': true,
            'ajax': {'url':'/ajax/search/progenies',
                data:{'pedigree_female_parent':jQuery('#female_parent').val(),
                    'pedigree_male_parent':jQuery('#male_parent').val(),
                    }
            }
        });

        jQuery('#pedigree_male_female_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) {
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }

            jQuery('#progeny_names').html(names);

            addToListMenu('progenies_to_list_menu', 'progeny_names',{
                listType:'accessions'
            });
        });
    });


});


</script>
