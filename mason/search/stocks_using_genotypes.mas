<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title=>'搜尋包含特定基因型的種原(Search Accessions Containing Specific Genotypes)' &>

<!--
<&| /page/info_section.mas, title=>'Step 1: Select a set of accessiions (dataset)'&>
    <div class="row" id="search_form_1" >
        <div class="col-sm-1">
        </div>
        <div class="col-sm-12 well">
            <span style="width:240px" id="dataset_accessions"></span>
        </div>
    </div>
</&>
-->

<&| /page/info_section.mas, title=>'步驟一(Step 1):'&>
    <div class="row" id="search_form_1" >
        <div class="col-sm-1">
        </div>
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-11">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-sm-4">選擇種原清單(Select a list of accessions):</label>
                            <div class="col-sm-8" >
                                <div class="input-group">
                                    <select class="form-control" id="stock_list_select">
                                        <option value="">選擇種原清單(Select a list of accessions)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>

<br>
<&| /page/info_section.mas, title=>'步驟二(Step 2):'&>
    <div class="row" id="search_form_2" >
        <div class="col-sm-1">
        </div>
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-11">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-sm-4">選擇分子標記組(Select a markerset):</label>
                            <div class="col-sm-8" >
                                <div class="input-group">
                                    <select class="form-control" id="markerset_select">
                                        <option value="">選擇分子標記組(Select a markerset)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-sm-4"></label>
                            <div class="col-sm-8" >
                                <a href="/breeders/markers"><p>需要建立新的分子標記組(Need to create new markerset)。</p></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>
<br>
<&| /page/info_section.mas, title=>'步驟三(Step 3):'&>
    <div class="row" id="search_form_3" >
        <div class="col-sm-1">
        </div>
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-11">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-sm-4"></label>
                            <div class="col-sm-8" >
                                <button class="btn btn-primary" id="search_accessions_using_markerset"><i class="glyphicon glyphicon-search"></i> 搜尋種原(Search Accessions)</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
 </&>


<&| /page/info_section.mas, title => '搜尋結果(Search Results)' , collapsible=>1, collapsed=>0 &>

    <table id="genotype_search_results" width="100%" class="table table-hover table-striped">
    </table>
</&>

<script>


jQuery(document).ready(function (){

    var data_set = new CXGN.Dataset();
    var lo = new CXGN.List();

//    get_select_box('datasets', 'dataset_accessions', {"checkbox_name":"dataset_accessions_checkbox"});
    jQuery('#stock_list_select').html(lo.listSelect('stock_list_select', ['accessions'], '選擇種原清單(Select a list of accessions)', undefined, undefined));

    jQuery('#markerset_select').html(lo.listSelect('markerset_select', ['markers'], '選擇分子標記組(Select a markerset)', undefined, undefined));

    jQuery("#search_accessions_using_markerset").click(function(){

//        var selected_datasets = [];
//        var dataset_id;
//        jQuery('input[name="dataset_accessions_checkbox"]:checked').each(function() {
//            selected_datasets.push(jQuery(this).val());
//        });

//        if (selected_datasets.length < 1){
//            alert('Please select a set of accessions!');
//            return false;
//        } else if (selected_datasets.length > 1){
//            alert('Please select only one set of accessions!');
//            return false;
//        } else {
//            dataset_id = selected_datasets[0];
//        }

        var stock_list_id = jQuery('#stock_list_select').val();

        if (!stock_list_id) {
            alert("請選擇種原清單！(Please choose a list of accessions)");
            return;
        }

        var markerset_id = jQuery('#markerset_select').val();

        if (!markerset_id) {
            alert("請選擇分子標記組！(Please choose a markerset)");
            return;
        }

        var table = jQuery('#genotype_search_results').DataTable({
            'destroy' : true,
            'ajax': { 'url':'/ajax/search/search_stocks_using_markerset',
                'data':{
                    'stock_list_id': stock_list_id,
                    'markerset_id': markerset_id,
                }
            },
            columns: [
                {
                    title: "種原名稱(Accession Name)",
                    data: null,
                    render: function(data, type, row){return "<a href='/stock/"+row.stock_id+"/view'>"+row.stock_name+"</a>";}
                },
                {
                    title: "樣本名稱(Sample Name)",
                    data: null,
                    render: function(data, type, row){return "<a href='/stock/"+row.sample_id+"/view'>"+row.sample_name+"</a>";}
                },
                {
                    title: "樣本類型(Sample Type)",
                    data: "sample_type",
                },
                {
                    title: "基因型(Genotypes)",
                    data: "genotypes",
//                    render: function(data, type,row){
//                        var newFormat = data.split(",").join("&nbsp &nbsp &nbsp &nbsp &nbsp");
//                        return newFormat;
//                    }
                },
            ],
        });
    });

});


</script>
