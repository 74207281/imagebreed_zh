<%args>

  $results

  $quick_search_term

  $show_times => 0

  $xrefs      => {}
  $xrefs_time => 0

</%args>

<& /page/page_title.mas, title => '快速搜尋(Quick search)：'.encode_entities( '"'.$quick_search_term.'"' ) &>

<div class="page_introduction">
  注意：快速搜尋執行的查詢與各類資料的完整搜尋不完全相同。如果未出現您期望的結果，您可以嘗試在「搜尋」選單中使用進階搜尋工具。
</div>

<&| /page/info_section.mas, title => '精確比對(Exact matches)' &>

<div class="well">

% if( $show_times ) {
  <div>網站交叉參照搜尋耗時：<% sprintf('%0.1f 秒', $xrefs_time) %></div>
% }
% if( @$xrefs ) {
  <& /sitefeatures/mixed/xref_set/link.mas, xrefs => $xrefs &>
    <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />
% }

  <div>
    <dl>
      <dt>識別碼 - 育種資料(Identifiers - Breeding Data)</dt>
      <dd>
	<div style="float: left; width: 50%">
	  <% $search{accessions} %>
	  <% $search{populations} %>
	  <% $search{trials} %>
	</div>
	<div style="float: right; width: 50%">
	  <% $search{traits} %>
	  <% $search{locations} %>
	  <% $search{breeding_programs} %>
	</div>
	<div style="clear: both;">&nbsp;</div>
      </dd>
      <dt>識別碼 - 基因體資料(Identifiers - Genomic Data)</dt>
      <dd >
	<div style="float: left; width: 50%">
          <% $search{marker} %>
          <% $search{clone} %>
          <% $search{est} %>
	</div>
	<div style="float: right; width: 50%;">
	  <% $search{unigene} %>
	  <% $search{microarray} %>
	</div>
      </dd>
    </dl>
    <span style="margin-bottom:20px;">&nbsp</span>
  </div>
</div>

</&>

<&| /page/info_section.mas,
    title => '模糊搜尋(Fuzzy searches)',
    subtitle => '點擊檢視搜尋結果',
 &>

<div class="well">

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">識別碼(Identifiers)</div>
      <div style="float: right; width: 50%">cDNA 文庫(cDNA Libraries)</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{bac} %>
        <% $search{phenotype} %>
      </div>
      <div style="float: right; width: 50%">
	<% $search{locus_allele} %>
        <% $search{library} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">人員（依姓名搜尋）(People (searching by name))</div>
      <div style="float: right; width: 50%">註解資訊(Annotations)</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{people} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{manual_annotations} %>
        <% $search{automatic_annotations} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%">影像(Images)</div>
      <div style="float: right; width: 50%">網頁(Web Pages)</div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{image} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{sgn_pages} %>
        <% $search{external_link} %>
        <% $search{web} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

</div>

</&>

<%init>

  use HTML::Entities;

  my %search = %$results;
  for my $search ( values %search ) {
      my ( $url, $desc ) = @{$search->{result}};
      my $time  = $show_times ? sprintf(' (%0.1f sec)', $search->{time}) : '';
      my $html = $url ? qq|<div><a class="quicksearch_hit" href="$search->{result}[0]">$search->{result}[1]$time</a></div>|
                      : qq|<div class="ghosted">$desc$time</div>|;
      $search = $html;
  }

</%init>
