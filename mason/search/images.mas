
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => "影像搜尋(Image Search)" &>

<&| /page/info_section.mas, title=>"影像搜尋條件(Image Search Criteria)",  collapsible => 1, collapsed=>0, subtitle => "並非所有影像都具有相關聯的名稱、描述或標籤。"&>

    <div id="image_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label">影像描述項 (名稱、描述或檔案名稱 / Image descriptors): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_description_filename_composite" name="image_description_filename_composite" placeholder="例如：MyImageName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">公司/單位(Company): </label>
                <div class="col-sm-6" >
                    <div id="image_private_company_div"></div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">提交者(Submitter): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_submitter" name="image_submitter" placeholder="例如：JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">影像標籤(Image Tag): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_tag" name="image_tag" placeholder="例如：ImageTagName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">關聯材料(Associated Stock): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_stock_uniquename" name="image_stock_uniquename" placeholder="例如：FieldPlot100" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">關聯專案/試驗(Associated Project): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_project_name" name="image_project_name" placeholder="例如：DroneProject 01/01/2019" />
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="image_search_submit" >搜尋(Search)</button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>"影像搜尋結果(Image Search Results)",  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="images_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>影像縮圖(Image Thumbnail)</th>
                    <th>公司/單位(Company)</th>
                    <th>檔案名稱(Filename)</th>
                    <th>描述(Description)</th>
                    <th>提交者(Submitter)</th>
                    <th>關聯(Associations)</th>
                    <th>標籤(Tags)</th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<script>

var images_table;

jQuery(document).ready(function () {

    get_select_box('private_companies', 'image_private_company_div', { 'name': 'image_private_company_id', 'id': 'image_private_company_id' });

    _load_image_search_results();

    jQuery("#image_submitter").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery('#image_search_submit').click( function() {
        _load_image_search_results();
    });

    jQuery('#image_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#image_search_submit').click();
        }
    });

    jQuery('#images_search_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox();
    });

});

function _load_image_search_results() {
    images_table = jQuery('#images_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/images',
            'data': function(d) {
              d.image_description_filename_composite = jQuery('#image_description_filename_composite').val();
              d.image_person = jQuery('#image_submitter').val();
              d.image_tag = jQuery('#image_tag').val();
              d.image_stock_uniquename = jQuery('#image_stock_uniquename').val();
              d.image_project_name = jQuery('#image_project_name').val();
              d.private_company_id = jQuery('#image_private_company_id').val();
            }
        }
    });
}

</script>
