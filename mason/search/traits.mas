
<%args>
$is_curator => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jquery.dataTables-select-min' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css', '/documents/inc/datatables/custom_datatable_select_styles.css'] &>

<& /page/page_title.mas, title => "性狀搜尋(Trait Search)" &>


    <&| /page/info_section.mas, title => '搜尋(Search)', collapsible=>1, collapsed=>0 &>
        <div id="trait_search_form" class="form-horizontal well">
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label">選擇本體名稱(Select Ontology Name(s)): </label>
                <div class="col-sm-9" >
                    <div id="trait_search_ontology_select"></div>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label">搜尋性狀名稱(Search Trait Name): </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_name" placeholder="搜尋任何性狀名稱或名稱片段"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label">搜尋定義(Search Definition): </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_definition" placeholder="搜尋任何詞彙或定義片段"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label">性狀子集清單(Subset Traits): </label>
                <div class="col-sm-9" >
                    <div id="trait_search_list_select">
                        [載入中... (LOADING...)]
                    </div>
                </div>
            </div>
        </div>

        <center>
            <button class="btn btn-primary" id="submit_trait_search" />搜尋(Search)</button>
        </center>
    </&>

    <&| /page/info_section.mas, title => '結果(Results)', collapsible=>1, collapsed=>0 &>

        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">

                    <table id="trait_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                      <tr>
                        <th>選取(Select)</th>
                        <th>性狀ID(Trait ID)</th>
                        <th>性狀名稱(Trait Name)</th>
                        <th>定義(Definition)</th>
                        <th>性狀使用情況(Trait Usage)</th>
                      </tr>
                    </thead>
                    </table>

                    <button type="button" class="selectAll-dt">全選(Select All)</button>
                    <button type="button" class="deselectAll-dt">取消全選(Deselect All)</button>

                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">

                    <&| /page/info_section.mas, title => '複製選取的結果至清單(Copy Selected Results to a List)', collapsible=>1, collapsed=>0, subtitle=>'<i>將搜尋結果表格中目前選取的性狀名稱複製到新清單或現有清單中</i>'&>
                    <br>
                    <p><em>已選取 <span id="trait_result_count">0</span> 個性狀 (trait(s) selected)。</em></p>
                    <div style="text-align:right" id="traits_to_list_menu"></div>
                    <div id="trait_result_names" style="display: none;"></div>
                    </&>

                </div>
            </div>
        </div>
    </&>

<& /breeders_toolbox/add_new_trait_dialogs.mas &>

    <&| /page/info_section.mas, title => '說明(Help)', collapsible=>1, collapsed=>0 &>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <h2>找不到您要尋找的性狀嗎？(Is the trait you are looking for not here?)</h2>

%  if ($c->config->{allow_observation_variable_submission_interface}) {

%  if ($is_curator) {
                        <button class="btn btn-primary" name="add_new_observation_variable_button">新增觀測變數 (僅限管理者 / Curators Only)</button>
                        <!--button class="btn btn-primary" name="upload_new_observation_variable_button">Upload Observation Variables</button-->
%  } else {
                        <button class="btn btn-primary" disabled>新增觀測變數 (僅限管理者 / Curators Only)</button>
%  }

%  } else {

                        <p>請<a href="http://submit.rtbbase.org/">使用性狀提交表單</a>提交您的新性狀。</p>
                        <p>為加速將您的性狀加入資料庫中，請使用<a href="/contact/form">聯絡表單</a>與我們聯絡。</p>
                        <p>在 sgn.conf 設定檔中啟用 'allow_observation_variable_submission_interface' 即可在此處以互動方式新增變數！</p>
%  }
                </div>
            </div>
        </div>
    </&>

</div>

<script>

jQuery(document).ready(function () {

    get_select_box('trait_variable_ontologies', 'trait_search_ontology_select', { 'name' : 'trait_search_ontology_select_id', 'cvprop_type_name':JSON.stringify(['trait_ontology','composed_trait_ontology']) });

    jQuery('[data-toggle="tooltip"]').tooltip();

    var lo = new CXGN.List();
    jQuery('#trait_search_list_select').html(lo.listSelect('trait_search_list_select', [ 'traits' ], '留空以檢視所有性狀(Leave blank to see all traits)', undefined, undefined));

    jQuery(document).on('change', '#trait_search_list_select', function(){
        _draw_trait_search_result_table();
    });

    jQuery('#submit_trait_search').click(function(){
        _draw_trait_search_result_table();
    });

    jQuery('#trait_search_form').keypress(function(e){
        var code = e.keyCode || e.which;
        if( code == 13 ) {
             jQuery('#submit_trait_search').click();
        }
    });

    var trait_table;
    _draw_trait_search_result_table();

    function _draw_trait_search_result_table (){
        var selectedontologies = [];
        jQuery(document).find('input[name="trait_search_ontology_select_id"]:checked').each(function (i, ob) {
            selectedontologies.push(jQuery(ob).val());
        });

        trait_table = jQuery('#trait_search_results').DataTable( {
            'destroy': true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            'lengthMenu': [10,20,50],
            'columnDefs': [ {
                'orderable': false,
                'className': 'select-checkbox',
                'targets':   0
            } ],
            'select': {
                'style':    'multi'
            },
            'ajax': {
                'url': '/ajax/search/traits',
                'data': function(d) {
                    d.trait_search_list_id  = jQuery('#trait_search_list_select_list_select').val();
                    d.trait_any_name  = jQuery('#trait_search_name').val();
                    d.trait_definition  = jQuery('#trait_search_definition').val();
                    d.ontology_db_id = selectedontologies;
                }
            },
            "order": [[ 1, "asc" ]]
        });
    }

   jQuery('.selectAll-dt').click(function(){
     trait_table.rows().select();
     return false;
   });
   jQuery('.deselectAll-dt').click(function(){
     trait_table.rows().deselect();
     return false;
   });
   var selection_changed = function () {
     var selected_rows = trait_table.rows({'selected':true});
     jQuery("#trait_result_count").text(selected_rows.count());
     //console.log(selected_rows.data());

     var name_links = selected_rows.data().map(function(row){
         return [row[5], row[6]];
         trait_table.rows().deselect();
     });

     var names = [];
     for (var i = 0; i < name_links.length; i++) { //extract and combine trait name and id from anchor tags
       names.push(name_links[i][0] + '|' + name_links[i][1] + '\n');
     }

     jQuery('#trait_result_names').html(names);
     addToListMenu('traits_to_list_menu', 'trait_result_names', {
       listType: 'traits'
     });
   };
   trait_table.on( 'deselect', selection_changed);
   trait_table.on( 'select', selection_changed);

});

</script>
