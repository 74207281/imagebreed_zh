
<%args>
$tempfile
$filename
$refering_page => undef
$type
$type_id
$sp_person_id
$image_url
</%args>

<& /page/page_title.mas, title=>"確認上傳圖片(Confirm Upload Image)" &>

<%perl>

  print qq { 已上傳的圖片顯示如下。請點選「儲存在 SGN 資料庫中」以將圖片永久儲存於資料庫中。(The image uploaded is shown below. Please click on "Store in SGN database" to permanently store the image in the database.) <br /> };

print "<br />\n";
if ($type && $type_id) { print "<b>關聯(Association)：</b> $type id $type_id<br />\n"; }

print "<b>提交者(Submitter)：</b> $sp_person_id<br /><br/>\n";

print qq { 
	  <form name="store_image" action="/image/store" method="post" enctype="multipart/form-data" >
	  <input type="hidden" name="tempfile" value="$tempfile" />
	  <input type="hidden" name="filename" value="$filename" />
	  <input type="hidden" name="type" value="$type" />
	  <input type="hidden" name="type_id" value="$type_id" />
	  <input id="store_image_submit" class="btn btn-primary" type="submit" value="儲存在 SGN 資料庫中(Store in SGN database)" />
	  
	  </form>
	  <br/>
	 };

if ($refering_page) { print "<a class=\"footer\" href=\"$refering_page\"><button class=\"btn btn-default\">返回(Go Back)</button></a><br /><br />\n"; }

print qq { <img src="$image_url" /><br/><br/> };



</%perl>
