
<%args>
$image_id
$size => "large"
$dbh
</%args>

<%perl>

  my $url = "";
  eval { 
    my $image = SGN::Image->new( $dbh, $image_id );
    $url = $image->get_image_url($size);
};
if ($@) { 
    print "抱歉，無法取得圖片編號 $image_id (Sorry. Could not get image # $image_id)\n"; 
}
</%perl>

<img src="<% $url %>" />




   
    
