
<%doc>

</%doc>

<%args>

$type => undef
$type_id
$refering_page => undef
</%args>

  <& /page/page_title.mas, title=>"上傳圖片(Upload Image)" &>

  <p class="boxbgcolor2">注意：按下「上傳」按鈕即表示您被視為所上傳圖片的著作權所有人，並且您授予在與本網站相關的網頁和資料上顯示及使用該圖片的非專屬授權。<br /></p>

        <p>支援的檔案格式包括：.jpg, .jpeg, .gif, .png, .pdf, .ps, .eps<br></p>
	<form name="upload_image_form" action="/image/confirm" method="post" enctype="multipart/form-data" >
	    上傳圖片並與物件 <b><% $type %></b> 編號 <% $type_id %> 建立關聯<br /><br />
	    <input type="file" name="file" value="Choose image file" />
	    <input type="hidden" name="action" value="confirm" /><br /><br />
	    <input type="hidden" name="type" value="<% $type %>" />
	    <input type="hidden" name="type_id" value="<% $type_id %>" />
	    <input type="hidden" name="refering_page" value="<% $refering_page %>" />
	    <input id="upload_image_submit" class="btn btn-primary" type="submit" value="上傳(Upload)" />
	 </form>
	 <br/>


%   if ($refering_page) { print "<a class=\"footer\" href=\"$refering_page\"><button class=\"btn btn-default\">返回(Go Back)</button></a>"; }



