<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial08232022' ] &>

<div class="modal fade" id="field_trial_tissue_sample_dialog" name="field_trial_tissue_sample_dialog" tabindex="-1" role="dialog" aria-labelledby="addFieldTrialTissueSampleDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addFieldTrialTissueSampleDialog">建立田間試驗組織樣本(Create Tissue Samples for a Field Trial)</h4>
            </div>
            <div class="modal-body">

                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "field_tissue_samples_create_workflow" &>
                        <&| /util/workflow.mas:step, title=> "簡介(Intro)" &>
                            <& /page/page_title.mas, title=>"此工作流程將引導您為田間試驗建立組織樣本(This workflow will guide you through creating tissue samples for your field trial)" &>
                            <p>組織樣本與單一植株關聯，而該植株又與單一小區關聯。</p>
                            <p>每株植株可以建立多個組織樣本。</p>
                            <p>每個組織樣本都需要一個全域唯一的名稱。</p>
                            <p>組織樣本隨後可轉移至基因型分析盤（96 或 384 孔盤）中。</p>

                            <br/><br/>
                            <center>
                            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "選取田間試驗(Select a field trial)" &>
                            <& /page/page_title.mas, title=>"選取田間試驗(Select a field trial)" &>

                            <div class="well well-sm">
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <table id="manage_tissue_samples_field_search_results" class="table table-hover table-striped">
                                            <thead>
                                                <tr>
                                                    <th>選取(Select)</th>
                                                    <th>試驗名稱(Trial Name)</th>
                                                    <th>描述(Description)</th>
                                                    <th>公司(Company)</th>
                                                    <th>育種計畫(Breeding Program)</th>
                                                    <th>資料夾(Folder)</th>
                                                    <th>年份(Year)</th>
                                                    <th>地點(Location)</th>
                                                    <th>試驗類型(Trial Type)</th>
                                                    <th>設計(Design)</th>
                                                    <th>種植日期(Planting Date)</th>
                                                    <th>收穫日期(Harvest Date)</th>
                                                    <th>下載(Download)</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" id="create_tissue_samples_select_trial">前往下一步(Go to Next Step)</button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> "植株項目(Plant Entries)" &>
                            <& /page/page_title.mas, title=>"田間試驗中的植株項目(Plant entries in your field trial)" &>

                            <div id="create_tissue_samples_plant_entries_exist_section" style="display:none">
                                <h4>此試驗已存在植株項目。請前往下一步。</h4>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </div>
                            <div id="create_tissue_samples_plant_entries_dont_exist_section" style="display:none">
                                <h4>請為此試驗建立植株項目。</h4>
                                <form class="form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">每小區植株數量：</label>
                                        <div class="col-sm-9" >
                                            <input name="create_tissue_samples_plants_per_plot_num" id="create_tissue_samples_plants_per_plot_num" class="form-control" type="number" autofocus/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">從小區繼承管理因子：</label>
                                        <div class="col-sm-9" >
                                            <input name="create_tissue_samples_plants_per_plot_inherit_treatments" id="create_tissue_samples_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
                                        </div>
                                    </div>
                                </form><br/>
                                <center>
                                    <button type="button" class="btn btn-primary" id="create_tissue_samples_plants_per_plot_submit">送出(Submit)</button>
                                </center>
                            </div>

                        </&>
                        <&| /util/workflow.mas:step, title=> "建立組織樣本項目(Create Tissue Sample Entries)" &>
                            <& /page/page_title.mas, title=>"為此試驗建立組織樣本項目(Create tissue sample entries for this trial)" &>

                            <form class="form-horizontal" >
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><span title="您可以在下方多次使用相同的組織名稱（例如 root 和 root）。由於結尾會加上組織索引（例如 1 和 2），組織名稱仍將保持唯一。"></span><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;每株植株組織樣本數量：</label>
                                    <div class="col-sm-9" >
                                        <input name="create_tissue_samples_per_plant_num" id="create_tissue_samples_per_plant_num" class="form-control" type="text" autofocus/>
                                    </div>
                                </div>

                                <div id="create_tissue_samples_names_div">
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">從小區繼承管理因子：</label>
                                    <div class="col-sm-9" >
                                        <input name="create_tissue_samples_per_plant_inherit_treatments" id="create_tissue_samples_per_plant_inherit_treatments" type="checkbox" checked disabled/>
                                    </div>
                                </div>
                            </form><br/>
                            <center>
                            <button type="button" class="btn btn-primary" name="create_tissue_samples_plants_per_plant_submit" id="create_tissue_samples_plants_per_plant_submit">送出(Submit)</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                            <& /page/page_title.mas, title=>"完成！您田間試驗的組織樣本已儲存。(Complete! Your field trial's tissue samples were saved.)" &>

                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                組織樣本已成功儲存
                            </p>

                            <ul>
                                <li>您現在可以前往該試驗的詳細資訊頁面，因為它已有植株。</li>
                                <li>您可以為新組織樣本列印條碼。</li>
                                <li>您可以將這些組織樣本用作基因型分析盤（96 或 384 孔盤）的來源材料。</li>
                            </ul>
                            <br/>
                        </&>
                    </&>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    var create_tissue_sample_trial_table = jQuery('#manage_tissue_samples_field_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/search/trials',
            'data': function(d) {
                d.select_checkbox_name = 'create_tissue_sample_select_trial';
            }
        },
        "scrollX": true
    });

    var selected;
    jQuery('#create_tissue_samples_select_trial').click(function(){
        selected = [];
        jQuery('input[name="create_tissue_sample_select_trial"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length !== 1){
            alert('請僅選取一個試驗！');
        } else {
            new jQuery.ajax({
                type: 'POST',
                url: '/ajax/breeders/trial/'+selected[0]+'/has_plants',
                dataType: "json",
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                },
                success: function (response) {
                    jQuery("#working_modal").modal("hide");
                    if (response.has_plants){
                        jQuery('#create_tissue_samples_plant_entries_exist_section').show();
                        jQuery('#create_tissue_samples_plant_entries_dont_exist_section').hide();
                        Workflow.complete('#create_tissue_samples_select_trial');
                        Workflow.skip('#create_tissue_samples_plant_entries_exist_section');
                        Workflow.focus("#field_tissue_samples_create_workflow", 3);
                    } else {
                        jQuery('#create_tissue_samples_plant_entries_dont_exist_section').show();
                        jQuery('#create_tissue_samples_plant_entries_exist_section').hide();
                        Workflow.complete('#create_tissue_samples_select_trial');
                        Workflow.focus("#field_tissue_samples_create_workflow", 2);
                    }
                },
                error: function () {
                    jQuery("#working_modal").modal("hide");
                    alert('檢查試驗是否具有植株時發生錯誤。');
                }
            });
        }
    });

    jQuery('#create_tissue_samples_plants_per_plot_submit').click(function(){
        var is_checked;
        if(jQuery('#create_tissue_samples_plants_per_plot_inherit_treatments').is(":checked")){
            is_checked = 1;
        }

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+selected[0]+'/create_plant_entries/',
            type: 'POST',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            data: {
                'plants_per_plot' : jQuery('#create_tissue_samples_plants_per_plot_num').val(),
                'inherits_plot_treatments' : is_checked
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert("成功建立植株項目。");
                    Workflow.complete('#create_tissue_samples_plants_per_plot_submit');
                    Workflow.focus("#field_tissue_samples_create_workflow", 3);
                }
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert("儲存植株項目時發生錯誤");
            },
        });
    });

    jQuery('#create_tissue_samples_per_plant_num').keyup(function(){
        var num_tissues = jQuery(this).val();
        var html = '';
        for (var i=1; i<=num_tissues; i++){
            html = html + '<div class="form-group"><label class="col-sm-3 control-label"><span title="樣本名稱將由植株名稱、您在此處提供的組織名稱以及組織編號組合而成。"><span class="glyphicon glyphicon-info-sign"></span>&nbsp;&nbsp;組織名稱 '+i+'：</span></label><div class="col-sm-9" ><input name="create_tissue_samples_tissue_name" id="create_tissue_samples_tissue_name_'+i+'" class="form-control" type="text" placeholder="例如：leaf 或 root 或 stem 或 seed 或 fruit" /></div></div>';
        }
        jQuery('#create_tissue_samples_names_div').html(html);
    });

    jQuery('#create_tissue_samples_plants_per_plant_submit').click(function(){
        var is_checked;
        if(jQuery('#create_tissue_samples_per_plant_inherit_treatments').is(":checked")){
            is_checked = 1;
        }

        var tissue_names = [];
        jQuery('input[name="create_tissue_samples_tissue_name"]').each(function() {
            tissue_names.push(this.value);
        });

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+selected[0]+'/create_tissue_samples/',
            type: 'POST',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            data: {
                'tissue_samples_per_plant' : jQuery('#create_tissue_samples_per_plant_num').val(),
                'inherits_plot_treatments' : is_checked,
                'tissue_samples_names' : JSON.stringify(tissue_names)
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert("成功建立組織樣本項目。");
                    Workflow.complete('#create_tissue_samples_plants_per_plant_submit');
                    Workflow.focus("#field_tissue_samples_create_workflow", -1); //go to success
                }
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert("建立組織樣本項目時發生錯誤");
            },
        });
    });

});
</script>
