
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4>基因型分析孔盤(Genotyping Plates)</h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_genotyping_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>試驗名稱(Trial Name)</th>
                        <th>描述(Description)</th>
                        <th>公司(Company)</th>
                        <th>育種計畫(Breeding Program)</th>
                        <th>資料夾(Folder)</th>
                        <th>年份(Year)</th>
                        <th>地點(Location)</th>
                        <th>基因型分析設施(Genotyping Facility)</th>
                        <th>格式(Format)</th>
                        <th>樣本類型(Sample Type)</th>
                        <th>下載(Download)</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var geno_trial_table = jQuery('#tissue_sample_genotyping_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/genotyping_trials',
   });

});

</script>
