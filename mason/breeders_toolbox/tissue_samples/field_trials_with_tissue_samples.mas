
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4>具組織樣本的田間試驗(Field Trials With Tissue Samples)</h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>試驗名稱(Trial Name)</th>
                        <th>描述(Description)</th>
                        <th>公司(Company)</th>
                        <th>育種計畫(Breeding Program)</th>
                        <th>資料夾(Folder)</th>
                        <th>年份(Year)</th>
                        <th>地點(Location)</th>
                        <th>試驗類型(Trial Type)</th>
                        <th>試驗設計(Design)</th>
                        <th>種植日期(Planting Date)</th>
                        <th>收穫日期(Harvest Date)</th>
                        <th>下載(Download)</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#tissue_sample_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/field_trials',
       "scrollX": true
   });

});

</script>
