
<%args>
$cross_id
$cross_name => ''
$breeding_program => undef
$progeny_count => undef
$trial_id => undef
$trial_name => undef
$user_id => undef
$identifier_prefix => ''
</%args>

<& /util/import_javascript.mas, classes => ["CXGN.BreedersToolbox.CrossDetailPage03152022" ] &>

% use utf8;
% $cross_name ||= "Untitled cross";
% my $basename = $cross_name."P";
% my $cross_properties = $c->config->{cross_properties};
% my @cross_props = split ',',$cross_properties;
% my $odk_crossing_data_service_name = $c->config->{odk_crossing_data_service_name};
% my $cross_additional_info_header_string = $c->config->{cross_additional_info_header};
% my @cross_additional_info_header = split ',',$cross_additional_info_header_string;
% my $cross_additional_info_string = $c->config->{cross_additional_info};
% my @cross_additional_info = split ',',$cross_additional_info_string;

<& /page/page_title.mas, title => "雜交 '$cross_name' 的詳細資訊(Details for cross '$cross_name')" &>

<&| /page/info_section.mas, title => "雜交資訊(Cross Information)" &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <& /page/form.mas,
                        object_type=>'cross',
                        object_id=> $cross_id,
                        form_name=> 'stock_form',
                        server_side_script => '/phenome/stock/stock_ajax_form.pl',
                        form_div_name=>'stock_details',
                        js_object_name=> 'stockForm',
                        page_url => "/cross/$cross_id" ,
                        alternate_new_button => '',
                        alternate_ghosted_new_button => '',
                        alternate_delete_button => '',
                        alternate_ghosted_delete_button => ''
                    &>
                </div>
                <div class="col-sm-6">
                    <br /><br />
                    <& /util/barcode.mas, identifier => "$identifier_prefix"."$cross_id", text=> "$identifier_prefix stock $cross_id ($cross_name)", format=>"stock_qrcode"  &>
                    <br /><br />
                </div>
            </div>
        </div>
    </div>

</&>

<div id="cross_name" style="visibility:hidden">
<% $cross_name %>
</div>

<div id="cross_id" style="visibility:hidden">
<% $cross_id %>
</div>


<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>

<&| /page/info_section.mas, title => '所屬項目(Member of)', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "membership_table" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>雜交實驗(Crossing Experiment)</th>
                                <th>描述(Description)</th>
                                <th>家族名稱(Family Name)</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => '親本(Parents)', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "parent_information" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>雜交組合(Cross Combination)</th>
                                <th>雜交類型(Cross Type)</th>
                                <th>母本種原(Female Accession)</th>
                                <th>母本倍數性(Female Ploidy)</th>
                                <th>父本種原(Male Accession)</th>
                                <th>父本倍數性(Male Ploidy)</th>
                                <th>母本小區(Female Plot)</th>
                                <th>父本小區(Male Plot)</th>
                                <th>母本植株(Female Plant)</th>
                                <th>父本植株(Male Plant)</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_additional_info_link = "[編輯]";
% if ($user_id) { $edit_additional_info_link = '<a id="edit_additional_info_link">[編輯(Edit)]</a>'; }

<div id="edit_additional_info_dialog">
    <select id="additional_info_select">
% foreach my $info(@cross_additional_info){
        <option value="<%$info%>"><%$info%></option>
%}
    </select>
    <input id="additional_info_value" />
    <button id="edit_additional_info_submit" >儲存(Save)</button>
</div>


<&| /page/info_section.mas, title => '附加親本資訊(Additional Parent Info)', collapsible => 1, collapsed => 0, subtitle => $edit_additional_info_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_additional_info" class="table table-hover table-striped">
                        <thead>
                            <tr>
% foreach my $additional_info(@cross_additional_info_header){
                                <th><%$additional_info%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_link = "[編輯]";
% if ($user_id) { $edit_link = '<a id="edit_properties_link">[編輯(Edit)]</a>'; }

<&| /page/info_section.mas, title => '田間雜交資料(Field Crossing Data)', collapsible => 1, collapsed => 0, subtitle => $edit_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                <table id = "cross_properties" class="table table-hover table-striped">
                    <thead>
                        <tr>
% foreach my $cross_prop(@cross_props){
                        <th><%$cross_prop%></th>
%}
                        </tr>
                    </thead>
                </table>
                </div>
            </div>
        </div>
    </div>
 </&>

<div id="edit_properties_dialog">

    <select id="properties_select">
% foreach my $cross_prop(@cross_props){
        <option value="<%$cross_prop%>"><%$cross_prop%></option>
%}
    </select>

    <input id="property_value" />

    <button id="property_submit" >儲存(Save)</button>

    <p><b>警告！</b>&nbsp;如果參數與其他資料不一致，更改參數可能會在下游分析中產生無法預測的結果。</p>

</div>

<&| /page/info_section.mas, title => '雜交交易紀錄(Cross Transactions)', collapsible => 1, collapsed => 0, subtitle => '檢視此雜交的雜交活動紀錄'&>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_transactions" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>交易 ID(Transaction ID)</th>
                                <th>操作員(Operator)</th>
                                <th>時間戳記(Timestamp)</th>
                                <th>花朵數量(Number of Flowers)</th>
                                <th>果實數量(Number of Fruits)</th>
                                <th>種子數量(Number of Seeds)</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% if ($odk_crossing_data_service_name eq 'ONA') {
    <&| /page/info_section.mas, id=>'tissue_culture_summary_section', title => '此雜交的組織培養 ID(Tissue Culture IDs of This Cross)', collapsible=>1, collapsed=>1, subtitle => '檢視每個步驟中的組織培養 ID（例如胚胎 ID、繼代培養 ID、生根 ID、出瓶馴化 1 ID）'&>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div style="overflow:scroll">
                        <table id="tissue_culture_summary_table" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>胚胎 ID(Embryo IDs)</th>
                                    <th>繼代培養 ID(Subculture IDs)</th>
                                    <th>生根 ID(Rooting IDs)</th>
                                    <th>出瓶馴化 1 ID(Weaning1 IDs)</th>
                                    <th>出瓶馴化 2 ID(Weaning2 IDs)</th>
                                    <th>溫網室 ID(Screenhouse IDs)</th>
                                    <th>健化 ID(Hardening IDs)</th>
                                    <th>田間定植 ID(Openfield IDs)</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<& /breeders_toolbox/seedlots_section.mas, stock_id=>$cross_id, stock_type=>'cross', stock_uniquename=>$cross_name &>

% my $add_progeny_link = "[新增後代]";
% if ($user_id) { $add_progeny_link= '<a id="add_more_progeny_link">[新增後代(Add Progeny)]</a>'; }

<&|  /page/info_section.mas, title => "後代(Progeny)", collapsible => 1, collapsed => 0, subtitle => $add_progeny_link   &>

    <div id="progeny_information_div">
        [載入中...]
    </div>

    <div id="add_more_progeny_dialog">
        <table>
            <tr><td>基本名稱</td><td><input type="input" id="basename" name="basename" value="<% $basename %>" /></td></tr>
            <tr><td>起始編號</td><td><input type="input" id="start_number" name="start_number" size="5" value="<% $progeny_count + 1 %>" /></td></tr>
            <tr><td>數量</td><td><input type="input" id="progeny_count" name="progeny_count" size="5" /></td></tr>
        </table>
    </div>


</&>

<&|  /page/info_section.mas, title => "刪除雜交(Delete Cross)", collapsible => 1, collapsed => 0, subtitle => '<font color="red">刪除後無法復原</font>'  &>

<button id="delete_cross_button" class="btn btn-default">刪除(Delete)</button>

</&>

<script>

jQuery(document).ready( function() {
    jQuery('#delete_cross_button').click( function() {
        var response = confirm('確定要刪除此雜交嗎？此操作無法復原。');
        if (response) {
            jQuery.ajax( {
                url: '/ajax/cross/delete',
                data: { 'cross_id' : <% $cross_id %>},
                method: 'POST',
                error: function(r) { alert('發生錯誤。'); },
                success: function(r) {
                    if (r.error) {
                        alert(r.error);
                    } else {
                        alert('刪除成功。');
                    }
                }
            });
        }
    });
});

</script>
