<div class="modal fade" id="upload_family_name_dialog" name="upload_family_name_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadFamilyNameDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadFamilyNameDialog">上傳現有雜交組合的家族名稱(Upload Family Name of Existing Crosses)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                        <p>
                            <b>檔案格式資訊</b>
                            <br>
                            <a id="upload_family_name_spreadsheet_format_info">試算表格式</a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_family_name_form" name="upload_family_name_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">家族類型：</label>
                            <div class="col-sm-8">
                                <select class="form-control" id="family_type_option">
                                    <option value="">選擇家族類型</option>
                                    <option value="same_parents">僅包含具有相同母本與相同父本的雜交</option>
                                    <option value="reciprocal_parents">包含正反交</option>
                                </select>
                            </div>
                        </div>
                        <div id="upload_family_with_the_same_parents" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                <div class="col-sm-8" >
                                    <input type="file" name="same_parents_file" id="same_parents_file" encoding="multipart/form-data" />
                                </div>
                            </div>
                        </div>
                        <div id="upload_family_with_reciprocal_parents" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                <div class="col-sm-8" >
                                    <input type="file" name="reciprocal_parents_file" id="reciprocal_parents_file" encoding="multipart/form-data" />
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_family_name_submit" id="upload_family_name_submit">上傳檔案(Upload File)</button>
            </div>
        </div>
    </div>
</div>

