<%args>
$trial_id
$trial_name
$company_id
$company_name
$company_project_is_private
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$planting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>雜交實驗名稱</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[無雜交實驗名稱]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>育種計畫</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
%  print "$breeding_program_name";
% }
% else {
%  print "<span class='text-danger'>[無育種計畫]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>地點</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name ( $country_name )";
% } else {
%  print "<span class='text-danger'>[無地點]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>年份</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[無年份]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>種植日期</b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $planting_date %>" ><% $planting_date %></a>
% } else {
%  print "<span class='text-danger'>[無種植日期]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>收穫日期</b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $harvest_date %>" ><% $harvest_date %></a>
% } else {
%  print "<span class='text-danger'>[無收穫日期]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>描述</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[無描述]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>資料夾</b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link">新資料夾(New Folder)</button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link">變更資料夾(Change Folder)</button>
                </td>
            </tr>

            <tr>
                <td><b>建立者</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[N/A]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>公司名稱</b></td>
                <td>
                    <span id="copmany_name">
                        <a href="/company/<% $company_id %>"><% $company_name %></a>
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>是否對公司保密</b></td>
                <td>
                    <span id="copmany_project_is_private">
                        <% $company_project_is_private %>
                    </span>
                </td>
            </tr>

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_new_crosses_link">上傳新雜交(Upload New Crosses)</button><a href="/breeders/trial/<% $trial_id %>/download/crosses?format=crossing_experiment_xls&dataLevel=cross" class="btn btn-sm btn-default">下載此雜交實驗中的雜交(Download Crosses in this Crossing Experiment)</a>
