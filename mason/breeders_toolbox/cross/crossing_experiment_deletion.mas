<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<&| /page/info_section.mas, id=>'delete_cross_section', title => '刪除雜交(Delete Crosses)', subtitle => '<font color="red">刪除後無法復原</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="cross_deletion_table">
                </table>
            </div>
        </div>
        <button class="btn btn-default" id="delete_all_crosses" role="button">刪除此實驗中的所有雜交(Delete All Crosses in This Experiment)</button><br/><br/>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_crossing_experiment_section', title => '刪除雜交實驗(Delete Crossing Experiment)', subtitle => '<font color="red">刪除後無法復原。請先刪除此實驗中的雜交</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_crossing_experiment" role="button">刪除雜交實驗(Delete Crossing Experiment)</button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    jQuery('#delete_cross_section_onswitch').click(function(){

        var cross_deletion_table = jQuery('#cross_deletion_table').DataTable({

            'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/crosses_in_crossingtrial',

            columns: [
                { title: "雜交唯一識別碼(Cross Unique ID)", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: "刪除(Delete)", "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteCross("+row.cross_id+")'>刪除</a>"; } },
            ]
        });
    });

    jQuery('#delete_all_crosses').click(function() {

        var trial_id = "<% $trial_id %>";
        var confirmation = confirm("您確定要刪除此雜交實驗中的所有雜交嗎？刪除後將無法復原。");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_all_crosses_in_crossingtrial',
                destroy: true,
                beforeSend: function(response) {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('刪除成功');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('刪除過程中發生錯誤');
                }
            });
        }
    });

    jQuery('#delete_crossing_experiment').click(function() {

        var trial_id = "<% $trial_id %>";
        var confirmation = confirm("您確定要刪除此雜交實驗嗎？刪除後將無法復原。");
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+trial_id+'/delete/crossing_experiment',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert('刪除成功');
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert('刪除過程中發生錯誤');
                }
            });
        }
    });

});

function deleteCross(cross_id){

    var confirmation = confirm('您確定要刪除此雜交嗎？刪除後將無法復原。');

    if (confirmation) {
        jQuery.ajax({
            url: '/ajax/cross/delete',
            data: {'cross_id' : cross_id},
            method: 'POST',
            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert('刪除成功');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert('刪除過程中發生錯誤');
            }
        });
    }
}


</script>
