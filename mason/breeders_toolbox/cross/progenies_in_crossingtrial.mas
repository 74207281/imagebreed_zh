<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"上傳後代或家族名稱(Upload Progenies or Family Names)", is_subsection => 1, collapsible=>1, collapsed=>1, &>
                <&| /page/info_section.mas, title=>"上傳資料庫中不存在的後代名稱(Upload Progeny Names That Are NOT in Database)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_progenies_new_accessions_link">上傳(Upload)</button>'&>
                </&>
                <&| /page/info_section.mas, title=>"上傳資料庫中已存在的後代名稱(Upload Progeny Names That Already EXIST in Database)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_progenies_existing_accessions_link">上傳(Upload)</button>'&>
                </&>
                <&| /page/info_section.mas, title=>"上傳家族名稱(Upload Family Names)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_family_names_link">上傳(Upload)</button>'&>
                </&>
            </&><!-- closes upload progenies and family names section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"後代與家族名稱資訊(Progeny and Family Name Info)", is_subsection => 1, collapsible=>1, collapsed=>0 &>
                <table class="table table-hover table-bordered" id="progenies_in_crossingtrial_table">
                    <thead>
                        <tr>
                            <th>雜交唯一識別碼(Cross Unique ID)</th>
                            <th>雜交組合(Cross Combination)</th>
                            <th>後代數量(Number of Progenies)</th>
                            <th>家族名稱(Family Name)</th>
                        </tr>
                    </thead>
                </table>
            </&><!-- closes progeny and family name info section -->
        </div>
    </div>
</div>

<& /breeders_toolbox/cross/add_progenies_dialogs.mas &>


<script>

jQuery(document).ready(function(){

    jQuery('#progenies_in_crossingtrial_section_onswitch').click(function(){
        jQuery('#progenies_in_crossingtrial_table').DataTable({
            'destroy': true,
            'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/cross_progenies_trial',
        });
    });

});

</script>
