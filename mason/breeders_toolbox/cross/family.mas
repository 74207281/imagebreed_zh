
<%args>
$family_id
$family_name => ''
$user_id => undef
$identifier_prefix => ''
$family_type
$family_type_string
</%args>

<& /util/import_javascript.mas, classes => [] &>

<& /page/page_title.mas, title => "家族 '$family_name' 的詳細資訊(Details for family '$family_name')" &>

<&| /page/info_section.mas, title => "家族資訊(Family Information)" &>
<div class="panel panel-default">
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-6">`
                <& /page/form.mas,
                    object_type=>'family_name',
                    object_id=> $family_id,
                    form_name=> 'stock_form',
                    server_side_script => '/phenome/stock/stock_ajax_form.pl',
                    form_div_name=>'stock_details',
                    js_object_name=> 'stockForm',
                    page_url => "/family/$family_id" ,
                    alternate_new_button => '',
                    alternate_ghosted_new_button => '',
                    alternate_delete_button => '',
                    alternate_ghosted_delete_button => ''
                &>
            </div>
            <div class="col-sm-6">
                <br /><br />
                <& /util/barcode.mas, identifier => "$identifier_prefix"."$family_id", text=> "$identifier_prefix stock $family_id ($family_name)", format=>"stock_qrcode"  &>
                <br /><br />
            </div>
        </div>
    </div>
</div>
</&>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>

<&| /page/info_section.mas, title => "親本：($family_type_string)(Parents: ($family_type_string))", collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <table id = "family_parent_information" class="table table-hover table-striped">
                    <thead>
                        <tr>
% if ($family_type eq 'same_parents') {
                            <th>母本(Female Parent)</th>
                            <th>母本種原類型(Female Stock Type)</th>
                            <th>母本倍數性(Female Ploidy)</th>
                            <th>父本(Male Parent)</th>
                            <th>父本種原類型(Male Stock Type)</th>
                            <th>父本倍數性(Male Ploidy)</th>
% } elsif ($family_type eq 'reciprocal_parents') {
                            <th>親本 1(Parent 1)</th>
                            <th>親本 1 種原類型(Parent 1 Stock Type)</th>
                            <th>親本 1 倍數性(Parent 1 Ploidy)</th>
                            <th>親本 2(Parent 2)</th>
                            <th>親本 2 種原類型(Parent 2 Stock Type)</th>
                            <th>親本 2 倍數性(Parent 2 Ploidy)</th>
%}
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => '此家族中的雜交(Crosses in this family)', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="crosses_in_family_table">
                    </table>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <&| /page/info_section.mas, title => '將雜交新增至清單(Add Crosses to a List)', collapsible=>1, collapsed=>1, subtitle=>'<i>將此家族中的雜交新增至新清單或現有清單</i>'&>
                            <br>
                            <div id="members_to_new_list" style="display:none"></div>
                            <div id="members_add_to_list"></div>
                        </&>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => '後代(Progenies)', collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="all_progenies">
                    </table>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <&| /page/info_section.mas, title => '將後代新增至清單(Add progenies to a List)', collapsible=>1, collapsed=>1, subtitle=>'<i>將此家族的後代新增至新清單或現有清單</i>'&>
                            <br>
                            <div id="progenies_to_new_list" style="display:none"></div>
                            <div id="progenies_add_to_list"></div>
                        </&>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>

<script>

jQuery(document).ready(function(){

    var family_id = "<% $family_id %>";

    var family_parent_table = jQuery('#family_parent_information').DataTable({
        'ajax': '/ajax/family/parents/'+family_id,
        'paging' : false,
        'searching' : false,
        'destroy' : true,
    });

    var crosses_in_family = jQuery('#crosses_in_family_table').DataTable({
        'ajax': '/ajax/family/members/'+family_id,
        'destroy': true,
        columns: [
            { title: "雜交唯一識別碼(Cross Unique ID)", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
            { title: "雜交類型(Cross Type)", "data": "cross_type" },
            { title: "後代數量(Number of Progenies)", "data": "progeny_number" },
            { title: "雜交實驗(Crossing Experiment)", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/trial/"+row.crossing_experiment_id+"'>"+row.crossing_experiment_name+"</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#members_add_to_list').html("<div class='well well-sm'><h3>請先登入以使用清單功能！</h3></div>");
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].cross_name+"\n";
                }
                jQuery("#members_to_new_list").html(html);
                addToListMenu("members_add_to_list", "members_to_new_list", {
                    selectText: true,
                    listType: 'crosses',
                });
            }
        }
    });

    var progenies = jQuery('#all_progenies').DataTable({
        'ajax': '/ajax/family/all_progenies/'+family_id,
        'destroy': true,
        columns: [
            { title: "後代名稱(Progeny Name)", "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.progeny_id+"/view'>"+row.progeny_name+"</a>"; } },
            { title: "雜交唯一識別碼(Cross Unique ID)", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#progenies_add_to_list').html("<div class='well well-sm'><h3>請先登入以使用清單功能！</h3></div>");
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].progeny_name+"\n";
                }
                jQuery("#progenies_to_new_list").html(html);
                addToListMenu("progenies_add_to_list", "progenies_to_new_list", {
                    selectText: true,
                    listType: 'accessions',
                });
            }
        }
    });

});

</script>
