<%args>
$number_of_crosses_added => undef
$number_of_unique_parents => undef
$upload_data_ref => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui' ] &>



<article>
  <header>
    <h1>上傳雜交檔案驗證(Upload Cross File Verification)</h1>
  </header>
</article>
<a id="return_to_home" href="/breeders/home" >返回育種者工具(Return to Breeders Tools)</a>



<div id="verify_uploaded_data_dialog"  class="ui-widget" >
<%perl>
print "<br><b>新增的雜交數量：</b> $number_of_crosses_added<br>";
print "<b>新增雜交中的不重複親本數量</b>：$number_of_unique_parents<br><br>";
</%perl>
<button id="view_uploaded_data_link" >檢視已上傳資料(View Uploaded Data)</button>
</div>

<div id="display_uploaded_data_dialog"  class="ui-widget" >
<table border ="1">
<%perl>
my %upload_data = %{$upload_data_ref};
print "<tr><th>雜交唯一識別碼(cross_unique_id)</th><th>母本(maternal_parent)</th><th>父本(paternal_parent)</th><th>試驗(trial)</th><th>地點(location)</th><th>後代數量(number_of_progeny)</th><th>前綴(prefix)</th><th>後綴(suffix)</th><th>花朵數量(number_of_flowers)</th><th>種子數量(number_of_seeds)</th></tr>";
foreach my $key (sort { $a <=> $b} keys %upload_data) {
  my %cross = %{$upload_data{$key}};
  print "<tr><td>".$cross{'cross_unique_id'}."</td><td>".$cross{'maternal_parent'}."</td><td>".$cross{'paternal_parent'}."</td><td>".$cross{'cross_trial'}."</td><td>".$cross{'cross_location'}."</td>";
  if ($cross{'number_of_progeny'}) {
    print "<td>".$cross{'number_of_progeny'}."</td>";
  }
  else {
    print "<td></td>";
  }
  if ($cross{'prefix'}) {
    print "<td>".$cross{'prefix'}."</td>";
  }
  else {
    print "<td></td>";
  }
  if ($cross{'suffix'}) {
    print "<td>".$cross{'suffix'}."</td>";
  }
  else {
    print "<td></td>";
  }
  if ($cross{'number_of_flowers'}) {
    print "<td>".$cross{'number_of_flowers'}."</td>";
  }
  else {
    print "<td></td>";
  }
  if ($cross{'number_of_seeds'}) {
    print "<td>".$cross{'number_of_seeds'}."</td>";
  }
  else {
    print "<td></td>";
  }
  print "</tr>";
}
</%perl>
</table>
</div>


<script defer="defer">

   jQuery("#verify_uploaded_data_dialog").dialog( {
      autoOpen: true,
      buttons: { "關閉(Close)" :  function() { jQuery("#verify_uploaded_data_dialog").dialog("close"); }},
      modal: true,
      width: 600,
      height: 250
    });

    jQuery("#view_uploaded_data_link").click( function () {
      autoOpen: false,
     jQuery("#display_uploaded_data_dialog" ).dialog("open");
    })

   jQuery("#display_uploaded_data_dialog").dialog( {
      autoOpen: false,
      buttons: { "確定(OK)" :  function() { jQuery("#display_uploaded_data_dialog").dialog("close"); },},
      modal: true,
      width: 1000,
      height: 300
    });

    function submit_cross_upload() {
    }

</script>

<%perl>
if ($number_of_crosses_added) {
  print '<object id="view_uploaded_data_link"></object>';
}
</%perl>
