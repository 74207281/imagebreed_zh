
<style>
@media (min-width: 768px) {
  .modal-xl {
    width: 90%;
   max-width:1200px;
  }
}
</style>

<div class="modal fade" id="create_cross_wishlist_dialog" name="create_cross_wishlist_dialog" tabindex="-1" role="dialog" aria-labelledby="createCrossWishlistDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createCrossWishlistDialog">建立雜交清單(Create Cross Wishlist)</h4>
            </div>

            <div class="modal-body">
                <div class="container-fluid">
                    <div class="well">
                        <form class="form-horizontal" id="cross_wishlist_create_select_form_id" name="cross_wishlist_create_select_form_id">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">在 ONA 上選擇 ODK 表單：</label>
                                <div class="col-sm-8" >
                                    <div id="cross_wishlist_create_select_form_id_div">載入中...</div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <ul class="nav nav-pills nav-justified" id="cross_wishlist_tab_select">
                        <li id="cross_wishlist_list_tab"><a data-toggle="tab" href="#with_lists">使用種原清單(Using Accession Lists)</a></li>
                        <li class="active" id="cross_wishlist_no_list_tab"><a data-toggle="tab" href="#not_with_lists">使用雜交區(Using Crossing Blocks)</a></li>
                        <li id="cross_wishlist_upload_tab"><a data-toggle="tab" href="#upload_wishlist">上傳雜交組合(Uploading Cross Combinations)</a></li>
                    </ul>

                    <div class="tab-content">

                        <div id="with_lists" class="tab-pane fade">
                            <hr>
                            <form class="form-horizontal" >
                                <div class="form-group" style="display:none" <!-- location name is coming from the trial they select --> >
                                    <label class="col-sm-3 control-label">地點名稱（選填）：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_location_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">母本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">父本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">雜交計畫將新增至名為以下名稱的雜交清單中：</label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_list_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="請先選擇試驗" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">母本種原清單：</label>
                                    <div class="col-sm-9" id="female_accession_list_div" name="female_accession_list_div">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">父本種原清單：</label>
                                    <div class="col-sm-9" id="male_accession_list_div" name="male_accession_list_div">
                                    </div>
                                </div>
                            </form>
                            <br/>
                            <div id="cross_wishlist_cross_grid_div"></div>
                        </div>

                        <div id="not_with_lists" class="tab-pane fade in active">
                            <hr>

                            <form class="form-horizontal" >
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">母本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_no_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">父本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_no_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">雜交計畫將新增至名為以下名稱的雜交清單中：</label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_no_list_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="請先選擇試驗" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">母本種原名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_accession_select_div">
                                            <p>請先選擇試驗</p>
                                        </div>
                                    </div>
                                </div>
                                <div id ="cross_wishlist_male_parent_div">
                                </div>
                            </form>
                        </div>

                        <div id="upload_wishlist" class="tab-pane fade">
                            <hr>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_wishlist_form" name="upload_wishlist_form">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">母本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_upload_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">父本試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_upload_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">雜交計畫將新增至名為以下名稱的雜交清單中：</label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_upload_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="請先選擇試驗" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                                <p>
                                                    <b>檔案格式資訊</b>
                                                    <br>
                                                    <a id="wishlist_format">試算表格式</a>
                                                </p>
                                            </&>
                                        </div>
                                        <div class="col-sm-8">
                                            <br/>
                                            <div class="panel panel-default">
                                                <div class="panel-body">
                                                    <div class="form-group">
                                                        <label class="col-sm-6 control-label">選擇 XLS 檔案：</label>
                                                        <div class="col-sm-6">
                                                            <input type="file" name="wishlist_file" id="wishlist_file" encoding="multipart/form-data" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div id="wishlist_lists_footer">
                <div class="modal-footer">
                    <button class="btn btn-info" id="show_cross_wishlists_select_submits" name="show_cross_wishlists_select_submits">可用於 ODK 的雜交清單(Available Cross Wishlist(s) for ODK Use)</button>
                    <button class="btn btn-primary" id="cross_wishlist_submit" name="cross_wishlist_submits">下一步(Next)</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                </div>
            </div>
            <div id="wishlist_upload_footer" style="display:none">
                <div class="modal-footer">
                    <button class="btn btn-info" id="upload_show_cross_wishlists_select_submits" name="upload_show_cross_wishlists_select_submits">可用於 ODK 的雜交清單(Available Cross Wishlist(s) for ODK Use)</button>
                    <button class="btn btn-primary" id="wishlist_upload_submit" name="wishlist_upload_submit">上傳檔案(Upload File)</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="create_cross_wishlist_select_dialog" name="create_cross_wishlist_select_dialog" tabindex="-1" role="dialog" aria-labelledby="createCrossWishlistSelectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createCrossWishlistSelectDialog">為雜交清單選取小區(Select Plots for Cross Wishlist)</h4>
                <h4>母本小區顯示為<span class="bg-primary">藍色</span><!-- and Male Plots are in <span class="bg-success">Green</span>.--></h4>
            </div>

            <div class="modal-body">
                <div class="container-fluid">
                    <div id="cross_wishlist_cross_select_div"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" id="cross_wishlist_select_submits" name="cross_wishlist_select_submits">建立雜交清單(Create Wishlist)</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="create_cross_wishlist_response_dialog" name="create_cross_wishlist_response_dialog" tabindex="-1" role="dialog" aria-labelledby="createCrossWishlistResponseDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createCrossWishlistResponseDialog">雜交清單(Cross Wishlist)</h4>
            </div>

            <div class="modal-body">
                <div class="container-fluid">
                    <div id="cross_wishlist_response_div"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="show_cross_wishlists_response_dialog" name="show_cross_wishlists_response_dialog" tabindex="-1" role="dialog" aria-labelledby="showCrossWishlistsResponseDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="showCrossWishlistsResponseDialog">先前建立的雜交清單(Cross Wishlists Previously Created)</h4>
            </div>

            <div class="modal-body">
