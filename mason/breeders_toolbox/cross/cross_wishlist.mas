</div>

<div class="modal fade" id="upload_wishlist_error_display" name="upload_wishlist_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadWishlistErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadWishlistErrorDialog">上傳雜交清單檔案錯誤(Upload Wishlist File Error)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_wishlist_spreadsheet_info_dialog" name="upload_wishlist_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadWishlistInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadWishlistInfoDialog">範本資訊(Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        雜交清單可透過 Excel 檔案（.xls 或 .xlsx）上傳
                    </b>
                    <br>
                    <b>
                        標題列：
                    </b>
                    <br>
                        第一列（標題）必須包含以下欄位：
                    <br>

                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>female_accession</td>
                                <td>male_accession</td>
                                <td>priority</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        必填欄位：
                    </b>
                    <ul>
                        <li><b>female_accession</b>（種原名稱必須作為<b>唯一名稱</b>存在於資料庫中，且屬於所選的母本試驗。雜交清單將包含該試驗中的所有母本小區。）</li>
                        <li><b>male_accession</b>（種原名稱必須作為<b>唯一名稱</b>存在於資料庫中）</li>
                        <li><b>priority</b>（優先順序，1 為最重要）</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

var lo = new CXGN.List();

function draw_cross_grid(female_accessions, male_accessions){
    console.log("draw cross grid");
    var cross_grid_html = '<h3>設定雜交優先順序：1 為最高，60 為最低</h3><h4>母本種原位於第一欄，父本種原位於標題列</h4><table class="table table-bordered"><thead><tr><th>母本種原(Female Accessions)</th>';
    for(var i=0; i<male_accessions.length; i++){
        cross_grid_html = cross_grid_html + '<th>' + male_accessions[i] + '</th>';
    }
    cross_grid_html = cross_grid_html + '</tr></thead><tbody>';
    for(var i=0; i<female_accessions.length; i++){
        cross_grid_html = cross_grid_html + '<tr><td>' + female_accessions[i] + '</td>';
        for(var j=0; j<male_accessions.length; j++){
            cross_grid_html = cross_grid_html + '<td><input type="text" name="cross_wishlist_cross_grid_inputs" class="form-control" data-female="'+female_accessions[i]+'" data-male="'+male_accessions[j]+'"/></td>';
        }
        cross_grid_html = cross_grid_html + '</tr>';
    }
    cross_grid_html = cross_grid_html + '</tbody></table>';
    jQuery('#cross_wishlist_cross_grid_div').html(cross_grid_html);
}

jQuery(document).ready(function($) {

    jQuery('#show_cross_wishlists_select_submits').click(function(){
        jQuery('#show_cross_wishlists_response_dialog').modal('show');

        jQuery.ajax({
            url: '/ajax/cross/list_cross_wishlists',
            dataType:'json',
            beforeSend: function() {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                //console.log(response);
                jQuery('#working_modal').modal('hide');
                var html = '';
                if(response.success){
                    html += "<table class='table table-bordered table-hover'><thead><tr><th>檔案(File)</th><th>更新者(Updated By)</th><th>日期(Date)</th></tr></thead><tbody>";
                    for(var i=0; i<response.files.length; i++){
                        html += "<tr><td><a href='/breeders/phenotyping/download/"+response.files[i][0]+"' >"+response.files[i][1]+"</a></td><td><a href='/solpeople/personal-info.pl?sp_person_id="+response.files[i][6]+"' >"+response.files[i][7]+" "+response.files[i][8]+"</a></td><td>"+response.files[i][5]+"</td></tr>";
                    }
                    html += "</tbody></table>";
                } else {
                    html = '發生錯誤。'
                }
                jQuery('#show_cross_wishlists_response_div').html(html);
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert("取得雜交清單時發生錯誤");
            }
        });

    });

    jQuery("#create_cross_wishlist").click(function() {
        jQuery("#create_cross_wishlist_dialog").modal("show");
        jQuery("#female_accession_list_div").html(lo.listSelect('female_accession_list_div', ["accessions"], "請選擇種原數量少於 60 個的清單", undefined, undefined ));
        jQuery("#male_accession_list_div").html(lo.listSelect('male_accession_list_div', ["accessions"], "請選擇種原數量少於 60 個的清單", undefined, undefined ));
        var female_accessions;
        var male_accessions
        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            female_accessions = lo.getList(jQuery('#female_accession_list_div_list_select').val());
            male_accessions = lo.getList(jQuery('#male_accession_list_div_list_select').val());
        }

        jQuery.ajax ({
            url : '/ajax/odk/get_crossing_available_forms',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error){
                    alert(response.error);
                }
                if (response.success){


                    jQuery.ajax ({
                        url : '/ajax/odk/get_crossing_saved_ona_forms',
                        success: function(response_forms){
                            console.log(response_forms);

                            if (response_forms.error){
                                alert(response.error);
                            }
                            if (response_forms.success){

                                var form_dropdown_select_html = '<select class="form-control" id="cross_wishlist_availabe_odk_crossing_forms"><option value="">不使用 ONA</option>';
                                var allowed_forms = response_forms.odk_ona_forms;
                                allowed_forms.push('<% $c->config->{odk_crossing_data_test_form_name} %>');
                                for(var i=0; i<response.forms.length; i++){
                                    if (jQuery.inArray(response.forms[i].id_string, allowed_forms) != -1){
                                        form_dropdown_select_html = form_dropdown_select_html + '<option value="'+response.forms[i].id+'">'+response.forms[i].id_string+'</option>';
                                    }
                                }
                                form_dropdown_select_html = form_dropdown_select_html + '</select>';
                                jQuery('#cross_wishlist_create_select_form_id_div').html(form_dropdown_select_html);

                            }
                        },
                        error: function(response_forms){
                            alert("擷取已儲存的 ODK ONA 表單時發生錯誤");
                        }
                    });

                }
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert("擷取可用的 ODK 雜交表單時發生錯誤");
            }
        });

        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            draw_cross_grid(female_accessions, male_accessions);
        }
    });

    jQuery(document).on('change', '#female_accession_list_div_list_select', function(){
        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            var female_accessions = lo.getList(jQuery('#female_accession_list_div_list_select').val());
            var male_accessions = lo.getList(jQuery('#male_accession_list_div_list_select').val());
            draw_cross_grid(female_accessions, male_accessions);
        }
    });
    jQuery(document).on('change', '#male_accession_list_div_list_select', function(){
        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            var female_accessions = lo.getList(jQuery('#female_accession_list_div_list_select').val());
            var male_accessions = lo.getList(jQuery('#male_accession_list_div_list_select').val());
            draw_cross_grid(female_accessions, male_accessions);
        }
    });

    get_select_box('locations', 'cross_wishlist_location_select_list_div', { 'name' : 'cross_wishlist_location_id', 'id' : 'cross_wishlist_location_id', 'empty':1 });
    get_select_box('trials', 'cross_wishlist_female_trial_select_no_list_div', { 'name' : 'cross_wishlist_female_trial_id', 'id' : 'cross_wishlist_female_trial_id', 'empty':1, 'multiple':0 });
    get_select_box('trials', 'cross_wishlist_male_trial_select_no_list_div', { 'name' : 'cross_wishlist_male_trial_id', 'id' : 'cross_wishlist_male_trial_id', 'empty':1, 'multiple':0 });

    get_select_box('trials', 'cross_wishlist_female_trial_select_list_div', { 'name' : 'cross_wishlist_list_female_trial_id', 'id' : 'cross_wishlist_list_female_trial_id', 'empty':1, 'multiple':0 });
    get_select_box('trials', 'cross_wishlist_male_trial_select_list_div', { 'name' : 'cross_wishlist_list_male_trial_id', 'id' : 'cross_wishlist_list_male_trial_id', 'empty':1, 'multiple':0 });

    get_select_box('trials', 'cross_wishlist_female_trial_select_upload_div', { 'name' : 'cross_wishlist_upload_female_trial_id', 'id' : 'cross_wishlist_upload_female_trial_id', 'empty':1, 'multiple':0 });
    get_select_box('trials', 'cross_wishlist_male_trial_select_upload_div', { 'name' : 'cross_wishlist_upload_male_trial_id', 'id' : 'cross_wishlist_upload_male_trial_id', 'empty':1, 'multiple':0 });

    jQuery(document).on('change', "#cross_wishlist_list_female_trial_id", function() {
        cross_wishlist_change_trials_lists();
    });

    jQuery(document).on('change', "#cross_wishlist_female_trial_id", function() {
        cross_wishlist_change_trials();
    });

    jQuery(document).on('change', "#cross_wishlist_upload_female_trial_id", function() {
        cross_wishlist_change_trials_upload();
    });

    var female_trial_id;
    var male_trial_id;
    var cross_data = [];
    var female_male_tracker = {};
    var selected_plot_ids = [];
    jQuery('.nav-pills a').on('shown.bs.tab', function(event){
        cross_data = [];
        female_male_tracker = {};
        selected_plot_ids = [];
        female_trial_id;
        male_trial_id;
    });

    var female_trial_ids_array = [];
    var male_trial_ids_array = [];
    function cross_wishlist_change_trials () {
        var female_trial_ids = jQuery('#cross_wishlist_female_trial_id').val();
        var female_trial_ids_string = '';
        if ( jQuery.isArray(female_trial_ids) ) {
            female_trial_ids_array = female_trial_ids;
            trial_ids_string = female_trial_ids.join();
        } else {
            female_trial_ids_array = [female_trial_ids];
            female_trial_ids_string = female_trial_ids;
        }

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+female_trial_ids_array[0]+'/location',
            success: function(response) {
                //console.log(response);
                var cross_wishlist_name;
                if ('<% $c->config->{odk_crossing_data_test_form_name} %>' == jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text()){
                    cross_wishlist_name = 'cross_wishlist_test.csv';
                } else if ('<% $c->config->{odk_crossing_data_separate_wishlist_by_location} %>' == '1') {
                    cross_wishlist_name = 'cross_wishlist_'+response.location[1]+'.csv'
                } else {
                    cross_wishlist_name = 'cross_wishlist_<% $c->config->{project_name} %>.csv';
                }
                jQuery('#cross_wishlist_trial_select_no_list_cross_wishlist_name_div').html('<input type="text" class="form-control" disabled value="'+cross_wishlist_name+'" />');
            },
            error: function(response) {
                alert("取得試驗地點時發生錯誤");
            }
        });

        get_select_box('stocks', 'cross_wishlist_female_accession_select_div', { 'name' : 'cross_wishlist_female_accession_ids', 'id' : 'cross_wishlist_female_accession_ids', 'size' : 7, 'stock_type_name':'accession', 'trial_id_list':female_trial_ids_array, 'names_as_select':1 });
    };

    function cross_wishlist_change_trials_lists () {
        var female_trial_ids = jQuery('#cross_wishlist_list_female_trial_id').val();
        var female_trial_ids_string = '';
        if ( jQuery.isArray(female_trial_ids) ) {
            female_trial_ids_array = female_trial_ids;
            female_trial_ids_string = female_trial_ids.join();
        } else {
            female_trial_ids_array = [female_trial_ids];
            female_trial_ids_string = female_trial_ids;
        }

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+female_trial_ids_array[0]+'/location',
            success: function(response) {
                //console.log(response);
                var cross_wishlist_name;
                if ('<% $c->config->{odk_crossing_data_test_form_name} %>' == jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text()){
                    cross_wishlist_name = 'cross_wishlist_test.csv';
                } else if ('<% $c->config->{odk_crossing_data_separate_wishlist_by_location} %>' == '1') {
                    cross_wishlist_name = 'cross_wishlist_'+response.location[1]+'.csv'
                } else {
                    cross_wishlist_name = 'cross_wishlist_<% $c->config->{project_name} %>.csv';
                }
                jQuery('#cross_wishlist_trial_select_list_cross_wishlist_name_div').html('<input type="text" class="form-control" disabled value="'+cross_wishlist_name+'" />');
            },
            error: function(response) {
                alert("取得試驗地點時發生錯誤");
            }
        });
    };

    function cross_wishlist_change_trials_upload () {
        var female_trial_ids = jQuery('#cross_wishlist_upload_female_trial_id').val();
        var female_trial_ids_string = '';
        if ( jQuery.isArray(female_trial_ids) ) {
            female_trial_ids_array = female_trial_ids;
            female_trial_ids_string = female_trial_ids.join();
        } else {
            female_trial_ids_array = [female_trial_ids];
            female_trial_ids_string = female_trial_ids;
        }

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+female_trial_ids_array[0]+'/location',
            success: function(response) {
                //console.log(response);
                var cross_wishlist_name;
                if ('<% $c->config->{odk_crossing_data_test_form_name} %>' == jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text()){
                    cross_wishlist_name = 'cross_wishlist_test.csv';
                } else if ('<% $c->config->{odk_crossing_data_separate_wishlist_by_location} %>' == '1') {
                    cross_wishlist_name = 'cross_wishlist_'+response.location[1]+'.csv'
                } else {
                    cross_wishlist_name = 'cross_wishlist_<% $c->config->{project_name} %>.csv';
                }
                jQuery('#cross_wishlist_trial_select_upload_cross_wishlist_name_div').html('<input type="text" class="form-control" disabled value="'+cross_wishlist_name+'" />');
            },
            error: function(response) {
                alert("取得試驗地點時發生錯誤");
            }
        });
    };

    jQuery(document).on('change', "#cross_wishlist_female_accession_ids", function() {
        cross_wishlist_select_females();
    });

    function cross_wishlist_select_females () {

        var male_trial_ids = jQuery('#cross_wishlist_male_trial_id').val();
        var male_trial_ids_string = '';
        if ( jQuery.isArray(male_trial_ids) ) {
            male_trial_ids_array = male_trial_ids;
            male_trial_ids_string = male_trial_ids.join();
        } else {
            male_trial_ids_array = [male_trial_ids];
            male_trial_ids_string = male_trial_ids;
        }
        if (male_trial_ids.length == 0){
            alert('請先選擇父本試驗！');
            return;
        }

        var female_accession_ids = jQuery('#cross_wishlist_female_accession_ids').val();
        var html = '<table class="table table-bordered" id="cross_wishlist_male_select_table"><thead><tr><th>母本(Female Parent)</th><th>選擇父本(Select Male Parent)</th><th>優先順序 ( 1 : 最高, 60 : 最低 )(Priority ( 1 : highest, 60 : lowest ))</th></tr></thead><tbody>';
        for(var i=0; i<female_accession_ids.length; i++){
            html = html + '<tr><td>' + female_accession_ids[i] + '</td><td><div name="cross_wishlist_male_selects" id="cross_wishlist_male_select_' +i+ '"></div></td><td><span id="cross_wishlist_male_accession_id_'+ i +'_priority" data-related="'+encodeURI(female_accession_ids[i])+'" >選擇父本(Select Male(s))</span></td></tr>';
        };
        html = html + '</tbody></table>';
        jQuery('#cross_wishlist_male_parent_div').html(html);

        var cross_wishlist_male_parents = jQuery('#cross_wishlist_male_select_table')
             .find("div")
             .map(function() { return this.id; })
             .get();
        //console.log(cross_wishlist_male_parents);
        for(var i=0; i<cross_wishlist_male_parents.length; i++){
            var female_id = jQuery('#cross_wishlist_male_accession_id_'+ i +'_priority').data('related');
            get_select_box('stocks', cross_wishlist_male_parents[i], { 'name' : 'cross_wishlist_male_accession_id_select', 'id' : 'cross_wishlist_male_accession_id_'+i, 'size' : 7, 'stock_type_name':'accession', 'trial_id_list':male_trial_ids_array, 'names_as_select':1, 'data-related':female_id });
        };
    };

    jQuery(document).on('change', "select[name='cross_wishlist_male_accession_id_select']", function() {
        var div_id = '#' + this.id;
        var male_ids = jQuery(div_id).val();
        if (male_ids.length > 0){
            cross_wishlist_change_males(div_id, div_id + '_priority');
        }
    });

    function cross_wishlist_change_males(div_id, select_id){
        var female_accession_ids = jQuery('#cross_wishlist_female_accession_ids').val();
        var male_ids = jQuery(div_id).val();
        var female_id = jQuery(div_id).data('related');
        var html = '<table class="table table-bordered" div="' + div_id +'_table"><thead><tr><th>父本(Male Parent)</th><th>優先順序(Priority)</th></tr></thead><tbody>';
        for (var i=0; i<male_ids.length; i++){
            html = html + '<tr><td>' + male_ids[i] + '</td><td><input class="form-control" male_id="' + male_ids[i] + '" female_id="' + female_id + '" name ="cross_wishlist_final_priority" id="cross_wishlist_male_priority_'+ i +'" value="1" placeholder="1"/></td></tr>';
        };
        html = html + '</tbody></table>';
        jQuery(select_id).html(html);
    };


    jQuery('#cross_wishlist_submit').click(function(e){
        e.preventDefault();
        var active_tab = jQuery('ul#cross_wishlist_tab_select li.active').attr('id');
        //console.log(active_tab);
        cross_data = [];
        female_male_tracker = {};
        selected_plot_ids = [];
        female_trial_id;
        male_trial_id;

        var male_accession_limit = 60;
        if (active_tab == 'cross_wishlist_no_list_tab'){
            jQuery('input[name="cross_wishlist_final_priority"]').each(function() {
                value = this.value;
                var male_id = jQuery(this).attr('male_id');
                var female_id = jQuery(this).attr('female_id');
                cross_data.push({ 'female_id':female_id, 'male_id':male_id, 'priority':value });
                if (female_id in female_male_tracker){
                    female_male_tracker[female_id].push(male_id);
                } else {
                    female_male_tracker[female_id] = [male_id];
                }
            });
            female_trial_id = jQuery('#cross_wishlist_female_trial_id').val();
            male_trial_id = jQuery('#cross_wishlist_male_trial_id').val();
        }
        if (active_tab == 'cross_wishlist_list_tab'){
            jQuery('input[name="cross_wishlist_cross_grid_inputs"]').each(function() {
                value = this.value;
                if (value){
                    var male_id = jQuery(this).data('male');
                    var female_id = jQuery(this).data('female');
                    cross_data.push({ 'female_id':female_id, 'male_id':male_id, 'priority':value });
                    if (female_id in female_male_tracker){
                        female_male_tracker[female_id].push(male_id);
                    } else {
                        female_male_tracker[female_id] = [male_id];
                    }
                }
            });
            female_trial_id = jQuery('#cross_wishlist_list_female_trial_id').val();
            male_trial_id = jQuery('#cross_wishlist_list_male_trial_id').val();
        }
        //console.log(cross_data);
        //console.log(trial_id);
        //console.log(female_male_tracker);
        if(!female_trial_id){
            alert('您必須選擇母本試驗！');
            return;
        }
        if(!male_trial_id){
            alert('您必須選擇父本試驗！可以與母本試驗相同。');
            return;
        }
        for (f in female_male_tracker){
            var male_array = female_male_tracker[f];
            if (male_array.length > male_accession_limit){
                alert('每個雜交組合最多只能選擇 60 個父本種原！');
                return;
            }
        }
        jQuery.ajax({
            url: '/ajax/cross/create_cross_wishlist',
            method: 'POST',
            data: {
                'crosses': JSON.stringify(cross_data),
                'female_trial_id': female_trial_id,
                'male_trial_id': male_trial_id
            },
            dataType:'json',
            beforeSend: function() {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                //console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error){
                    alert(response.error);
                } else {
                    jQuery('#cross_wishlist_cross_select_div').html(response.data);
                    jQuery('#create_cross_wishlist_select_dialog').modal('show');
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert("提交雜交清單小區時發生錯誤");
            }
        });
    });

    jQuery('#cross_wishlist_select_submits').click(function(){
        var male_plot_limit = 60;
        female_male_tracker = {};
        selected_plot_ids = [];

        jQuery('input[name="cross_wishlist_plot_select_female_input"]').each(function() {
            if (this.checked){
                selected_plot_ids.push({
                    'cross_female_accession_name' : jQuery(this).data('female_accession_name'),
                    'female_plot_id' : jQuery(this).val(),
                    'male_genotypes_string' : jQuery(this).data('male_genotypes_string')
                });
            }
        });
        jQuery('input[name="cross_wishlist_plot_select_male_input"]').each(function() {
            if (this.checked){
                selected_plot_ids.push({
                    'cross_female_accession_name' : jQuery(this).data('female_accession_name'),
                    'male_plot_id' : jQuery(this).val()
                });
                if (jQuery(this).data('female_accession_name') in female_male_tracker){
                    female_male_tracker[jQuery(this).data('female_accession_name')].push(jQuery(this).val());
                } else {
                    female_male_tracker[jQuery(this).data('female_accession_name')] = [jQuery(this).val()];
                }
            }
        });
        //console.log(selected_plot_ids);
        //console.log(female_male_tracker);
        for (f in female_male_tracker){
            var male_array = female_male_tracker[f];
            if (male_array.length > male_plot_limit){
                alert('每個雜交組合最多只能選擇 60 個父本小區！');
                return;
            }
        }

        jQuery.ajax({
            url: '/ajax/cross/create_cross_wishlist_submit',
            method: 'POST',
            data: {
                'crosses': JSON.stringify(cross_data),
                'selected_plot_ids': JSON.stringify(selected_plot_ids),
                'female_trial_id': female_trial_id,
                'male_trial_id': male_trial_id,
                'form_id': jQuery('#cross_wishlist_availabe_odk_crossing_forms').val(),
                'form_name': jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text()
            },
            dataType:'json',
            beforeSend: function() {
                jQuery('#working_msg').html('正在建立雜交清單檔案並將資訊發送至 ONA... 這可能需要一些時間...');
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                //console.log(response);
                jQuery('#working_msg').html('');
                jQuery('#working_modal').modal('hide');
                if (response.filename) {
                    window.location.href = "/download/"+response.filename;
                }
                if (response.error) {
                    jQuery('#cross_wishlist_response_div').html(response.error);
                }
                if (response.success){
                    jQuery('#cross_wishlist_response_div').html(response.success);
                }
                jQuery('#create_cross_wishlist_response_dialog').modal('show');
            },
            error: function(response) {
                jQuery('#working_msg').html('');
                jQuery('#working_modal').modal('hide');
                alert("建立雜交清單時發生錯誤");
            }
        });
    });

    jQuery('#cross_wishlist_female_trial_select_upload_div').change(function(){
        jQuery('#wishlist_lists_footer').hide();
        jQuery('#wishlist_upload_footer').show();
    });

    jQuery('#wishlist_format').click(function() {
        jQuery('#upload_wishlist_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#wishlist_upload_submit').click(function() {
        upload_wishlist_file();
    });

    function upload_wishlist_file() {
        var female_trial_id = $('#cross_wishlist_upload_female_trial_id').val();
        if (!female_trial_id) {
            alert('需要母本試驗');
            return;
        }

        var male_trial_id = $('#cross_wishlist_upload_male_trial_id').val();
        if (!male_trial_id) {
            alert('需要父本試驗');
            return;
        }

        var uploadFile = $("#wishlist_file").val();
        if (uploadFile === ''){
            alert("請選擇檔案");
            return;
        }

        jQuery('#upload_wishlist_form').attr("action", "/ajax/cross/create_wishlist_by_uploading");

        jQuery("#upload_wishlist_form").submit();

    }

    jQuery('#upload_wishlist_form').iframePostForm({
        json: true,
        post: function() {
            var uploadFile = $('#wishlist_file').val();
            if (uploadFile === '') {
                alert("未選擇檔案");
            }
            jQuery('#working_msg').html('正在建立雜交清單檔案並將資訊發送至 ONA... 這可能需要一些時間...');
            jQuery('#working_modal').modal('show');
        },
        complete: function(response) {
            if (response.error_string) {
                jQuery('#working_modal').modal('hide');
                jQuery('#upload_wishlist_error_display tbody').html('');
                jQuery('#upload_wishlist_error_display tbody').append(response.error_string);
                jQuery('#upload_wishlist_error_display').modal("show");
                return;
            }
            if (response.error) {
                jQuery('#working_modal').modal('hide');
                alert(response.error);
                return;
            }
            if ((response.selected_plot_ids) && (response.cross_combinations)) {
                var selected_plot_ids = JSON.stringify(response.selected_plot_ids);
                var cross_combinations = JSON.stringify(response.cross_combinations);
                var female_trial_id = jQuery('#cross_wishlist_upload_female_trial_id').val();
                var male_trial_id = jQuery('#cross_wishlist_upload_male_trial_id').val();
                var form_id = jQuery('#cross_wishlist_availabe_odk_crossing_forms').val();
                var form_name = jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text();

                jQuery.ajax({
                    url: '/ajax/cross/create_cross_wishlist_submit',
                    method: 'POST',
                    data: {
                        'crosses': cross_combinations,
                        'selected_plot_ids': selected_plot_ids,
                        'female_trial_id': female_trial_id,
                        'male_trial_id': male_trial_id,
                        'form_id': form_id,
                        'form_name': form_name
                    },
                    dataType:'json',
                    success: function(response) {
                        //console.log(response);
                        jQuery('#working_msg').html('');
                        jQuery('#working_modal').modal('hide');
                        if (response.filename) {
                            window.location.href = "/download/"+response.filename;
                        }
                        if (response.error) {
                            jQuery('#cross_wishlist_response_div').html(response.error);
                        }
                        if (response.success){
                            jQuery('#cross_wishlist_response_div').html(response.success);
                        }
                        jQuery('#create_cross_wishlist_response_dialog').modal('show');
                    },
                    error: function(response) {
                        jQuery('#working_msg').html('');
                        jQuery('#working_modal').modal('hide');
                        alert("建立雜交清單時發生錯誤");
                    }
                });
            }
        }
    });

});

</script>
