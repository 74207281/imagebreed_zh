<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title=>"已下載的互交檔案（親本與雜交清單檔案）(Downloaded Intercross Files (Parents and Wishlist Files))", is_subsection => 1, collapsible=>1, collapsed=>1 &>
            <table class="table table-hover table-bordered" id="downloaded_intercross_files_table">
            </table>
        </&>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title=>"已上傳的互交檔案(Uploaded Intercross Files)", is_subsection => 1, collapsible=>1, collapsed=>1 &>
            <table class="table table-hover table-bordered" id="uploaded_intercross_files_table">
            </table>
        </&>
    </div>
</div>


<script>

jQuery(document).ready(function(){

jQuery('#intercross_section_onswitch').click(function(){

    jQuery('#downloaded_intercross_files_table').DataTable({
        'autoWidth': false,
        'destroy': true,
        'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/downloaded_intercross_file_metadata' },
        columns: [
            { title: "檔案名稱(Filename)", "data": null, "render": function ( data, type, row ) { return row[4]; } },
            { title: "建立日期(Create Date)", "data": null, "render": function ( data, type, row ) { return row[1]; } },
            { title: "建立者(Created By)", "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
            { title: "檔案類型(File Type)", "data": null, "render": function ( data, type, row ) { return row[6]; } },
            { title: "操作(Options)", "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+'">檢視(View)</a> | <a href="/breeders/phenotyping/download/'+row[0]+'">下載(Download)</a>'; } },
        ]
    });

    jQuery('#uploaded_intercross_files_table').DataTable({
        'autoWidth': false,
        'destroy': true,
        'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/uploaded_intercross_file_metadata' },
        columns: [
            { title: "檔案名稱(Filename)", "data": null, "render": function ( data, type, row ) { return row[4]; } },
            { title: "建立日期(Create Date)", "data": null, "render": function ( data, type, row ) { return row[1]; } },
            { title: "建立者(Created By)", "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
            { title: "檔案類型(File Type)", "data": null, "render": function ( data, type, row ) { return row[6]; } },
            { title: "操作(Options)", "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+'">檢視(View)</a> | <a href="/breeders/phenotyping/download/'+row[0]+'">下載(Download)</a>'; } },
        ]
    });


});


});

</script>
