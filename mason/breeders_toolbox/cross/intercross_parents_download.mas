<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<div class="modal fade" id="intercross_parents_download_dialog" name="intercross_parents_download_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsDownloaddialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsDownloaddialog">下載互交親本檔案(Download Intercross Parents File)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-11">
                            <&| /page/explanation.mas, title=>'檔案資訊(File Information)' &>
                                <p>
                                    <b>檔案資訊</b>
                                    <br>
                                    <a id="intercross_parents_file_info">互交親本</a>
                                    <br>
                                </p>
                            </&>
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-sm-3">母本：</label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="female_parents_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-sm-3">父本：</label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="male_parents_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="download_intercross_parents_submit" type="button" class="btn btn-primary" >下載(Download)</button>
                <input type="hidden" id="intercross_parents_download_token" name="intercross_parents_download_token"/>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_parents_download_message" name="intercross_parents_download_message" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsDownloadMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsDownloadMessage">互交親本檔案已建立(Intercross Parents File Created)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        互交親本檔案已成功建立。
                    </p>
                    <p>
                        <a id="intercross_parents_download_link">下載互交親本檔案</a>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="intercross_parents_download_close_button" id="intercross_parents_download_close_button" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_parents_file_info_dialog" name="intercross_parents_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsFileInfoDialog">互交親本(Intercross Parents)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        清單中的名稱必須為唯一名稱（uniquename）。
                    </b>
                    <br>
                        互交親本檔案為 CSV 檔案（.csv）。
                    <br>
                        此檔案可直接在 Intercross 應用程式中使用。
                    <br><br>
                    <b>
                        標題列：
                    </b>
                    <br>
                        第一列（標題）包含以下欄位：
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>codeId</td>
                                <td>sex</td>
                                <td>name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        欄位資訊：
                    </b>
                    <ul>
                        <li><b>codeId:</b> 資料庫中的 stock_id。</li>
                        <li><b>sex:</b> 0（母本），1（父本）</li>
                        <li><b>name:</b> 資料庫中的唯一名稱（uniquename）。</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    var crossing_experiment_id = "<% $trial_id %>";
    var lo = new CXGN.List();

    jQuery('#female_parents_list_select').html(lo.listSelect('female_parents_list_select', ['accessions'], '請選擇母本清單', undefined, undefined));
    jQuery('#male_parents_list_select').html(lo.listSelect('male_parents_list_select', ['accessions'], '請選擇父本清單', undefined, undefined));

    jQuery('#download_intercross_parents').click(function(){
        jQuery('#intercross_parents_download_dialog').modal("show");
    });

    jQuery("#intercross_parents_file_info").click(function(){
        jQuery("#intercross_parents_file_info_dialog").modal("show");
    });

    jQuery('#download_intercross_parents_submit').click(function(){

        var female_list_id = jQuery('#female_parents_list_select').val();
        var male_list_id = jQuery('#male_parents_list_select').val();

        if (!female_list_id) {
            alert("請選擇母本清單");
            return;
        }

        if (!male_list_id) {
            alert("請選擇父本清單");
            return;
        }

        jQuery.ajax({
            url: '/ajax/intercross/create_parents_file',
            dataType: "json",
            type: 'POST',
            data:{
                'female_list_id': female_list_id,
                'male_list_id': male_list_id,
                'crossing_experiment_id': crossing_experiment_id
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    jQuery('#intercross_parents_download_link').attr('href', "/fieldbook/trait_file_download/" + response.file_id);
                    jQuery("#intercross_parents_download_message").modal("show");
                    jQuery('#intercross_parents_download_dialog').modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert('建立親本檔案時發生錯誤。');
                jQuery('#intercross_parents_download_dialog').modal("hide");
            },
        });
    });

    jQuery("#intercross_parents_download_close_button").click(function(){
        location.reload();
    });


});


</script>
