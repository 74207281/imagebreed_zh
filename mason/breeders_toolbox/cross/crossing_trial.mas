<%doc>

=head1 NAME

/breeders_toolbox/cross/crossing_trial.mas - a mason component to display a crossing experiment detail page

=head1

=cut

</%doc>


<%args>
$trial_id
$trial_name
$private_company_id
$private_company_name
$private_company_project_is_private
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$folder_name => undef
$folder_id => undef
$locations_by_program_json
$trial_owner => undef
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial03152022', 'moment_min', 'daterangepicker', 'CXGN.BreedersToolbox.Crosses03152022'] &>

<br/>

%  my $project_is_private = $private_company_project_is_private ? 'True' : 'False';

<& /page/page_title.mas, title=> $trial_name . " 的詳細資訊(Details for " . $trial_name . ")" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>雜交實驗詳細資訊(Crossing Experiment Details)</h4>", info_section_subtitle => '檢視並編輯實驗的基本資訊。', buttons_html => '<button class="btn btn-primary btn-sm" id="edit_crossingtrial_details" style="margin:3px">編輯雜交實驗詳細資訊(Edit Crossing Experiment Details)</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "crossingtrial_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, folder_name => $folder_name, folder_id => $folder_id, trial_owner => $trial_owner, company_id => $private_company_id, company_name => $private_company_name, company_project_is_private => $project_is_private &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>管理互交(Manage Intercross)</h4>", info_section_subtitle => '下載親本與雜交清單檔案。上傳匯出檔案。', buttons_html => '<button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_parents">下載親本檔案(Download Parents File)</button><button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_wishlist">下載雜交清單檔案(Download Wishlist File)</button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_intercross_file_link">上傳互交檔案(Upload Intercross File)</button>', icon_class => "glyphicon glyphicon-sort", info_section_id => "intercross_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>此實驗中的雜交(Crosses in this experiment)</h4>", info_section_subtitle => '檢視此實驗中的雜交唯一 ID、雜交組合、雜交類型與親本。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="crossing_experiment_barcode">產生條碼標籤(Generate Barcode Labels)</button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "crosses_in_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>附加親本資訊(Additional Parent Info)</h4>", info_section_subtitle => '檢視此實驗中雜交的附加母本與父本資訊。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_additional_info">上傳現有雜交的附加親本資訊(Upload Additional Parent Info of Existing Crosses)</button>', icon_class => "glyphicon glyphicon-pencil", info_section_id => "additional_info_crossingtrial_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>田間雜交資料(Field Crossing Data)</h4>", info_section_subtitle => '檢視雜交詳細資訊（例如授粉日期、花朵數量、種子數量）', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_cross_info">上傳現有雜交的田間雜交資料(Upload Field Crossing Data of Existing Crosses)</button>', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "cross_properties_crossingtrial_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json, info_section_title => "<h4 style='display:inline'>種子批次資訊(Seedlot Info)</h4>", info_section_subtitle => '檢視源自此雜交實驗的種子批次', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_seedlots_from_crosses">上傳從雜交收穫的種子批次(Upload Seedlots Harvested From Crosses)</button>', icon_class => "glyphicon glyphicon-retweet", info_section_id => "seedlots_from_crossingtrial_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>後代與家族名稱(Progenies and Family Names)</h4>", info_section_subtitle => '檢視後代數量與家族名稱', icon_class => "glyphicon glyphicon-random", info_section_id => "progenies_in_crossingtrial_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>試驗連結(Trial Linkage)</h4>", info_section_subtitle => '檢視屬於此雜交實驗的田間試驗', icon_class => "glyphicon glyphicon-link", info_section_id => "crossing_trial_from_field_trial_section" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>刪除雜交實驗或雜交(Delete Crossing Experiment or Crosses)</h4>", info_section_subtitle => '刪除雜交實驗或此實驗中的雜交。', icon_class => "glyphicon glyphicon-trash", info_section_id => "crossing_experiment_deletion_section" &>

<& /breeders_toolbox/folder/folder_set.mas, project_type => 'crossing_experiment', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, project_type => 'crossing_experiment',, breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name &>
<& /breeders_toolbox/cross/edit_crossingtrial_details_dialog.mas, trial_name => $trial_name, breeding_program_id => $breeding_program_id, location_id => $location_id, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, company_id => $private_company_id, company_name => $private_company_name, company_project_is_private => $private_company_project_is_private &>
<& /breeders_toolbox/cross/upload_update_crosses.mas &>
<& /breeders_toolbox/cross/upload_crossingtrial_seedlots_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json&>
<& /breeders_toolbox/trial/generate_trial_barcode.mas, identifier => ''."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", trial_stock_type => '' &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/intercross_file_upload.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/intercross_parents_download.mas, trial_id => $trial_id &>
<& /breeders_toolbox/cross/intercross_wishlist_download.mas, trial_id => $trial_id &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>
