<%args>

$breeding_program_name
$breeding_program_id
$locations_by_program_json

</%args>

<div class="modal fade" id="upload_cross_seedlot_dialog" name="upload_cross_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog">上傳種子批次(Upload Seedlots)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> "介紹(Intro)" &>
                            <& /page/page_title.mas, title=>"什麼是種子批次？(What are seedlots?)" &>
                            <ul>
                                <li>種子批次是從雜交、種原、小區或植株收穫的種子集合。</li>
                                <li>種子批次可以具有特定位置、儲藏盒、重量（公克）及數量。</li>
                                <li>種子批次可屬於育種計畫和機構。</li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "檔案格式(File format)" &>
                        <& /page/page_title.mas, title=>"請確認您的檔案符合正確的檔案格式(Make sure your file matches the correct file format)" &>
                            <br/><br/>
                            <center>
                                <div id="upload_crosses_seedlots_template_section" style="display:none">
                                    <button class="btn btn-info" id ="guided_help_crosses_seedlots_upload_format_button" name ="guided_help_crosses_seedlots_upload_format_button">收穫種子批次上傳檔案格式資訊(Information about file format for uploading seed lots harvested)</button><br/><br/>
                                </div>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);">確認檔案格式相符後，前往下一步(Once you think your file matches, go to Next Step)</button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "上傳種子批次(Upload seedlots)" &>
                        <& /page/page_title.mas, title=>"提供種子批次基本資訊並上傳您的檔案(Provide basic information about the seedlots and upload your file)" &>
                        <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_cross_seedlot_form" name="upload_cross_seedlot_form">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">育種計畫：</label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_breeding_program_name" id="upload_seedlot_breeding_program_name" disabled value="<% $breeding_program_name %>">
                                    <input name="upload_seedlot_breeding_program_id" id="upload_seedlot_breeding_program_id" type="hidden" value="<% $breeding_program_id %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">種子批次儲藏位置：</label>
                                <div class="col-sm-9" >
                                    <select class="form-control" name="upload_seedlot_location" id="upload_seedlot_location"></select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">機構名稱：</label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="選填">
                                </div>
                            </div>
                            <div id="upload_seedlots_harvested_section" style="display:none">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </div>
                            <div id="upload_seedlot_breeding_program_id" style="visibility:hidden">
                                <% $breeding_program_id %>
                            </div>
                        </form>
                        <center>
                            <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" id ="upload_cross_seedlot_button" name="upload_cross_seedlot_button" >上傳種子批次(Upload Seedlots)</button><br/><br/>
                        </center>
                    </&>
                    <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                        <& /page/page_title.mas, title=>"完成！您的種子批次現已儲存在資料庫中(Finished! Your seedlots are now in the database)" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                種子批次檔案已成功上傳
                            </p>
                            <ul>
                                <li>您可以前往剛建立的種子批次詳細資訊頁面。</li>
                                <li>您可以為種子批次列印條碼。</li>
                            </ul>
                            <br/>
                            <center>
                                <button class="btn btn-primary" name="upload_seedlot_success_complete_button">種子批次已成功儲存至資料庫且無任何錯誤！祝賀 請點選此處(The seedlots were saved to the database with no errors! Congrats Click Here)</button><br/><br/>
                            </center>
                        </&>
                    </&>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="crosses_seedlots_upload_spreadsheet_info_dialog" name="crosses_seedlots_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog">來自雜交的種子批次上傳範本資訊(Upload Template Information For Seedlots From Crosses)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>種子批次可以 Excel 檔案（.xls 或 .xlsx）格式上傳</b>
                    <br />
                    <b>標題欄（Header）：</b>
                    <br>
                        第一列（標題欄）必須包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight(g)</td>
                                <td>description</td>
                                <td>box_name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>必填欄位：</b>
                    <ul>
                        <li>seedlot_name（必須唯一）</li>
                        <li>cross_unique_id（必須存在於資料庫中。cross_unique_id 可代表種原之間的雜交，例如 AxB，若有相關資訊，雜交亦可代表田間特定小區之間的雜交）</li>
                        <li>operator_name（監督庫存流程的人員姓名，可為任意名稱）</li>
                        <li>amount（種子批次中的種子數量。可與 weight(g) 一同提供。必須提供 amount 或 weight(g) 或兩者的值）
                            <br/><b>及／或</b><br/>
                            weight(g)（種子批次的重量（公克）。可與 amount 一同提供。必須提供 amount 或 weight(g) 或兩者的值）
                        </li>
                        <li>box_name（種子所在的盒子名稱，可為任意名稱）</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                        <li>description（各個種子批次的附加資訊）</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_cross_seedlot_error_display" name="upload_cross_seedlot_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCrossSeedlotErrorDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadCrossSeedlotErrorDialog">上傳種子批次檔案錯誤(Upload Seedlot File Error)</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	  <table>
    	  <tbody></tbody>
  	  </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
      </div>
    </div>
  </div>
</div>


<script>
jQuery(document).ready(function(){

    var locations_by_program_json = <% $locations_by_program_json %>;
    var locations_string = locations_by_program_json.toString();
    var locations_array = locations_string.split(",");

    jQuery('#upload_seedlots_from_crosses').click( function() {
        jQuery('#upload_cross_seedlot_dialog').modal('show');

        var html = '<select id = "upload_seedlot_location" >';
        for (var i=0; i<locations_array.length; i++) {
            html = html + '<option value='+locations_array[i]+'>'+locations_array[i]+'</option>';
        }
        html = html + "</select>";

        jQuery('#upload_seedlot_location').html(html);

    });

    jQuery('#upload_crosses_seedlots_template_section').show();

    jQuery('#upload_seedlots_harvested_section').show();

    jQuery('#guided_help_crosses_seedlots_upload_format_button').click( function () {
        jQuery('#crosses_seedlots_upload_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#upload_cross_seedlot_button').click(function () {
        upload_crosses_seedlots();
    });

    function upload_crosses_seedlots() {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_cross_seedlot_form').attr("action", "/ajax/breeders/seedlot-upload");
        if (breeding_program === '') {
            alert("請選擇育種計畫");
            return;
        }
        if (location === '') {
            alert("請提供位置");
            return;
        }
        if (uploadSeedlotsHarvestedFile == '') {
            alert("請選擇檔案");
            return;
        }
        jQuery("#upload_cross_seedlot_form").submit();
    }

    jQuery('#upload_cross_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery('#upload_cross_seedlot_error_display').modal("show");
                jQuery('#upload_cross_seedlot_error_display tbody').html('');
                jQuery('#upload_cross_seedlot_error_display tbody').append(response.error_string);
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");

            }
        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert('種子批次已儲存至資料庫');
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });

});


</script>
