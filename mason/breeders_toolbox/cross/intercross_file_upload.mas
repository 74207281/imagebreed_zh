<%args>
$trial_id
$trial_name
</%args>


<div class="modal fade" id="upload_intercross_file_dialog" name="upload_intercross_file_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadIntercrossFileDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadIntercrossFileDialog">上傳互交檔案(Upload Intercross File)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'互交上傳資訊(Intercross Upload Information)' &>
                        <p>
                            <a id="upload_intercross_file_spreadsheet_format_info">互交上傳資訊(Intercross Upload Information)</a>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_intercross_form" name="upload_intercross_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">雜交實驗：</label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="intercross_experiment_name" id="intercross_experiment_name" disabled value="<% $trial_name %>">
                                <input name="intercross_experiment_id" id="intercross_experiment_id" type="hidden" value="<% $trial_id %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">選擇雜交唯一識別碼格式：</label>
                            <div class="col-sm-8">
                                <select class="form-control" id="cross_id_format_option" name="cross_id_format_option">
                                    <option value="">請為互交檔案選擇您的雜交唯一識別碼格式</option>
                                    <option value="customized_id">使用先前儲存在資料庫中的自訂雜交唯一 ID</option>
                                    <option value="auto_generated_id">使用自動產生的雜交唯一 ID</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">上傳檔案 (.csv)：</label>
                            <div class="col-sm-8">
                                <input type="file" name="intercross_file" id="intercross_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_intercross_file_submit" id="upload_intercross_file_submit">上傳檔案(Upload File)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_intercross_error_display" name="upload_intercross_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadIntercrossErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadIntercrossErrorDialog">上傳互交檔案錯誤(Upload Intercross File Error)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_saved_dialog_message" name="intercross_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="intercrossSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossSavedDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        來自互交檔案的雜交資料已成功儲存。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_intercross_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉並重新載入(Close & Reload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_spreadsheet_info_dialog" name="intercross_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossFileInfoDialog">雜交唯一識別碼與範本資訊(Cross Unique ID and Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>雜交唯一識別碼：</b>您可以讓資料庫自動為您產生雜交唯一 ID，也可以在上傳互交檔案之前在資料庫中設定自己的雜交唯一 ID。對於自動產生的雜交唯一 ID，雜交唯一 ID 是雜交實驗名稱和遞增後綴編號的組合。
                    <br><br>
                    <b>互交檔案為 CSV 檔案（.csv）。</b>互交檔案中的雜交必須屬於同一個雜交實驗。
                    <br><br>
                    <b>標題列：</b>
                    <br>
                    請勿修改互交檔案的標題列。第一列（標題）必須包含以下欄位：
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>crossDbId</td>
                                <td>femaleObsUnitDbId</td>
                                <td>maleObsUnitDbId</td>
                                <td>timestamp</td>
                                <td>person</td>
                                <td>experiment</td>
                                <td>type</td>
                                <td>fruits</td>
                                <td>flowers</td>
                                <td>seeds</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>欄位資訊：</b>
                    <ul>
                        <li>crossDbId（在資料庫中稱為交易 ID。交易 ID 是每項活動的唯一識別碼）</li>
                        <li>femaleObsUnitDbId（必須作為唯一名稱存在於資料庫中，可以是種原、小區或植株種原類型。）</li>
                        <li>maleObsUnitDbId（必須作為唯一名稱存在於資料庫中，可以是種原、小區或植株種原類型。）</li>
                        <li>person（操作員姓名，操作員不需要擁有資料庫使用者帳號）</li>
                        <li>experiment（在資料庫中稱為雜交實驗。該雜交實驗必須存在於資料庫中。）</li>
                        <li>type（雜交類型，Intercross 支援雙親、自交、開放授粉與多系交配雜交類型）</li>
                        <li>fruits（果實數量）</li>
                        <li>flowers（花朵數量）</li>
                        <li>seeds（種子數量）</li>
                    </ul>
                    <br>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#upload_intercross_file_link').click(function(){
        jQuery('#upload_intercross_file_dialog').modal("show");
    });

    jQuery('#upload_intercross_file_spreadsheet_format_info').click(function(){
        jQuery("#intercross_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_intercross_file_submit").click(function(){
        var uploadFile = jQuery("#intercross_file").val();
        var crossIDformat = jQuery("#cross_id_format_option").val();

        jQuery('#upload_intercross_form').attr("action", "/ajax/cross/upload_intercross_file");

        if (crossIDformat === ''){
            alert("請選擇您的雜交 ID 格式");
            return;
        }

        if (uploadFile === ''){
            alert("請選擇檔案");
            return;
        }
        jQuery("#upload_intercross_form").submit();
        jQuery("#upload_intercross_file_dialog").modal("hide");
    });

    jQuery('#upload_intercross_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_intercross_error_display tbody").html('');
                jQuery("#upload_intercross_error_display tbody").append(response.error_string);
                jQuery("#upload_intercross_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#intercross_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_intercross_saved_dialog").click(function(){
        location.reload();
    });

});

</script>
