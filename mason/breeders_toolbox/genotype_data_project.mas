
<%doc>

=head1 NAME

/breeders_toolbox/genotype_data_project.mas - a mason component to display a genotyping project detail page

=head1 AUTHOR


=cut

</%doc>

<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$user_can_modify => undef
$has_plant_entries => undef
$has_subplot_entries => undef
$has_tissue_sample_entries => undef
$hidap_enabled => undef
$folder_name => undef
$folder_id => undef
$plants_per_plot => undef
$has_expression_atlas => undef
$expression_atlas_url => undef
$site_project_name => undef
$trial_phenotype_files => undef
$sgn_session_id => undef
$user_name => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$identifier_prefix => 'SGN'
$genotyping_facility => undef
$genotype_data_type => undef
$has_plate => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial03152022', 'moment_min', 'daterangepicker' ] &>

<br/>

<& /page/page_title.mas, title=>"基因型資料專案(Genotyping Data Project): ".$trial_name &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>基因型資料專案詳細資訊(Genotyping Data Project Details)</h4>", info_section_subtitle => '檢視基因型資料專案的基本資訊。',buttons_html => '<button class="btn btn-primary btn-sm" id="edit_genotyping_project_details" style="margin:3px">編輯基因型專案詳細資訊(Edit Genotyping Project Details)</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_data_project_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, year => $year, trial_description => $trial_description, identifier_prefix => $identifier_prefix, genotyping_facility => $genotyping_facility, genotype_data_type => $genotype_data_type &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>基因型分析盤(Genotyping Plates)</h4>", info_section_subtitle => '檢視此專案中的基因型分析盤資訊，或將基因型分析盤移至此專案。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_existing_genotyping_plate_link">移動基因型分析盤至此專案(Move Genotyping Plate(s) to this Project)</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "genotyping_project_plates" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>基因型分析流程(Genotyping Protocols)</h4>", info_section_subtitle => '檢視此基因型資料專案所使用的基因型分析流程基本資訊。', icon_class => "glyphicon glyphicon-cog", info_section_id => "genotyping_data_project_protocols" &>

% if ($genotype_data_type ne 'SSR') {
<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>基因型資料(Genotyping Data)</h4>", info_section_subtitle => '檢視並下載基因型資料。', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "genotyping_data_project_data" &>
% }
% my $data_agreement_link = '<button class="btn btn-sm btn-primary" disabled style="margin:3px">新增/編輯資料協議(Add/edit data agreement)</button>';
% if ($user_can_modify) { $data_agreement_link = '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_data_agreement">新增/編輯資料協議(Add/edit data agreement)</button>'; }

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>資料協議授權(Data Agreement License)</h4>", info_section_subtitle => '檢視並編輯此試驗的公開資料協議。', icon_class => "glyphicon glyphicon-inbox", info_section_id => "trial_data_agreement_section", buttons_html => $data_agreement_link &>

<& /breeders_toolbox/add_data_agreement_dialogs.mas, trial_id => $trial_id &>
<& /breeders_toolbox/genotyping_data_project/add_existing_genotyping_plate_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/genotyping_data_project/edit_genotyping_project_details_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name, trial_description => $trial_description, year => $year, genotyping_facility => $genotyping_facility, has_plate => $has_plate &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

<script defer="defer">

jQuery(document).ready(function () {

    trial_detail_page_setup_dialogs();

    jQuery('#edit_genotyping_project_details').click(function(){
        jQuery('#edit_genotyping_project_details_dialog').modal("show");
        edit_genotyping_project_details();
    });


});

</script>
