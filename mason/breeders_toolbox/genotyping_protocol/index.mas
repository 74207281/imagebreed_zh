
<%doc>

=head1 NAME

/breeders_toolbox/trial.mas - a mason component to display a genotyping protocol detail page

=head1 AUTHOR

=cut

</%doc>

<%args>
$protocol_id
$protocol_name
$protocol_description
$protocol_is_grm
$marker_names
$header_information_lines
$reference_genome_name
$species_name
$sample_observation_unit_type_name
$create_date
$marker_type
</%args>


<& /util/import_javascript.mas, classes => [ ] &>


<br/>

<& /page/page_title.mas, title=>"基因分型協定詳細資訊(Genotyping Protocol Detail) - ".$protocol_name &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>基因分型協定詳細資訊(Genotype Protocol Details)</h4>", info_section_subtitle => '檢視有關基因分型協定的基本資訊。', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_protocol_details", protocol_name => $protocol_name, protocol_description => $protocol_description, marker_names => $marker_names, header_information_lines => $header_information_lines, reference_genome_name => $reference_genome_name, species_name => $species_name, create_date => $create_date, sample_observation_unit_type_name => $sample_observation_unit_type_name, marker_type => $marker_type, protocol_is_grm => $protocol_is_grm &>

% if ($marker_type eq 'SSR') {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>標記(Markers)</h4>", info_section_subtitle => '檢視此協定中使用的標記資訊。', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "pcr_based_genotyping_markers" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_names => $marker_names, info_section_title => "<h4 style='display:inline'>基因型資料(Genotype Data)</h4>", info_section_subtitle => '檢視並下載此協定的基因分型資料。',buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="download_ssr_data_link">下載 SSR 資料(Download SSR Data)</button>', icon_class => "glyphicon glyphicon-save-file", info_section_id => "pcr_genotyping_protocol_genotype_data" &>
% }
% elsif ($protocol_is_grm) {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>基因型關係(Genotype Relationships)</h4>", info_section_subtitle => '檢視並下載此協定中的基因型關係資訊。', icon_class => "glyphicon glyphicon-random", info_section_id => "genotyping_protocol_grm_relationships" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>田間試驗連結(Field Trial Linkage)</h4>", info_section_subtitle => '檢視連結至此協定的田間試驗。', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "genotyping_protocol_grm_field_trial" &>
% }
% else {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>標記(Markers)</h4>", info_section_subtitle => '檢視此協定中使用的標記資訊。', icon_class => "glyphicon glyphicon-map-marker", info_section_id => "genotyping_protocol_markers" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>基因型資料(Genotype Data)</h4>", info_section_subtitle => '檢視並下載此協定的基因分型資料。', icon_class => "glyphicon glyphicon-save-file", info_section_id => "genotyping_protocol_genotype_data", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_vcf">下載所有基因型資料 VCF(Download All Genotype Data VCF)</button><button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_dosagematrix">下載所有基因型資料劑量矩陣(Download All Genotype Data Dosage Matrix)</button>' &>
% }


% if ($c->user() && $c->user()->has_role("curator")) {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>刪除基因分型協定及所有資料(Delete Genotyping Protocol and All Data)</h4>", info_section_subtitle => '刪除此協定的基因分型協定及所有資料。', icon_class => "glyphicon glyphicon-trash", info_section_id => "genotyping_protocol_delete_genotype_data" &>
% }
