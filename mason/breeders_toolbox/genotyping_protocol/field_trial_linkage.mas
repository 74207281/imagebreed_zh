<%args>
$protocol_id
</%args>

<table id="trial_search_results" width="100%" class="table table-hover table-striped">
    <thead>
        <tr>
            <th>試驗名稱(Trial Name)</th>
            <th>描述(Description)</th>
            <th>公司(Company)</th>
            <th>育種計畫(Breeding Program)</th>
            <th>資料夾(Folder)</th>
            <th>年份(Year)</th>
            <th>地點(Location)</th>
            <th>試驗類型(Trial Type)</th>
            <th>試驗設計(Design)</th>
            <th>種植日期(Planting Date)</th>
            <th>收穫日期(Harvest Date)</th>
            <th>下載(Download)</th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function() {

    jQuery(document).on('click', '#genotyping_protocol_grm_field_trial_onswitch', function(){
        var trial_table = jQuery('#trial_search_results').DataTable({
            'ajax': '/ajax/search/trials?nd_protocol_grm_id=<% $protocol_id %>',
            "scrollX": true
        });
    });

});

</script>
