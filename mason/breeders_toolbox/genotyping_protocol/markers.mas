<%args>
$protocol_id
</%args>

<div class="well well-sm">
    <div class="form form-horizontal" id="markers_table_search_form">
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">標記名稱：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="markers_table_search_marker_name" type="text" placeholder="標記名稱 (以逗號分隔)"/>
            </div>
        </div>
    </div>
    <center>
    <button class="btn btn-primary btn-sm" id="marker_table_search_submit">搜尋(Search)</button>
    </center>
</div>

<table id="protocol_markers_table" class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>標記名稱(Marker Name)</th>
            <th>染色體(Chromosome)</th>
            <th>位置(Position)</th>
            <th>變異等位基因(Alternate)</th>
            <th>參考等位基因(Reference)</th>
            <th>品質(Quality)</th>
            <th>過濾條件(Filter)</th>
            <th>資訊(Info)</th>
            <th>格式(Format)</th>
        </tr>
    </thead>
    </tbody>
</table>

<script>

jQuery(document).ready(function(){
    
    var genotyping_protocol_table = jQuery('#protocol_markers_table').DataTable({
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'lengthMenu': [10,20,50,100,1000],
        'ajax': { 'url': '/ajax/genotyping_protocol/markers_search',
                  'data': function(d) {
                     d.protocol_id = <% $protocol_id %>;
                     d.marker_names = jQuery('#markers_table_search_marker_name').val();
                }
        },
    });

    jQuery('#marker_table_search_submit').click( function() {
        genotyping_protocol_table.search("available_seedlots_table").draw();
    });

    jQuery('#markers_table_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#marker_table_search_submit').click();
        }
    });
});

</script>
