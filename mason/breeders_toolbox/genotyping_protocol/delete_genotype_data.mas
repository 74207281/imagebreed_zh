<%args>
$protocol_id
</%args>

<button class="btn btn-danger" id="genotyping_protocol_detail_page_delete">刪除此協定的基因分型資料(Delete Genotyping Data For this Protocol)</button>

<script>

jQuery('#genotyping_protocol_detail_page_delete').click(function(){
    if (confirm("您確定要刪除此基因分型協定嗎？此操作無法復原！")) {
        jQuery.ajax ({
            url : '/ajax/genotyping_protocol/delete/<% $protocol_id %>',
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert('基因分型協定已刪除！');
                    window.location.replace("/search/genotyping_protocols");
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('刪除基因分型協定時發生錯誤！');
            }

        });
    }
});

</script>

