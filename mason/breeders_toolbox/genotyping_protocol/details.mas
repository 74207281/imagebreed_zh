<%args>
$protocol_id
$protocol_name
$protocol_description
$marker_names => []
$header_information_lines => []
$reference_genome_name
$species_name
$create_date
$sample_observation_unit_type_name
$marker_type
$protocol_is_grm
</%args>

<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>基因分型協定名稱(Genotyping Protocol Name)</b></td>
                <td>
                    <% $protocol_name %>
                </td>
            </tr>

            <tr>
                <td><b>協定描述(Protocol Description)</b></td>
                <td>
                    <% $protocol_description %>
                </td>
            </tr>

            <tr>
                <td><b>標記類型(Marker Type)</b></td>
                <td>
                    <% $marker_type %>
                </td>
            </tr>

%  if (!$protocol_is_grm) {
            <tr>
                <td><b>標記數量(Number of Markers)</b></td>
                <td>
%                   print scalar(@$marker_names);
                </td>
            </tr>

            <tr>
                <td><b>表頭資訊描述(Header Information Description)</b></td>
                <td>
% my @trimmed;
% my $header_line_count = 0;
% foreach (@$header_information_lines){
%    if ($header_line_count < 10) {
%        $_ =~ tr/<>//d;
%        push @trimmed, $_;
%    }
%    else {
%        push @trimmed, "### ----- 僅顯示前 10 行(SHOWING FIRST 10 LINES ONLY) ----- ###";
%        last;
%    }
%    $header_line_count++;
% }
% my $description = join '<br/>', @trimmed;
% $description = $description ? $description : 'NA';
% print "$description";
                </td>
            </tr>
%  }

            <tr><td><b>參考基因組(Reference Genome)</b></td>
                <td>
                    <% $reference_genome_name %>
                </td>
            </tr>

            <tr><td><b>物種名稱(Species Name)</b></td>
                <td>
                    <% $species_name %>
                </td>
            </tr>

            <tr><td><b>樣本單位(Sample Unit)</b></td>
                <td>
                    <% $sample_observation_unit_type_name %>
                </td>
            </tr>

            <tr><td><b>建立日期(Create Date)</b></td>
                <td>
                    <% $create_date %>
                </td>
            </tr>

        </table>

    </div>
</div>
