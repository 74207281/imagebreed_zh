<%args>
$protocol_id
</%args>

<table id="pcr_protocol_markers_table" class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>標記名稱(Marker Name)</th>
            <th>產物大小(Product Sizes)</th>
            <th>正向引子(Forward Primer)</th>
            <th>反向引子(Reverse Primer)</th>
            <th>黏合溫度(Annealing Temperature)</th>
            <th>序列模體(Sequence Motif)</th>
            <th>序列來源(Sequence Source)</th>
            <th>連鎖群(Linkage Group)</th>
        </tr>
    </thead>
    </tbody>
</table>

<script>

jQuery(document).ready(function(){

    var pcr_genotyping_protocol_table = jQuery('#pcr_protocol_markers_table').DataTable({
        'autoWidth': false,
        'ajax': {'url': '/ajax/genotyping_protocol/pcr_markers',
                 'data': function(d) {
                    d.protocol_id = <% $protocol_id %>;
                }
        },
    });

});


</script>
