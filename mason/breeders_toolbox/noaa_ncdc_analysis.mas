<div id="noaa_ndcd_analysis_result">
</div>

<script>

jQuery(document).ready(function() {

    get_select_box('locations', 'noaa_ncdc_analysis_location_select', {'id':'noaa_ncdc_analysis_location_id', 'name':'noaa_ncdc_analysis_location_id', 'empty':'1'});

    var noaa_ncdc_analysis_location_id = '';
    var noaa_ncdc_analysis_location_station_id = '';
    var noaa_ncdc_analysis_start_date = '';
    var noaa_ncdc_analysis_end_date = '';
    var noaa_ncdc_analysis_type = '';
    var noaa_ncdc_analysis_cumulative_year = '';
    // var noaa_ncdc_token = '<% $c->config->{noaa_ncdc_access_token} %>';
    var cwa_token = '<% $c->config->{cwa_token} %>';
    var web_host = '<% $c->config->{parse_cwa_url} %>';
    var noaa_ncdc_analysis_gdd_base_temp = '50';

    // if (noaa_ncdc_token == 'NULL') {
        // alert(`Configuration variable 'noaa_ncdc_access_token' is undefined. Data from station `+noaa_station_id+` can't be accessed without a token.\r\nPlease visit https://www.ncdc.noaa.gov/cdo-web/token to generate a valid access token, then include the token in sgn_local.conf`);
    // }

    jQuery(document).on('change', '#noaa_ncdc_analysis_location_id', function(){
        noaa_ncdc_analysis_location_id = jQuery(this).val();
        jQuery.ajax({
            url : '/ajax/location/get_noaa_station_id/'+noaa_ncdc_analysis_location_id,
            success: function(response){
                console.log(response);
                if (response.noaa_station_id) {
                    noaa_ncdc_analysis_location_station_id = response.noaa_station_id;

                    jQuery.ajax({
                                url : web_host + '/api/get_cwa_data',
                                method : 'POST',
                                dataType : 'JSON',
                                data : JSON.stringify({StationId:noaa_ncdc_analysis_location_station_id}), 
                        success: function(response) {
                            console.log(response);
                            if (response.Current.Name) {
                                alert('為此地點找到有效的 CWA 測站: '+response.Current.Name);
                                
                                // Build new table for current weatheraders
                                var currentHead = '<tr><th scope="col">觀測時間(Observe Time)</th><th scope="col">天氣(Weather)</th><th scope="col">溫度(Temperature)(&deg;C)</th><th scope="col">相對濕度(RH)</th><th scope="col">氣壓(Air Pressure)</th><th scope="col">風速(Wind Speed)</th><th scope="col">風向(Wind Direction)</th><th scope="col">降水量(Precipitation)</th></tr>';
                                
                                // Loop through the response object and build new rows
                                var currentData = response.Current;
                                var currentBody = '';
                                // jQuery.each(response, function(key, value) {
                                // console.log(value);
                                // Skip the first two elements (indexes 0 and 1)
                                currentBody += '<tr>';
                                currentBody += '<th scope="row">'+currentData.ObsevationTime+'</th>'
                                currentBody += '<td>' + currentData.Weather+'</td>'
                                currentBody += '<td>' + currentData.Temperature + '</td>';
                                currentBody += '<td>' + currentData.Humidity+ '</td>';
                                currentBody += '<td>' + currentData.AirPressure + '</td>';
                                currentBody += '<td>' + currentData.WindSpeed+ '</td>';
                                currentBody += '<td>' + currentData.WindDirection + '</td>';
                                currentBody += '<td>' + currentData.Precipitation + '</td>';
                                currentBody += '</tr>';
                                // });

                                // past data
                                var pastHead = '<tr>\
                                    <th scope="col">日期時間(Date Time)</th>\
                                    <th scope="col">溫度(Temperature)(&deg;C)</th>\
                                    <th scope="col">相對濕度(RH)</th>\
                                    <th scope="col">氣壓(Air Pressure)</th>\
                                    <th scope="col">風速(Wind Speed)</th>\
                                    <th scope="col">風向(Wind Direction)</th>\
                                    <th scope="col">降水量(Precipitation)</th>\
                                    <th scope="col">日照時數(Sunshine Duration)</th>\
                                </tr>';
                                var pastBody = '';
                                var pastData = response.Past;
                                // Loop through the response object and build new rows
                                jQuery.each(pastData, function(key, value) {
                                    console.log(value);
                                    pastBody += '<tr>';
                                    pastBody += '<th scope="row">'+value.Date+'</th>'
                                    pastBody += '<td>' + value.Temperature + '</td>';
                                    pastBody += '<td>' + value.Humidity+ '</td>';
                                    pastBody += '<td>' + value.AirPressure + '</td>';
                                    pastBody += '<td>' + value.WindSpeed+ '</td>';
                                    pastBody += '<td>' + value.WindDirection + '</td>';
                                    pastBody += '<td>' + value.Precipitation + '</td>';
                                    pastBody += '<td>' + value.SunshineDuration + '</td>';
                                    pastBody += '</tr>';
                                });

                                // Overwrite the existing dummy data in the table
                                jQuery('#cwa_current_weather_table thead').html(currentHead);
                                jQuery('#cwa_current_weather_table tbody').html(currentBody);
                                jQuery('#cwa_past_weather_table thead').html(pastHead);
                                jQuery('#cwa_past_weather_table tbody').html(pastBody);
                                
                                // jQuery('#noaa_ncdc_analysis_input_div').show();
                                // jQuery('#cwa_current_weather_table').show();
                                // jQuery('#cwa_current_weather').show();
                                // jQuery('#cwa_past_weather_table').show();
                                jQuery('#cwa_weather').show();
                            }
                            else {
                                alert('無法驗證您提供的 NOAA 測站 ID。請前往「管理(Manage)->地點(Locations)」並確認您的地點具有有效的 NOAA 測站 ID！');
                                jQuery('#noaa_ncdc_analysis_input_div').hide();
                            }
                        },
                        error: function() {
                            alert('NOAA NCDC 授權權杖可能無效！我們無法驗證您的 NOAA 測站 ID。請與我們聯絡！');
                            jQuery('#noaa_ncdc_analysis_input_div').hide();
                        }
                    });
                }
                else {
                    alert('此地點沒有 NOAA NCDC 測站 ID。請前往「管理(Manage)->地點(Locations)」並編輯您的地點以加入有效的 NOAA 測站 ID！');
                    jQuery('#noaa_ncdc_analysis_input_div').hide();
                }
            },
            error: function(response){
                alert('取得地點的 NOAA NCDC ID 時發生錯誤！');
                jQuery('#noaa_ncdc_analysis_input_div').hide();
            }
        });
    });

    // jQuery('#noaa_ncdc_analysis_gdd_cp_submit').click(function(){
    //     noaa_ncdc_analysis_start_date = jQuery('#noaa_ncdc_analysis_start_date').val();
    //     noaa_ncdc_analysis_end_date = jQuery('#noaa_ncdc_analysis_end_date').val();
