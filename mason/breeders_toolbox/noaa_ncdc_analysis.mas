
<%args>
$locations => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<& /page/page_title.mas, title=>"分析 NOAA NCDC 氣象資料(Analyze NOAA NCDC Weather Data)" &>

<div class="form-horizontal">
    <div class="form-group">
        <label class="col-sm-4 control-label">選取地點: </label>
        <div class="col-sm-8" >
            <div id="noaa_ncdc_analysis_location_select"></div>
        </div>
    </div>
</div>

<div id="cwa_weather" style="display:none;">
    <div class="col-sm-8" id="cwa_current_weather",>
        <label class="col-sm-4 control-label">目前天氣(Current Weather)</label>
        <table class="table" id="cwa_current_weather_table">
            <thead>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <div class="col-sm-8" id="cwa_past_weather">
        <label class="col-sm-4 control-label">過去 30 天天氣(Past 30 days Weather)</label>
        <table class="table" id="cwa_past_weather_table">
            <thead>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
