    //                 jQuery('#noaa_ndcd_analysis_result').html(html);

    //                 jQuery.ajax({
    //                     url : '/ajax/location/noaa_ncdc_gdd_cp?location_id='+noaa_ncdc_analysis_location_id+'&station_id='+noaa_ncdc_analysis_location_station_id+'&start_date='+noaa_ncdc_analysis_start_date+'&end_date='+noaa_ncdc_analysis_end_date+'&data_type=cp',
    //                     success: function(response){
