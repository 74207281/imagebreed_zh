<%args>
</%args>

<div class="modal fade" id="upload_seedlot_inventory_dialog" name="upload_seedlot_inventory_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_inventory_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_inventory_dialog">上傳種子批次盤點(Upload Seedlot Inventory)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "upload_seedlot_inventory_workflow" &>
                        <&| /util/workflow.mas:step, title=> "介紹(Intro)" &>
                            <& /page/page_title.mas, title=>"什麼是種子批次盤點？(What is a seedlot inventory?)" &>
                            <ul>
                            <li>種子批次代表封裝於紙袋或容器中的實體種子。</li>
                            <li>這些種子可來自雜交組合或具名種原。</li>
                            <li>種子批次可包含特定地點、箱號、重量（克）和數量。</li>
                            <li>種子批次可屬於育種計畫和機構。</li>
                            <li>種子批次可用於試驗（例如種植在小區中），也可以從小區或植株收穫（例如進行雜交並收集種子）。</li>
                            <li>種子批次盤點包括為您的種子批次指定地點和目前重量（克）。種子批次名稱是每個種子批次的唯一識別碼，因此應編碼在每個種子批次袋上的條碼中。</li>
                            <li>您可以使用「Inventory」Android 應用程式掃描種子批次條碼並記錄重量。如果您不想使用 Inventory 應用程式，也可以自行建立 CSV 檔案並上傳。有關上傳檔案格式的資訊，請前往下一個標籤頁。</li>
                            <li><b>有關「Seed Inventory」Android 應用程式的更多資訊，請造訪 <a href="https://play.google.com/store/apps/details?id=org.wheatgenetics.inventory/">Inventory</a>。</b></li>
                            <li>也可以透過前往種子批次詳細資訊頁面並點擊「新增交易」手動輸入交易記錄。</li>
                            </ul>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "檔案格式(File format)" &>
                            <& /page/page_title.mas, title=>"請確認您收集的種子批次盤點符合以下格式(Make sure you are collecting seedlot inventory in the following format)" &>

                            <p>「Seed Inventory」Android 應用程式預設會匯出完全相同的格式。</p>

                            <br/><br/>
                            <center>
                                <button class="btn btn-info" id="seedlot_upload_inventory_spreadsheet_format_info">檔案格式資訊(Info about file format)</button><br/><br/>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">確認檔案符合格式後，前往下一步(Once you think your file matches, go to Next Step)</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "上傳盤點(Upload inventory)" &>
                            <& /page/page_title.mas, title=>"選擇您的檔案並上傳種子批次盤點(Select your file and upload seedlot inventory)" &>

                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_seedlot_inventory_form" name="upload_seedlot_inventory_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">上傳檔案 (.csv)：</label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="seedlot_uploaded_inventory_file" id="seedlot_uploaded_inventory_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </form>

                            <br/><br/>
                            <center>
                                <button name="upload_seedlot_inventory_button" onclick="Workflow.complete(this, false);" type="button" class="btn btn-primary" >提交(Submit)</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "修正缺失種子批次問題(Fix missing seedlots problem)" &>
                            <& /page/page_title.mas, title=>"修正缺失種子批次的問題(Fixing the missing seedlot(s) problem)" &>

                            <div id="upload_seedlot_inventory_missing_seedlots_div" style="display:none">
                                <div class="well">
                                    <ul>
                                        <li>在更新或新增盤點之前，種子批次必須已存在於資料庫中。原因是盤點不提供有關內容物（具名種原或雜交名稱）的資訊，而此資訊是種子批次存在於資料庫中所必需的。我們在向資料庫新增新種子批次時也需要謹慎，以避免資料與重複項錯誤連結。</li>
                                    </ul>
                                </div>
                                <ul>
                                <li>向資料庫新增種子批次時，您可以上傳 Excel 檔案，也可以一次新增一個種子批次。<br/><br/>
                                    <ul>
                                     <li><button class="btn btn-info" name="seedlot_bulk_upload">上傳 Excel 檔案(Upload Excel file)</button><br/><br/></li>
                                     <li><button class="btn btn-info" name="add_seedlot_button">新增一個種子批次(Add One Seedlot)</button></li>
                                    </ul>
                                </li>
                                </ul><br/>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">所有種子批次皆已存在於資料庫後點擊此處(Once all your seedlots are in the database Click Here)</button><br/><br/>
                            </div>
                            <div id="upload_seedlot_inventory_error_display">

                                <h3>種子批次盤點上傳錯誤訊息(Seedlot Inventory Upload Error Messages)</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <center>
                            <div id="upload_seedlot_inventory_no_error_messages_html">
                            </div>
                            <div name="upload_seedlot_inventory_completed_message">
                            </div>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "再次嘗試提交盤點(Try submitting inventory again)" &>
                            <& /page/page_title.mas, title=>"再次提交您的盤點。此時您應該已經修正了所有錯誤，如果仍有錯誤，請查看下方紅色方框中的錯誤訊息。您可以繼續修改檔案，然後點擊上傳直到成功。(Submit your inventory again. You should have corrected all errors by now, but if not please take a look at the errors in the red box below. You can continue to modify your file and then click Upload until it works.)" &>
                            <div id="seedlot_inventory_upload_show_repeat_upload_button">
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" name="upload_seedlot_inventory_button" >上傳種子批次盤點(Upload Seedlot Inventory)</button><br/><br/>
                                </center>
                            </div>
                            <center>
                            <div name="upload_seedlot_inventory_completed_message">
                            </div>
                            </center>

                            <div id="upload_seedlot_inventory_error_display_second_try" style="display:none">

                                <h3>您的檔案中存在以下問題：</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                            <& /page/page_title.mas, title=>"完成！您的種子批次盤點現已在資料庫中(Finished! Your seedlot inventory is in the database)" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                種子批次盤點檔案已成功上傳
                            </p>

                            <ul>
                                <li>您可能想要前往剛剛更新的種子批次之詳細資訊頁面。</li>
                                <li>您可以為種子批次列印條碼。</li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_inventory_spreadsheet_info_dialog" name="seedlot_upload_inventory_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotInventoryInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotInventoryInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>種子批次可以 CSV 檔案（.csv）上傳</b>
                    <br />
                    （不支援 Excel .xls 及 .xlsx 格式）
                    <br /><br />
                    <b>表頭：</b>
                    <br>
                    第一列（表頭）應包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>box_id</td>
                                <td>seed_id</td>
                                <td>inventory_date</td>
                                <td>inventory_person</td>
                                <td>weight_gram</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <ul>
                    <li>box_id（種子批次所在的箱號名稱，亦稱 box_name。）</li>
                    <li>seed_id（種子批次的唯一識別碼，必須存在於資料庫中，亦稱 seedlot_name）</li>
                    <li>inventory_date（種子批次盤點的時間戳記）</li>
                    <li>inventory_person（執行盤點的人員姓名，可為任意名稱，亦稱 operator_name）</li>
                    <li>weight_gram（種子批次的重量，以克為單位）</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_info_upload_inventory_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery('[name="seedlot_upload_inventory"]').click( function() {
        jQuery('#upload_seedlot_inventory_dialog').modal('show');
    });

    jQuery("#seedlot_upload_inventory_spreadsheet_format_info").click( function () {
        jQuery("#seedlot_upload_inventory_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery('[name="upload_seedlot_inventory_button"]').click(function () {
        upload_seedlot_inventory_button();
    });
    function upload_seedlot_inventory_button() {
        jQuery('#upload_seedlot_inventory_form').attr("action", "/ajax/breeders/seedlot-inventory-upload");
        jQuery("#upload_seedlot_inventory_form").submit();
    }

    jQuery('#upload_seedlot_inventory_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedSeedlotInventoryFile = jQuery("#seedlot_uploaded_inventory_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedSeedlotInventoryFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error){
                alert(response.error);
            }

            if (response.error_string) {
                if (response.missing_seedlots) {
                    jQuery('#upload_seedlot_inventory_missing_seedlots_div').show();
                } else {
                    jQuery('#upload_seedlot_inventory_missing_seedlots_div').hide();
                    var no_missing_seedlot_html = '<button class="btn btn-primary" onclick="Workflow.skip(this);">沒有關於缺失種子批次的錯誤，點擊此處(There were no errors regarding missing seedlots Click Here)</button><br/><br/>';
                    jQuery('#upload_seedlot_inventory_no_error_messages_html').html(no_missing_seedlot_html);
                    Workflow.skip('#upload_seedlot_inventory_missing_seedlots_div', false);
                }
                jQuery("#upload_seedlot_inventory_error_display tbody").html(response.error_string);
                jQuery("#upload_seedlot_inventory_error_display_second_try").show();
                jQuery("#upload_seedlot_inventory_error_display_second_try tbody").html(response.error_string);
            }

            if(response.missing_seedlots){
                Workflow.focus("#upload_seedlot_inventory_workflow", 3);
            } else if(response.error_string){
                Workflow.focus("#upload_seedlot_inventory_workflow", 4);
                jQuery("#upload_seedlot_inventory_error_display_second_try").show();
            }

            if (response.success) {
                jQuery("#upload_seedlot_inventory_error_display_second_try").hide();
                jQuery('#seedlot_inventory_upload_show_repeat_upload_button').hide();
                jQuery('[name="upload_seedlot_inventory_completed_message"]').html('<h3>種子批次盤點已儲存至資料庫，無任何錯誤！</h3><br/><br/>');
                Workflow.skip('#upload_seedlot_inventory_missing_seedlots_div', false);
                Workflow.skip('#upload_seedlot_inventory_error_display_second_try', false);
                Workflow.focus("#upload_seedlot_inventory_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_inventory_workflow");
            }
        }
    });
});
</script>
