<%args>
$trial_id
$trial_name
$trial_description
$identifier_prefix
$drone_run_date => undef
</%args>

<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>成像事件名稱(Imaging Event Name)</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[無成像事件名稱]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>成像事件日期(Imaging Event Date)</b></td>
                <td>
                    <div id="drone_run_date">
% if ($drone_run_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $drone_run_date %>" ><% $drone_run_date %></a>
% } else {
%  print "<span class='text-danger'>[無成像事件日期]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>描述(Description)</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[無描述]</span>";
% }
                    </div>
                </td>
            </tr>

        </table>

    </div>
</div>
