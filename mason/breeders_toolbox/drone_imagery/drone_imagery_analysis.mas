    jQuery('#drone_imagery_calculate_statistics_analysis_save_blups_spatial').click(function(){
        if (manage_drone_imagery_calculate_statistics_field_trial_id_array.length>1) {
            alert('儲存空間 BLUP 目前僅支援單一試驗，因此分析中請僅選取一個田間試驗');
