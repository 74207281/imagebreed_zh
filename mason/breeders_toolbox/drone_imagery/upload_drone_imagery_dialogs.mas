                                    <input type="file" id="drone_run_band_stitched_ortho_report_five_or_ten_agisoft" name="drone_run_band_stitched_ortho_report" encoding="multipart/form-data" />
                                </div>
       
                            </div>
                        </div>

                        <center>
                            <button class="btn btn-primary" 
name="upload_drone_imagery_select_images_five_or_ten_agisoft" id="upload_drone_imagery_select_images_five_or_ten_agisoft">下一步</button>
                        </center>
                    </&>
                    <&|
/util/workflow.mas:step, title=> "送出" &>
                        <& /page/page_title.mas, title=>"送出拍攝批次" &>
                        <center>
                            <button type="submit" class="btn btn-info" name="upload_drone_imagery_five_or_ten_agisoft_submit" id="upload_drone_imagery_five_or_ten_agisoft_submit">送出。請點擊一次並耐心等候，這可能需要很長時間。</button>
                        </center>
                    </&>
                </&>
            </form><br/>
        </div>
      </div>
   
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉</button>
      </div>
    </div>
  </div>
</div>

