<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreederSearch03152022', 'CXGN.Trial03152022', 'moment_min', 'daterangepicker' ] &>

<div class="modal fade" id="upload_drone_imagery_dialog" name="upload_drone_imagery_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadDroneImageryDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadDroneImageryDialog">上傳空拍影像</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" 
id="upload_drone_imagery_form" name="upload_drone_imagery_form" action="/drone_imagery/upload_drone_imagery" >

                <&|
/util/workflow.mas, id=> "drone_imagery_upload_workflow" &>
                    <&|
/util/workflow.mas:step, title=> "簡介" &>
                        <& /page/page_title.mas, title=>"此流程將引導您將空拍影像上傳至資料庫" &>
                        <ul>
                            <li>您的田間試驗必須已存在於資料庫中，才能上傳影像。如果不存在，請前往 <a href="/breeders/trials">管理->田間試驗</a>。</li>
                            <li><b>關於原始影像擷取檔 (Raw Image Captures)</b>：如果您有尚未拼接成完整田間正射影像的原始空拍影像（.TIFF, .JPG, .PNG），應使用 Zip 壓縮檔 (.zip) 上傳。Zip 檔內請包含至少 25 張影像。OpenDroneMap 將用於拼接正射影像和數值地表模型 (DSM)。OpenDroneMap 適用於彩色 RGB 影像和 MicaSense 5 通道多光譜影像。</li>
                            <li><b>關於正射鑲嵌影像 (Orthophotomosaics)</b>：如果您已經有使用外部軟體建立的完整田間正射鑲嵌影像，您可以上傳這些影像。請上傳 .TIFF, .PNG 或 .JPG 格式的正射影像。多光譜相機的正射鑲嵌影像預期應為所有光譜完全重疊。</li>
                        </ul>
                        <hr>
                        <p><b>範例資料：</b> <a href="https://imagebreed.org/static_content/imagebreed/AlfalfaExample35MeterMicasenseAerialDroneFlightRawCaptures.zip" download>MicaSense 5 波段原始擷取檔（未拼接的 TIFF 影像擷取）（上傳 Zip 檔至 ImageBreed 並讓 OpenDroneMap 拼接正射影像和 DSM。）</a></p>
                        <p><b>範例資料：</b> <a href="https://imagebreed.org/static_content/imagebreed/ExampleAerialDroneFlightMicasensePanel.zip" download>MicaSense 5 波段校正板影像（MicaSense 輻射校正板影像。）（上傳 Zip 檔供 ImageBreed 校正 Micasense 原始擷取檔。）</a></p>
                        <p><b>範例資料：</b> <a href="https://imagebreed.org/static_content/imagebreed/AlfalfaExample35MeterMicasenseAerialDroneFlightOrthomosaics.zip" download>MicaSense 5 波段先前已拼接的正射鑲嵌影像（提供的 Zip 檔內含 PNG 檔案。可將每個波段分別上傳至 ImageBreed。）</a></p>
                        <p><b>範例資料：</b> <a href="https://imagebreed.org/static_content/imagebreed/ExampleColorAerialDroneFlightRawCaptures.zip" download>彩色相機原始擷取檔（未拼接的 JPG 影像擷取）（上傳 Zip 檔至 ImageBreed 並讓 OpenDroneMap 拼接正射影像和 DSM。）</a></p>
                        <br/>
                        <center>
 
                        <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">上傳單一拍攝批次</button>
                        <br/><br/>
                        <button class="btn btn-default" id="upload_drone_imagery_bulk_button" >批次上傳拍攝批次</button>
        
                        <br/><br/>
                        <button class="btn btn-default" id="upload_drone_imagery_bulk_previous_button" >批次上傳已處理的拍攝批次（包含 GeoJSON 定義）</button>
                        </center>
                    </&>
 
                    <&|
/util/workflow.mas:step, title=> "田間試驗" &>
                        <& /page/page_title.mas, title=>"選擇您的田間試驗" &>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">公司：</label>
          
                            <div class="col-sm-9" >
                                <div id="upload_drone_image_company_select_div"></div>
                            </div>
                   
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">田間試驗：</label>
                            <div class="col-sm-9" >
        
                                <div id="upload_drone_image_trial_select_div"></div>
                            </div>
                        </div>

                       
                        <div id="upload_drone_image_field_trial_info">
                        </div>

                        <div id="upload_drone_image_field_trial_select_date_continue_div" style="display:none">
                            <div class="form-group">
                   
                                <label class="col-sm-3 control-label">拍攝批次日期與時間（必須在種植日期之後）：</label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="drone_run_date" name="drone_run_date" title="drone_run_date" 
type="text" />
                                </div>
                            </div>
                            <div class="form-group">
          
                                <label class="col-sm-3 control-label">這是否來自溫室、生長箱或固定式相機架設？：</label>
                                <div class="col-sm-9" >
                                
                                    <select class="form-control" id="drone_run_is_fixed_rig" name="drone_run_is_fixed_rig">
                                        <option value="No">否</option>
                                        <option value="Yes">是</option>
           
                                    </select>
                                </div>
                            </div>
               
                        </div>

                        <center>
                        <button class="btn btn-primary" id="upload_drone_image_field_trial_select_date_continue">下一步</button>
                        </center>
             
                    </&>
                    <&|
/util/workflow.mas:step, title=> "拍攝批次" &>
                        <& /page/page_title.mas, title=>"建立新的拍攝批次" &>

                        <table class="table table-bordered table-hover" id="drone_image_upload_drone_runs_table">
                            <thead>
         
                                <tr>
                                    <th>選擇</th>
                                    <th>拍攝批次名稱</th>
   
                                    <th>拍攝批次類型</th>
                                    <th>拍攝批次描述</th>
                           
                                    <th>拍攝批次日期</th>
                                    <th>拍攝批次 GDD</th>
                                    <th>感測器</th>
               
                                    <th>田間試驗名稱</th>
                                    <th>田間試驗描述</th>
                                </tr>
       
                            </thead>
                        </table>

                        <input id="drone_run_id" name="drone_run_id" type="hidden" value=""/>
                        <input id="drone_image_upload_drone_run_band_stitching_odm_image_count" name="drone_image_upload_drone_run_band_stitching_odm_image_count" type="hidden" value=""/>

                        <br/>
                        <div id="drone_image_upload_create_drone_inputs">
      
                            <div class="form-group">
                                <label class="col-sm-3 control-label">拍攝批次名稱（唯一產生）：</label>
                                <div class="col-sm-9" >
    
                                    <input class="form-control" id="drone_run_name" name="drone_run_name" type="text" placeholder="例如：田間試驗名稱 + 飛行日期" disabled/>
                                </div>
                            </div>
                            <div class="form-group">
    
                                <label class="col-sm-3 control-label">拍攝批次類型：</label>
                                <div class="col-sm-9" >
                                  
                                    <select class="form-control" id="drone_run_type" name="drone_run_type">
                                        <option value="">請選擇</option>
                                        <option value="Aerial Medium to High Res">中高解析度空拍影像</option>
  
                                        <option value="Aerial Low Res">低解析度空拍影像</option>
                                    </select>
                   
                            </div>
                            </div>
                            <div class="form-group">
                              
                                <label class="col-sm-3 control-label">感測器類型：</label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="drone_image_upload_camera_info" name="drone_image_upload_camera_info">
                      
                                        <option value="">請選擇</option>
                                        <option value="micasense_5">Micasense 5 通道相機</option>
                                     
                                        <option value="micasense_10">Micasense 10 通道相機</option>
                                        <option value="ccd_color">RGB 彩色相機</option>
                                        <option value="interpolated_elevation">內插海拔影像</option>
                                        <option value="em38_interpolated_ch1.0m">EM38 內插 CH1.0m 影像</option>
                    
                                        <option value="em38_interpolated_ch0.5m">EM38 內插 CH0.5m 影像</option>
                                        <option value="em38_interpolated_ih1.0m">EM38 內插 IH1.0m 影像</option>
                                
                                        <option value="em38_interpolated_ih0.5m">EM38 內插 IH0.5m 影像</option>
                                    </select>
                                </div>
                    
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">拍攝載具： <button class="btn btn-sm btn-default" name="drone_run_imaging_vehicle_add_new" type="button">新增載具</button></label>
                    
                                <div class="col-sm-9" >
                                    <div id="drone_run_imaging_vehicle_div"></div>
                                </div>
                 
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">拍攝載具電池組：</label>
                       
                                <div class="col-sm-9" >
                                    <div id="drone_run_imaging_vehicle_battery_div"></div>
                                </div>
                    
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">拍攝批次描述（例如：飛行高度、飛行計畫名稱、整體天氣狀況）：</label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="drone_run_description" name="drone_run_description" type="text" />
                 
                                </div>
                            </div>
                        </div>
                        <div id="drone_image_upload_create_drone_inputs_fixed_camera" style="display:none">
       
                            <div class="form-group">
                                <label class="col-sm-3 control-label">固定式相機架設名稱（用於溫室或生長箱等固定架設）（若不適用請留空）：</label>
                           
                                <div class="col-sm-9" >
                                    <input class="form-control" id="drone_run_camera_rig_description" name="drone_run_camera_rig_description" title="drone_run_camera_rig_description" type="text" />
                                </div>
                   
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">基準日期與時間（用於溫室或生長箱等固定架設）（當固定相機架設捕捉田間試驗的不同部分，且捕捉時間未同步但間隔相同時很有用。可設為該架設的第一張影像時間。）（若不適用請留空）：</label>
                                <div class="col-sm-9" >
                  
                                    <input class="form-control" id="drone_run_base_date" name="drone_run_base_date" title="drone_run_base_date" type="text" />
                                </div>
                            </div>
                
                        </div>
                        <br/>

                        <center>
                        <button class="btn btn-primary" id="drone_image_upload_drone_run_continue">下一步</button>
              
                        </center>
                    </&>
                    <&|
/util/workflow.mas:step, title=> "影像資訊" &>
                        <& /page/page_title.mas, title=>"上傳影像類型" &>

                        <div class="well">
                            <center><h4>上傳已拼接的田間實驗正射鑲嵌影像或完整影像</h4></center>
   
                            <ul>
                                <li>您可以選擇上傳使用外部軟體（Pix4d, Agisoft, ODM 等）建立的正射鑲嵌影像 (PNG, TIFF)。</li>
                           
                                <li>您可以上傳任何覆蓋整個實驗田區的影像 (PNG, TIFF, JPEG)，例如用於海拔或導電度 EC 測量的內插土壤數據。另一個例子是來自表型設施、溫室或生長箱的影像。</li>
                                <li>最多可上傳七個不同的光譜波段影像。</li>
                                <li>多光譜相機的正射鑲嵌影像預期應為所有光譜完全重疊。</li>
    
                            </ul>
                        </div>
                        <div class="well">
                           
                            <center><h4>上傳原始影像以使用 OpenDroneMap 拼接</h4></center>
                            <ul>
                                <li>您可以上傳來自 MicaSense 5 通道相機或彩色相機的原始影像 (PNG, TIFF, JPEG)（例如從無人機採集的），然後使用 OpenDroneMap 建立正射鑲嵌影像並儲存在 ImageBreed 中。</li>
                                <li>原始影像使用 Zip 壓縮檔 (.zip) 上傳。請將與該拍攝批次相關的所有影像放入一個 zip 檔中。Zip 檔內請包含至少 25 張影像。</li>
                                <li>請確保影像重疊率 >75%，以便正確拼接影像。</li>
                                <li>數值地表模型 (DSM) 也將生成並儲存為黑白影像。DSM 代表物體的高度。</li>
                            </ul>
                        </div>

                        <div class="form-group">
            
                            <label class="col-sm-3 control-label">您是否要上傳實驗田區的正射鑲嵌影像或完整影像？：</label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="drone_image_upload_drone_run_band_stitching" name="drone_image_upload_drone_run_band_stitching">
       
                                    <option value="">請選擇</option>
                                    <option value="no">是，我要上傳已拼接的正射影像或完整影像</option>
%  if ($c->config->{enable_opendronemap}) {
                    
                                    <option value="yes_open_data_map_stitch">否，我要上傳原始影像 Zip 檔並在 ImageBreed 內使用 OpenDroneMap 拼接</option>
%  } else {
                                    <option value="yes_open_data_map_stitch" disabled>否，我要上傳原始影像 Zip 檔並在 ImageBreed 內使用 OpenDroneMap 拼接（您的系統未設定此功能。請檢查 Docker 部署說明）</option>
%  }
                                </select>
                            </div>
                        </div>
           
                        <div class="form-group" id="drone_run_upload_drone_run_band_number_div">
                            <label class="col-sm-3 control-label">要上傳的光譜波段（影像組）數量：</label>
                            <div class="col-sm-9" >
                  
                                <select class="form-control" id="drone_run_band_number" name="drone_run_band_number">
                                    <option value="">請選擇</option>
                                    <option value="one_bw">單張黑白影像</option>
    
                                    <option value="one_rgb">單張 RGB 彩色影像</option>
                                    <option value="1">一個光譜波段或 DSM 網格</option>
                      
                                    <option value="2">兩個獨立光譜波段和/或 DSM 網格</option>
                                    <option value="3">三個獨立光譜波段和/或 DSM 網格</option>
                                    
                                    <option value="4">四個獨立光譜波段和/或 DSM 網格</option>
                                    <option value="5">五個獨立光譜波段</option>
                                    <option value="6">六個獨立光譜波段和/或 DSM 網格</option>
          
                                    <option value="7">七個獨立光譜波段和/或 DSM 網格</option>
                                    <option value="8">八個獨立光譜波段和/或 DSM 網格</option>
                        
                                    <option value="9">九個獨立光譜波段和/或 DSM 網格</option>
                                    <option value="10">十個獨立光譜波段和/或 DSM 網格</option>
                                    <option value="11">十一個獨立光譜波段和/或 DSM 網格</option>
                                </select>
                            </div>
                        </div>
           
                        <div class="form-group" id="drone_run_upload_drone_run_band_image_type_div">
                            <label class="col-sm-3 control-label">正射鑲嵌影像產自：</label>
                            <div class="col-sm-9" >
                       
                                <select class="form-control" id="drone_run_upload_drone_run_band_image_type" name="drone_run_upload_drone_run_band_image_type">
                                    <option value="">請選擇</option>
                                    <option value="None">無</option>
             
                                    <option value="Pix4D">Pix4D（獨立波段影像）</option>
                                    <option value="Agisoft">Agisoft（多波段堆疊影像）</option>
                                 
                                    <option value="ODM">OpenDroneMap（多波段堆疊影像）</option>
                                    <option value="Other">其他</option>
                                </select>
                        
                            </div>
                        </div>

                        <center>
                        <button class="btn btn-primary" id="drone_image_upload_drone_run_band_continue">下一步</button>
                  
                        </center>
                    </&>

                </&>

                <div id="upload_drone_imagery_verify_status"></div>
            </form><br/>
        </div>
      </div>
      <div class="modal-footer">
        
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="upload_drone_imagery_dialog_odm" name="upload_drone_imagery_dialog_odm" tabindex="-1" role="dialog" aria-labelledby="uploadDroneImageryODMDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadDroneImageryODMDialog">上傳空拍影像</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <& 
/page/page_title.mas, title=>"選擇要上傳的影像" &>

            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_drone_imagery_odm_form" name="upload_drone_imagery_odm_form" action="/drone_imagery/upload_drone_imagery" >
                <input type="hidden" name="drone_run_field_trial_id" value="" >

                <input type="hidden" 
name="drone_run_id" value=""/>
                <input type="hidden" name="drone_image_upload_drone_run_band_stitching_odm_image_count" value=""/>

                <input type="hidden" name="private_company_id" value="" />
                <input type="hidden" name="drone_run_name" value="" />
                <input type="hidden" name="drone_run_type" value="" />
                <input type="hidden" name="drone_image_upload_camera_info" value="" 
/>
                <input type="hidden" name="drone_run_imaging_vehicle_id" value="" />
                <input type="hidden" name="drone_run_imaging_vehicle_battery_name" value="" />
                <input type="hidden" name="drone_run_description" value="" />
                <input type="hidden" name="drone_run_date" value="" />
                <input type="hidden" name="drone_run_camera_rig_description" value="" 
/>
                <input type="hidden" name="drone_run_base_date" value="" />
                <input type="hidden" name="drone_image_upload_drone_run_band_stitching" value="" />
                <input type="hidden" name="drone_image_upload_drone_run_band_type" value="" />
                <input type="hidden" name="drone_run_band_number" value="" />

                <&|
/util/workflow.mas, id=> "drone_imagery_upload_workflow_odm" &>
                    <&|
/util/workflow.mas:step, title=> "選擇影像" &>
                        <& /page/page_title.mas, title=>"選擇原始影像 Zip 檔" &>

                        <div class="well well-sm">
                            <div class="form-group">
           
                                <label class="col-sm-6 control-label">拍攝批次影像 Zip 檔 (.zip)（至少 25 張影像）：</label>
                                <div class="col-sm-6" >
                                  
                                    <input type="file" id="upload_drone_images_zipfile_odm" name="upload_drone_images_zipfile" encoding="multipart/form-data" />
                                </div>
                            </div>

                            </div>
                        <center>
                       
                            <button class="btn btn-primary" id="upload_drone_imagery_select_images_odm" name="upload_drone_imagery_select_images_odm">下一步</button>
                        </center>
                    </&>
                    <&|
/util/workflow.mas:step, title=> "送出" &>
                        <& /page/page_title.mas, title=>"送出拍攝批次以使用 OpenDroneMap 處理" &>
                        <center>
                            <button type="submit" class="btn btn-info" name="upload_drone_imagery_odm_submit" id="upload_drone_imagery_odm_submit">送出。請點擊一次並耐心等候，這可能需要很長時間。</button>
                        </center>
                    </&>
                </&>
            </form><br/>
        </div>
      </div>
   
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="upload_drone_imagery_dialog_odm_micasense" name="upload_drone_imagery_dialog_odm_micasense" tabindex="-1" role="dialog" aria-labelledby="uploadDroneImageryODMMicaSenseDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadDroneImageryODMMicaSenseDialog">上傳空拍影像</h4>
      </div>
      <div class="modal-body">
