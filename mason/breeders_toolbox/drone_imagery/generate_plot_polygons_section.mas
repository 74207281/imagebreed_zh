<%args>
$id_extension => ''
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="well well-sm">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">列數：</label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_rows<% $id_extension %>" name="drone_imagery_plot_polygons_num_rows<% $id_extension %>" type="number" placeholder="影像區段中的列數" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">行數：</label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_cols<% $id_extension %>" name="drone_imagery_plot_polygons_num_cols<% $id_extension %>" type="number" placeholder="影像區段中的行數"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4>點選感興趣區域的四個角落：</h4>

                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_left_click<% $id_extension %>">點選左上角(Click Top Left Corner)</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_right_click<% $id_extension %>">點選右上角(Click Top Right Corner)</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_left_click<% $id_extension %>">點選左下角(Click Bottom Left Corner)</button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_right_click<% $id_extension %>">點選右下角(Click Bottom Right Corner)</button>
                </div>
            </div>
            <hr>
        
            <&| /page/info_section.mas, title => '範本參數(Template Parameters)', collapsible=>1, collapsed => 1, subtitle=> '檢視並編輯範本參數。這些參數可使用上方的按鈕點選自動填入' &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最左行頂部邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最左行底部邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最頂列左側邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" type="number" placeholder="影像區段左側偏移量" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最頂列右側邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" type="number" placeholder="影像區段右側偏移量" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最底列左側邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" type="number" placeholder="影像區段左側偏移量" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">最右行底部邊界：</label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" type="number" placeholder="最右行底部偏移量" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </&>

            <br/>
            <button class="btn btn-sm btn-primary" id="drone_imagery_plot_polygons_rectangles_apply<% $id_extension %>">繪製小區多邊形範本(Draw Plot Polygon Template) (未儲存。如有需要可套用多個範本。)</button>

        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4>或貼上先前使用過的範本：</h4>
                </div>
            </div>

            <&| /page/info_section.mas, title => '先前使用過的小區多邊形範本(Previously Used Plot Polygon Templates)', collapsible=>1, collapsed => 1, subtitle=> '檢視並使用先前在此田間試驗中使用過的小區多邊形範本' &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label">此田間試驗先前使用過的小區多邊形範本：</label>
                                    <div class="col-sm-6">
                                        <div id="plot_polygons_previously_saved_plot_polygon_templates<% $id_extension %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <button class="btn btn-primary" id="plot_polygons_use_previously_saved_template<% $id_extension %>">繪製小區多邊形範本(Draw Plot Polygon Template) (未儲存)</button>
                </div>
            </&>
        </div>
    </div>

    <div id="drone_imagery_plot_polygons_active_templates<% $id_extension %>"></div>

</div>
