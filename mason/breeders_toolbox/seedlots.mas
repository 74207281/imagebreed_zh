
<%args>
$timestamp
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$programs
$locations
$crossing_trials
$user_role => undef
</%args>

<& /page/page_title.mas, title=>"可用種子批次(Available Seedlots)" &>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.Accessions03152022', 'CXGN.BreedersToolbox.UploadPedigrees03152022', 'CXGN.BreedersToolbox.Crosses03152022' ] &>

<&| /page/info_section.mas, title=>"關於種子批次(About Seedlots)",  collapsible => 1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <b><p>什麼是種子批次？</p></b>
                <ul>
                <li>種子批次代表封裝於紙袋或容器中的實體種子。</li>
                <li>這些種子可來自雜交組合或具名種原。</li>
                <li>種子批次可包含特定地點、箱號、重量（克）和數量。</li>
                <li>種子可以移入或移出種子批次，例如從種子批次移入小區。</li>
                <li>種子批次可屬於育種計畫和機構。</li>
                </ul>

                <b><p>如何盤點我的種子？</p></b>
                <ul>
                <li>1) 確保您的種子批次已在資料庫中。使用「新增種子批次」新增單一種子批次，或使用「上傳種子批次」批量新增。</li>
                <li>2) 確保您的種子批次已印製條碼。您可以從資料庫列印這些條碼。</li>
                <li>3) 使用「Inventory」Android 應用程式掃描種子批次條碼並記錄重量。然後在管理種子批次頁面上點擊「上傳盤點」將此資訊上傳到資料庫中。如果您不想使用 Inventory Android 應用程式，也可以自行建立 CSV 檔案並上傳。</li>
                <li><b>有關「Seed Inventory」Android 應用程式的更多資訊，請造訪 <a href="https://play.google.com/store/apps/details?id=org.wheatgenetics.inventory/">Inventory</a>。</b></li>
                <li>也可以透過前往種子批次詳細資訊頁面並點擊「新增交易」手動輸入交易記錄。</li>
                </ul>
            </div>
        </div>
    </div>
</&>

<%perl>
    my $seedlot_subtitle = !!$c->user()
        ? '<div class="btn-group"><button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">建立種子批次(Create Seedlot(s))&nbsp;<span class="caret"></span></button><ul class="dropdown-menu"><li><a href="#" name="add_seedlot_button">新增種子批次(Add New Seedlot)</a></li><li><a href="#" name="seedlot_bulk_upload">上傳種子批次(Upload Seedlots)</a></li><li><a href="#" name="create_seedlots_trial_button">從試驗建立種子批次(Create Seedlots from Trial)</a></li></ul></div> <button class="btn btn-sm btn-primary" style="margin:3px" name="seedlot_upload_inventory">上傳盤點(Upload Inventory)</button>'
        : "請登入以新增或上傳種子批次";
</%perl>
<&| /page/info_section.mas, title=>"種子批次(Seedlots)",  collapsible => 1, subtitle => $seedlot_subtitle &>

<br/>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">

<&| /page/info_section.mas, title=>"搜尋種子批次(Search Seedlots)",  collapsible => 1, collapsed=>0 &>

<div class="well well-sm">
    <form class="form-horizontal" id="search_seedlot_form" name="search_seedlot_form">
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">種子批次名稱：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_seedlot_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">公司：</label>
            <div class="col-sm-9" >
                <div id="select_seedlot_private_company_div"></div>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">育種計畫：</label>
            <div class="col-sm-9" >
                <div id="select_seedlot_breeding_program_div"></div>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">地點：</label>
            <div class="col-sm-9" >
                <div id="select_seedlot_location_div"></div>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">內容（種原唯一名稱）：</label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_accession" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_accession" value="1">
              <label class="form-check-label" for="exact_accession">精確比對</label>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">內容（雜交唯一識別碼）：</label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_cross" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_cross" value="1">
              <label class="form-check-label" for="exact_cross">精確比對</label>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">箱號名稱：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_box_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">最少數量：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_count" type="number" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">最少重量 (克)：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_weight" type="number" />
            </div>
        </div>

	<!-- div class="form-group form-group-sm">
	  <label class="col-sm-3 control-label"></label>
          <div class="col-sm-9" >
	    <input id="search_seedlot_form_only_good_quality_checkbox" type="checkbox" /> Only show seedlots without quality issues
          </div>
        </div  -->

	<div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">品質：</label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_quality" type="text" />
            </div>
        </div>

    </form>
    <center>
    <button class="btn btn-primary" id="submit_seedlot_search" />搜尋(Search)</button>
    </center>
</div>
</&>

<br/>

<table id="available_seedlots_table" class="table table-hover table-striped table-bordered">
</table>

<hr>

<div id="available_seedlots_to_list" style="display:none">
</div>
<div id="available_seedlots_add_to_list">
</div>

        </div>
    </div>
</div>
</&>

<& /breeders_toolbox/upload_seedlots_inventory_dialogs.mas &>
<& /breeders_toolbox/upload_seedlots_dialogs.mas &>
<& /breeders_toolbox/add_seedlot_dialogs.mas, timestamp=>$timestamp &>
<& /breeders_toolbox/add_accessions_dialogs.mas, preferred_species=>$preferred_species, editable_stock_props=>$editable_stock_props, editable_stock_props_definitions=>$editable_stock_props_definitions &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, programs=>$programs, locations=>$locations, crossing_trials=>$crossing_trials &>
<& /breeders_toolbox/cross/add_cross_dialogs.mas, programs=>$programs, locations=>$locations, crossing_trials=>$crossing_trials &>
<& /breeders_toolbox/cross/add_crossing_trial_dialogs.mas, programs=>$programs, locations=>$locations &>
<& /breeders_toolbox/create_seedlots_from_trial_dialogs.mas &>
<& /breeders_toolbox/delete_seedlots.mas, user_role => $user_role &>

<script>
jQuery(document).ready(function(){

    get_select_box('private_companies', 'select_seedlot_private_company_div', { 'name': 'select_private_company_id', 'id': 'select_private_company_id' });
    get_select_box('breeding_programs', 'select_seedlot_breeding_program_div', { 'name' : 'search_seedlot_form_breeding_program', 'id' : 'search_seedlot_form_breeding_program', 'names_as_values':1 });
    get_select_box('locations', 'select_seedlot_location_div', { 'name' : 'search_seedlot_form_location', 'id' : 'search_seedlot_form_location', 'names_as_values':1 });

    jQuery(document).on('change', '#select_private_company_id', function(){
        get_select_box('breeding_programs', 'select_seedlot_breeding_program_div', { 'name' : 'search_seedlot_form_breeding_program', 'id' : 'search_seedlot_form_breeding_program', 'names_as_values':1, 'private_company_id':jQuery(this).val() });
        get_select_box('locations', 'select_seedlot_location_div', { 'name' : 'search_seedlot_form_location', 'id' : 'search_seedlot_form_location', 'names_as_values':1, 'private_company_id':jQuery(this).val() });
    });

    jQuery("#search_seedlot_form_seedlot_name").autocomplete({
       source: '/ajax/stock/seedlot_name_autocomplete',
    });

    var seedlots_table = jQuery('#available_seedlots_table').DataTable({
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'lengthMenu': [10,20,50,100,1000],
        'ajax': { 'url': '/ajax/breeders/seedlots',
                  'data': function(d) {
                     d.seedlot_name  = jQuery('#search_seedlot_form_seedlot_name').val();
                     d.breeding_program = jQuery('#search_seedlot_form_breeding_program').val();
                     d.minimum_count   = jQuery('#search_seedlot_form_minimum_count').val();
                     d.minimum_weight   = jQuery('#search_seedlot_form_minimum_weight').val();
                     d.location     = jQuery('#search_seedlot_form_location').val();
                     d.box_name = jQuery('#search_seedlot_form_box_name').val();
                     d.contents_accession = jQuery('#search_seedlot_form_contents_accession').val();
                     d.contents_cross = jQuery('#search_seedlot_form_contents_cross').val();
                     d.exact_accession = jQuery('#exact_accession').is(":checked") ? 1 : 0;
                     d.exact_cross = jQuery('#exact_cross').is(":checked") ? 1 : 0;
                     d.quality = jQuery('#search_seedlot_form_quality').val();
                     d.private_company_id = jQuery('#select_private_company_id').val();
                     d.only_good_quality = jQuery('#search_seedlot_form_only_good_quality_checkbox').is(":checked") ? 1 : 0;
                }
        },
        columns: [
            { title: "種子批次名稱(Seedlot Name)", "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/seedlot/"+row.seedlot_stock_id+"'>"+row.seedlot_stock_uniquename+"</a>"; } },
            { title: "公司(Company)", "data": null, "render": function ( data, type, row ) { return "<a href='/company/"+row.private_company_id+"'>"+row.private_company_name+"</a>"; } },
            { title: "育種計畫(Breeding Program)", "data": "breeding_program_name" },
            { title: "內容(Contents)", "data": "contents_html" },
            { title: "地點(Location)", "data": "location" },
            { title: "數量(Count)", "data": "count" },
            { title: "重量 (克)(Weight (g))", "data": "weight_gram" },
            { title: "提交者(Submitters)", "data": "owners_string" },
            { title: "機構(Organization)", "data": "organization" },
            { title: "箱號(Box)", "data": "box" },
            { title: "品質(Quality)", "data": "seedlot_quality" },
            { title: "刪除(Delete)", "data": "null", "render": function ( data, type, row ) { return "<a onclick='removeSeedlot("+row.seedlot_stock_id+")' >X</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            if (!isLoggedIn()) {
                jQuery('#available_seedlots_add_to_list').html("<div class='well well-sm'><h4>請登入以使用清單！</h4></div>");
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].seedlot_stock_uniquename+"\n";
                }
                jQuery("#available_seedlots_to_list").html(html);
                addToListMenu("available_seedlots_add_to_list", "available_seedlots_to_list", {
                    selectText: true,
                    listType: 'seedlots',
                    listName: 'seedlots'
                });
            }
        }
    });

    jQuery('#submit_seedlot_search').click( function() {
        seedlots_table.search("available_seedlots_table").draw();
    });

    jQuery('#search_seedlot_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#submit_seedlot_search').click();
        }
    });

});

function removeSeedlot(seedlot_stock_id){
    if (confirm("您確定要刪除此種子批次嗎？")){
        jQuery.ajax({
            url: '/ajax/breeders/seedlot/'+seedlot_stock_id+'/delete',
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert("該種子批次已刪除。");
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('刪除種子批次時發生錯誤');
            }
        });
    }
}

</script>
