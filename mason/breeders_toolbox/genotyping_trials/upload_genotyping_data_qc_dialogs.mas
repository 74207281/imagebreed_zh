<%args>
$facilities
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial08232022' ] &>

<div class="modal fade" id="upload_genotypes_qc_dialog" name="upload_genotypes_qc_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypesQCDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypesQCDialog">上傳基因型品管(Upload Genotypes QC)</h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotypes_qc_form" name="upload_genotypes_qc_form" action="/ajax/genotype_qc/upload">

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "upload_genotypes_qc_workflow" &>
                            <&| /util/workflow.mas:step, title=> "簡介(Intro)" &>
                                <& /page/page_title.mas, title=>"此工作流程將引導您進行基因型品管(This Workflow Will Guide You Through Genotype QC)" &>

                                <ul>
                                    <li>基因型品管不會將您的基因型儲存至資料庫中，僅會針對資料庫中已儲存的基因分型通訊協定進行比對掃描。</li>
                                    <li>若要將資料實際儲存至資料庫，請使用「上傳基因分型資料」。</li>
                                    <li>標記名稱應完全符合您要比對的標記名稱，而非其他 ID</li>
                                </ul>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "基因分型通訊協定(Genotype Protocol)" &>
                                <& /page/page_title.mas, title=>"選取您要比對的基因分型通訊協定(Select The Genotyping Protocol You Want To Compare Against)" &>

                                <ul>
                                    <li>在資料庫中選取您要比對基因型的基因分型通訊協定。</li>
                                </ul>
                                <br/><br/>

                                <div id="genotype_qc_selected_protocol">
                                </div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "基因型資訊(Genotype Info)" &>
                                <& /page/page_title.mas, title=>"提供基因型資訊(Provide Genotype Information)" &>
                                <br/><br/>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                            <p>
                                                <b>檔案格式資訊</b>
                                                <br>
                                                <a id="upload_genotype_qc_spreadsheet_info_format">檔案格式(File Format)</a>
                                            </p>
                                        </&>
                                    </div>
                                    <div class="col-sm-8">
                                        <br/>
                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="form-group">
                                                    <label class="col-sm-6 control-label">選取檔案：</label>
                                                    <div class="col-sm-6">
                                                        <input type="file" name="upload_genotype_qc_file_input" id="upload_genotype_qc_file_input" encoding="multipart/form-data" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" id="genotype_qc_upload_submit_button">送出(Submit)</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "結果(Results)" &>
                                <& /page/page_title.mas, title=>"您的檔案中樣本與所選通訊協定已儲存基因型之間的相似性矩陣(A Similarity Matrix Between Samples And Saved Genotypes)" &>

                                <div id="genotype_qc_result_div"></div>

                            </&>
                        </&>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_genotype_qc_spreadsheet_info_format_dialog" name="upload_genotype_qc_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypeQCInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypeQCInfoDialog">上傳基因型品管範本資訊(Upload Genotype QC Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>此功能用於上傳基因型品管資料。</b>
                    <br/>
                    <b>請使用 CSV 格式檔案</b>
                    <p>
                    <br />
                    <b>標頭：</b>
                    <br>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>SampleName.LabID</td>
                                <td>每個標記名稱獨立一欄（例如 S12_7926132）</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_qc_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery('button[name=upload_genotyping_data_qc_link]').click(function(){
        jQuery('#upload_genotypes_qc_dialog').modal('show');
    });

    get_select_box('genotyping_protocol','genotype_qc_selected_protocol', {'empty':'1', 'id':'genotype_qc_protocol_id', 'name':'genotype_qc_protocol_id'});

    jQuery('#upload_genotype_qc_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_qc_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotype_qc_upload_submit_button').click(function () {
        submit_genotype_data_qc_upload()
    });

    function submit_genotype_data_qc_upload() {
        jQuery('#working_modal').modal('show');
        jQuery("#upload_genotypes_qc_form").submit();
    }

    jQuery('#upload_genotypes_qc_form').iframePostForm({
        json: true,
        post: function () {
        },
        complete: function (response) {
            //console.log(response);
            jQuery('#working_modal').modal('hide');
            if (response.success) {

                var html = '<table class="table table-hover"><thead><tr><th>檔案中的樣本(Samples In File)</th>';
                for(var i=0; i<response.protocol_stock_names.length; i++) {
                    html = html + '<th>'+response.protocol_stock_names[i]+'</th>';
                }
                html = html + '</tr></thead><tbody>';
                for(var j=0; j<response.users_stock_names.length; j++) {
                    html = html + '<tr><td>'+response.users_stock_names[j]+'</td>';
                    for(var k=0; k<response.protocol_stock_names.length; k++) {
                        var distance = response.distance_matrix[response.users_stock_names[j]][response.protocol_stock_names[k]];
                        html = html + '<td>'+distance+'</td>';
                    }
                    html = html + '</tr>';
                }
                html = html + '</tbody></table>';
                jQuery('#genotype_qc_result_div').html(html);

                Workflow.complete('#genotype_qc_upload_submit_button');
                Workflow.focus("#upload_genotypes_qc_workflow", 3);
            }
        }
    });

});
</script>
