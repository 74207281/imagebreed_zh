<%args>
$facilities => ();
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial08232022' ] &>


<div class="modal fade" id="genotyping_trial_dialog" name="genotyping_trial_dialog" tabindex="-1" role="dialog" aria-labelledby="addGenoTrialDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addGenoTrialDialog">新增基因分型微孔盤(Add Genotyping Plate)</h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotyping_trials_form" name="upload_genotyping_trials_form">

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "genotyping_trial_create_workflow" &>
                            <&| /util/workflow.mas:step, title=> "簡介(Intro)" &>
                                <& /page/page_title.mas, title=>"此工作流程將引導您在資料庫中新增基因分型微孔盤(This Workflow Will Guide You Through Adding A Genotyping Plate In The Database)" &>
                                <p>基因分型微孔盤代表 96 或 384 孔微孔盤。</p>
                                <p>每個微孔盤都有全域唯一的微孔盤 ID。</p>
                                <p>微孔盤中的每個孔位都有全域唯一的組織樣本 ID。</p>
                                <p>每個孔位的「內容物」可以是組織樣本、植株名稱、小區名稱或品系名稱。此「來源」名稱必須已存在於資料庫中。如果您提供田間試驗實體（例如小區、植株或組織樣本名稱），這將有助於直接比較表型與基因型。</p>
                                <p>如果您選擇將基因分型微孔盤送交至基因分型機構（Cornell IGD、Intertek 等），我們可以為您產生他們所需的檔案。請注意他們的要求，例如空白孔位位置和濃度。</p>
                                <p>除了樣本 ID 外，您還可以選擇為每個孔位納入機構識別碼。</p>
                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "基因分型專案(Genotyping Project)" &>
                                <& /page/page_title.mas, title=>"選取基因分型專案(Select A Genotyping Project)" &>
                                <p>基因分型專案用於將基因分型微孔盤和／或基因分型資料分組在一起。如果您有廠商專案，基因分型專案應與之相符。</p>
                                <center>
                                    <button class="btn btn-info" name="create_genotyping_project_link">若您需要建立基因分型專案，請點擊此處(If you need to create a genotyping project, click here)</button><br/><br/>
                                    <button id="next_step_creating_genotyping_plates" class="btn btn-primary" onclick="Workflow.complete(this);">取得基因分型專案後，前往下一步(Once you have a genotyping project, go to Next Step)</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "微孔盤基本資訊(Basic Plate Info)" &>
                                <& /page/page_title.mas, title=>"提供關於微孔盤的資訊(Provide Info About Your Plate)" &>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型專案名稱：</label>
                                    <div class="col-sm-7">
                                        <span id="plate_genotyping_project_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型微孔盤 ID：<br/><small>-在 Coordinate App 中此稱為「微孔盤名稱」<br/>-這是微孔盤的全域唯一名稱</small></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="genotyping_trial_name" name="genotyping_trial_name" type="text" placeholder="例如 18DNA00001"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">公司：</label>
                                    <div class="col-sm-7">
                                        <span id="company_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型微孔盤之育種計畫：</label>
                                    <div class="col-sm-7">
                                        <span id="breeding_program_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型微孔盤之位置：</label>
                                    <div class="col-sm-7">
                                        <span id="location_select_div"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">微孔盤格式：</label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_plate_format">
                                            <option value="96">96 孔</option>
                                            <option value="384">384 孔</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">樣本類型：</label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_plate_sample_type">
                                            <option value="DNA">DNA</option>
                                            <option value="RNA">RNA</option>
                                            <option value="Tissue">組織</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型微孔盤描述（選填）：</label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="genotyping_trial_description" name="genotyping_trial_description" maxlength="250"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">納入基因分型機構產生的識別碼<br/>（僅適用於上傳選項）：<br/></label>
                                    <div class="col-sm-7">
                                        <input type="checkbox" id="upload_include_facility_identifiers" name="upload_include_facility_identifiers" >
                                    </div>
                                </div>
                                <br/>
                                <center>
                                    <button id="plate_info_intro_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "孔位資訊(Well Info)" &>
                                <& /page/page_title.mas, title=>"提供微孔盤中孔位的相關資訊(Provide Information About The Wells In Your Plate)" &>
                                <br/>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label text-align: right">請選擇一項：</label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="genotyping_trial_well_input_option">
                                            <option value="">請選取您要上傳的檔案格式</option>
                                            <option value="xls">我要上傳在 Excel 中製作的微孔盤設計</option>
                                            <option value="coordinate">我要上傳預設 Coordinate Android 應用程式微孔盤設計</option>
                                            <option value="coordinate_template">我要上傳自訂 Coordinate Android 應用程式微孔盤設計</option>
                                            <option value="design">我需要設計一個全新的微孔盤</option>
                                        </select>
                                    </div>
                                </div>
                                <br/><br/>

                                <div id="genotyping_trial_well_upload_section" style="display:none">
                                    <h3>您想要上傳現有的微孔盤配置</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                                    <p>
                                                        <b>檔案格式資訊</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_spreadsheet_info_format">試算表格式(Spreadsheet Format)</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">選取微孔盤配置 XLS 檔案：</label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload" id="genotyping_trial_layout_upload" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_coordinate_upload_section" style="display:none">
                                    <h3>您想要上傳 Coordinate Android 應用程式檔案。</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                                    <p>
                                                        <b>檔案格式資訊</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_coordinate_spreadsheet_info_format">試算表格式(Spreadsheet Format)</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">選取 Coordinate CSV 檔案：</label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload_coordinate" id="genotyping_trial_layout_upload_coordinate" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_coordinate_template_upload_section" style="display:none">
                                    <h3>您想要上傳自訂 Android 應用程式檔案。</h3>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                                    <p>
                                                        <b>檔案格式資訊</b>
                                                        <br>
                                                        <a id="genotyping_trial_layout_upload_coordinate_custom_spreadsheet_info_format">試算表格式(Spreadsheet Format)</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">選取 Coordinate CSV 檔案：</label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="genotyping_trial_layout_upload_coordinate_template" id="genotyping_trial_layout_upload_coordinate_template" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="genotyping_trial_well_design_section" style="display:none">
                                    <h3>您想要設計一個全新的微孔盤。</h3>
                                    <div class="well well-sm">
                                        <ul>
                                            <li>選取要放入每個孔位之來源材料的清單。您的清單應與每個孔位一對一配對，例如若要填滿 95 個孔位，您應提供包含 95 個項目的清單。</li>
                                            <li>注意：來源觀察單位的偏好順序為：組織樣本、植株、小區或品系</li>
                                        </ul>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-7 control-label">來源觀察單位清單：</label>
                                        <div class="col-sm-5">
                                            <span id="accession_select_box_span">[載入中...]</span>
                                        </div>
                                    </div>
                                    <br/>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>空白孔位：<small>(Cornell IGD 要求特定孔位為空白。)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_blank_well" name="genotyping_blank_well" type="text" placeholder="e.g. A01"/>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>孔位濃度 (ng/ul)：<small>(若所有孔位使用相同濃度)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_concentration" name="genotyping_well_concentration" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>孔位體積 (ul)：<small>(若所有孔位使用相同體積)</small></label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_volume" name="genotyping_well_volume" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>組織：<small>(若所有孔位使用相同組織)</small> </label>
                                        <div class="col-sm-5">
                                            <select class="form-control" id="genotyping_well_tissue">
                                                <option value="leaf">葉(Leaf)</option>
                                                <option value="root">根(Root)</option>
                                                <option value="stem">莖(Stem)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>NCBI 分類 ID：<small>(官方 NCBI ID。)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_ncbi_taxonomy_id" name="genotyping_well_ncbi_taxonomy_id" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>萃取方式：<small>(若所有孔位使用相同萃取方式)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_extraction" name="genotyping_well_extraction" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>人員：<small>(若所有孔位由同一人製備。)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_dna_person" name="genotyping_well_dna_person" type="text" />
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>日期：<small>(若在同天分盤。YYYY/MM/DD)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_date" name="genotyping_well_date" type="text" placeholder="YYYY/MM/DD"/>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-7 control-label"><i>（選填）</i>備註：<small>(這些孔位的其他備註。)</small> </label>
                                        <div class="col-sm-5">
                                            <input class="form-control" id="genotyping_well_notes" name="genotyping_well_notes" type="text" />
                                        </div>
                                    </div>
                                </div>

                                <br/>
                                <div id="next_upload_button" style="display:none">
                                    <center>
                                        <button id="well_info_intro_button" class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                    </center>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> "試驗關聯(Trial Linkage)" &>
                                <& /page/page_title.mas, title=>"您的基因分型微孔盤是否與資料庫中的田間試驗關聯？此資訊亦可在試驗儲存至資料庫後，從基因分型微孔盤詳細資料頁面新增。(Is Your Genotyping Plate Linked With Field Trials In The Database?)" &>
                                <p>如果您向我們提供了每個孔位中組織樣本來源的資訊（例如來自田間試驗中的小區名稱、植株名稱或組織樣本名稱），我們將自動在田間試驗與此基因分型微孔盤之間建立關聯。</p>
                                <br/>
                                <center>
                                    <button id="trial_linkage_intro_button"  class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" >繼續前往下一步(Continue to Next Step)</button>
                                <center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "確認(Confirm)" &>
                                <& /page/page_title.mas, title=>"確認並送出您的基因分型微孔盤(Finalize And Submit Your Genotyping Plate)" &>

                                <p>自動送交至基因分型機構功能目前尚未開放。您可以在點擊送出後，從基因分型微孔盤的詳細資料頁面送交，或是從詳細資料頁面下載資訊並自行送交。</p>
<!--
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Along with saving this information to this database, I want to automatically submit to the Genotyping Facility: <small>Automatic submission currently not working. You can submit it from the Genotyping Plate's detail page or download the information from the Genotyping Plate's detail page and submit it yourself after clicking Submit</small></label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_trial_facility_submit_select" disabled>
                                            <option value="no">No</option>
                                            <option value="yes">Yes</option>
                                        </select>
                                    </div>
                                </div>
-->
                                <input name="genotyping_trial_facility_submit_select" id="genotyping_trial_facility_submit_select" type="hidden" value="no">

                                <hr/>
                                <center>
                                    <button type="button" class="btn btn-primary" name="add_geno_trial_submit" id="add_geno_trial_submit">送出(Submit)</button>
                                </center>
                            </&>

                            <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                                <& /page/page_title.mas, title=>"完成！您的基因分型微孔盤已儲存至資料庫。(Complete! Your Genotyping Plate Was Saved In The Database.)"
                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    基因分型微孔盤已成功儲存
                                </p>
                                <ul>
                                    <li>您可以前往剛建立之試驗的基因分型微孔盤詳細資料頁面。</li>
                                    <li>您可以為微孔盤和組織樣本列印條碼。</li>
                                </ul>
                                <br/>
                            </&>
                        </&>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_spreadsheet_info_format_dialog" name="genotyping_trial_layout_upload_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>此功能用於上傳既有的基因分型微孔盤配置。</b>
                    <br/>
                    <b>檔案必須為 Excel 檔案 (.xls 或 .xlsx)</b>
                    <br />
                    <b>標頭：</b>
                    <br>
                    第一列（標頭）必須包含以下內容：

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>date</td>
                                <td>sample_id</td>
                                <td>well_A01</td>
                                <td>row</td>
                                <td>column</td>
                                <td>source_observation_unit_name</td>
                                <td>ncbi_taxonomy_id</td>
                                <td>dna_person</td>
                                <td>notes</td>
                                <td>tissue_type</td>
                                <td>extraction</td>
                                <td>concentration</td>
                                <td>volume</td>
                                <td>is_blank</td>
                            </tr>
                        </tbody>
                    </table>
                    選填欄位：除樣本 ID 外，您可以在最後一欄新增機構識別碼，欄位標題為："facility_identifier"。
                    <br/><br/>
                    <b>必填欄位：</b>
                    <ul>
                    <li>date (should be YYYY-MM-DD)</li>
                    <li>sample_id (the unique identifier for the sample in the well)</li>
                    <li>well_A01 (the position of the sample in the plate e.q. A10)</li>
                    <li>row (the row position of the sample in the plate e.g. A)</li>
                    <li>column (the column position of the sample in the plate e.g. 10)</li>
                    <li>source_observation_unit_name (must exist in the database. the identifier of the origin material. in order of most desirable identifier to least desirable identifier that can be used here: tissue sample name, plant name, plot name, accession name. For blank wells, you can write BLANK here and place a 1 in the is_blank column also.)</li>
                    <li>tissue_type (must be either leaf, root, or stem)</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                    <li>ncbi_taxonomy_id (NCBI taxonomy identifier)</li>
                    <li>dna_person (the name of the person who prepared the well)</li>
                    <li>notes (any additional notes on the well)</li>
                    <li>extraction (free-text for the extraction method e.g. CTAB)</li>
                    <li>concentration (concentration in ng/ul)</li>
                    <li>volume (volume in ul)</li>
                    <li>is_blank (indicates if well is blank. write 1 if blank, otherwise leave empty.)</li>
                    <li>facility_identifier (if you would like to include facility identifiers in your genotyping plate layout, you can add facility identifiers in the last column with the header <b>"facility_identifier"</b>)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_coordinate_info_format_dialog" name="genotyping_trial_layout_upload_coordinate_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialCoordinateInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialCoordinateInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>此功能用於上傳預設 Coordinate Android 應用程式匯出的微孔盤配置。</b>
                    <br/>
                    <b>檔案必須為 CSV 檔案 (.csv)</b>
                    <br />
                    （不支援 Excel 格式）
                    <br /><br />
                    <b>標頭：</b>
                    <br>
                    第一列（標頭）必須包含以下內容：

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>date</td>
                                <td>plate_id</td>
                                <td>plate_name</td>
                                <td>sample_id</td>
                                <td>well_A01</td>
                                <td>well_01A</td>
                                <td>tissue_id</td>
                                <td>dna_person</td>
                                <td>notes</td>
                                <td>tissue_type</td>
                                <td>extraction</td>
                            </tr>
                        </tbody>
                    </table>
                    選填欄位：除樣本 ID 外，您可以在最後一欄新增機構識別碼，欄位標題為："facility_identifier"。
                    <br/><br/>
                    <b>必填欄位：</b>
                    <ul>
                    <li>date (should be YYYY-MM-DD)</li>
                    <li>plate_id (an identifier for a grouping of plates. called "Genotyping Project Name" in genotyping plate submission form. e.g. NextGenCassava)</li>
                    <li>plate_name (the unique name for the individual plate. called "Plate ID" in genotyping plate submission form. e.g. 18DNA00001)</li>
                    <li>sample_id (the unique identifier for the sample in the well. e.g. 18DNA00001_A01)</li>
                    <li>well_A01 (the position of the sample in the plate in this format A01)</li>
                    <li>well_01A (the position of the sample in the plate in this format 01A)</li>
                    <li>tissue_id (the identifier of the origin material. in order of most desirable identifier to least desirable identifier that can be used here: tissue sample name, plant name, plot name, accession name. this can also say 'BLANK' to indicate a blank well.)</li>
                    <li>dna_person (the name of the person who plated the individual sample. can be any name.)</li>
                    <li>tissue_type (must be either leaf, root, or stem)</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                    <li>notes (any additional notes on the well)</li>
                    <li>extraction (free-text for the extraction method e.g. CTAB)</li>
                    <li>facility_identifier (if you would like to include facility identifiers in your genotyping plate layout, you can add facility identifiers in the last column with the header <b>"facility_identifier"</b>)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_coordinate_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genotyping_trial_layout_upload_coordinate_custom_info_format_dialog" name="genotyping_trial_layout_upload_coordinate_custom_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypingTrialCoordinateCustomInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypingTrialCoordinateCustomInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>此功能用於上傳自訂 Coordinate Android 應用程式匯出的微孔盤配置。</b>
                    <br/>
                    <b>檔案必須為 CSV 檔案 (.csv)</b>
                    <br />
                    （不支援 Excel 格式）
                    <br /><br />
                    <b>Header:</b>
                    <br

                    <p>請注意，若您使用此上傳類型，組織類型將預設設為「葉 (leaf)」，因為上傳中未提供組織類型且 DaRT 需要組織類型。</p>

                    第一列（標頭）必須包含以下內容：

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>Value</td>
                                <td>Column</td>
                                <td>Row</td>
                                <td>Identification</td>
                                <td>Person</td>
                                <td>Date</td>
                            </tr>
                        </tbody>
                    </table>
                    選填欄位：除樣本 ID 外，您可以在最後一欄新增機構識別碼，欄位標題為："Facility Identifier"。
                    <br/><br/>
                    <b>必填欄位：</b>
                    <ul>
                        <li>Value (the identifier of the origin material. e.g. 2018MyPlant0001. in order of most desirable identifier to least desirable identifier that can be used here: tissue sample name, plant name, plot name, accession name. This can also say 'exclude' to indicate a BLANK)</li>
                        <li>Column (the column position of the sample e.g. 10)</li>
                        <li>Row (the row position of the sample e.g. A)</li>
                        <li>Identification (free text)</li>
                        <li>Person (the name of the person who plated the individual sample. can be any name.)</li>
                        <li>Date (should be YYYY-MM-DD)</li>
                    </ul>
                    <b>選填欄位：</b>
                    <ul>
                        <li>Facility Identifier (if you would like to include facility identifiers in your genotyping plate layout, you can add facility identifiers in the last column with the header <b>"Facility Identifier"</b>)</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_coordinate_custom_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery('#genotyping_trial_layout_upload_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_layout_upload_coordinate_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_coordinate_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_layout_upload_coordinate_custom_spreadsheet_info_format').click(function(){
        jQuery('#genotyping_trial_layout_upload_coordinate_custom_info_format_dialog').modal('show');
    });

    jQuery('#genotyping_trial_well_input_option').change(function(){
        if (jQuery(this).val() == 'xls'){
            jQuery("#genotyping_trial_well_upload_section").show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
        if(jQuery(this).val() == 'coordinate'){
            jQuery('#genotyping_trial_well_coordinate_upload_section').show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
        if(jQuery(this).val() == 'coordinate_template'){
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').show();
            jQuery('#next_upload_button').show();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery("#genotyping_trial_well_design_section").hide();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
        }
        if (jQuery(this).val() == 'design' ){
            jQuery("#genotyping_trial_well_design_section").show();
            jQuery('#next_upload_button').show();
            jQuery("#genotyping_trial_well_upload_section").hide();
            jQuery('#genotyping_trial_well_coordinate_upload_section').hide();
            jQuery('#genotyping_trial_well_coordinate_template_upload_section').hide();
            jQuery('#genotyping_trial_layout_upload_coordinate').val('');
            jQuery('#genotyping_trial_layout_upload').val('');
            jQuery('#genotyping_trial_layout_upload_coordinate_template').val('');
        }
    });

    get_select_box('breeding_programs', 'plate_breeding_program_select_div', {'name' : 'plate_breeding_program_id', 'id' : 'plate_breeding_program_id', 'empty': 1  });

    jQuery('#next_step_creating_genotyping_plates').click(function(){
        get_select_box('projects', 'plate_genotyping_project_select_div', { 'name' : 'plate_genotyping_project_id', 'id' : 'plate_genotyping_project_id', 'get_genotyping_projects': '1', 'empty':1});
        return false;
    });

});
</script>
