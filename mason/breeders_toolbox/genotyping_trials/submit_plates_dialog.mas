
<%args>
$trial_id
$genotyping_facility

</%args>

<div class="modal fade" id="submit_plate_dialog" name="submit_plate_dialog" tabindex="-1" role="dialog" aria-labelledby="SendPlateToFacilityDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SendPlateToFacilityDialog">提交基因分型微孔盤至機構(Submit Genotyping Plates to Facility)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="submit_plate_form" name="submit_plate_form">

                        <&| /util/workflow.mas, id=> "plates_to_facilities_workflow" &>
                            <&| /util/workflow.mas:step, title=> "微孔盤資訊(Plate Info)" &>
                                                        <& /page/page_title.mas, title=>"微孔盤資訊(Plate Information)" &>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">微孔盤 ID：</label>
                        <div class="col-sm-9" id="plate_id">
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">基因分型微孔盤：</label>
                        <div class="col-sm-9" id="plate_name">
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">微孔盤格式：</label>
                        <div class="col-sm-9" id="plate_format">
                        </div>
                      </div>
<!--                       <div class="form-group">
                        <label class="col-sm-3 control-label">樣本數量：</label>
                        <div class="col-sm-9" id="number_samples">
                        </div>
                      </div> -->
                        <center>
                            <button class="btn btn-primary" id="facility_info_link" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                        </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "機構(Facility)" &>
                    <& /page/page_title.mas, title=>"機構資訊(Facility Information)" &>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">基因分型機構：</label>
                            <div class="col-sm-9" id="genotyping_facility">
                            </div>
                        </div>
                        <div class="form-group">
                        <label class="col-sm-3 control-label">生物名稱：</label>
                        <div class="col-sm-9">
                            <select class="form-control" id="organism_name">                               
                            </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">機構服務 ID：</label>
                        <div class="col-sm-9">
                            <select class="form-control" id="service_id_select" multiple>                               
                            </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">客戶 ID：</label>
                        <div class="col-sm-9">
                            <input class="form-control" id="client_id" name="client_id"></input>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label">樣本類型：</label>
                        <div class="col-sm-9" id="sample_type">
                        </div>
                      </div> 
                      <div class="form-group" id="required_services"> 
                        <label class="col-sm-4 control-label">所需服務資訊：</label>
                      </div>
                      <center>
                            <button class="btn btn-primary" id="review_order_link" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                      </center>           
                      <br/><br/>
                       </&>
                       <&| /util/workflow.mas:step, title=> "審查(Review)" &>
                        <& /page/page_title.mas, title=>"審查訂單(Review Order)" &>

                        <div class="panel panel-default">
                            <div class="panel-body">
                                <& /breeders_toolbox/genotyping_trials/layout_as_list.mas, trial_id => $trial_id, genotyping_plate_format => '96' &>
                            </div>
                        </div>
                        <center>
                            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                        </center>  
                    </&>
                    <&| /util/workflow.mas:step, title=> "確認(Confirm)" &>
                        <& /page/page_title.mas, title=>"提交您的基因分型微孔盤(Submit Your Genotyping Plate)" &>

                        <div class="form-group">
                            <label class="col-sm-12">我想自動提交至基因分型機構：</label><label class="col-sm-12" id="facility_url_lbl"></label>
                            <div class="col-sm-12" align="center">
                                <select class="form-control" style="width: 200px" id="genotyping_trial_facility_submit_select">
                                    <option value="1" selected="">否</option>
                                    <option value="0">是</option>
                                </select>
                            </div>
                        </div>
                        <hr>
                        <center>
                            <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="submit_plate_btn" id="submit_plate_btn" disabled>提交基因分型微孔盤(Submit Genotyping Plate)</button>
                        </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> "完成訂單(Finalize)" &>
                        <& /page/page_title.mas, title=>"完成您的訂單(Finalize Your Order)" &>
                            <p>提交 ID：<b><label id="submission_lbl"></label></b></p>
                            <p>請點選<a id="facility_href" target="_blank">此處</a>以完成您的訂單。</p><br><br>
                            <p>訂單完成後請點選繼續。</p>
                            <center>
                                <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="continue_submission_btn" id="continue_submission_btn">繼續(Continue)</button>
                            <center>
                    </&> 
                    <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                        <& /page/page_title.mas, title=>"完成！(Complete!)" &>
                        
                            <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                            <p>訂單已完成。</p>
                            <!-- Facility Order Id: <b><label id="order_lbl"></label></b><br><br> -->
                            <li>您可以前往基因分型微孔盤詳細資料頁面以檢查訂單狀態。</li>
                       
                        <br/>
                    </&>

                    </&>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="submit_plate_dialog" type="button" class="btn btn-default" data-dismiss="modal" onclick="location.reload();">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="plate_to_facilities_dialog_message" name="plate_to_facilities_dialog_message" tabindex="-1" role="dialog" aria-labelledby="HmDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="HmDialog"><b>提交基因分型微孔盤(Submit Genotyping Plate)</b></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <p3>基因分型微孔盤已成功提交...</p3>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_message_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>

            </div>
        </div>
    </div>
</div>
