
<%args>
$trial_id
$trial_name
$plate_id
$breeding_program_name
$breeding_program_id
$private_company_id
$private_company_name
$location_data => undef
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$design_layout_view => undef
$user_can_modify => undef
$identifier_prefix => 'SGN'
$genotyping_facility => undef
$genotyping_facility_status => undef
$genotyping_facility_submitted => undef
$genotyping_vendor_order_id => undef
$genotyping_vendor_submission_id => undef
$genotyping_plate_format => '96'
$genotyping_plate_sample_type => undef
$raw_data_link => undef
$trial_owner => undef
$genotyping_project_link => undef
</%args>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;"><% $trial_id %></div>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial03152022', 'CXGN.BreedersToolbox.GenotypingTrial08232022', 'CXGN.BreedersToolbox.GenotypingSubmission03152022' ] &>

<& /page/page_title.mas, title=>"基因分型微孔盤(Genotyping Plate) $trial_name" &>

<%perl>
    my $order_id;
    my $submission_id;
    if($genotyping_vendor_order_id){
        my $order_info = JSON->new->allow_nonref->decode($genotyping_vendor_order_id);
        $order_id = $order_info->{orderId} || undef;
    } elsif($genotyping_vendor_submission_id){
        my $order_info = JSON->new->allow_nonref->decode($genotyping_vendor_submission_id);
        $submission_id = $order_info->{submissionId} || undef;
    }
 </%perl>

<br/>

<div class="well">
    <div class="row">
        <div class="col-sm-9">

            <div class="panel panel-default">
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                    <tbody>
                    <tr><td><b>基因分型專案(Genotyping Project)</b></td><td><% $genotyping_project_link %></td></tr>
                    <tr><td><b>育種計畫(Breeding Program)</b></td><td><a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a></td></tr>
                    <tr><td><b>試驗類型(Trial Type)</b></td><td>基因分型微孔盤</td></tr>
                    <tr><td><b>微孔盤格式(Plate Format)</b></td><td><% $genotyping_plate_format %></td></tr>
                    <tr><td><b>微孔盤樣本類型(Plate Sample Type)</b></td><td><% $genotyping_plate_sample_type %></td></tr>
                    <tr><td><b>基因分型機構(Genotyping Facility)</b></td><td><% $genotyping_facility %></td></tr>
                    <tr><td><b>描述(Description)</b></td><td><% $trial_description %></td></tr>
                    <tr><td><b>建立者(Created By)</b></td><td><% $trial_owner %></td></tr>
                    <!-- <tr><td><b>Submitted to Genotyping Facility</b></td><td><% $genotyping_facility_submitted %></td></tr>
                    <tr><td><b>Genotyping Facility Status</b></td><td><% $genotyping_facility_status %></td></tr>
                    <tr><td><b>Raw Data Link</b></td><td><a href='<% $raw_data_link %>'><% $raw_data_link %></td></tr> -->
                    </tbody>
                    </table>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <button class="btn btn-primary btn-sm" id="edit_genotyping_trial_details" style="margin:3px">編輯微孔盤詳細資料(Edit Plate Details)</button>
                </div>
            </div>

<!--             <div class="panel panel-default">
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                    <tbody>
                    <tr><td><b>Live Status From Genotyping Facility</b></td><td><div id="genotyping_trial_status_info"></div></td></tr>
                    <tr><td><b>Download PDF</b></td><td><div id="download_trial_pdf"></div></td></tr>
                    </tbody>
                    </table>
                </div>
            </div> -->

            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=csv&dataLevel=plate" class="btn btn-default">下載 Breedbase 格式檔案(Download Breedbase Formatted File)</a>
            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=intertekxls&dataLevel=plate" class="btn btn-default">下載 Intertek 格式檔案(Download Intertek Formatted File)</a>
            <a href="/breeders/trial/<% $trial_id %>/download/layout?format=dartseqcsv&dataLevel=plate" class="btn btn-default">下載 DartSeq 格式檔案(Download DartSeq Formatted File)</a>

        </div>
        <div class="col-sm-3">

            <center><& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", text=> "$identifier_prefix trial $trial_id ($trial_name)", format=>"stock_qrcode"  &></center><br />

        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-1">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-export"></span>
                </div>
                <div class="col-sm-11">
                <&| /page/info_section.mas, title => "<h4 style='display:inline'>基因分型微孔盤提交狀態(Genotyping Plate Submission Status)</h4>", subtitle=> "提交基因分型微孔盤至機構。", id => 'genotyping_facilities_section', collapsible => 1, collapsed => 1 &>
                    <div class="col-sm-9"></div>
                    <div class="col-sm-3">
                        <button class="btn btn-primary btn-sm" id="submit_plate_link" style="margin:3px">提交微孔盤(Submit Plates)</button>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <table class="table table-bordered table-hover">
                            <tbody>
                                <tr><td><b>基因分型機構(Genotyping Facility)</b></td><td><div id="genotyping_facility_tab"><% $genotyping_facility %></div></td></tr>
                                <tr><td><b>已提交至基因分型機構(Submitted to Genotyping Facility)</b></td><td><div id="genotyping_facility_submitted_tab"></div></td></tr>
                                <tr><td><b>基因分型機構訂單 ID(Genotyping Facility Order ID)</b></td><td><div id="genotyping_vendor_order_id_tab"><% $order_id %></div></td></tr>
                                <tr><td><b>基因分型機構提交 ID(Genotyping Facility Submission ID)</b></td><td><div id="genotyping_vendor_submission_id_tab"><% $submission_id %></div></td></tr>
                                <tr><td><b>基因分型機構即時狀態(Live Status From Genotyping Facility)</b></td><td><div id="genotyping_trial_status_info"></div></td></tr>
                                <tr><td><b>下載 PDF(Download PDF)</b></td><td><div id="download_trial_pdf"></div></td></tr>
                                <tr><td><b>原始資料連結(Raw Data Link)</b></td><td><div id="raw_data_tab"></div></td></tr>
                            </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                </&>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="well">
            <div class="row">
                <div class="col-sm-3">
                    <span style="font-size:3.5em;" class="glyphicon glyphicon-qrcode"></span>
                </div>
                <div class="col-sm-7">
                    <h4>產生樣本、種原或微孔盤 ID 的條碼標籤(Generate Barcode Labels for Samples, Accessions or Plate ID)</h4>
                </div>
                <div class="col-sm-2">
                    <& /breeders_toolbox/trial/generate_genotrial_barcode.mas, trial_name => $trial_name, trial_id => $trial_id, identifier => $identifier_prefix, plate_id=> $plate_id &>

                    <button id="generate_genotyping_trial_barcode_link" class="btn btn-primary btn-sm">執行(Go)</button>
                </div>
            </div>
        </div>
    </div>
</div>

