<div class="modal fade" id="upload_ssr_protocol_dialog" name="upload_ssr_protocol_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSSRProtocolDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSSRProtocolDialog">上傳 SSR 協定 (標記資訊)(Upload SSR Protocol (Marker Info))</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_ssr_protocol_form" name="upload_ssr_protocol_form">
                        <div class="form-group">
                            <label class="col-sm-5 control-label">SSR 協定名稱：</label>
                            <div class="col-sm-7">
                                <input class="form-control" id="upload_ssr_protocol_name" name="upload_ssr_protocol_name" type="text" placeholder=" e.g. SSR Cassava set 1"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-5 control-label">物種：</label>
                            <div class="col-sm-7">
                                <input class="form-control" id="upload_ssr_species_name_input" name="upload_ssr_species_name_input" type="text" placeholder=" e.g. Manihot esculenta"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-5 control-label">描述：</label>
                            <div class="col-sm-7">
                                <input class="form-control" id="upload_ssr_protocol_description_input" name="upload_ssr_protocol_description_input" type="text" />
                            </div>
                        </div>
<!--
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Sample Type: </label>
                            <div class="col-sm-7">
                                <select class="form-control" id="upload_ssr_sample_type_select" name="upload_ssr_sample_type_select">
                                    <option value="">Select sample type</option>
                                    <option value="accession">Accession</option>
                                    <option value="tissue_sample">Tissue Sample</option>
                                </select>
                            </div>
                        </div>
-->
                        <div class="row">
                            <div class="col-sm-5">
                                <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                                    <p>
                                        <b>檔案格式資訊</b>
                                        <br>
                                        <a id="upload_ssr_protocol_format">試算表格式(Spreadsheet Format)</a>
                                    </p>
                                </&>
                            </div>
                            <div class="col-sm-7">
                                <br/>
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">選擇 XLS 檔案：</label>
                                            <div class="col-sm-4">
                                                <input type="file" name="xls_ssr_protocol_file" id="xls_ssr_protocol_file" encoding="multipart/form-data" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" name="upload_ssr_protocol_submit" id="upload_ssr_protocol_submit">上傳檔案(Upload File)</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_grm_spreadsheet_info_dialog" name="upload_grm_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGRMSpreadsheetInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGRMSpreadsheetInfoDialog">上傳基因組親緣關係資料範本資訊(Upload Genomic Relationships Data Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>基因組親緣關係矩陣 (GRM) 資料可作為 Tab 分隔檔案 (.tsv) 上傳</b>
                    <br />
                        （不支援 Excel 格式）
                    <br /><br />
                    <b>GRM 資料試算表範例：</b>
                    <br>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>a_accession</td>
                                <td>b_accession</td>
                                <td>value</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>必填欄位：</b>
                    <ul>
                        <li><b>a_accession</b>：第一個種原的唯一名稱或別名。必須已存在於資料庫中。</li>
                        <li><b>b_accession</b>：第二個種原的唯一名稱或別名。必須已存在於資料庫中。</li>
                        <li><b>value</b>：兩個種原之間的基因組親緣關係值。</li>
                    </ul>
                    <b>注意：僅上傳單邊（上三角或下三角）關係，因為資料庫會自動儲存兩側。</b>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_ssr_spreadsheet_info_dialog" name="upload_ssr_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSSRSpreadsheetInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSSRSpreadsheetInfoDialog">上傳 SSR 資料範本資訊(Upload SSR Data Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>SSR 資料可透過 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <b>SSR 資料試算表範例：</b>
                    <br>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead>
                            <tr>
                                <th>sample_name</th>
                                <th>s01</th>
                                <th>s01</th>
                                <th>s01</th>
                                <th>s02</th>
                                <th>s02</th>
                                <th>s02</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                                <td>139</td>
                                <td>170</td>
                                <td>194</td>
                                <td>203</td>
                                <td>229</td>
                                <td>290</td>
                            </tr>
                            <tr>
                                <td>sample_A</td>
                                <td>1</td>
                                <td>0</td>
                                <td>0</td>
                                <td>0</td>
                                <td>1</td>
                                <td>1</td>
                            </tr>
                            <tr>
                                <td>sample_B</td>
                                <td>0</td>
                                <td>0</td>
                                <td>0</td>
                                <td>1</td>
                                <td>0</td>
                                <td>0</td>
                            </tr>
                            <tr>
                                <td>sample_C</td>
                                <td>0</td>
                                <td>1</td>
                                <td>1</td>
                                <td>0</td>
                                <td>1</td>
                                <td>0</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        欄位資訊：
                    </b>
                    <ul>
                        <li>s01 和 s02 為標記名稱。</li>
                        <li>139、170、194 是標記 s01 產生的產物大小，203、229、290 是標記 s02 產生的產物大小。</li>
                        <li>sample_A、sample_B、sample_C 為種原名稱。</li>
                        <li>「1」表示存在 PCR 產物。</li>
                        <li>「0」表示不存在 PCR 產物。</li>
                        <br>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    var data_type = '<% $genotyping_data_type %>';
    jQuery('#genotype_data_type_select_submit').click(function(){
        data_type = jQuery('#genotype_data_type_select').val();
        if (data_type == '') {
            alert('請先選擇資料類型！');
            return false;
        }
        else {
            Workflow.complete('#genotype_data_type_select_submit');
            Workflow.focus('#upload_genotypes_workflow', 2);
            return false;
        }
    });

%  if ($is_from_grm) {
    var list = new CXGN.List();
    jQuery("#upload_genotype_is_from_grm_accession_list_select_div").html(list.listSelect("upload_genotype_is_from_grm_accession_list_select_div", ["accessions"], '可選擇種原清單', undefined, undefined));

    get_select_box('trials', 'upload_genotype_is_from_grm_field_trial_select_div', { 'name' : 'upload_genotype_is_from_grm_field_trial_ids', 'id' : 'upload_genotype_is_from_grm_field_trial_ids', 'empty':1, 'multiple':1 });
%  }

    jQuery('#genotype_data_type_select').change(function() {
        data_type = jQuery('#genotype_data_type_select').val();

        document.getElementById('upload_genotype_data_type').value = data_type;

        if (data_type == 'vcf') {
            jQuery('#genotype_data_type_select_format_vcf_div').show();
            jQuery('#genotype_data_type_select_format_intertek_div').hide();
            jQuery('#genotype_data_type_select_format_hdf5_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_ssr_div').hide();
            jQuery('#genotype_data_type_select_format_grm_div').hide();

            jQuery('#upload_genotype_data_format_vcf').show();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
            jQuery('#upload_genotype_data_format_grm').hide();
        } else if (data_type == 'intertek') {
            jQuery('#genotype_data_type_select_format_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_intertek_div').show();
            jQuery('#genotype_data_type_select_format_hdf5_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_ssr_div').hide();
            jQuery('#genotype_data_type_select_format_grm_div').hide();

            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').show();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
            jQuery('#upload_genotype_data_format_grm').hide();
        } else if (data_type == 'tassel_hdf5') {
            jQuery('#genotype_data_type_select_format_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_intertek_div').hide();
            jQuery('#genotype_data_type_select_format_hdf5_vcf_div').show();
            jQuery('#genotype_data_type_select_format_ssr_div').hide();
            jQuery('#genotype_data_type_select_format_grm_div').hide();

            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').show();
            jQuery('#upload_genotype_data_format_ssr').hide();
            jQuery('#upload_genotype_data_format_grm').hide();
        } else if (data_type == 'ssr') {
            jQuery('#genotype_data_type_select_format_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_intertek_div').hide();
            jQuery('#genotype_data_type_select_format_hdf5_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_ssr_div').show();
            jQuery('#genotype_data_type_select_format_grm_div').hide();

            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').show();
            jQuery('#upload_genotype_data_format_grm').hide();
        } else if (data_type == 'grm') {
            jQuery('#genotype_data_type_select_format_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_intertek_div').hide();
            jQuery('#genotype_data_type_select_format_hdf5_vcf_div').hide();
            jQuery('#genotype_data_type_select_format_ssr_div').hide();
            jQuery('#genotype_data_type_select_format_grm_div').show();

            jQuery('#upload_genotype_data_format_vcf').hide();
            jQuery('#upload_genotype_data_format_intertek').hide();
            jQuery('#upload_genotype_data_format_tassel_hdf5').hide();
            jQuery('#upload_genotype_data_format_ssr').hide();
            jQuery('#upload_genotype_data_format_grm').show();
        }
    });

    jQuery('#upload_genotyping_data_protocol_missing_button').click(function(){
        if (data_type == 'ssr') {
            selected = [];
            jQuery('input[name="upload_genotype_protocol_id"]:checked').each(function() {
                selected.push(jQuery(this).val());
            });
            if (selected.length == 0){
                jQuery('#upload_ssr_protocol_dialog').modal('show');
            } else if (selected.length > 0) {
                alert('如果您已選擇協定，請勿同時嘗試建立新協定！');
            }
        } else {
            jQuery('#upload_genotype_data_protocol_details').show();
        }
        return false;
    });

    var upload_genotyping_data_trial_table = jQuery('#upload_genotyping_data_project_search_results').DataTable({
        'destroy': true,
        'ajax':'/ajax/genotyping_data/projects?select_checkbox_name=upload_genotyping_data_project_select'
    });

    var upload_genotyping_data_protocol_table = jQuery('#upload_genotyping_data_protocol_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/genotyping_data/protocols?select_checkbox_name=upload_genotype_protocol_id&trim_header_info_lines=10&only_geno_protocols=<% $is_from_grm %>',
        },
    });

    jQuery('#upload_genotyping_data_project_check_button').click(function(){
        selected = [];
        jQuery('input[name="upload_genotyping_data_project_select"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length > 1){
            alert('請僅選擇一個基因分型專案！');
        } else {
            if (selected.length == 0){
                alert('請選擇基因分型專案或建立新專案！');
            } else if (selected.length == 1){
                jQuery('#upload_genotype_project_id').val(selected[0]);
                Workflow.complete('#upload_genotyping_data_project_check_button');
                Workflow.focus('#upload_genotypes_workflow', 3);
            }
        }
        return false;
    });

    var ssr_protocol_id;
    var is_from_grm = '<% $is_from_grm %>';
    jQuery('#upload_genotyping_data_protocol_check_button').click(function(){
        selected = [];
        jQuery('input[name="upload_genotype_protocol_id"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });
        if (selected.length > 1){
            alert('請僅選擇一個基因分型協定！');
        } else {
            if (selected.length == 0 && jQuery('#upload_genotype_vcf_protocol_name').val() == '' && jQuery('#upload_genotype_protocol_id').val() == ''){
                alert('請選擇基因分型協定或建立新協定！');
            } else if (is_from_grm != 1 && selected.length == 1 && jQuery('#upload_genotype_vcf_protocol_name').val() != ''){
                alert('如果您已選擇協定，請勿同時嘗試建立新協定！');
            } else if (is_from_grm == 1 && selected.length == 0) {
                alert('請先選擇基因分型協定！');
            } else if (selected.length == 1 && (jQuery('#upload_genotype_vcf_protocol_name').val() == '' || jQuery('#upload_genotype_vcf_protocol_name').val() == undefined) ) {
                jQuery('#upload_genotype_protocol_id').val(selected[0]);
                Workflow.complete('#upload_genotyping_data_protocol_check_button');
                Workflow.focus('#upload_genotypes_workflow', 4);
            } else if (selected.length == 0 && jQuery('#upload_genotype_protocol_id').val() != ''){
                Workflow.complete('#upload_genotyping_data_protocol_check_button');
                Workflow.focus('#upload_genotypes_workflow', 4);
            } else if (selected.length == 0 && jQuery('#upload_genotype_vcf_protocol_name').val() != '') {
                if (jQuery('#upload_genotype_vcf_reference_genome_name').val() == ''){
                    alert('請提供參考基因組名稱。');
                } else if (jQuery('#upload_genotypes_species_name_input').val() == ''){
                    alert('請提供物種名稱。');
                } else {
                    jQuery('#upload_genotype_protocol_id').val(undefined);
                    Workflow.complete('#upload_genotyping_data_protocol_check_button');
                    Workflow.focus('#upload_genotypes_workflow', 4);
                }
            }
        }
        return false;
    });

    jQuery('#upload_genotype_data_info_button').click(function(){

%  if ($is_from_grm) {
        var selected_field_trial_ids = jQuery('#upload_genotype_is_from_grm_field_trial_ids').val();
        if (selected_field_trial_ids == null) {
            alert('請選擇要連結 GRM 的田間試驗。');
            return false;
        }
        if (selected_field_trial_ids.length < 1) {
            alert('請選擇要連結 GRM 的田間試驗。');
            return false;
        }
        jQuery('#upload_genotype_is_from_grm_field_trial_ids_json').val(JSON.stringify(selected_field_trial_ids));

        if (jQuery('#upload_genotype_is_from_grm_protocol_name').val() == '') {
            alert('請先提供 GRM 協定名稱！');
            return false;
        }
        else if (jQuery('#upload_genotype_is_from_grm_protocol_desc').val() == '') {
            alert('請先提供 GRM 協定描述！');
            return false;
        }
        else {
            Workflow.complete('#upload_genotype_data_info_button');
            Workflow.focus('#upload_genotypes_workflow', 5);
            return false;
        }
%  } else {
        Workflow.complete('#upload_genotype_data_info_button');
        Workflow.focus('#upload_genotypes_workflow', 5);
        return true;
%  }

    });

    jQuery('#upload_genotype_vcf_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_vcf_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_genotype_tassel_hdf5_info_format').click(function(){
        jQuery('#upload_genotype_tassel_hdf5_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_genotype_intertek_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_intertek_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#upload_ssr_data_spreadsheet_info').click(function(){
        jQuery('#upload_ssr_spreadsheet_info_dialog').modal('show');
    });

    jQuery('#upload_grm_data_spreadsheet_info').click(function(){
        jQuery('#upload_grm_spreadsheet_info_dialog').modal('show');
    });

    jQuery('#upload_ssr_protocol_format').click(function(){
        jQuery('#upload_ssr_protocol_format_dialog').modal('show');
        jQuery('#upload_ssr_protocol_dialog').modal('hide');
    });

    jQuery("#upload_ssr_protocol_submit").click(function(){

        var ssr_protocol_name = jQuery("#upload_ssr_protocol_name").val();
        var ssr_protocol_species_name = jQuery("#upload_ssr_species_name_input").val();
        var ssr_protocol_description = jQuery("#upload_ssr_protocol_description_input").val();
        var uploadFile = jQuery("#xls_ssr_protocol_file").val();

        jQuery('#upload_ssr_protocol_form').attr("action", "/ajax/genotype/upload_ssr_protocol");
        if (ssr_protocol_name === ''){
            alert("請提供協定名稱");
            return;
        }
        if (ssr_protocol_species_name === ''){
            alert("請提供物種名稱");
            return;
        }
        if (ssr_protocol_description === ''){
            alert("請提供描述");
            return;
        }
        if (uploadFile === ''){
            alert("請選擇檔案");
            return;
        }
        jQuery('#upload_ssr_protocol_form').submit();
        jQuery('#upload_ssr_protocol_dialog').modal("hide");
    });

    jQuery('#upload_ssr_protocol_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_ssr_protocol_error_display tbody").html('');
                jQuery("#upload_ssr_protocol_error_display tbody").append(response.error_string);
                jQuery("#upload_ssr_protocol_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#ssr_protocol_saved_dialog_message').modal("show");

                ssr_protocol_id = response.protocol_id;
                jQuery('#upload_genotype_protocol_id').val(ssr_protocol_id);

            }

        }
    });

});
</script>
