
<%args>
$breeding_programs
$locations
$design_types => ()
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.TrialTreeFolders03152022' ] &>

<div class="modal fade" id="upload_trial_dialog" name="upload_trial_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTrialDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTrialDialog">上傳現有試驗(Upload Existing Trial(s))</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <!-- <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_trial_form" name="upload_trial_form"> -->

                        <&| /util/workflow.mas, id=> "trial_upload_workflow" &>
                            <&| /util/workflow.mas:step, title=> "介紹(Intro)" &>
                                <& /page/page_title.mas, title=>"此工作流程將引導您將一個或多個新試驗上傳至資料庫" &>
                                <p>田間試驗代表田間的小區，每個小區具有全域唯一的 <i>plot_name</i>（小區名稱）、在該試驗中唯一的順序 <i>plot_number</i>（小區編號，例如三個獨立小區為 101、102、103），以及代表該小區受測基因型的 <i>accession_name</i>（種原名稱）。在評估雜交/家系的情況下（例如 F1 雜交種、回交），可以使用 <i>cross_unique_id</i> 或 <i>family_name</i> 代替 accession_name。根據您使用的試驗設計（例如完全區集或增強設計），每個小區可屬於不同的區集（<i>block_number</i>）與重複（<i>rep_number</i>）。每個小區可以有 <i>row_number</i>（行號）和 <i>col_number</i>（列號）以指出小區在田間的相對位置。</p>
                                <p>若特定種原是對照，您可以使用 <i>is_a_control</i> 將種植該種原的小區標記為對照。</p>
                                <p>您可以提供每個小區種植的具體 <i>seedlot_name</i>（種子批名稱），以及所使用的種子數量（<i>num_seed_per_plot</i>）和/或種子重量(克)（<i>weight_gram_seed_per_plot</i>）。</p>
                                <p>試驗可代表產量試驗、表型鑑定試驗、雜交區、溫室、苗圃等。</p>
                                <p>一個小區可以有多株植株，資料庫可以將它們作為獨立實體進行追蹤，讓您記錄植株層級的觀察與資訊。</p>
                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "檔案格式(File Formatting)" &>
                                <ul class="nav nav-pills nav-justified" id="upload_trial_designs_tab_select">
                                    <li class="active" id="upload_single_trial_design_tab"><a data-toggle="tab" href="#single_tab">單一試驗設計(Single Trial Design)</a></li>
                                    <li id="upload_multiple_trial_designs_tab"><a data-toggle="tab" href="#multiple_tab">多重試驗設計(Multiple Trial Designs)</a></li>
                                </ul>
                                <div class="tab-content">

                                    <div id="single_tab" class="tab-pane fade in active">
                                        <hr>
                                        <center>
                                            <&| /page/explanation.mas, title=>'範本資訊(Template information)' &>
                                                <p>
                                                    <b>檔案格式資訊</b>
                                                    <br>
                                                    <a id="upload_single_trial_design_format_info">單一試驗試算表(Single trial spreadsheet)</a>
                                                </p>
                                            </&>
                                            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go to Next Step)</button>
                                        </center>
                                    </div>

                                    <div id="multiple_tab" class="tab-pane fade">
                                        <hr>
                                        <center>
                                            <&| /page/explanation.mas, title=>'範本資訊(Template information)' &>
                                                <p>
                                                    <b>檔案格式資訊</b>
                                                    <br>
                                                    <a id="upload_multiple_trial_designs_format_info">多重試驗試算表(Multiple trial spreadsheet)</a>
                                                </p>
                                            </&>
                                            <br>

                                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_multiple_trial_designs_form" name="upload_multiple_trial_designs_form">
                                              <div class="form-group">
                                                  <input type="file" name="multiple_trial_designs_upload_file" id="multiple_trial_designs_upload_file" encoding="multipart/form-data" />
                                              </div>
                                              <div class="form-group">
                                                  <div class="col-sm-4"></div>
                                                  <label class="col-sm-2 control-label">忽略警告：</label>
                                                  <div class="col-sm-2" >
                                                      <input id="upload_multiple_trials_ignore_warnings" name="upload_multiple_trials_ignore_warnings" type="checkbox" data-toggle="toggle" encoding="multipart/form-data">
                                                  </div>
                                                  <div class="col-sm-4"></div>
                                              </div>
                                            </form>

                                            <div style="display:none" id="upload_multiple_trials_warning_messages" class="alert-warning" role="alert">
                                            </div>
                                            <div style="display:none" id="upload_multiple_trials_error_messages" class="alert-danger" role="alert">
                                            </div>
                                            <div style="display:none" id="upload_multiple_trials_success_messages" class="alert-success" role="alert">
                                            </div>

                                            <br>
                                            <button type="button" class="btn btn-primary" id="multiple_trial_designs_upload_submit" disabled>上傳試驗設計(Upload Trial Designs)</button>
                                            <button style="display:none" class="btn btn-primary" id="upload_multiple_trials_success_button">重新載入頁面(Reload Page)</button>
                                        </center>
                                    </div>

                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> "輸入試驗資訊(Enter trial information)" &>
                                <& /page/page_title.mas, title=>"輸入有關試驗的資訊並上傳您的試驗配置" &>
                              <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_trial_form" name="upload_trial_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">試驗名稱：</label>
                                    <div class="col-sm-9" >
                                        <input type="text" class="form-control" id="trial_upload_name" name="trial_upload_name" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">公司：</label>
                                    <div class="col-sm-9">
                                        <div id="trial_upload_company_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">育種計畫：</label>
                                    <div class="col-sm-9">
                                        <div id="trial_upload_breeding_program_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">地點：</label>
                                    <div class="col-sm-9">
                                        <div id="trial_upload_location_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">試驗類型：</label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="trial_upload_trial_type" name="trial_upload_trial_type" type="text">
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">年份：</label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_upload_year" name="trial_upload_year"></select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">小區寬度 (m)：<small>（選填）</small></label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="trial_upload_plot_width" name="trial_upload_plot_width" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">小區長度 (m)：<small>（選填）</small></label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="trial_upload_plot_length" name="trial_upload_plot_length" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">田區大小 (ha)：<small>（選填）</small></label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="trial_upload_field_size" name="trial_upload_field_size" type="text" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">每小區植株數：<small>（選填）</small></label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="trial_upload_plant_entries" name="trial_upload_plant_entries" type="number" value=0 placeholder=0/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">描述：</label>
                                    <div class="col-sm-9" >
                                        <textarea class="form-control" id="trial_upload_description" name="trial_upload_description" form="upload_trial_form" maxlength="250"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">試驗中評估的材料類型：</label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="trial_upload_trial_stock_type" name="trial_upload_trial_stock_type">
                                            <option value="">選取材料類型(Select a stock type)</option>
                                            <option value="accession">種原(accession)</option>
                                            <option value="cross">雜交(cross)</option>
                                            <option value="family_name">家系名稱(family_name)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">設計類型：</label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_upload_design_method" name="trial_upload_design_method">
% foreach my $type(@$design_types){
%    my $method;
%    if ($type eq 'Completely Randomized'){
%        $method = 'CRD';
%    } elsif ($type eq 'Complete Block'){
%        $method = 'RCBD';
%    } elsif ($type eq 'Resolvable Row-Column'){
%        $method = 'RRC';
%    } elsif ($type eq 'Doubly-Resolvable Row-Column'){
%        $method = 'DRRC';
%    } elsif ($type eq 'Augmented Row-Column'){
%        $method = 'ARC';
%    } elsif ($type eq 'Alpha Lattice'){
%        $method = 'Alpha';
%    } elsif ($type eq 'Modified Augmented Design'){
%        $method = 'MAD';
%    } elsif ($type eq 'Nursery/Greenhouse'){
%        $method = 'greenhouse';
%    } elsif ($type eq 'Split Plot'){
%        $method = 'splitplot';
%    } elsif ($type eq 'Partially Replicated'){
%        $method = 'p-rep';
%    } else {
%        $method = $type;
%    }
    <option value="<%$method%>"><%$type%></option>
%}
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">上傳檔案：</label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="trial_uploaded_file" id="trial_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">前往下一步(Go To Next Step)</button>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "試驗連結(Trial Linkage)" &>
                                <& /page/page_title.mas, title=>"您的試驗是否與資料庫中的其他田間試驗、基因分型盤或雜交試驗相關聯？如果不確定，您可以略過此步驟。儲存試驗後，亦可從小區詳細資訊頁面新增此資訊。" &>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">此試驗是否為先前後續田間試驗？：</label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_sourced" name="upload_trial_trial_sourced">
                                                <option value="no">否(No)</option>
                                                <option value="yes">是(Yes)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none" id="upload_trial_source_trial_section">
                                        <label class="col-sm-5 control-label">選取此試驗之前的先導試驗：</label>
                                        <div class="col-sm-7">
                                            <div id="upload_trial_trial_source" name="upload_trial_trial_source">
                                            </div>
                                            <input type="hidden" id="upload_trial_trial_source_select_value" name="upload_trial_trial_source_select_value" />
                                        </div>
                                    </div>
                                </div>

                                <p>如果您收集組織樣本以建立用於基因分型的 96 孔盤，將基因分型盤（96 孔盤配置）新增至資料庫時，可以使用此田間試驗的小區名稱、植株名稱或組織樣本名稱。如此一來，即可建立此田間試驗與基因分型盤之間的連結。</p>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">此試驗是否將進行基因分型？：</label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_will_be_genotyped" name="upload_trial_trial_will_be_genotyped">
                                                <option value="no">否(No)</option>
                                                <option value="yes">是(Yes)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <p>如果您在此田間試驗中進行雜交，每個雜交組合都可以連結至特定的母本與父本小區。上傳這些雜交時，我們可以自動將此田間試驗連結至資料庫中的雜交試驗。</p>

                                <div class="well form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label">此試驗是否會進行雜交？：</label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="upload_trial_trial_will_be_crossed" name="upload_trial_trial_will_be_crossed">
                                                <option value="no">否(No)</option>
                                                <option value="yes">是(Yes)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <br/>
                                <center>
                                    <button type="button" class="btn btn-lg btn-primary" name="upload_trial_validate_form_button" id="upload_trial_validate_form_button">先驗證表單(First validate the form)</button>
                                    <button type="button" class="btn btn-lg btn-primary" disabled name="upload_trial_submit_first" onclick="Workflow.complete(this, false); return false;" >上傳試驗(Upload Trial)</button>
                                <center>
                            </&>

                            <&| /util/workflow.mas:step, title=> "解決缺失種原問題(Fix missing accessions problem)" &>
                                <& /page/page_title.mas, title=>"解決缺失種原問題" &>

                                <div id="upload_trial_missing_accessions_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>在新增試驗之前，試驗中受測的種原必須已存在於資料庫中。這是因為一個種原可以在多個試驗中受測，因此在資料庫中作為獨立實體存在。我們也希望謹慎將新種原新增至資料庫，以避免錯誤重複的資料。</li>
                                            <li>將種原新增至資料庫時，您可以使用種原清單或 Excel 檔案。</li>
                                        </ul>
                                    </div>

                                    <div id="upload_trial_add_missing_accessions_html">
                                    </div>

                                    <button class="btn btn-info" name="add_accessions_link">將您的種原新增至資料庫(Add your accessions to the database)</button><br/><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">當所有種原都在資料庫中後點擊此處(Click Here)</button><br/><br/>
                                </div>
                                <div id="upload_trial_error_display">

                                    <h3>試驗上傳錯誤訊息(Trial Upload Error Messages)</h3>
                                    <div class="panel panel-danger">
                                        <div class="panel-body">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <center>
                                <div id="upload_trial_no_error_messages_html">
                                </div>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "解決缺失種子批問題(Fix missing seedlots problem)" &>
                                <& /page/page_title.mas, title=>"解決缺失種子批問題" &>

                                <div id="upload_trial_missing_seedlots_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>在新增試驗之前，試驗中受測的種子批必須已存在於資料庫中。這是因為種子批可以在多個試驗中受測，因此在資料庫中作為獨立實體存在。我們也希望謹慎將新種子批新增至資料庫，以避免資料錯誤連結至重複項目。</li>
                                        </ul>
                                    </div>
                                    <ul>
                                    <li>將種子批新增至資料庫時，您可以上傳 Excel 檔案或逐一新增種子批。<br/><br/>
                                        <ul>
                                        <li><button class="btn btn-info" name="seedlot_bulk_upload">上傳 Excel 檔案(Upload Excel file)</button><br/><br/></li>
                                        <li><button class="btn btn-info" name="add_seedlot_button">新增單一種子批(Add One Seedlot)</button></li>
                                        </ul>
                                    </li>
                                    </ul><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">當所有種子批都在資料庫中後點擊此處(Click Here)</button><br/><br/>
                                </div>
                                <div id="upload_trial_error_display_seedlot">

                                    <h3>試驗上傳錯誤訊息(Trial Upload Error Messages)</h3>
                                    <div class="panel panel-danger">
                                        <div class="panel-body">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <center>
                                <div id="upload_trial_no_error_messages_seedlot_html">
                                </div>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>
                            </&>
                            <&| /util/workflow.mas:step, title=> "再次嘗試提交試驗(Try submitting trial again)" &>
                                <& /page/page_title.mas, title=>"再次提交您的試驗。現在您應該已經修正了所有錯誤，如果沒有，請查看下方紅框中的錯誤。您可以繼續修改檔案，然後點擊上傳直到成功為止。" &>
                                <div id="trial_upload_show_repeat_upload_button">
                                    <center>
                                    <button type="button" class="btn btn-lg btn-primary" name="upload_trial_submit_second" >上傳試驗(Upload Trial)</button><br/><br/>
                                    </center>
                                </div>
                                <center>
                                <div name="upload_trial_completed_message">
                                </div>
                                </center>

                                <div id="upload_trial_error_display_second_try" style="display:none">

                                    <h3>您的檔案存在以下問題：</h3>
                                    <div class="panel panel-danger">
                                        <div class="panel-body">
                                            <table>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </&>
                            <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                                <& /page/page_title.mas, title=>"已完成！您的試驗現已存入資料庫" &>
                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    試驗檔案已成功上傳
                                </p>

                                <ul>
                                    <li>您可以前往剛建立的試驗詳細資訊頁面。</li>
                                    <li>您可以為此試驗中的小區、植株或組織樣本列印條碼。</li>
                                    <li>您現在可以為此試驗中的小區或植株新增表型。</li>
                                </ul>
                                <br/>
                                <!--center>
                                <button class="btn btn-primary" id="upload_trial_success_complete_button">The trial was saved to the database with no errors! Congrats Click Here</button><br/><br/>
                                </center-->
                            </&>
                        </&>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_upload_spreadsheet_info_dialog" name="trial_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTrialInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>試驗可以透過 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <hr>
                    <&| /page/info_section.mas, title=>"此試驗中評估的材料類型：種原(accession)", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>標頭：</b>
                            <br/>
                            第一行（標頭）必須包含以下內容：
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>accession_name</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>字串形式的標頭：</b><br/>
                            <p>plot_name,accession_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot</p>
                        </div>
                    </&>

                    <&| /page/info_section.mas, title=>"此試驗中評估的材料類型：雜交唯一識別碼(cross unique id)", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>標頭：</b>
                            <br/>
                            第一行（標頭）必須包含以下內容：
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>cross_unique_id</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>字串形式的標頭：</b><br/>
                            <p>plot_name,cross_unique_id,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot</p>
                        </div>
                    </&>

                    <&| /page/info_section.mas, title=>"此試驗中評估的材料類型：家系名稱(family name)", collapsible=>1, collapsed=>1 &>
                        <div class="well well-sm">
                            <b>標頭：</b>
                            <br/>
                            第一行（標頭）必須包含以下內容：
                            <br />
                            <table class="table table-hover table-bordered table-condensed" >
                                <thead></thead>
                                <tbody>
                                    <tr>
                                        <td>plot_name</td>
                                        <td>family_name</td>
                                        <td>plot_number</td>
                                        <td>block_number</td>
                                        <td>is_a_control</td>
                                        <td>rep_number</td>
                                        <td>range_number</td>
                                        <td>row_number</td>
                                        <td>col_number</td>
                                        <td>seedlot_name</td>
                                        <td>num_seed_per_plot</td>
                                        <td>weight_gram_seed_per_plot</td>
                                    </tr>
                                </tbody>
                            </table>
                            <b>字串形式的標頭：</b><br/>
                            <p>plot_name,family_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot</p>
                        </div>
                    </&>

                    <b>必填欄位：</b>
                    <ul>
                    <li>plot_name（整個資料庫中必須唯一。通常是試驗名稱與小區編號的組合。）</li>
                    <li>accession_name 或 cross_unique_id 或 family_name（必須存在於資料庫中。這是小區中受測的種原、雜交唯一識別碼或家系名稱。）</li>
                    <li>plot_number（田間小區的順序編號（例如 1001、1002、2001、2002）。在此試驗中應為唯一編號。）</li>
                    <li>block_number（設計參數，指出小區所在的區集編號）</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                    <li>is_a_control（若該小區為對照，在此欄位填入 1，否則留空。通常您會有作為對照的種原/雜交識別碼/家系名稱，因此應將這些小區標記為對照。）</li>
                    <li>rep_number（重複編號，數值）</li>
                    <li>range_number（排號。通常與 col_number 同義，數值）</li>
                    <li>row_number（行號。若田區為網格狀，這代表 y 座標，數值，產生田間地圖所需。左上角小區應為第 1 行第 1 列）</li>
                    <li>col_number（列號。若田區為網格狀，這代表 x 座標。有時稱為 range_number，數值，產生田間地圖所需。左上角小區應為第 1 行第 1 列）</li>
                    <li>seedlot_name（種植種子來源的種子批。必須存在於資料庫中）</li>
                    <li>num_seed_per_plot（每小區種子數。種子由 seedlot_name 中提及的種子批轉出。數值）</li>
                    <li>weight_gram_seed_per_plot（小區中種子重量(克)。種子由 seedlot_name 中提及的種子批轉出。數值）</li>
                    </ul>

                    <b>處理：</b>
                    <ul>
                    <li>處理欄位（指定處理名稱的附加欄位（例如：接種、乾旱等）。若施加了該處理，每小區的值應為 1，否則留空。）</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="multiple_trial_upload_spreadsheet_info_dialog" name="multiple_trial_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadMultipleTrialInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadMultipleTrialInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>試驗可以透過 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <b>多重試驗設計：</b>
                    <b>標頭：</b>
                    <br>
                    第一行（標頭）必須包含以下內容，這是單一試驗設計標頭的擴展：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>trial_name</td>
                                <td>company</td>
                                <td>breeding_program</td>
                                <td>location</td>
                                <td>year</td>
                                <td>design_type</td>
                                <td>description</td>
                                <td>trial_type</td>
                                <td>plot_width</td>
                                <td>plot_length</td>
                                <td>field_size</td>
                                <td>planting_date</td>
                                <td>harvest_date</td>
                                <td>plot_name</td>
                                <td>accession_name</td>
                                <td>plot_number</td>
                                <td>block_number</td>
                                <td>is_a_control</td>
                                <td>rep_number</td>
                                <td>range_number</td>
                                <td>row_number</td>
                                <td>col_number</td>
                                <td>seedlot_name</td>
                                <td>num_seed_per_plot</td>
                                <td>weight_gram_seed_per_plot</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>字串形式的標頭：</b><br/>
                    <p>trial_name,company,breeding_program,location,year,design_type,description,trial_type,plot_width,plot_length,field_size,planting_date,harvest_date,plot_name,accession_name,plot_number,block_number,is_a_control,rep_number,range_number,row_number,col_number,seedlot_name,num_seed_per_plot,weight_gram_seed_per_plot</p>

                    <b>必填欄位：</b>
                    <ul>
                    <li>trial_name（在整個資料庫中必須唯一。通常是年份、用途、唯一編號和地點的組合。）</li>
                    <li>company（儲存試驗的公司名稱，必須存在於資料庫中。）</li>
                    <li>breeding_program（管理試驗的育種計畫名稱，必須存在於資料庫中。）</li>
                    <li>location（進行試驗的地點名稱，必須存在於資料庫中。）</li>
                    <li>year（試驗進行的年份。）</li>
                    <li>design_type（設計類型的簡稱，必須存在於資料庫中。可能的值包括 CRD（完全隨機設計）、RCBD（隨機完全區集設計）、RRC（可解析行列設計）、DRRC（雙重可解析行列設計）、ARC（增強行列設計）、Alpha（Alpha 格子設計）、Lattice（格子設計）、Augmented（增強設計）、MAD（修改增強設計）、greenhouse（未設計的苗圃/溫室）、splitplot（分割區集設計）、p-rep（部分重複設計）、Westcott（Westcott 設計））</li>
                    <li>description（包含試驗其他相關資訊的附加文字說明。）</li>
                    <li>plot_name（在整個資料庫中必須唯一。通常是試驗名稱與小區編號的組合。）</li>
                    <li>accession_name（小區中受測的種原，必須存在於資料庫中。）</li>
                    <li>plot_number（田間小區的順序編號（例如 1001、1002、2001、2002）。在此試驗中應為唯一編號。）</li>
                    <li>block_number（設計參數，指出小區所在的區集編號。）</li>
                    </ul>

                    <b>其他選填欄位：</b>
                    <ul>
                    <li>trial_type（試驗類型名稱，必須存在於資料庫中。可能的值包括 Seedling Nursery、phenotyping_trial、Advanced Yield Trial、Preliminary Yield Trial、Uniform Yield Trial、Variety Release Trial、Clonal Evaluation、genetic_gain_trial、storage_trial、heterosis_trial、health_status_trial、grafting_trial、Screen House、Seed Multiplication、crossing_block_trial、Specialty Trial）</li>
                    <li>plot_width（小區寬度，公尺）</li>
                    <li>plot_length（小區長度，公尺）</li>
                    <li>field_size（田區大小，公頃）</li>
                    <li>planting_date（種植日期，格式為 YYYY-MM-DD）</li>
                    <li>harvest_date（收穫日期，格式為 YYYY-MM-DD）</li>
                    <li>is_a_control（若該小區為對照，在此欄位填入 1，否則填 0 或留空。通常您會有作為對照的種原，因此應將種植該種原的小區標記為對照。）</li>
                    <li>rep_number（重複編號，必須為數值）</li>
                    <li>range_number（排號。通常與 col_number 同義，必須為數值）</li>
                    <li>row_number（行號。若田區為網格狀，這代表 y 座標，數值，產生田間地圖所需。左上角小區應為第 1 行第 1 列）</li>
                    <li>col_number（列號。若田區為網格狀，這代表 x 座標。有時稱為 range_number，數值，產生田間地圖所需。左上角小區應為第 1 行第 1 列）</li>
                    <li>seedlot_name（種植種子來源的種子批。必須存在於資料庫中）</li>
                    <li>num_seed_per_plot（每小區種子數。種子由 seedlot_name 中提及的種子批轉出。數值）</li>
                    <li>weight_gram_seed_per_plot（小區中種子重量(克)。種子由 seedlot_name 中提及的種子批轉出。數值）</li>
                    </ul>

                    <b>處理：</b>
                    <ul>
                    <li>處理欄位（指定處理名稱的附加欄位（例如：接種、乾旱等）。若施加了該處理，每小區的值應為 1，未施加則留空。）</li>
                    </ul>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_multiple_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    get_select_box('private_companies', 'trial_upload_company_div', { 'name': 'trial_upload_company_id', 'id': 'trial_upload_company_id' });
    get_select_box('breeding_programs', 'trial_upload_breeding_program_div', { 'name' : 'trial_upload_breeding_program', 'id' : 'trial_upload_breeding_program', 'names_as_values':1, 'private_company_id':1 });
    get_select_box('locations', 'trial_upload_location_div', { 'name' : 'trial_upload_location', 'id' : 'trial_upload_location', 'names_as_values':1 });

    jQuery(document).on('change', '#trial_upload_company_id', function(){
        get_select_box('breeding_programs', 'trial_upload_breeding_program_div', { 'name' : 'trial_upload_breeding_program', 'id' : 'trial_upload_breeding_program', 'private_company_id':jQuery(this).val(), 'names_as_values':1 });
        get_select_box('locations', 'trial_upload_location_div', { 'name' : 'trial_upload_location', 'id' : 'trial_upload_location', 'private_company_id':jQuery(this).val(), 'names_as_values':1 });
    });

    jQuery('#multiple_trial_designs_upload_file').change(function() {
        if (jQuery(this).val()) {
          jQuery('#multiple_trial_designs_upload_submit').prop("disabled",false);
        } else {
          jQuery('#multiple_trial_designs_upload_submit').prop("disabled",true);
        }
    });

    jQuery('#upload_multiple_trials_ignore_warnings').change(function() {
      if (this.checked) {
        jQuery('#upload_multiple_trials_warning_messages').hide();
      }
    });
});
</script>
