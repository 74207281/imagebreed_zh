
<%args>
$trial_id
$trial_stock_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.dataTables-buttons-min', 'jquery.iframe-post-form', 'jszip-min', 'pdfmake.pdfmake-min', 'pdfmake.vfs_fonts', 'buttons.bootstrap-min', 'buttons.html5-min', 'jquery.dataTables-select-min', 'd3.d3v4Min', 'd3.graphers.stackedObservationPhenotypeHistogram03152022'] &>
<style>

.bar rect {
  fill: steelblue;
  shape-rendering: crispEdges;
}

.bar text {
  fill: #fff;
}

.axis path, .axis line {
  fill: none;
  stroke: #000;
  shape-rendering: crispEdges;
}

</style>


<div class="well well-sm table-responsive">
    <center><h4>原始資料統計(Raw Data Statistics)</h4></center>
    <br/>

    <form class="form-horizontal" role="form" >
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label">顯示：</label>
            <div class="col-sm-9" >
                <select class="form-control" id="display_trial_phenosummary">
%  if ($trial_stock_type eq 'analysis_instance') {
                    <option value="analysis_instance">用於分析的數值</option>
%  } else {
                    <option value="plots">此試驗中小區的性狀值</option>
                    <option value="plants">此試驗中植株的性狀值</option>
                    <option value="subplots">此試驗中次小區的性狀值</option>
                    <option value="tissue_samples">此試驗中組織樣本的性狀值</option>
                    <option id = "plots_stock_option" value="plots_accession"></option>
                    <option id = "plants_stock_option" value="plants_accession"></option>
                    <option id = "tissue_samples_stock_option" value="tissue_samples_accession"></option>
%  }
                </select>
            </div>
        </div>
    </form>
    <hr>

    <div id="pheno_summary_table_div">
        <table id="phenotype_summary_data" class="display">
        <thead>
        <tr>
        <th>性狀(Trait)</th>
        <th>平均值(Mean)</th>
        <th>最小值(Min)</th>
        <th>最大值(Max)</th>
        <th>標準差(Std Dev)</th>
        <th>變異係數(CV)</th>
        <th>計數(Count)</th>
        <th>缺失百分比(Percent Missing)</th>
        <th>直方圖(Histogram)</th>
        </tr>
        </thead>
        <tbody>
        </tbody>
        </table>
    </div>
    <div>
        <button type="button" class="selectAll-dt">全選(Select All)</button>
        <button type="button" class="deselectAll-dt">取消全選(Deselect All)</button>
    </div>
    <br>
    <div class="panel panel-default">
        <div class="panel-body">

            <&| /page/info_section.mas, title => '複製選取結果至列表(Copy Selected Results to a List)', collapsible=>1, collapsed=>0, subtitle=>'<i>將摘要表格第一欄目前選取的名稱複製到新列表或現有列表</i>'&>
            <br>
            <p><em>已選取 <span id="selected_row_count">0</span> 行。</em></p>
            <div style="text-align:right" id="names_to_list_menu"></div>
            <div id="selected_names" style="display: none;"></div>
            </&>

        </div>
    </div>
</div>

<div class="well well-sm" id="raw_data_histogram_well">
    <center><h4>原始資料直方圖(Raw Data Histogram)</h4></center><hr>
    <div id="trial_summary_hist_div">
        <div class="row">
            <div class="col-sm-8">
                <form class="form-horizontal">
                    <div class="form-group form-group-sm">
                        <label for="trial_summary_hist_dropdown" class="col-sm-2 control-label">選擇：</label>
                        <div class="col-sm-10">
                            <div id="traits_assayed_dropdown">
                            </div>
                        </div>
                    </div>
                    <div class="form-group form-group-sm">
                        <label class="col-sm-2 control-label">顯示：</label>
                        <div class="col-sm-10" >
                            <select class="form-control" id="display_trial_phenosummary_hist">
%  if ($trial_stock_type eq 'analysis_instance') {
                                <option value="analysis_instance">用於分析的數值</option>
%  } else {
                                <option value="plot">此試驗中小區的數值</option>
                                <option value="plant">此試驗中植株的數值</option>
                                <option value="subplot">此試驗中次小區的數值</option>
                                <option value="tissue_sample">此試驗中組織樣本的數值</option>
%  }
                            </select>
                        </div>
                    </div>
                </form>
                <br/>

            </div>
            <div class="col-sm-4" id="traits_assayed_histogram_cvterm_link">
            </div>
        </div>

        <div id="trial_summary_hist">
        </div>

    </div>
</div>


<script>
// wrap code in an immediately invoked function, so we can use d3v4 as d3;
(function(){
var d3 = d3v4;
var draw_histogram = stackedObservationPhenotypeHistogram.draw;
jQuery(document).ready(function () {
    var type = "<% $trial_stock_type %>";
    jQuery("#display_trial_phenosummary_hist").change(function(){
      trait_summary_hist_display_change(this.value);
    });
    jQuery('#trial_detail_traits_assayed_onswitch').click( function() {

        datatables_display_phenosummary(type);

        jQuery(document).on('change', '#display_trial_phenosummary', function() {
            var html = '';
            var display = jQuery('#display_trial_phenosummary').val();
            if (display == 'plots' || display == 'plants' || display == 'subplots' || display == 'tissue_samples') {
                html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>性狀(Trait)</th><th>平均值(Mean)</th><th>最小值(Min)</th><th>最大值(Max)</th><th>標準差(Std Dev)</th><th>變異係數(CV)</th><th>計數(Count)</th><th>缺失百分比(Percent Missing)</th><th>直方圖(Histogram)</th></tr></thead><tbody></tbody></table>';
            }
            if (display == 'plots_accession' || display == 'plants_accession' || display == 'tissue_samples_accession') {
                if (type == 'family_name') {
                    html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>家族名稱(Family Name)</th><th>性狀(Trait)</th><th>平均值(Mean)</th><th>最小值(Min)</th><th>最大值(Max)</th><th>標準差(Std Dev)</th><th>變異係數(CV)</th><th>計數(Count)</th><th>缺失百分比(Percent Missing)</th><th>直方圖(Histogram)</th></tr></thead><tbody></tbody></table>';
                } else if (type == 'cross') {
                    html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>雜交唯一ID(Cross Unique ID)</th><th>性狀(Trait)</th><th>平均值(Mean)</th><th>最小值(Min)</th><th>最大值(Max)</th><th>標準差(Std Dev)</th><th>變異係數(CV)</th><th>計數(Count)</th><th>缺失百分比(Percent Missing)</th><th>直方圖(Histogram)</th></tr></thead><tbody></tbody></table>';
                } else {
                    html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>種原(Accession)</th><th>性狀(Trait)</th><th>平均值(Mean)</th><th>最小值(Min)</th><th>最大值(Max)</th><th>標準差(Std Dev)</th><th>變異係數(CV)</th><th>計數(Count)</th><th>缺失百分比(Percent Missing)</th><th>直方圖(Histogram)</th></tr></thead><tbody></tbody></table>';
                }
            }
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });

%  if ($trial_stock_type eq 'analysis_instance') {
        trait_summary_hist_display_change('analysis_instance');
%  } else {
        trait_summary_hist_display_change('plot');
%  }

    });

    jQuery('#phenotype_summary_data').on('click', 'a[href^="#"]', function(event) {
        //console.log("scrolling histo into view");
        var offset = jQuery(window).height() - jQuery('#raw_data_histogram_well').height() - 40;
        var target = jQuery(this.getAttribute('href'));
        if( target.length ) {
            event.preventDefault();
            jQuery('html, body').stop().animate({
                scrollTop: target.offset().top - offset
            }, 1500);
        }
    });

    var plots_stock_text = '';
    var plants_stock_text = '';
    var tissue_samples_stock_text = '';

    if (type == 'family_name') {
        plots_stock_text = '此試驗中小區的性狀值（按家族名稱分組）';
        plants_stock_text = '此試驗中植株的性狀值（按家族名稱分組）';
        tissue_samples_stock_text = '此試驗中組織樣本的性狀值（按家族名稱分組）';
    } else if (type == 'cross') {
        plots_stock_text = '此試驗中小區的性狀值（按雜交唯一ID分組）';
        plants_stock_text = '此試驗中植株的性狀值（按雜交唯一ID分組）';
        tissue_samples_stock_text = '此試驗中組織樣本的性狀值（按雜交唯一ID分組）';
    } else {
        plots_stock_text = '此試驗中小區的性狀值（按種原分組）';
        plants_stock_text = '此試驗中植株的性狀值（按種原分組）';
        tissue_samples_stock_text = '此試驗中組織樣本的性狀值（按種原分組）';
    }
    jQuery('#plots_stock_option').text(plots_stock_text);
    jQuery('#plants_stock_option').text(plants_stock_text);
    jQuery('#tissue_samples_stock_option').text(tissue_samples_stock_text);

});

function datatables_display_phenosummary(type) {
    var summary_table = jQuery('#phenotype_summary_data').DataTable( {
        "lengthMenu": [ 10, 20, 50, 100, 500, 1000 ],
        "retrieve": true,
        "dom": 'Bfrtip',
        'columnDefs': [ {
            'orderable': false,
            'className': 'select-checkbox',
            'targets':   0
        } ],
        'select': {
            'style':    'multi'
        },
        "buttons":  [
            'pageLength','copy', 'excel', 'csv', 'pdf'
        ],
        "ajax": '/ajax/breeders/trial/'+ <% $trial_id %> + '/phenotypes?display='+jQuery('#display_trial_phenosummary').val() + '&trial_stock_type='+type,
    });

    var selection_changed = function () {
        var selected_rows = summary_table.rows({'selected':true});
        var table_type = jQuery('#display_trial_phenosummary').val();
        var list_type = table_type.match('accession') ? 'accessions' : 'traits';
        jQuery("#selected_row_count").text(selected_rows.count());
        // console.log(selected_rows.data());

        var selected_names = [];
        selected_rows.data().map(function(row){
            selected_names.push(row[0].match(/<a [^>]+>([^<]+)<\/a>/)[1] + '\n');
        });

        jQuery('#selected_names').html(selected_names);
        addToListMenu('names_to_list_menu', 'selected_names', {
            listType: list_type
        });
    };

    summary_table.on( 'draw', selection_changed);
    summary_table.on( 'deselect', selection_changed);
    summary_table.on( 'select', selection_changed);

    jQuery('.selectAll-dt').click(function(){
      summary_table.rows().select();
      return false;
    });
    jQuery('.deselectAll-dt').click(function(){
      summary_table.rows().deselect();
      return false;
    });
}

function trait_summary_hist_display_change(value) {
    jQuery.ajax ( {
        url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/traits_assayed?stock_type='+value,
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            //console.log(response);
            if (response.traits_assayed[0][0]) {
                var traits_assayed_html = "<select class='form-control' id='trial_summary_hist_dropdown'>";
                for (i=0; i<response.traits_assayed[0].length; i++) {
                    traits_assayed_html = traits_assayed_html + "<option value="+ response.traits_assayed[0][i][0] + " >" + response.traits_assayed[0][i][1] + "</option>";
                }
                traits_assayed_html = traits_assayed_html +"</select>";
                jQuery("#traits_assayed_dropdown").html(traits_assayed_html);
                jQuery("#traits_assayed_dropdown>select").change(function(){
                  trait_summary_hist_change(this.value);
                });

                jQuery('#traits_assayed_histogram_cvterm_link').html("<a href='/cvterm/"+response.traits_assayed[0][0][0]+"/view'>定義(Definition)</a>");

                jQuery.ajax( {
                    url : '/ajax/breeders/trial/'+ <% $trial_id %> +'/trait_phenotypes/?trait='+jQuery("#trial_summary_hist_dropdown").val()+'&display='+value,
                    type: 'POST',
                    success: function(response){
                        jQuery("#working_modal").modal("hide");
                        if (response.error) {
                            alert(response.error);
                        }
                        else if (response.status!="success"){
                            alert("載入植株/小區資料時發生問題："+response.status);
                        }
                        else {
                            draw_histogram(response.data, d3.select("#trial_summary_hist").node());
                        }
                    },
                    error: function(response) {
                        jQuery("#working_modal").modal("hide");
                        alert('擷取性狀直方圖資料時發生錯誤。');
                    }
                });
            } else {
                jQuery("#working_modal").modal("hide");
                jQuery("#trial_summary_hist").html("<center><h4>沒有可用於繪圖的資料。</h4></center>");
            }

        },
        error: function(response){
            alert('擷取此試驗中分析的性狀時發生錯誤');
        }

    });
}

function trait_summary_hist_change(value) {
    jQuery("#trial_summary_hist_dropdown").val(value);
    jQuery('#traits_assayed_histogram_cvterm_link').html("<a href='/cvterm/"+value+"/view'>定義(Definition)</a>");
    // console.log("value",value);
    jQuery.ajax( {
        url : '/ajax/breeders/trial/'+ <% $trial_id %> +'/trait_phenotypes/?trait='+value+'&display='+jQuery('#display_trial_phenosummary_hist').val(),
        type: 'POST',
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error) {
                alert(response.error);
            }
            else if (response.status!="success"){
                alert("載入植株/小區資料時發生問題："+response.status);
            }
            else {
                draw_histogram(response.data, d3.select("#trial_summary_hist").node());
            }
        },
        error: function(response) {
            jQuery("#working_modal").modal("hide");
            alert('擷取性狀直方圖資料時發生錯誤。');
        }
    });
}

//end of immediately inoked function
})();

</script>
