<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_type
$planting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$plot_width
$plot_length
$field_size
$field_trial_is_planned_to_be_genotyped
$field_trial_is_planned_to_cross
$trial_stock_type
$trial_owner
$company_id
$company_name
$company_project_is_private
$latest_trial_activity => undef
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b>試驗名稱</b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>[無試驗名稱]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>育種計畫</b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print "<span class='text-danger'>[無育種計畫]</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>試驗地點</b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name ( $country_name )";
% } else {
%  print "<span class='text-danger'>[無地點]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>年份</b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print "<span class='text-danger'>[無年份]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>此試驗中評估的材料類型</b></td>
                <td>
                    <div id="stock_type_in_trial">
% if ($trial_stock_type) {
%     print "$trial_stock_type";
% } else {
%     print "accession";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>試驗類型</b></td>
                <td>
                    <div id="trial_type">
% if ($trial_type) {
%  print "$trial_type";
% } else {
% print "<span class='text-danger'>[未設定類型]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>種植日期</b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $planting_date %>" ><% $planting_date %></a>
% } else {
%  print "<span class='text-danger'>[無種植日期]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>收穫日期</b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $harvest_date %>" ><% $harvest_date %></a>
% } else {
%  print "<span class='text-danger'>[無收穫日期]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b>描述</b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>[無描述]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>資料夾</b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link">新資料夾(New Folder)</button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link">變更資料夾(Change Folder)</button>
                </td>
            </tr>

	    <tr><td><b>建立者</b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>[N/A]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>公司名稱</b></td>
                <td>
                    <span id="copmany_name">
                        <a href="/company/<% $company_id %>"><% $company_name %></a>
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>是否對公司保密</b></td>
                <td>
                    <span id="copmany_project_is_private">
                        <% $company_project_is_private %>
                    </span>
                </td>
            </tr>

            <tr>
                <td><b>最新試驗活動</b></td>
                <td>
                    <div id="latest_trial_activity">
% if ($latest_trial_activity) {
%  print "<span class='text-success'>$latest_trial_activity</span>";
% } else {
%  print "<span class='text-danger'>[無記錄]</span>";
% }
                    </div>
                </td>
            </tr>

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>

        <table class="table table-hover table-bordered">
            <tr><td><b>小區寬度 (m)</b></td>
                <td>
                    <div id="trial_description">
% if ($plot_width) {
%  print "$plot_width";
% } else {
%  print "<span class='text-default'>[無小區寬度]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>小區長度 (m)</b></td>
                <td>
                    <div id="trial_description">
% if ($plot_length) {
%  print "$plot_length";
% } else {
%  print "<span class='text-default'>[無小區長度]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>田區大小 (ha)</b></td>
                <td>
                    <div id="trial_description">
% if ($field_size) {
%  print "$field_size";
% } else {
%  print "<span class='text-default'>[無田區大小]</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>試驗將進行基因分型</b></td>
                <td>
                    <div id="trial_description">
% if ($field_trial_is_planned_to_be_genotyped) {
%  print "$field_trial_is_planned_to_be_genotyped";
% } else {
%  print "no";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b>試驗將用於雜交</b></td>
                <td>
                    <div id="trial_description">
% if ($field_trial_is_planned_to_cross) {
%  print "$field_trial_is_planned_to_cross";
% } else {
%  print "no";
% }
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>
