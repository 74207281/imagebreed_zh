
<%args>
$trial_ids
$dialog_type => undef
$dialog_name => undef
</%args>


<div class="modal fade" id="download_trial_phenotypes_dialog" name="download_trial_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="downloadTrialPhenotypesDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="downloadTrialPhenotypesDialog">下載表型(Download Phenotypes) - <% $dialog_type %>  <% $dialog_name %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

          <form class="form-horizontal" role="form" method="post" >
            <div class="form-group">
                <label class="col-sm-3 control-label">格式：</label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_trial_phenotypes_format">
                        <option value="csv">CSV 寬格式 (Wide Format)</option>
                        <option value="csv_long">CSV 長格式 (Long Format)</option>
                        <option value="xlsx">Excel (xlsx) 寬格式 (Wide Format)</option>
                        <option value="xlsx_long">Excel (xlsx) 長格式 (Long Format)</option>
                    </select>
                </div>
	        </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">資料層級：</label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_trial_phenotypes_level_option">
                        <option value="all">所有層級</option>
%  if ($dialog_type ne 'Analysis') {
                        <option value="plot">小區</option>
                        <option value="plant">植株</option>
                        <option value="subplot">次小區</option>
%  }
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">重複測量值：</label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_trial_phenotypes_repeated_measurements">
                        <option value="all">所有數值</option>
                        <option value="average">平均重複數值</option>
                        <option value="first">第一筆數值</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">性狀：<br/><small>（不選擇即代表所有性狀）</small></label>
                <div class="col-sm-9" >
                    <div id="download_trial_phenotypes_traits">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">性狀組成部分：<br/><small>（不選擇即代表全部）</small></label>
                <div class="col-sm-9" >
                    <div id="download_trial_phenotypes_trait_components">
                    </div>
                </div>
            </div>

<&| /page/info_section.mas, title=>"其他搜尋選項(Additional Search Options)",  collapsible => 1, collapsed=>1 &>

            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">包含時間戳記：</label>
                        <div class="col-sm-6" >
                            <select class="form-control" id="download_trial_phenotypes_timestamp_option">
                                <option value="0">否</option>
                                <option value="1">是</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">排除使用者定義的離群值：</label>
                        <div class="col-sm-6" >
                            <select class="form-control" id="download_trial_phenotypes_exclude_outliers">
                                <option value="0">否</option>
                                <option value="1">是</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">包含標頭：</label>
                        <div class="col-sm-6" >
                            <select class="form-control" id="download_trial_phenotypes_include_headers">
                                <option value="0">否</option>
                                <option value="1">是</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">包含種原項目編號：</label>
                        <div class="col-sm-6" >
                            <select class="form-control" id="download_trial_phenotypes_entry_numbers_option">
                                <option value="1">是</option>
                                <option value="0">否</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">性狀名稱包含：</label>
                <div class="col-sm-9" >
                    <input id="download_trial_phenotype_trait_contains" name="download_trial_phenotype_trait_contains" type="text" class="form-control" placeholder="例如：storage root,oxoglutarate"/>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-8 control-label">最小表型值：</label>
                        <div class="col-sm-4" >
                            <input id="download_trial_phenotype_phenotype_min" name="download_trial_phenotype_phenotype_min" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-8 control-label">最大表型值：</label>
                        <div class="col-sm-4" >
                            <input id="download_trial_phenotype_phenotype_max" name="download_trial_phenotype_phenotype_max" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
</&>
        </form><br/>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="download_trial_phenotypes_cancel_button" id="download_trial_phenotypes_cancel_button" data-dismiss="modal">關閉(Close)</button>
        <button type="button" class="btn btn-primary" name="download_trial_phenotypes_submit_button" id="download_trial_phenotypes_submit_button" title="送出(Submit)">送出(Submit)</button>
      </div>
    </div>
  </div>
</div>

<script>

jQuery(document).ready(function() {

  jQuery('#trial_download_phenotypes_button').click( function () {
    jQuery('#download_trial_phenotypes_dialog').modal("show");
    data_level_change_traits();
  });

  jQuery(document).on('change', "#download_trial_phenotypes_level_option", function() {
    data_level_change_traits();
  });

  jQuery('#download_trial_phenotypes_submit_button').click( function () {
    var trial_ids = "<% $trial_ids %>";
    var trial_id_array = trial_ids.split(",");
    var format = jQuery("#download_trial_phenotypes_format").val();
    var timestamp = jQuery("#download_trial_phenotypes_timestamp_option").val();
    var entry_numbers = jQuery("#download_trial_phenotypes_entry_numbers_option").val();
    var trait_contains = jQuery("#download_trial_phenotype_trait_contains").val();
    var trait_contains_array = trait_contains.split(",");
    var traits = jQuery("#download_trial_phenotypes_traits_select").val();
    var trait_components = jQuery("#download_trial_phenotypes_trait_components_select").val();
    var data_level = jQuery("#download_trial_phenotypes_level_option").val();
    var phenotype_min_value = jQuery("#download_trial_phenotype_phenotype_min").val();
    var phenotype_max_value = jQuery("#download_trial_phenotype_phenotype_max").val();
    var exclude_phenotype_outlier = jQuery("#download_trial_phenotypes_exclude_outliers").val();
    var repeated_measurements = jQuery('#download_trial_phenotypes_repeated_measurements').val();
    var include_header = jQuery('#download_trial_phenotypes_include_headers').val();

    var first_value_only = 0;
    var average_repeat = 0;
    if (repeated_measurements == 'average') {
        average_repeat = 1;
    }
    else if (repeated_measurements == 'first') {
        first_value_only = 1;
    }

    window.open("/breeders/trials/phenotype/download?trial_list="+JSON.stringify(trial_id_array)+"&format="+format+"&timestamp="+timestamp+"&entry_numbers="+entry_numbers+"&trait_contains="+JSON.stringify(trait_contains_array)+"&trait_component_list="+JSON.stringify(trait_components)+"&trait_list="+JSON.stringify(traits)+"&dataLevel="+data_level+"&phenotype_min_value="+phenotype_min_value+"&phenotype_max_value="+phenotype_max_value+"&exclude_phenotype_outlier="+exclude_phenotype_outlier+"&return_only_first_measurement="+first_value_only+"&average_repeat_measurements="+average_repeat+"&has_header="+include_header);
  });

});

function data_level_change_traits() {
    get_select_box('traits', 'download_trial_phenotypes_traits', { 'name' : 'download_trial_phenotypes_traits_select', 'id' : 'download_trial_phenotypes_traits_select', 'trial_ids':'<% $trial_ids %>', 'data_level':jQuery('#download_trial_phenotypes_level_option').val(), 'multiple': true });
    get_select_box('phenotyped_trait_components', 'download_trial_phenotypes_trait_components', { 'name' : 'download_trial_phenotypes_trait_components_select', 'id' : 'download_trial_phenotypes_trait_components_select', 'trial_ids':'<% $trial_ids %>', 'data_level':jQuery('#download_trial_phenotypes_level_option').val() });
}
</script>
