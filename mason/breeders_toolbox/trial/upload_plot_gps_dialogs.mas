<%args>
$trial_id
</%args>

<div class="modal fade" id="upload_plot_gps_dialog" name="upload_plot_gps_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlotGPSDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlotGPSDialog">上傳小區 GPS 座標(Upload GPS Coordinates for Plots)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /page/explanation.mas, title=>'範本資訊(Template information)' &>
                        <p>
                            <b>檔案格式資訊</b>
                            <br>
                            <a id="trial_upload_plot_gps_spreadsheet_info_format">試算表格式(Spreadsheet format)</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_plot_gps_dialog_form" name="upload_plot_gps_dialog_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">上傳檔案（.xls 或 .xlsx）：</label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_plot_gps_file" id="trial_upload_plot_gps_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form><br/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="upload_plot_gps_cancel_button" id="upload_plot_gps_cancel_button" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_plot_gps_save_button" id="upload_plot_gps_save_button" title="上傳(Upload)">上傳(Upload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_plot_gps_spreadsheet_info_dialog" name="upload_plot_gps_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlotGPSInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlotGPSInfoDialog">上傳範本資訊(Upload Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>此處用於記錄小區的 GPS 座標。</b>
                    <br/>
                    <b>GPS 座標可以透過 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <b>標頭：</b>
                    <br>
                    第一行（標頭）應包含以下內容：

                    <h3>每個小區表示為具有四個角的多邊形。您可以選擇上傳 UTM31N 和/或 WGS84 座標。</h3>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>plot_name</td>
                                <td>WGS84_bottom_left_x</td>
                                <td>WGS84_bottom_left_y</td>
                                <td>WGS84_bottom_right_x</td>
                                <td>WGS84_bottom_right_y</td>
                                <td>WGS84_top_right_x</td>
                                <td>WGS84_top_right_y</td>
                                <td>WGS84_top_left_x</td>
                                <td>WGS84_top_left_y</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <br/>
                    plot_name（小區名稱，必須存在於資料庫中）
                    <br />
                    WGS84_bottom_left_x（小區左下角 WGS84 經度座標）
                    <br />
                    WGS84_bottom_left_y（小區左下角 WGS84 緯度座標）
                    <br />
                    WGS84_bottom_right_x（小區右下角 WGS84 經度座標）
                    <br />
                    WGS84_bottom_right_y（小區右下角 WGS84 緯度座標）
                    <br />
                    WGS84_top_right_x（小區右上角 WGS84 經度座標）
                    <br />
                    WGS84_top_right_y（小區右上角 WGS84 緯度座標）
                    <br />
                    WGS84_top_left_x（小區左上角 WGS84 經度座標）
                    <br />
                    WGS84_top_left_y（小區左上角 WGS84 緯度座標）
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_plot_gps_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function () {

    jQuery('#trial_upload_plot_gps_button').click( function () {
        jQuery('#upload_plot_gps_dialog').modal("show");
    });

    jQuery('#trial_upload_plot_gps_spreadsheet_info_format').click( function () {
        jQuery('#upload_plot_gps_spreadsheet_info_dialog').modal("show");
    });
    
    jQuery('#upload_plot_gps_save_button').click( function () {
        upload_plot_gps();
    });

    function upload_plot_gps() {
        var uploadFile = jQuery("#trial_upload_plot_gps_file").val();
        jQuery('#upload_plot_gps_dialog_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_plot_gps");
        if (uploadFile === '') {
            alert("請選取檔案");
            return;
        }
        jQuery("#upload_plot_gps_dialog_form").submit();
    }

    jQuery('#upload_plot_gps_dialog_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedFile = jQuery("#trial_upload_plot_gps_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("未選取檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert("檔案上傳成功");
                window.location.replace('/breeders/trial/'+<% $trial_id %>);
            }
        }
    });

});

</script>
