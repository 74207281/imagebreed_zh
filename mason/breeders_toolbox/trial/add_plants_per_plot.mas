
<%args>
$trial_id
$trial_name => undef
</%args>

<div class="modal fade" id="add_plants_dialog" name="add_plants_dialog" tabindex="-1" role="dialog" aria-labelledby="addPlantsDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addPlantsDialog">新增植株至 <% $trial_name %>(Add plants to <% $trial_name %>)</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

	       <form class="form-horizontal" role="form" method="post" id="add_plants_dialog_form" name="add_plants_dialog_form">
	        <div class="form-group">
      	      <label class="col-sm-3 control-label">每個小區最大植株數：</label>
      	      <div class="col-sm-9" >
                <input name="add_plants_per_plot_num" id="add_plants_per_plot_num" class="form-control" type="number" autofocus/>
              </div>
	        </div>
            <div class="form-group">
      	      <label class="col-sm-3 control-label">從小區繼承管理因子：</label>
      	      <div class="col-sm-9" >
                <input name="add_plants_per_plot_inherit_treatments" id="add_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
              </div>
	        </div>
	       </form><br/>
         
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="add_plants_cancel_button" id="add_plants_cancel_button" data-dismiss="modal">關閉(Close)</button>
	      <button type="button" class="btn btn-primary" name="add_plants_save_button" id="add_plants_save_button" title="儲存(Save)">儲存(Save)</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="upload_plants_dialog" name="upload_plants_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsDialog">上傳植株至 <% $trial_name %>(Upload plants to <% $trial_name %>)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                        <p>
                            <b>檔案格式資訊</b>
                            <br>
                            <a id="trial_upload_plants_spreadsheet_info_format">試算表格式</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_plants_dialog_form" name="upload_plants_dialog_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_plants_file" id="trial_upload_plants_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">每個小區最大植株數：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_per_plot_number" id="upload_plants_per_plot_number" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">從小區繼承管理因子：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_per_plot_inherit_treatments" id="upload_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
                            </div>
                        </div>
                    </form><br/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="upload_plants_cancel_button" id="upload_plants_cancel_button" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_plants_save_button" id="upload_plants_save_button" title="上傳(Upload)">上傳(Upload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_plants_spreadsheet_info_dialog" name="upload_plants_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsInfoDialog">範本資訊(Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>用於記錄小區內的各個植株。</b>
                    <br/>
                    <b>植株名稱可以 Excel 檔案（.xls 或 .xlsx）格式上傳</b>
                    <br />
                    <b>標題欄（Header）：</b>
                    <br>
                    第一列（標題欄）應包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>plot_name</td>
                                <td>plant_name</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <br/>
                    plot_name（必須已存在於資料庫中）
                    <br />
                    plant_name（必須全域唯一。通常為 plot_name + plant_number 的串接，例如 MyTrial_plot101_plant1）
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_plants_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="upload_plants_with_index_number_dialog" name="upload_plants_with_index_number_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsWithIndexNumberDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsWithIndexNumberDialog">依植株索引編號上傳植株至 <% $trial_name %>(Upload plants to <% $trial_name %> with plant index number)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                        <p>
                            <b>檔案格式資訊</b>
                            <br>
                            <a id="trial_upload_plants_with_index_number_spreadsheet_info_format">試算表格式</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_plants_with_index_number_dialog_form" name="upload_plants_with_index_number_dialog_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_plants_with_index_number_file" id="trial_upload_plants_with_index_number_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">每個小區最大植株數：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_with_index_number_per_plot_number" id="upload_plants_with_index_number_per_plot_number" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">從小區繼承管理因子：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_with_index_number_inherit_treatments" id="upload_plants_with_index_number_inherit_treatments" type="checkbox" checked disabled/>
                            </div>
                        </div>
                    </form><br/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="upload_plants_with_index_number_cancel_button" id="upload_plants_with_index_number_cancel_button" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_plants_with_index_number_save_button" id="upload_plants_with_index_number_save_button" title="上傳(Upload)">上傳(Upload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_plants_with_index_number_spreadsheet_info_dialog" name="upload_plants_with_index_number_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsWithIndexNumberInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsWithIndexNumberInfoDialog">範本資訊(Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>用於記錄小區內的各個植株。植株名稱將儲存為 plot_name + _ + plant_index_number 的串接</b>
                    <br/>
                    <b>可以 Excel 檔案（.xls 或 .xlsx）格式上傳</b>
                    <br />
                    <b>標題欄（Header）：</b>
                    <br>
                    第一列（標題欄）應包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>plot_name</td>
                                <td>plant_index_number</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <br/>
                    plot_name（必須已存在於資料庫中）
                    <br />
                    plant_index_number（必須為數字。儲存的植株名稱將為 plot_name + plant_index_number 的串接，例如 MyTrial_plot101_plant1。）
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_plants_with_index_number_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_plants_with_number_of_plants_number_dialog" name="upload_plants_with_number_of_plants_number_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsWithNumPlantsPerPlotDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsWithNumPlantsPerPlotDialog">依每個小區植株數上傳植株至 <% $trial_name %>(Upload plants to <% $trial_name %> with number of plants per plot)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                        <p>
                            <b>檔案格式資訊</b>
                            <br>
                            <a id="trial_upload_plants_with_num_plants_spreadsheet_info_format">試算表格式</a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_plants_with_num_plants_dialog_form" name="upload_plants_with_num_plants_dialog_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_plants_with_number_of_plants_file" id="trial_upload_plants_with_number_of_plants_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">每個小區最大植株數：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_with_num_plants_per_plot_number" id="upload_plants_with_num_plants_per_plot_number" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">從小區繼承管理因子：</label>
                            <div class="col-sm-8" >
                                <input name="upload_plants_with_num_plants_inherit_treatments" id="upload_plants_with_num_plants_inherit_treatments" type="checkbox" checked disabled/>
                            </div>
                        </div>
                    </form><br/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="upload_plants_with_num_plants_cancel_button" id="upload_plants_with_num_plants_cancel_button" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_plants_with_num_plants_save_button" id="upload_plants_with_num_plants_save_button" title="上傳(Upload)">上傳(Upload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_plants_with_num_plants_spreadsheet_info_dialog" name="upload_plants_with_num_plants_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPlantsWithNumPlantsInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPlantsWithNumPlantsInfoDialog">範本資訊(Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>用於記錄小區內的各個植株。植株名稱將儲存為 plot_name + _ + plant_index_number 的串接，共建立由 num_plants_per_plot 指定數量的植株</b>
                    <br/>
                    <b>可以 Excel 檔案（.xls 或 .xlsx）格式上傳</b>
                    <br />
                    <b>標題欄（Header）：</b>
                    <br>
                    第一列（標題欄）應包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>plot_name</td>
                                <td>num_plants_per_plot</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <br/>
                    plot_name（必須已存在於資料庫中）
                    <br />
                    num_plants_per_plot（必須為數字。即小區中的植株數量。儲存的植株名稱將為 plot_name + plant_number 的串接，例如 MyTrial_plot101_plant1）
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_plants_with_number_plants_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function() {

    jQuery('#create_plant_entries_button').click( function () {
        jQuery('#add_plants_dialog').modal("show");
    });

    jQuery('#upload_plant_entries_button').click( function () {
        jQuery('#upload_plants_dialog').modal("show");
    });

    jQuery('#upload_plant_entries_with_index_number_button').click( function () {
        jQuery('#upload_plants_with_index_number_dialog').modal("show");
    });

    jQuery('#trial_upload_plants_spreadsheet_info_format').click( function () {
        jQuery('#upload_plants_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#trial_upload_plants_with_index_number_spreadsheet_info_format').click( function () {
        jQuery('#upload_plants_with_index_number_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#trial_upload_plants_with_num_plants_button').click( function () {
        jQuery('#upload_plants_with_number_of_plants_number_dialog').modal("show");
    });

    jQuery('#trial_upload_plants_with_num_plants_spreadsheet_info_format').click( function () {
        jQuery('#upload_plants_with_num_plants_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#add_plants_save_button').click( function () {
        add_plants_to_trial();
    });

    jQuery('#upload_plants_save_button').click( function () {
        upload_plants_to_trial();
    });

    jQuery('#upload_plants_with_index_number_save_button').click( function () {
        upload_plants_with_index_number_to_trial();
    });

    jQuery('#upload_plants_with_num_plants_save_button').click( function () {
        upload_plants_with_num_plants_to_trial();
    });

    function upload_plants_to_trial() {
        var uploadFile = jQuery("#trial_upload_plants_file").val();
        jQuery('#upload_plants_dialog_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_plants");
        if (uploadFile === '') {
            alert("請選擇檔案");
            return;
        }
        jQuery("#upload_plants_dialog_form").submit();
    }

    jQuery('#upload_plants_dialog_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedPlantsFile = jQuery("#trial_upload_plants_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedPlantsFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert("檔案上傳成功");
                window.location.replace('/breeders/trial/'+<% $trial_id %>);
            }
        }
    });

    function upload_plants_with_index_number_to_trial() {
        var uploadFile = jQuery("#trial_upload_plants_with_index_number_file").val();
        jQuery('#upload_plants_with_index_number_dialog_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_plants_with_plant_index_number");
        if (uploadFile === '') {
            alert("請選擇檔案");
            return;
        }
        jQuery("#upload_plants_with_index_number_dialog_form").submit();
    }

    jQuery('#upload_plants_with_index_number_dialog_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedPlantsFile = jQuery("#trial_upload_plants_with_index_number_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedPlantsFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert("檔案上傳成功");
                window.location.replace('/breeders/trial/'+<% $trial_id %>);
            }
        }
    });

    function upload_plants_with_num_plants_to_trial() {
        var uploadFile = jQuery("#trial_upload_plants_with_number_of_plants_file").val();
        jQuery('#upload_plants_with_num_plants_dialog_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_plants_with_number_of_plants");
        if (uploadFile === '') {
            alert("請選擇檔案");
            return;
        }
        jQuery("#upload_plants_with_num_plants_dialog_form").submit();
    }

    jQuery('#upload_plants_with_num_plants_dialog_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedPlantsFile = jQuery("#trial_upload_plants_with_number_of_plants_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedPlantsFile === '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert("檔案上傳成功");
                window.location.replace('/breeders/trial/'+<% $trial_id %>);
            }
        }
    });

});

function add_plants_to_trial() {

    var is_checked;
    if(jQuery('#add_plants_per_plot_inherit_treatments').is(":checked")){
        is_checked = 1;
    }

    jQuery.ajax( {
      url: '/ajax/breeders/trial/'+<% $trial_id %>+'/create_plant_entries/',
      type: 'POST',
      beforeSend: function() {
          enable_working_modal();
      },
      data: {
        'plants_per_plot' : jQuery('#add_plants_per_plot_num').val(),
        'inherits_plot_treatments' : is_checked
      },
      success: function(response) {
        disable_working_modal();
        if (response.error) {
          alert(response.error);
        }
        else {
          alert("已成功建立植株項目。");
          jQuery('#add_plants_dialog').modal("hide");
          window.location.replace('/breeders/trial/'+<% $trial_id %>);
        }
      },
      error: function(response) {
        disable_working_modal();
        alert("儲存植株項目時發生錯誤");
      },
    });

}

function enable_working_modal() {
    jQuery("#working_modal").modal("show");
}

function disable_working_modal() {
    jQuery("#working_modal").modal("hide");
}

function enable_plants_datatable() {
    jQuery('#trial_plants_table_html').DataTable();
}

</script>
