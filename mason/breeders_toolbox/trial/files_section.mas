<%args>
$trial_id
$trial_stock_type => undef
$for_analysis_page => undef
</%args>

<div class="well well-sm">

    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"資料收集檔案(Data Collection Files)", is_subsection => 1, collapsible=>1, collapsed=>0, &>
                <&| /page/info_section.mas, title=>"表型鑑定試算表(Phenotyping Spreadsheets)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-default" style="margin:3px" name="create_spreadsheet_link">建立試算表(Create Spreadsheet)</button>' &>
                </&>
%  if (!$for_analysis_page) {
                <&| /page/info_section.mas, title=>"Android 田間手冊配置(Android Field Book Layout)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-default" style="margin:3px" name="create_fieldbook_link">建立田間手冊(Create Field Book)</button>' &>
                </&>
                <&| /page/info_section.mas, title=>"Data Collector 試算表(Data Collector Spreadsheet)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=> '<button class="btn btn-sm btn-default" style="margin:3px" id="create_DataCollector_link">建立 DataCollector 試算表(Create DataCollector Spreadsheet)</button>' &>
                </&>
%  }
            </&><!-- closes create new phenotyping file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"上傳表型檔案(Upload Phenotyping Files)", is_subsection => 1, collapsible=>1, collapsed=>0, &>
                <&| /page/info_section.mas, title=>"表型鑑定試算表(Phenotyping Spreadsheets)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_spreadsheet_phenotypes_link">上傳(Upload)</button>'&>
                </&>
%  if (!$for_analysis_page) {
                <&| /page/info_section.mas, title=>"Android 田間手冊匯出檔(Android Field Book Exported)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_fieldbook_phenotypes_link">上傳(Upload)</button>'&>
                </&>
                <&| /page/info_section.mas, title=>"Data Collector 試算表(Data Collector Spreadsheet)", empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_datacollector_phenotypes_link">上傳(Upload)</button>'&>
                </&>
%  }
            </&><!-- closes upload new phenotype file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"已上傳之表型檔案(Uploaded Phenotyping Files)", is_subsection => 1, collapsible=>1, collapsed=>0 &>

                <table class="table table-bordered" id="trial_phenotype_files_datatables" alt="">
                </table>

            </&><!-- closes uploaded file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>"已上傳之附加檔案(Uploaded Additional Files)", is_subsection => 1, collapsible=>1, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="trial_upload_additional_files_link">上傳附加檔案(Upload Additional Files)</button>' &>

            <& /breeders_toolbox/trial/upload_additional_file.mas, trial_id => $trial_id &>

            </&><!-- closes uploaded additional file section -->
        </div>
    </div>

</div><!-- closes well -->

<script>
jQuery(document).ready(function() {
    jQuery('#trial_upload_files_onswitch').one("click", function(){

        jQuery('#trial_phenotype_files_datatables').DataTable({
            'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/phenotype_metadata' },
            columns: [
                { title: "檔案名稱(Filename)", "data": null, "render": function ( data, type, row ) { return row[4]; } },
                { title: "上傳日期(Date Uploaded)", "data": null, "render": function ( data, type, row ) { return row[1]; } },
                { title: "上傳者(Uploaded By)", "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
                { title: "檔案類型(File Type)", "data": null, "render": function ( data, type, row ) { return row[6]; } },
                { title: "選項(Options)", "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+'">檢視</a> | <a href="/breeders/phenotyping/download/'+row[0]+'">下載</a>'; } },
            ]
        });

    });
});
</script>
