<%args>
$trial_id => undef
$trial_name => undef
$is_analysis => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<!--div class="well well-sm">
    <button class="btn btn-primary btn-sm" id="trial_detail_page_analysis_rr_workflow">Calculate Random Regression Permanent Environment (PE) Effects</button>
</div-->

<div class="modal fade" id="trial_analysis_2dspl_rr_workflow_dialog" name="trial_analysis_2dspl_rr_workflow_dialog" tabindex="-1" role="dialog" aria-labelledby="trialAnalysisRRWorkflowDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialAnalysisRRWorkflowDialog">尋找 <% $trial_name %> 中測量值的隨機迴歸時間校正(Find Random Regression Temporal Correction for Measurements in <% $trial_name %>)</h4>
            </div>
            <div class="modal-body">

                <&| /util/workflow.mas, id=> "trial_analysis_rr_workflow_dialog_workflow" &>
                    <&| /util/workflow.mas:step, title=> "輸入(Input)" &>
                        <& /page/page_title.mas, title=>"選擇用於執行隨機迴歸的輸入測量值(Select the input measurements to run random regression on)" &>

                        <div class="container-fluid">
                            <div class="form-horizontal">

%  if ($is_analysis) {
                                <input type="hidden" id="trial_analysis_rr_workflow_observation_level" name="trial_analysis_rr_workflow_observation_level" value="analysis_instance" />
%  } else {
                                <input type="hidden" id="trial_analysis_rr_workflow_observation_level" name="trial_analysis_rr_workflow_observation_level" value="plot" />
%  }

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">隨機迴歸方法：</label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_analysis_rr_workflow_model_type">
                                            <option value="">選擇模型</option>
                                            <option value="airemlf90_legendre_rr">AIREMLF90 勒壤得多項式(Legendre Polynomial)：(y1, .., yn) ~ f(rep) + r(G, leg(z)) + r(E, leg(z)) + e_het</option>
                                            <option value="sommer_legendre_rr">Sommer 勒壤得多項式(Legendre Polynomial)：(y1, .., yn) ~ f(rep) + r(G, leg(z)) + r(E, leg(z)) + e</option>
                                        </select>
                                    </div>
                                </div>
                                <div id="trial_analysis_rr_workflow_model_type_desc"></div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">性狀：</label>
                                    <div class="col-sm-9" >
                                        <div id="trial_analysis_rr_workflow_traits_div"></div>
                                    </div>
                                </div>

                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">親緣關係：</label>
                                        <div class="col-sm-9" >
                                            <select class="form-control" id="trial_analysis_rr_workflow_genetic_relationship_type">
                                                <option value="identity">單位矩陣(Identity Matrix)（所有種原關係相等）</option>
                                                <option value="grm">基因體親緣關係矩陣(Genomic Relationship Matrix)（來自全基因體標記資料的種原親緣關係）</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div id="trial_analysis_rr_workflow_grm_select_div" style="display:none">
                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="well well-sm">
                                                    <div class="form-group">
                                                        <label class="col-sm-3 control-label">基因體親緣關係矩陣 (GRM) 協定：</label>
                                                        <div class="col-sm-9" >
                                                            <div id="trial_analysis_rr_workflow_grm_div"></div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <p>僅顯示連結到此田間試驗的 GRM 協定。請在試驗詳細資訊頁面的「基因體親緣關係矩陣」區段中為此田間試驗連結和/或建立新的 GRM 協定。如果親本種原與後代之間的譜系資訊可用，可以直接為田間試驗中的種原或從親本基因型建立 GRM 協定。</p>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">容許度(Tolerance)：</label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_analysis_rr_workflow_tolerance">
                                            <option value="0.001">0.001</option>
                                            <option value="0.01">0.01</option>
                                            <option value="0.000001">0.000001</option>
                                            <option value="0.00001">0.00001</option>
                                            <option value="0.0001">0.0001</option>
                                            <option value="0.0005">0.0005</option>
                                            <option value="0.0008">0.0008</option>
                                            <option value="0.05">0.05</option>
                                            <option value="0.08">0.08</option>
                                            <option value="0.1">0.1</option>
                                            <option value="0.2">0.2</option>
                                            <option value="0.5">0.5</option>
                                            <option value="1">1</option>
                                            <option value="10">10</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">勒壤得多項式階數：</label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_analysis_rr_workflow_legendre_order">
                                            <option value="3">3</option>
                                        </select>
                                    </div>
                                </div>

                            </div>

                            <hr>
                            <center>
                                <button type="button" class="btn btn-primary" name="trial_analysis_rr_workflow_submit" id="trial_analysis_rr_workflow_submit" title="送出(Submit)">送出(Submit)</button>
                            </center>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> "輸出(Output)" &>
                        <& /page/page_title.mas, title=>"結果(Results)" &>

                        <div id="trial_analysis_rr_workflow_results_div"></div>
                    </&>
                </&>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#trial_detail_page_analysis_rr_workflow').click( function(){
        jQuery('#trial_analysis_2dspl_rr_workflow_dialog').modal('show');

        get_select_box('traits', 'trial_analysis_rr_workflow_traits_div', { 'name' : 'trial_analysis_rr_workflow_trait_ids', 'id' : 'trial_analysis_rr_workflow_trait_ids', 'empty':1, 'multiple':1, 'size': 20, 'trial_ids':<% $trial_id %>, 'stock_type':'plot', 'contains_composable_cv_type':'time_ontology', 'select_format':'component_table_select' });

        get_select_box('genotyping_protocol', 'trial_analysis_rr_workflow_grm_div', { 'name' : 'trial_analysis_rr_workflow_grm_id', 'id' : 'trial_analysis_rr_workflow_grm_id', 'only_grm_protocols':1, 'empty':1, 'field_trial_ids':<% $trial_id %> });
    });

    var trial_analysis_rr_workflow_model_type_val = '';
    jQuery('#trial_analysis_rr_workflow_model_type').change(function(){
        trial_analysis_rr_workflow_model_type_val = jQuery(this).val();

        if (trial_analysis_rr_workflow_model_type_val == '') {
            jQuery('#trial_analysis_rr_workflow_model_type_desc').html('');
        }
        if (trial_analysis_rr_workflow_model_type_val == 'airemlf90_legendre_rr') {
            jQuery('#trial_analysis_rr_workflow_model_type_desc').html('<div class="well well-sm"><p>所選性狀將以多變量方式在同一個模型中全部執行。重複(replicate)為固定效應。加性遺傳效應 (G) 依勒壤得多項式設定為隨機效應。永久環境效應 (E) 依勒壤得多項式設定為隨機效應。異質殘差誤差。此模型於 AIREMLF90 中執行。</p></div>');
        }
        if (trial_analysis_rr_workflow_model_type_val == 'sommer_legendre_rr') {
            jQuery('#trial_analysis_rr_workflow_model_type_desc').html('<div class="well well-sm"><p>所選性狀將以多變量方式在同一個模型中全部執行。重複(replicate)為固定效應。加性遺傳效應 (G) 依勒壤得多項式設定為隨機效應。永久環境效應 (E) 依勒壤得多項式設定為隨機效應。此模型於 R Sommer 中執行。</p></div>');
        }
    });

    var trial_analysis_rr_workflow_grm_type_val = '';
    jQuery('#trial_analysis_rr_workflow_genetic_relationship_type').change(function(){
        trial_analysis_rr_workflow_grm_type_val = jQuery(this).val();

        if (trial_analysis_rr_workflow_grm_type_val == 'identity') {
            jQuery('#trial_analysis_rr_workflow_grm_select_div').hide();
        }
        if (trial_analysis_rr_workflow_grm_type_val == 'grm') {
            jQuery('#trial_analysis_rr_workflow_grm_select_div').show();
        }
    });

    var trial_analysis_rr_workflow_response_trait_ids = [];
    var trial_analysis_r_workflow_response_postcomposing_info = {};
    var trial_analysis_rr_workflow_response_spatial_data = {};
    var trial_analysis_rr_workflow_response_heatmap_graphs = {};
    jQuery('#trial_analysis_rr_workflow_submit').click(function() {
        var selected_trait_ids = [];
        jQuery('input[name="trial_analysis_rr_workflow_trait_ids"]').each(function() {
            if (this.checked){
                selected_trait_ids.push(jQuery(this).val());
            }
        });

        console.log(selected_trait_ids);

        var trial_analysis_rr_workflow_grm_id = jQuery('#trial_analysis_rr_workflow_grm_id').val();

        if (!selected_trait_ids || selected_trait_ids.length < 1) {
            alert('請至少選擇一個性狀！');
            return false;
        }
        else if (trial_analysis_rr_workflow_model_type_val == '') {
            alert('請選擇一個分析！');
            return false;
        }
        else if (trial_analysis_rr_workflow_grm_type_val == 'grm' && trial_analysis_rr_workflow_grm_id == '') {
            alert('如果要使用基因體親緣關係，請選擇 GRM 協定！您也可以隨時改用單位矩陣！');
            return false;
        }
        else {
            jQuery.ajax({
                type : 'POST',
                url : '/ajax/breeders/trial/<% $trial_id %>/random_regression_correct_traits',
                data : {
                    'trait_ids': JSON.stringify(selected_trait_ids),
                    'observation_unit_level': jQuery('#trial_analysis_correlation_workflow_observation_level').val(),
                    'model_type': trial_analysis_rr_workflow_model_type_val,
                    'genomic_relationship_type': trial_analysis_rr_workflow_grm_type_val,
                    'genomic_relationship_protocol_id': trial_analysis_rr_workflow_grm_id,
                    'tolparinv': jQuery('#trial_analysis_rr_workflow_tolerance').val(),
                    'legendre_order': jQuery('#trial_analysis_rr_workflow_legendre_order').val()
                },
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                },
                success: function(response) {
                    console.log(response);
                    jQuery("#working_modal").modal("hide");
                    if (response.error) {
                        alert(response.error);
                    }
                    else {
                        trial_analysis_rr_workflow_response_trait_ids = response.trait_ids;
                        trial_analysis_rr_workflow_response_postcomposing_info = response.postcomposing_info;
                        trial_analysis_rr_workflow_response_spatial_data = response.result_blup_spatial_data_original;
                        trial_analysis_rr_workflow_response_heatmap_graphs = [response.heatmaps_plot];

                        var html = '<div class="well well-sm"><button class="btn btn-primary" id="trial_analysis_rr_workflow_results_save_button" >儲存永久環境 (PE) 效應結果至 <% $trial_name %>(Save Permanent Environment (PE) Effect Results to <% $trial_name %>)</button></div><div class="well well-sm"><h4>繪製的圖形如下：</h4><button class="btn btn-default" id="trial_analysis_rr_workflow_results_save_graphs_button" >匯出圖形至檔案(Export Graph to File)</button><br/><br/>';
                        html = html + '<img src="'+response.heatmaps_plot+'" />';
                        html = html + '<img src="'+response.gen_effects_line_plot+'" /></div>';
                        jQuery('#trial_analysis_rr_workflow_results_div').html(html);

                        Workflow.complete("#trial_analysis_rr_workflow_submit");
                        Workflow.focus('#trial_analysis_rr_workflow_dialog_workflow', 1);
                    }
                },
                error: function(response){
                    jQuery("#working_modal").modal("hide");
                    alert('進行隨機迴歸時發生錯誤！請嘗試較大的容許度！');
                }
            });
        }

    });

    jQuery(document).on('click', '#trial_analysis_rr_workflow_results_save_graphs_button', function() {
        for (var i=0; i<trial_analysis_rr_workflow_response_heatmap_graphs.length; i++) {
            window.open(trial_analysis_rr_workflow_response_heatmap_graphs[i], '_blank');
        }
    });

    jQuery(document).on('click', '#trial_analysis_rr_workflow_results_save_button', function() {
        jQuery.ajax({
            type : 'POST',
            url : '/ajax/breeders/trial/<% $trial_id %>/upload_phenotypes',
            data : {
                'trait_ids': JSON.stringify(trial_analysis_rr_workflow_response_trait_ids),
                'postcomposing_info': JSON.stringify(trial_analysis_rr_workflow_response_postcomposing_info),
                'pheno_data': JSON.stringify(trial_analysis_rr_workflow_response_spatial_data),
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                console.log(response);
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else {
                    alert('已儲存永久環境 (PE) 效應！您可以在試驗詳細資訊頁面的「表型」區段中檢視！');
                    location.reload();
                }
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert('儲存隨機迴歸校正結果時發生錯誤！');
            }
        });
    });

});

</script>
