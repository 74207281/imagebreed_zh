<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>



<&| /page/info_section.mas, title => "試驗土壤資料(Trial Soil Data)", collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "soil_data_table" class="table table-hover table-striped">
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<script defer="defer">

jQuery(document).ready(function () {

    var soil_data_table = jQuery('#soil_data_table').DataTable({
        'searching': false,
        'order': false,
        'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/all_soil_data',
        columns: [
            { title: "土壤資料 ID(Soil Data ID)", "data": "prop_id" },
            { title: "描述(Description)", "data": "description" },
            { title: "日期(Date)", "data": "date" },
            { title: "GPS", "data": "gps" },
            { title: "取樣類型(Type of Sampling)", "data": "type_of_sampling" },
            { title: "土壤資料(Soil Data)", "data": "soil_data" },
            { title: "下載(Download)", "data": "download_link" },
            { title: "刪除(Delete)", "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteSoilData("+row.prop_id+")'>刪除</a>"; } },
        ]
    });

});

function deleteSoilData(prop_id){
    var confirmation = confirm('您確定要刪除此土壤資料 ID 嗎？此刪除操作無法復原。');

    if (confirmation) {
        jQuery.ajax({
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_soil_data',
            method: 'POST',
            data : {
                'prop_id': prop_id
            },

            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert('刪除成功');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert('刪除時發生錯誤');
            }
        });
    }
}


</script>
