<%args>
$timestamp => localtime()
$accession_uniquename => ''
$cross_uniquename => ''
</%args>

<div class="modal fade" id="add_seedlot_dialog" name="add_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="seedlot_dialog">建立新種子批次(Create New Seedlot)</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" id="create_new_seedlot_form" name="create_new_seedlot_form">

                <div class="form-group">
                    <label class="col-sm-3 control-label">種子批次名稱：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_name" placeholder="必填">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">公司：</label>
                    <div class="col-sm-9" >
                        <div id="seedlot_private_company_div"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">育種計畫：</label>
                    <div class="col-sm-9" >
                        <div id="seedlot_breeding_program_div"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">地點：</label>
                    <div class="col-sm-9" >
                        <div id="seedlot_location_div"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">箱號名稱：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_box_name" placeholder="必填">
                    </div>
                </div>

		<div class="form-group">
                    <label class="col-sm-3 control-label">品質問題：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_quality" placeholder="在此列出品管問題，或填入「ok」表示種子品質良好" >
                    </div>
                </div>

                <div class="well well-sm">
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="col-sm-12 control-label">內容物：</label>
                            </div>
                        </div>
                        <div class="col-sm-9">
% if ($accession_uniquename || $cross_uniquename){
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">種原名稱：</label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_accession_uniquename" placeholder="需填寫其中一項內容" disabled value="<% $accession_uniquename %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <center><h4>或</h4></center>
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">雜交唯一識別碼：</label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_cross_uniquename" placeholder="需填寫其中一項內容" disabled value="<% $cross_uniquename %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
% } else {
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">種原名稱：</label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_accession_uniquename" placeholder="需填寫其中一項內容">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <center><h4>或</h4></center>
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">雜交唯一識別碼：</label>
                                        <div class="col-sm-9" >
                                            <input class="form-control" id="seedlot_cross_uniquename" placeholder="需填寫其中一項內容">
                                        </div>
                                    </div>
                                </div>
                            </div>
% }
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">數量（種子粒數）：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_amount" placeholder="需填寫數量或重量（克）">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">重量（克）：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_weight" placeholder="需填寫數量或重量（克）">
                    </div>
                </div>
                <!--
                <div class="form-group">
                    <label class="col-sm-3 control-label">Population: </label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_population_name" placeholder="Optional">
                    </div>
                </div>
                -->
                <div class="form-group">
                    <label class="col-sm-3 control-label">機構／單位：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_organization" placeholder="選填">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">時間戳記：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_timestamp" value="<% $timestamp %>" placeholder="<% $timestamp %>">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">描述：</label>
                    <div class="col-sm-9" >
                        <input class="form-control" id="seedlot_description" placeholder="選填">
                    </div>
                </div>
            </form>
        </div>
      </div>
      <div class="modal-footer">
        <button id="create_new_seedlot_button" type="button" class="btn btn-primary" >確定(OK)</button>
      </div>
    </div>
  </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery("#seedlot_accession_uniquename").autocomplete({
       source: '/ajax/stock/accession_autocomplete',
    });
    jQuery("#seedlot_cross_uniquename").autocomplete({
       source: '/ajax/stock/cross_autocomplete',
    });

    jQuery('[name="add_seedlot_button"]').click( function() {
        jQuery('#add_seedlot_dialog').modal('show');
        get_select_box('private_companies', 'seedlot_private_company_div', { 'name' : 'seedlot_private_company_id', 'id' : 'seedlot_private_company_id' });
        get_select_box('breeding_programs', 'seedlot_breeding_program_div', { 'name' : 'seedlot_breeding_program_id', 'id' : 'seedlot_breeding_program_id', 'private_company_id':1 });
        get_select_box('locations', 'seedlot_location_div', { 'name' : 'seedlot_location', 'id' : 'seedlot_location', 'names_as_values':1, 'private_company_id':1 });
    });

    jQuery(document).on('change', '#seedlot_private_company_id', function(){
        var private_company_id = jQuery(this).val();
        get_select_box('breeding_programs', 'seedlot_breeding_program_div', { 'name' : 'seedlot_breeding_program_id', 'id' : 'seedlot_breeding_program_id', 'private_company_id':private_company_id });
        get_select_box('locations', 'seedlot_location_div', { 'name' : 'seedlot_location', 'id' : 'seedlot_location', 'names_as_values':1, 'private_company_id':private_company_id  });
    });

    jQuery('#create_new_seedlot_button').click( function() {
        var name = jQuery('#seedlot_name').val();
        var location = jQuery('#seedlot_location').val();
        var box_name = jQuery('#seedlot_box_name').val();
        var accession_uniquename = jQuery('#seedlot_accession_uniquename').val();
        var cross_uniquename = jQuery('#seedlot_cross_uniquename').val();
        var population_name = jQuery('#seedlot_population_name').val();
        var organization = jQuery('#seedlot_organization').val();
        var amount = jQuery('#seedlot_amount').val();
        var weight = jQuery('#seedlot_weight').val();
        var timestamp = jQuery('#seedlot_timestamp').val();
        var description = jQuery('#seedlot_description').val();
        var breeding_program_id = jQuery('#seedlot_breeding_program_id').val();
        var seedlot_quality = jQuery('#seedlot_quality').val();
        var private_company_id = jQuery('#seedlot_private_company_id').val();

        if (name == '') { alert("請提供種子批次名稱"); return; }
        else if (location == '') { alert("請提供地點"); return; }
        else if (box_name == '') { alert("請提供箱號名稱"); return; }
        else if (amount == '' && weight == '') { alert("請提供種子數量或以克為單位的重量！"); return; }
        else if (breeding_program_id == '') { alert("請選擇育種計畫"); return; }
        else if (accession_uniquename == '' && cross_uniquename == '') {
            alert("請提供種原名稱或雜交唯一識別碼作為種子批次的內容物。"); return;
        }
        else if (accession_uniquename != '' && cross_uniquename != '') {
            alert("請僅提供種原名稱或雜交唯一識別碼其中之一作為種子批次內容物，不可同時填寫兩者。"); return;
        }
        else {

            jQuery.ajax({
                url: '/ajax/breeders/seedlot-create',
                data : {
                    'seedlot_name' : name,
                    'seedlot_location': location,
                    'seedlot_box_name':box_name,
                    'seedlot_accession_uniquename': accession_uniquename,
                    'seedlot_cross_uniquename': cross_uniquename,
                    'seedlot_organization': organization,
                    'seedlot_population_name': population_name,
                    'seedlot_amount':amount,
                    'seedlot_weight':weight,
                    'seedlot_timestamp':timestamp,
                    'seedlot_description':description,
                    'seedlot_breeding_program_id':breeding_program_id,
                    'seedlot_quality' : seedlot_quality,
                    'private_company_id' : private_company_id

                },
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert("種子批次已成功建立。");
                        jQuery('#add_seedlot_dialog').modal('hide');
                        //seedlots_table.ajax.reload();
                        //document.location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert('建立種子批次時發生錯誤');
                }
            });
        }

    });

});
</script>
