
<%args>
$facilities => ()
$sampling_facilities => ()
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.GenotypingTrial08232022' ] &>

<& /page/page_title.mas, title=>"管理組織樣本(Manage Tissue Samples)" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>田間試驗組織樣本(Field Trial Tissue Samples)</h4>", info_section_subtitle => '檢視並建立田間試驗的組織樣本。組織樣本來自小區中的植株。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="tissue_sample_guided_help">田間試驗組織樣本引導說明(Guided help for field trial tissue samples)</button><button class="btn btn-sm btn-primary" style="margin:3px" name="manage_tissue_samples_create_field_trial_samples">建立田間試驗組織樣本(Create tissue samples for field trial)</button>', icon_class => "glyphicon glyphicon-leaf", info_section_id => "manage_tissue_samples_field_trials" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>基因型分析盤組織樣本(Genotyping Plate Tissue Samples)</h4>", info_section_subtitle => '檢視並建立基因型分析盤的組織樣本。基因型分析盤代表 96 或 384 孔盤配置中的組織樣本。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="create_genotyping_trial_link">建立或上傳基因型分析盤(Create or upload a genotyping plate)</button> <button class="btn btn-sm btn-primary" style="margin:3px" name="export_genotyping_trial_link">匯出至基因型分析廠商(Export to Genotyping Vendor)</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "manage_tissue_samples_genotyping_trials" &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>取樣試驗(Sampling Trials)</h4>", info_section_subtitle => '檢視並建立一般取樣試驗的組織樣本。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="create_sampling_trial_button">建立新取樣試驗(Create new sampling trial)</button>', icon_class => "glyphicon glyphicon-th", info_section_id => "manage_tissue_samples_sampling_trials" &>

<& /help/workflow_guided/tissue_sample_help.mas &>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities=>$facilities &>
<& /breeders_toolbox/create_tissue_samples_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities &>

<script>

jQuery(document).ready(function(){
    jQuery('button[name="export_genotyping_trial_link"]').click(function(){
        alert('目前尚不提供自動匯出至基因型分析廠商；但是，您可以下載配置並手動提交給廠商。');
    });
});

</script>
