
<%doc>
</%doc>

<%args>
$files => []
$allow_delete => 0
</%args>

% if (scalar(@$files)>0) {
<table class="table table-bordered files_datatables" alt="">
<thead>
  <tr><th>檔案名稱(Filename)</th><th>上傳日期(Date Uploaded)</th><th>選項(Options)</th></tr>
</thead>
<tbody>
% foreach my $f (@$files) { 
  <tr>
    <td><% $f->{basename} %></td>
    <td><% $f->{create_date} %></td>
    <td>
% if ($allow_delete){
    <button class="btn btn-default btn-sm" name="delete_pheno_file_link" data-file_id="<% $f->{file_id} %>" >刪除(Delete)</button> | 
% }
    <a href="/breeders/phenotyping/view/<% $f->{file_id} %>">檢視</a> | <a href="/breeders/phenotyping/download/<% $f->{file_id} %>">下載</a></td>
  </tr>
% }
</tbody>
</table>
% }

<script>

jQuery(document).ready(function() {

    jQuery('.files_datatables').DataTable();

});

</script>
