
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadPhenotype03152022', 'CXGN.Trial03152022' ] &>

<div class="modal fade" id="upload_phenotype_spreadsheet_dialog" name="upload_phenotype_spreadsheet_dialog" tabindex="-1" role="dialog" aria-labelledby="addSpreadsheetPhenotypeDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addSpreadsheetPhenotypeDialog">上傳表型試算表(Upload Phenotype Spreadsheet)</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                <p>
                <b>檔案格式資訊</b>
                <br>
                <a id="phenotype_upload_spreadsheet_format_info">試算表格式</a>
                </p>
            </&>

            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_spreadsheet_phenotype_file_form" name="upload_spreadsheet_phenotype_file_form">
                <div class="form-group">
                    <label class="col-sm-3 control-label">試算表格式：</label>
                    <div class="col-sm-9" >
                        <select class="form-control" id="upload_spreadsheet_phenotype_file_format" name="upload_spreadsheet_phenotype_file_format">
                            <option value="detailed">詳細格式（Detailed）</option>
                            <option value="simple">簡易格式（Simple）</option>
                            <!--option value="associated_images">Associated Images</option-->
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">包含時間戳記：</label>
                    <div class="col-sm-9" >
                        <input type="checkbox" id="upload_spreadsheet_phenotype_timestamp_checkbox" name="upload_spreadsheet_phenotype_timestamp_checkbox" />
                    </div>
                </div>
                <div id="upload_spreadsheet_phenotype_data_level_div">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">資料層級：</label>
                        <div class="col-sm-9" >
                            <select class="form-control" id="upload_spreadsheet_phenotype_data_level" name="upload_spreadsheet_phenotype_data_level">
                                <option value="plots">小區</option>
                                <option value="plants">植株</option>
                                <option value="subplots">子小區</option>
                                <option value="tissue_samples">組織樣本</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">表型試算表：</label>
                    <div class="col-sm-9" >
                        <input type="file" id="upload_spreadsheet_phenotype_file_input" name="upload_spreadsheet_phenotype_file_input" encoding="multipart/form-data" />
                    </div>
                </div>
                <div id="phenotype_upload_associated_images_div" style="display:none">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">關聯影像（.zip）：</label>
                        <div class="col-sm-9" >
                            <input type="file" id="upload_spreadsheet_phenotype_associated_images_file_input" name="upload_spreadsheet_phenotype_associated_images_file_input" encoding="multipart/form-data" />
                        </div>
                    </div>
                </div>

                <div id="upload_phenotype_spreadsheet_verify_status"></div>
                </div>
            </form><br/>

        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            <button type="button" class="btn btn-info" name="upload_spreadsheet_phenotype_submit_verify" id="upload_spreadsheet_phenotype_submit_verify">驗證(Verify)</button>
            <button disabled type="button" class="btn btn-primary" name="upload_spreadsheet_phenotype_submit_store" id="upload_spreadsheet_phenotype_submit_store" title="請先驗證您的檔案">儲存(Store)</button>
        </div>

    </div>
  </div>
</div>

<div class="modal fade" id="phenotype_upload_spreadsheet_info_dialog" name="phenotype_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="phenotypeUploadInfoDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="phenotypeUploadInfoDialog">範本資訊(Template Information)</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <h4>表型試算表必須以 .xls 或 .xlsx Excel 檔案格式上傳</h4>
            <p>（不支援 Tab 分隔文字格式）</p>

            <hr>
            <button class="btn btn-primary" name="create_spreadsheet_link">建立試驗表型試算表(Create Phenotyping Spreadsheet for Trial)</button>
            <hr>

            <h4>必要資料(Required Data)：</h4>
            <ul>
                <li>請點擊上方按鈕產生所需的表型試算表。</li>
            </ul>

            <h4>注意事項(Notes)：</h4>
            <ul>
                <li>對於 <i>"sprouting proportion"</i>，<i>"性狀名稱|性狀編號"</i><br>應寫為 <i>"sprouting proportion|CO_334:0000008"</i>。</li>
                <li>若試算表檔案並非從資料庫產生，</br>請查閱<i>性狀本體論（Trait Ontology）</i>以確保您擁有正確的性狀編號。</li>
                <li>可同時上傳兩個或多個性狀。</li>
            </ul>

            <h4>簡易與詳細試算表格式(Simple and Detailed Spreadsheet Format)：</h4>
            <ul>
                <li>「簡易（Simple）」格式僅需要名為「observationunit_name」的欄位，其後緊接您的性狀欄位。</li>
                <li>「詳細（Detailed）」格式包含特殊的表頭以及用於試驗設計資訊的額外欄位。</li>
                <li>「近紅外光譜（NIRS）」格式建構於簡易格式之上——名為「observationunit_name」的欄位後緊接來自 NIR 光譜推導的性狀欄位，其後再接 NIR 光譜資料本身的欄位。性狀欄位名稱必須來自性狀本體論，但 NIR 光譜欄位名稱只需從 NIR 設備產生的任何標準輸出檔案複製即可。</li>
                <li>「關聯影像（Associated Images）」格式適用於上傳與表型值關聯的影像 zip 壓縮檔。其包含以下欄位：observationunit_name, observationvariable_name, phenotype_value, phenotype_timestamp, image_name, username。影像名稱必須與上傳之 zip 壓縮檔內的影像名稱一致。</li>
            </ul>

            <h4>時間戳記(Timestamps)：</h4>
            <ul>
                <li>若要在測量值中包含時間戳記資訊，請勾選「包含時間戳記」核取方塊。</li>
                <li>對於時間戳記，數值應記錄為 <i>"數值,時間戳記"</i>。<br/>若無時間戳記，數值應記錄為 <i>"數值"</i>。</li>
                <li>時間戳記格式必須為 YYYY-MM-DD HH:MM:SS-0000 或 YYYY-MM-DD HH:MM:SS+0000</li><br/>
                <li>包含時間戳記範例：<br/><br/>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>sprouting proportion|CO_334:0000008</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>20,2016-04-28 16:30:40-0500</td>
                        </tr>
                    </tbody>
                </table>
                </li>
                <li>無時間戳記範例：<br/><br/>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>sprouting proportion|CO_334:0000008</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
                </li>
            </ul>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
      </div>
    </div>
  </div>
</div>


<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_spreadsheet_phenotypes_link').click( function() {
        jQuery('#upload_phenotype_spreadsheet_dialog').modal("show");
    });

    jQuery("#phenotype_upload_spreadsheet_format_info").click( function () {
        jQuery("#phenotype_upload_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery('#upload_spreadsheet_phenotype_file_format').change(function(){
        if (jQuery(this).val() == 'associated_images') {
            jQuery('#phenotype_upload_associated_images_div').show();
        }
        else {
            jQuery('#phenotype_upload_associated_images_div').hide();
        }
    });

});

</script>
