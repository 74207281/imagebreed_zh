
<%doc>

=head1 NAME

/breeders_toolbox/folder.mas - a mason component to display a folder detail page

=head1 AUTHOR

Nicolas Morales nm529@cornell.edu

=cut

</%doc>

<%args>
$folder_id
$folder_name
$folder_description
$trials
$crossing_trials
$genotyping_trials
$analyses_trials
$child_folders
$project_parent => undef
$breeding_program => undef
$folder_for_trials
$folder_for_crosses
$folder_for_genotyping_trials
$has_child_folders => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial03152022' ] &>

<br/>

<& /page/page_title.mas, title=>"資料夾詳細資訊(Folder Detail) - ".$folder_name &>

<& /breeders_toolbox/folder/folder_set.mas, folder_id=>$folder_id, folder_name=>$folder_name, breeding_program_id=>$breeding_program->project_id(), breeding_program_name=>$breeding_program->name(), folder_for_trials => $folder_for_trials, folder_for_crosses => $folder_for_crosses, folder_for_genotyping_trials => $folder_for_genotyping_trials &>
<& /breeders_toolbox/folder/folder_move.mas, breeding_program_id=>$breeding_program->project_id(), breeding_program_name=>$breeding_program->name()   &>
<& /breeders_toolbox/folder/edit_folder_name.mas, trial_id=>$folder_id, trial_name=>$folder_name, trial_type=>"Folder" &>
<& /breeders_toolbox/folder/folder_category_set.mas, folder_id=>$folder_id, folder_name=>$folder_name, folder_for_trials=>$folder_for_trials, folder_for_crosses=>$folder_for_crosses, folder_for_genotyping_trials=>$folder_for_genotyping_trials &>

<div>

  <ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active"><a href="#trials" aria-controls="trials" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-leaf text-success"></span>&nbsp;&nbsp;&nbsp;試驗(Trials)</a></li>
    <li role="presentation"><a href="#analyses" aria-controls="analyses" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-stats text-success"></span>&nbsp;&nbsp;&nbsp;分析(Analyses)</a></li>
    <li role="presentation"><a href="#crosses" aria-controls="crosses" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-grain text-success"></span>&nbsp;&nbsp;&nbsp;雜交試驗(Crossing Experiments)</a></li>
    <li role="presentation"><a href="#genotyping_trials" aria-controls="genotyping_trials" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-th text-success"></span>&nbsp;&nbsp;&nbsp;基因型分析孔盤(Genotyping Plates)</a></li>
    <li role="presentation"><a href="#folders" aria-controls="folders" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;&nbsp;&nbsp;資料夾(Folders)</a></li>
    <li role="presentation"><a href="#breeding_program" aria-controls="breeding_program" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;&nbsp;&nbsp;育種計畫(Breeding Program)</a></li>
  </ul>

  <div class="tab-content">
    <div role="tabpanel" class="tab-pane fade in active" id="trials">
      <div class="well">
        <h3>資料夾中的試驗(Trials in Folder)</h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th>試驗名稱(Trial Name)</th></tr></thead>
        <tbody>
% my @trial_ids;
% foreach (@$trials) {
    <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% push @trial_ids, $_->folder_id();
% }
% my $trial_ids = join ',', @trial_ids;
        </tbody>
        </table>

        <br/>
        <button class="btn btn-primary" id="trial_download_phenotypes_button">下載表型(Download Phenotypes)</button>

      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="analyses">
      <div class="well">
        <h3>資料夾中的分析(Analyses in Folder)</h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th>分析名稱(Analyses Name)</th></tr></thead>
        <tbody>
% foreach (@$analyses_trials) {
    <tr><td><a href="/analyses/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
        </tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="crosses">
      <div class="well">
        <h3>資料夾中的雜交(Crosses in Folder)</h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th>雜交唯一識別碼(Cross Unique ID)</th></tr></thead>
        <tbody>
% foreach (@$crossing_trials) {
            <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
        </tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="genotyping_trials">
      <div class="well">
        <h3>資料夾中的基因型分析孔盤(Genotyping Plates in Folder)</h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th>基因型分析孔盤名稱(Genotyping Plate Name)</th></tr></thead>
        <tbody>
% my @genotyping_trial_ids;
% foreach (@$genotyping_trials) {
            <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% push @genotyping_trial_ids, $_->folder_id();
% }
% my $genotyping_trial_ids = join ',', @genotyping_trial_ids;
        </tbody>
        </table>

        <br/>
        <button class="btn btn-primary" id="folder_download_genotyping_plates_button">下載基因型分析孔盤配置(Download Genotyping Plate Layouts)</button>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="folders">
      <div class="well">
        <h3>上層資料夾(Parent Folder)</h3>
% if ($breeding_program->name() ne $project_parent->name()) {
        <a href="/folder/<% $project_parent->project_id %>" target=_blank><% $project_parent->name() %></a>
% } else {
      無上層資料夾
% }
      </div>

      <div class="well">
        <h3>子資料夾(Child Folders)</h3>
% if ($has_child_folders) {
        <table class="table table-hover table-bordered">
        <tbody>
% foreach (@$child_folders) {
%   if ($_->folder_type eq 'folder') {
      <tr><td><a href="/folder/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
% }
        </tbody>
        </table>
% } else {
      無子資料夾
% }
      </div>

      <div class="well">
        <button class="btn btn-primary" id="move_folder_dialog_link">移動資料夾(Move Folder)</button>
      </div>

    </div>

    <div role="tabpanel" class="tab-pane fade" id="breeding_program">
      <div class="well">
        <h3>資料夾之育種計畫(Folder's Breeding Program)</h3>
        <% $breeding_program->name() %>
      </div>
    </div>

  </div>

</div>

<hr>

<div class="row">
    <div class="col-sm-6">
        <div class="well well-sm">
            <table class="table table-bordered">
                <thead></thead>
                <tbody>
                    <tr>
                        <td><h5>用於試驗的資料夾(Folder For Trials)</h5></td>
% if($folder_for_trials){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }

                    </tr>
                    <tr>
                        <td><h5>用於雜交的資料夾(Folder For Crosses)</h5></td>
% if($folder_for_crosses){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                    <tr>
                        <td><h5>用於基因型分析孔盤的資料夾(Folder For Genotyping Plates)</h5></td>
% if($folder_for_genotyping_trials){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                </tbody>
            </table>
            <button class="btn btn-sm btn-default" id="change_folder_categories_button">新增額外資料夾類型(Add Additional Folder Type)</button>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="well">
            <center>
<!--
            <button class="btn btn-sm btn-primary" id="open_folder_dialog_link">Add Trial and Analyses to Folder</button>
            <br/><br/>
-->
            <button class="btn btn-sm btn-default" id="edit_trial_name">重新命名資料夾(Rename Folder)</button>&nbsp;&nbsp;&nbsp;&nbsp;
            <button class="btn btn-sm btn-default" id="delete_folder_button">刪除資料夾(Delete Folder)</button>
            </center>
        </div>
    </div>
</div>

<& /breeders_toolbox/trial/download_phenotypes_dialog.mas, trial_ids => $trial_ids, dialog_name => $folder_name, dialog_type => 'Folder' &>
<& /breeders_toolbox/genotyping_trials/download_genotyping_trial_layouts_dialogs.mas, genotyping_trial_ids => $genotyping_trial_ids &>

<script>

jQuery(document).ready(function() {

    jQuery("[name=folder_datatables_table]").DataTable();

    jQuery('#delete_folder_button').click( function() {
        if (confirm("您確定要刪除此資料夾嗎？")) {
            jQuery.ajax( {
                url: '/ajax/folder/'+<% $folder_id %>+'/delete',
                success: function(response) {
                    if (response.error) {
                        alert(response.error);
                    } else {
                        alert("資料夾已成功刪除。");
                        window.location.replace("/breeders/trials");
                    }
                },
                error: function(response) {
                    alert('嘗試刪除資料夾時發生錯誤。');
                }
            });
        }
    });

});

</script>
