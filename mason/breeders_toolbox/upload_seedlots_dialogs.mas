<%args>
</%args>

<div class="modal fade" id="upload_seedlot_dialog" name="upload_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog">上傳種子批次(Upload Seedlots)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> "介紹(Intro)" &>
                            <& /page/page_title.mas, title=>"什麼是種子批次？(What are seedlots?)" &>
                            <ul>
                            <li>種子批次代表封裝於紙袋或容器中的實體種子。</li>
                            <li>這些種子可來自雜交組合或具名種原。</li>
                            <li>種子批次可包含特定地點、箱號、重量（克）和數量。</li>
                            <li>種子批次可屬於育種計畫和機構。</li>
                            <li>種子批次可用於試驗（例如種植在小區中），也可以從小區或植株收穫（例如進行雜交並收集種子）。</li>
                            </ul>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "您擁有什麼種子批次？(What seedlots do you have?)" &>
                            <& /page/page_title.mas, title=>"種子批次分為兩類(Seedlots fall into two categories)" &>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">請選擇一項：</label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="upload_seedlots_type_select" name="upload_seedlots_type_select">
                                        <option value=""></option>
                                        <option data-desc="如果您擁有具名種原的種子批次（例如從廠商訂購的種子），請使用此選項。如果種子不是從資料庫中的雜交組合收穫的，請使用此選項。" value="from_accession">我擁有具名種原的種子批次</option>
                                        <option data-desc="如果您的種子批次是從資料庫中的雜交組合收穫的，請使用此選項。" value="from_cross">我擁有從雜交收穫的種子批次</option>
                                    </select>
                                </div>
                            </div>
                            <br/><br/>
                            <div id="upload_seedlots_types_description">
                            </div>
                            <br/>
                            <center>
                                <button disabled id="seedlot_upload_type_select_button" class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "檔案格式(File format)" &>
                            <& /page/page_title.mas, title=>"請確認您的檔案符合正確的檔案格式(Make sure your file matches the correct file format)" &>
                            <br/><br/>
                            <center>
                                <div id="upload_seedlots_accessions_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_upload_format_button">上傳具名種原種子批次的檔案格式資訊(Information about file format for uploading seedlots of named accessions)</button><br/><br/>
                                </div>
                                <div id="upload_seedlots_crosses_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_crosses_upload_format_button">上傳收穫種子批次的檔案格式資訊(Information about file format for uploading seed lots harvested)</button><br/><br/>
                                </div>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">確認檔案符合格式後，前往下一步(Once you think your file matches, go to Next Step)</button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> "上傳種子批次(Upload seedlots)" &>
                            <& /page/page_title.mas, title=>"提供種子批次的基本資訊並上傳您的檔案(Provide basic information about the seedlots and upload your file)" &>

                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_seedlot_form" name="upload_seedlot_form">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">公司：</label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_private_company_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">育種計畫：</label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_breeding_program_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">種子批次存放地點：</label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_location_div"></div>
                                    </div>
                                </div>
                                <!--
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Population Name: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_population_name" id="upload_seedlot_population_name" placeholder="Optional">
                                    </div>
                                </div>
                                -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">機構名稱：</label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="選填">
                                    </div>
                                </div>

                                <div id="upload_seedlots_accessions_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_uploaded_file" id="seedlot_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                                <div id="upload_seedlots_harvested_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                            </form>
                            <center>
                            <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" name="upload_seedlot_button" >上傳種子批次(Upload Seedlots)</button><br/><br/>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> "修正檔案中的錯誤(Fix errors in file)" &>
                            <& /page/page_title.mas, title=>"修正檔案中的所有錯誤(Fix all errors in your file)" &>

                            <div id="upload_seedlots_missing_accessions_or_crosses_div" style="display:none">
                                <div id="upload_seedlots_missing_accessions_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>在新增種原的種子批次之前，種原必須已存在於資料庫中。原因是一個種原可以存在於多個種子批次中，因此在資料庫中作為獨立實體存在。我們在向資料庫新增新種原時也需要謹慎，以避免錯誤的重複資料。</li>
                                            <li>向資料庫新增種原時，您可以使用種原清單或 Excel 檔案。</li>
                                        </ul>
                                    </div>

                                    <div id="upload_seedlots_add_missing_accessions_html">
                                    </div>

                                    <button class="btn btn-info" name="add_accessions_link">新增您的種原至資料庫(Add your accessions to the database)</button><br/><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);">所有種原皆已存在於資料庫後點擊此處(Once all your accessions are in the database Click Here)</button><br/><br/>
                                </div>
                                <div id="upload_seedlots_missing_crosses_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li>在新增種子批次之前，雜交組合必須已存在於資料庫中。原因是雜交組合可以產生多個種子批次，因此雜交組合必須在資料庫中作為獨立實體存在。我們在向資料庫新增新雜交組合時也需要謹慎，以避免資料與重複項錯誤連結。</li>
                                        </ul>
                                    </div>
                                    <ul>
                                    <li>向資料庫新增雜交組合時，您可以上傳 Excel 檔案，也可以一次新增一個雜交組合。<br/><br/>
                                        <ul>
                                        <li><button class="btn btn-info" name="upload_crosses_link">上傳 Excel 檔案(Upload Excel file)</button><br/><br/></li>
                                        <li><button class="btn btn-info" name="create_cross_link">新增一個雜交(Add One Cross)</button></li>
                                        </ul>
                                    </li>
                                    </ul><br/>
                                    <center>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);">所有雜交組合皆已存在於資料庫後點擊此處(Once all your crosses are in the database Click Here)</button><br/><br/>
                                    </center>
                                </div>
                            </div>
                            <div id="upload_seedlots_error_display" style="display:none">

                                <h3>種子批次上傳錯誤訊息(Seedlot Upload Error Messages)</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <center>
                            <div id="upload_seedlots_no_error_messages_accessions_html">
                            </div>
                            <div name="upload_seedlots_completed_message">
                            </div>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "再次嘗試提交種子批次(Try submitting seedlots again)" &>
                            <& /page/page_title.mas, title=>"再次提交您的種子批次。此時您應該已經修正了所有錯誤，如果仍有錯誤，請查看下方紅色方框中的錯誤訊息。您可以繼續修改檔案，然後點擊上傳直到成功。(Submit your seedlots again. You should have corrected all errors by now, but if not please take a look at the errors in the red box below. You can continue to modify your file and then click Upload until it works.)" &>
                            <div id="seedlot_upload_show_repeat_upload_button">
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" name="upload_seedlot_button" >上傳種子批次(Upload Seedlots)</button><br/><br/>
                                </center>
                            </div>
                            <center>
                            <div name="upload_seedlots_completed_message">
                            </div>
                            </center>

                            <div id="upload_seedlots_error_display_second_try" style="display:none">

                                <h3>您的檔案中存在以下問題：</h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                            <& /page/page_title.mas, title=>"完成！您的種子批次現已在資料庫中(Finished! Your seedlots are now in the database)" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                種子批次檔案已成功上傳
                            </p>

                            <ul>
                                <li>您可能想要前往剛剛建立的種子批次之詳細資訊頁面。</li>
                                <li>您可以為種子批次列印條碼。</li>
                            </ul>
                            <br/>
                            <center>
                            <button class="btn btn-primary" name="upload_seedlot_success_complete_button">種子批次已成功儲存至資料庫，無任何錯誤！恭喜，點擊此處(The seedlots were saved to the database with no errors! Congrats Click Here)</button><br/><br/>
                            </center>
                        </&>
                    </&>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_info_dialog" name="seedlot_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotInfoDialog">具名種原上傳範本資訊(Upload Template Information For Named Accessions)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>種子批次可以 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <b>表頭：</b>
                    <br>
                    第一列（表頭）必須包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>accession_name</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight(g)</td>
                                <td>description</td>
                                <td>box_name</td>
				<td>quality</td>
				<td>source</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <ul>
                    <li>seedlot_name（必須唯一）</li>
                    <li>accession_name（必須存在於資料庫中。accession_name 是具名基因型的唯一識別碼）</li>
                    <li>operator_name（監督盤點過程的人員姓名，可為任意名稱。）</li>
                    <li>
                    amount（種子批次中的種子數量。可與 weight(g) 一同提供。必須提供 amount 或 weight(g) 或兩者。）
                    <br/><b>及／或</b><br/>
                    weight(g)（種子批次的重量，以克為單位。可與 amount 一同提供。必須提供 amount 或 weight(g) 或兩者。）
                    </li>
                    <li>box_name（種子所在的箱號名稱，可為任意名稱。）</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                      <li>description（有關新增此種子批次原因的資訊）</li>
		      <li>quality（種子批次的狀態，例如「ok」、「moldy」、「insect damage」等）</li>
		      <li>source（替代來源，例如若資料庫中未輸入特定雜交試驗，則填寫種子來源的小區或植株識別碼）</li>
                    </ul>

		    請注意，各欄必須按照上述順序排列，並帶有正確的欄表頭。

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_harvested_info_dialog" name="seedlot_upload_spreadsheet_harvested_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog">收穫種子批次上傳範本資訊(Upload Template Information For Harvested Seedlots)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>種子批次可以 Excel 檔案（.xls 或 .xlsx）上傳</b>
                    <br />
                    <b>表頭：</b>
                    <br>
                    第一列（表頭）必須包含以下內容：
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight(g)</td>
                                <td>description</td>
                                <td>box_name</td>
				<td>quality</td>
				<td>source</td>
                            </tr>
                        </tbody>
                    </table>

                    <b>必填欄位：</b>
                    <ul>
                    <li>seedlot_name（必須唯一）</li>
                    <li>cross_unique_id（必須存在於資料庫中。cross_unique_id 可以代表種原之間的雜交，例如 AxB，但如果您有田間特定小區之間雜交的資訊，也可以代表小區之間的雜交）</li>
                    <li>operator_name（監督盤點過程的人員姓名，可為任意名稱。）</li>
                    <li>
                    amount（種子批次中的種子數量。可與 weight(g) 一同提供。必須提供 amount 或 weight(g) 或兩者。）
                    <br/><b>及／或</b><br/>
                    weight(g)（種子批次的重量，以克為單位。可與 amount 一同提供。必須提供 amount 或 weight(g) 或兩者。）
                    </li>
                    <li>box_name（種子所在的箱號名稱，可為任意名稱。）</li>
                    </ul>

                    <b>選填欄位：</b>
                    <ul>
                      <li>description（有關新增此種子批次原因的資訊）</li>
		      <li>quality（品質簡要說明，例如「ok」、「moldy」、「insect damage」等）</li>
		      <li>source（替代來源，例如若資料庫中未輸入特定雜交試驗，則填寫種子來源的小區或植株識別碼）</li>
		    </ul>


                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>



<script>
jQuery(document).ready(function(){

    jQuery('#upload_seedlots_type_select').change(function(){
        if (jQuery(this).val() != ''){
            jQuery('#seedlot_upload_type_select_button').attr('disabled', false);
            jQuery('#upload_seedlots_types_description').html('<br/><div class="well"><p>'+jQuery(this).find("option:selected").data("desc")+'</p></div>');
        } else {
            jQuery('#seedlot_upload_type_select_button').attr('disabled', true);
            jQuery('#upload_seedlots_types_description').html('');
        }

        if(jQuery(this).val() == 'from_accession'){
            jQuery('#upload_seedlots_accessions_template_section').show();
            jQuery('#upload_seedlots_crosses_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').show();
            jQuery('#upload_seedlots_harvested_section').hide();
        }
        if(jQuery(this).val() == 'from_cross'){
            jQuery('#upload_seedlots_crosses_template_section').show();
            jQuery('#upload_seedlots_accessions_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').hide();
            jQuery('#upload_seedlots_harvested_section').show();
        }
    });

    jQuery('[name="seedlot_bulk_upload"]').click( function() {
        jQuery('#upload_seedlot_dialog').modal('show');
        get_select_box('private_companies', 'upload_seedlot_private_company_div', { 'name' : 'upload_seedlot_private_company_id', 'id' : 'upload_seedlot_private_company_id' });
        get_select_box('breeding_programs', 'upload_seedlot_breeding_program_div', { 'name' : 'upload_seedlot_breeding_program_id', 'id' : 'upload_seedlot_breeding_program_id', 'private_company_id':1 });
        get_select_box('locations', 'upload_seedlot_location_div', { 'name' : 'upload_seedlot_location', 'id' : 'upload_seedlot_location', 'names_as_values':1, 'private_company_id':1 });
    });

    jQuery(document).on('change', '#upload_seedlot_private_company_id', function(){
        var private_company_id = jQuery(this).val();
        get_select_box('breeding_programs', 'upload_seedlot_breeding_program_div', { 'name' : 'upload_seedlot_breeding_program_id', 'id' : 'upload_seedlot_breeding_program_id', 'private_company_id':private_company_id });
        get_select_box('locations', 'upload_seedlot_location_div', { 'name' : 'upload_seedlot_location', 'id' : 'upload_seedlot_location', 'names_as_values':1, 'private_company_id':private_company_id });
    });

    jQuery("[name='guided_help_seedlot_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery("[name='guided_help_seedlot_crosses_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_harvested_info_dialog" ).modal("show");
    });

    jQuery('[name="upload_seedlot_button"]').click(function () {
        upload_seedlot_button();
    });
    function upload_seedlot_button() {
        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_seedlot_form').attr("action", "/ajax/breeders/seedlot-upload");
        if (breeding_program === '') {
            alert("請選擇育種計畫");
            return;
        }
        if (location === '') {
            alert("請提供地點");
            return;
        }
        if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
            alert("請選擇一個檔案");
            return;
        }
        jQuery("#upload_seedlot_form").submit();
    }

    jQuery('#upload_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇任何檔案");
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            else if (response.error_string) {

                if (response.missing_accessions || response.missing_crosses) {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').show();
                    if (response.missing_accessions){
                        jQuery('#upload_seedlots_missing_accessions_div').show();
                        var missing_accessions_html = "<div class='well well-sm'><h3>將缺失的種原新增至清單</h3><div id='upload_seedlots_missing_accessions' style='display:none'></div><div id='upload_seedlots_add_missing_accessions'></div></div><br/>";
                        jQuery("#upload_seedlots_add_missing_accessions_html").html(missing_accessions_html);

                        var missing_accessions_vals = '';
                        for(var i=0; i<response.missing_accessions.length; i++) {
                            missing_accessions_vals = missing_accessions_vals + response.missing_accessions[i] + '\n';
                        }
                        jQuery("#upload_seedlots_missing_accessions").html(missing_accessions_vals);
                        addToListMenu('upload_seedlots_add_missing_accessions', 'upload_seedlots_missing_accessions', {
                            selectText: true,
                            listType: 'accessions'
                        });
                    } else if (response.missing_crosses){
                        jQuery('#upload_seedlots_missing_crosses_div').show();
                    }
                } else {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').hide();
                    var no_missing_accessions_html = '<button class="btn btn-primary" onclick="Workflow.skip(this);">沒有關於缺失種原或雜交的錯誤，點擊此處(There were no errors regarding missing accessions or crosses Click Here)</button><br/><br/>';
                    jQuery('#upload_seedlots_no_error_messages_accessions_html').html(no_missing_accessions_html);
                    Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                }

                jQuery("#upload_seedlots_error_display").show();
                jQuery("#upload_seedlots_error_display tbody").html(response.error_string);
                jQuery("#upload_seedlots_error_display_second_try").show();
                jQuery("#upload_seedlots_error_display_second_try tbody").html(response.error_string);
            }
            if (response.missing_accessions || response.missing_crosses){
                Workflow.focus("#upload_seedlot_main_workflow", 4);
            } else if(response.error_string){
                Workflow.focus("#upload_seedlot_main_workflow", 5);
                jQuery("#upload_seedlots_error_display_second_try").show();
            }
            if (response.success) {
                jQuery("#upload_seedlots_error_display").hide();
                jQuery("#upload_seedlots_error_display_second_try").hide();
                jQuery('#seedlot_upload_show_repeat_upload_button').hide();
                jQuery('[name="upload_seedlots_completed_message"]').html('<button class="btn btn-primary" name="upload_seedlot_success_complete_button">種子批次已成功儲存至資料庫，無任何錯誤！恭喜，點擊此處(The seedlots were saved to the database with no errors! Congrats Click Here)</button><br/><br/>');
                Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                Workflow.skip('#upload_seedlots_error_display_second_try', false);
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");
            }

        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert('種子批次已儲存至資料庫');
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });
});
</script>
