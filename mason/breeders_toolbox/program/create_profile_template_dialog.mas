
<div class="modal fade" id="create_profile_template_dialog" name="create_profile_template_dialog" tabindex="-1" role="dialog" aria-labelledby="createProfileTemplateDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createProfileTemplateDialog">建立產品概況範本，請提供檔案名稱及性狀清單(Create Product Profile Template)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">範本檔案名稱：</label>
                            <div class="col-sm-9">
                                <input class="form-control" id="template_file_name" name="template_file_name" type="text" placeholder="輸入範本檔案名稱"/>
                            </div>
                        </div><br/><br/>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="select_list_list_select">選擇性狀清單：</label>
                            <div class="col-sm-9">
                                <span id="select_list_div"></span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" id="create_profile_template" >建立範本(Create Template)</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="profile_template_saved_dialog_message" name="profile_template_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="createProfileTemplateSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createProfileTemplateSavedDialog">產品概況範本已建立(Product Profile Template Created)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        產品概況範本已成功建立。
                    </p>
                    <p>
                        <a id="profile_template_download_link">下載範本(Download Template)</a>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="profile_template_close_button" id="profile_template_close_button" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

    jQuery('#create_profile_template').click(function(){

        var list = new CXGN.List();
        var template_file_name = jQuery('#template_file_name').val();
        var trait_list_id = jQuery('#select_list_list_select').val();
        var trait_list = list.getList(trait_list_id);
        trait_list_json = JSON.stringify(trait_list);

        if (template_file_name === '') {
            alert("請提供範本檔案名稱");
            return;
        }

        if (trait_list_id === '') {
            alert("請選擇性狀清單");
            return;
        }

        jQuery.ajax({
            url: '/ajax/program/create_profile_template',
            dataType: "json",
            type: 'POST',
            data:{
                'template_file_name': template_file_name,
                'trait_list_json': trait_list_json,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    jQuery('#profile_template_download_link').attr('href', "/fieldbook/trait_file_download/" + response.file_id);
                    jQuery("#profile_template_saved_dialog_message").modal("show");
                    jQuery('#create_profile_template_dialog').modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert('建立概況範本時發生錯誤。');
                jQuery('#create_profile_template_dialog').modal("hide");
            },

        });
    });


});

</script>
