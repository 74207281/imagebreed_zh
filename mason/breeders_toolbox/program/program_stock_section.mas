<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/accessions"><p>前往管理種原(Go To Manage Accessions)</p></a>
            </td>
            <td>
                <a href="/breeders/seedlots"><p>前往管理種子批次(Go To Manage Seedlots)</p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_accessions", title=>"種原(Accessions)", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_accessions.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crosses", title=>"雜交(Crosses)", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crosses.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_seedlots", title=>"種子批次(Seedlots)", collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_seedlots.mas, program_id => $program_id &>
    </&>
</div>
