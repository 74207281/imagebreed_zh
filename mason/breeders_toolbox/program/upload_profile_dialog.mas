<%args>

$program_id
$program_name

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form'] &>

<div class="modal fade" id="upload_profile_dialog" name="upload_profile_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadProfileDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadProfileDialog">上傳產品概況(Upload Product Profile)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_profile_workflow" &>
                        <&| /util/workflow.mas:step, title=> "介紹(Intro)" &>
                            <& /page/page_title.mas, title=>"產品概況(Product Profile)" &>
                            <ul>
                                <li>產品概況可儲存在資料庫中，供每個育種計畫的下游品種選育過程使用。</li>
                                <li>為了便於資料管理，可以直接從資料庫中檢索目標性狀名稱和性狀 ID。</li>
                                <li>請使用從我們資料庫產生的產品概況範本填寫產品概況詳細資訊。</li>
                                <li>您可以在產品概況區段中找到建立範本的連結，只需提供檔案名稱和性狀清單即可。</li>
                                <li>填寫表格的說明在下一頁</li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "檔案格式(File Format)" &>
                            <& /page/page_title.mas, title=>"確保您的檔案符合正確的檔案格式(Make Sure Your File Matches the Correct File Format)" &>
                            <center>
                                <&| /page/explanation.mas, title=>'產品概況試算表(Product Profile Spreadsheet)' &>
                                    <p>
                                        <br>
                                        <a id="product_profile_instructions">產品概況試算表說明(Instructions for Product Profile Spreadsheet)</a>
                                        <br>
                                        <br>
                                    </p>
                                </&>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);">當您確認檔案符合格式後，前往下一步(Once You Think Your File Matches, Go to Next Step)</button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> "上傳產品概況(Upload Product Profile)" &>
                            <& /page/page_title.mas, title=>"提供關於產品概況的基本資訊並上傳您的檔案(Provide basic information about the product profile and upload your file)" &>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_profile_form" name="upload_profile_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">育種計畫：</label>
                                    <div class="col-sm-9">
                                        <input class="form-control" name="profile_program_name" id="profile_program_name" disabled value="<% $program_name %>">
                                        <input name="profile_program_id" id="profile_program_id" type="hidden" value="<% $program_id %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">產品概況名稱：</label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="new_profile_name" name="new_profile_name" type="text"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">範圍：</label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="new_profile_scope" name="new_profile_scope" type="text"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="profile_uploaded_file" id="profile_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </form>
                            <center>
                                <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" id ="upload_profile_submit" name="upload_profile_submit" >上傳產品概況(Upload Profile)</button><br/><br/>
                            </center>
                        </&>
                        <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                            <& /page/page_title.mas, title=>"完成！您的概況現已儲存在資料庫中(Finished! Your profile is now in the database)" &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                概況檔案已成功上傳
                            </p>
                            <br/>
                            <center>
                                <button class="btn btn-primary" name="upload_profile_success_complete_button">概況已成功儲存至資料庫，沒有任何錯誤！恭喜，點選此處(The profile was saved to the database with no errors! Congrats Click Here)</button><br/><br/>
                            </center>
                        </&>
                    </&>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_profile_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_profile_error_display" name="upload_profile_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadProfileErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadProfileErrorDialog">上傳概況檔案錯誤(Upload Profile File Error)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="product_profile_instruction_dialog" name="product_profile_instruction_dialog" tabindex="-1" role="dialog" aria-labelledby="profileInstructionDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="profileInstructionDialog">產品概況試算表說明(Instructions for Product Profile Spreadsheet)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        產品概況範本
                    </b>
                    <ul>
                        <li>產品概況範本為 Excel 檔案（.xls 格式）</li>
                        <li>填寫完產品概況詳細資訊後，也請將試算表儲存為 .xls 格式</li>
                        <li>請勿修改或刪除範本中的任何欄位表頭。</li>
                    </ul>
                    <br>
                    <b>
                        表頭：
                    </b>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>性狀名稱</td>
                                <td>目標值</td>
                                <td>對照品種</td>
                                <td>表現 (equal, smaller, larger)</td>
                                <td>權重</td>
                                <td>性狀類型</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        必填欄位：
                    </b>
                    <ul>
                        <li><b>性狀名稱 (Trait Name)：</b>範本已根據您的性狀清單包含性狀名稱</li>
                        <li><b>目標值或對照品種 (Target Value or Benchmark Variety)：</b>請為每個目標性狀指定<b>目標值</b>或<b>對照品種</b>。對照品種必須已存在於資料庫中。</li>
                        <li><b>表現 (Performance)：</b>請指定每個目標性狀相對於目標值或對照品種的表現（equal、smaller 或 larger）</li>
                    </ul>
                    <b>
                        選填欄位：
                    </b>
                    <ul>
                        <li><b>權重 (Weight)：</b>預設值為 1</li>
                        <li><b>性狀類型 (Trait Type)：</b>例如基本性狀、增值性狀</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#product_profile_instructions').click(function(){
        jQuery('#product_profile_instruction_dialog').modal("show");
    });

    jQuery('#upload_profile_submit').click(function () {
        upload_profile();
    });

    function upload_profile() {
        var profile_uploaded_file = jQuery("#profile_uploaded_file").val();
        var program_id = jQuery('#profile_program_id').val();
        var new_profile_name = jQuery('#new_profile_name').val();
        var new_profile_scope = jQuery('#new_profile_scope').val();

        jQuery('#upload_profile_form').attr("action", '/ajax/breeders/program/'+program_id+'/upload_profile');

        if (program_id === '') {
            alert("請選擇育種計畫");
            return;
        }
        if (new_profile_name === '') {
            alert("請輸入概況名稱");
            return;
        }
        if (new_profile_scope == '') {
            alert("請輸入範圍");
            return;
        }
        jQuery('#upload_profile_form').submit();

    }

    jQuery('#upload_profile_form').iframePostForm({
        json: true,
        post: function () {
        var profile_uploaded_file = jQuery("#profile_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (profile_uploaded_file == '') {
                jQuery('#working_modal').modal("hide");
                alert("未選擇檔案");
            }
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery('#upload_profile_error_display').modal("show");
                jQuery('#upload_profile_error_display tbody').html('');
                jQuery('#upload_profile_error_display tbody').append(response.error_string);
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#upload_profile_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_profile_workflow");

            }
        }
    });

    jQuery(document).on('click', '[name="upload_profile_success_complete_button"]', function(){
        jQuery('#upload_profile_dialog').modal('hide');
        location.reload();
    });


});

</script>
