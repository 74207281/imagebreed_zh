<%args>
$program_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<table id="program_cross_table" class="display">
    <thead>
        <tr>
            <th>雜交唯一 ID(Cross Unique ID)</th>
            <th>母本(Female Parent)</th>
            <th>父本(Male Parent)</th>
            <th>雜交類型(Cross Type)</th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#program_cross_table').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/crosses',
    });

});


</script>
