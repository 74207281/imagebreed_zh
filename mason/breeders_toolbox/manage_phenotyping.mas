
<%args>
$phenotype_files => undef
$deleted_phenotype_files => undef
$locations => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.Trial03152022','CXGN.BreedersToolbox.FieldBook03152022','CXGN.BreedersToolbox.UploadPhenotype03152022', 'CXGN.BreedersToolbox.UploadImages03152022', 'CXGN.BreederSearch03152022', 'CXGN.Trial03152022' ] &>

<& /page/page_title.mas, title=>"管理表型資料(Manage Phenotypic Data)" &>

<div class="container-fluid">

<!--button class="btn btn-info" onclick=location.href="/search/stocks">Phenotype Search</button><br /><br /-->

<& /fieldbook/create_fieldbook_dialog.mas &>
<& /fieldbook/create_trait_file_dialog.mas &>
<& /fieldbook/upload_phenotype_fieldbook.mas &>
<& /breeders_toolbox/upload_phenotype_spreadsheet.mas &>
<& /breeders_toolbox/upload_images.mas &>
<& /breeders_toolbox/trial/create_spreadsheet_dialog.mas &>

<div class="well">

<&| /page/info_section.mas, title=>'您上傳的檔案(Your Uploaded Files)', is_subsection=>1, subtitle=>'[<a id="upload_fieldbook_phenotypes_link" >上傳 Fieldbook 資料庫檔案(Upload Fieldbook Database File)</a>]    [<a id="upload_spreadsheet_phenotypes_link" >上傳試算表(Upload Spreadsheet)</a>]<br/>[<a name="create_fieldbook_link" >建立 Fieldbook 版面配置檔案(Create Fieldbook Layout File)</a>]    [<a id="create_new_trait_file_link" >建立 Fieldbook 性狀檔案(Create Fieldbook Trait File)</a>]<br/>[<a name="create_spreadsheet_link" >建立試算表(Create Spreadsheet)</a>] [<a id="upload_images_link" >上傳影像(Upload Images)</a>]' &>
  <br/>
  <& /breeders_toolbox/file_list.mas, files=>$phenotype_files, allow_delete=>1 &>

</&>

</div>
<div class="well">

<&| /page/info_section.mas, title=>'您已作廢的檔案(Your Obsoleted Files)', subtitle=>'這些檔案將不會在網站上的任何其他地方顯示', is_subsection=>1 &>

  <& /breeders_toolbox/file_list.mas, files=>$deleted_phenotype_files, allow_delete=>0 &>

</&>

</div>

</div>

<script>

jQuery(document).ready(function() {

    jQuery('button[name=delete_pheno_file_link]').click( function() {
        var delete_phenotypes_file_id = jQuery(this).data('file_id');
        if (confirm('您確定要從資料庫中刪除與此檔案相關的所有表型值並作廢此檔案嗎？')){
            jQuery.ajax ( {
                url : '/ajax/breeders/phenotyping/delete/'+delete_phenotypes_file_id,
                beforeSend : function() {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert('已作廢表型檔案並刪除資料庫中所有相關的表型值！');
                    location.reload();
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert("刪除檔案與表型時發生錯誤！");
                }
            });
        }
    });

});

</script>
