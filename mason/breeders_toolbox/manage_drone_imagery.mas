<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.BreederSearch03152022', 'd3.d3v4Min.js', 'opencv.opencv', 'CXGN.ManageDroneImagery09072022' ] &>

<style>
.straightLine, .hrLine{
  position: absolute;
  background-color: red;
  transition: transform .05s ease-in-out;
}
</style>

<div id="manage_drone_imagery_top_div">

    <& /page/page_title.mas, title=>"管理空拍影像" &>

    <div class="well well-sm">
        <center>
             <h4>請使用 Brave 或 Chrome 瀏覽器以正確顯示影像處理工具，未來將不再支援其他瀏覽器</h4>
             <h4><a href="https://www.youtube.com/channel/UC1FYqz6kz9pE72sSHhG7ocQ">空拍影像處理教學影片請點此連結</a></h4>
        </center>
    </div>

<%perl>
# 保留原始英文註解供參考
# my $buttons_html = "<button class='btn btn-primary' style='margin:3px' id='upload_drone_imagery_link'>Upload Imagery</button>...";
my $buttons_html = "<button class='btn btn-primary' style='margin:3px' id='upload_drone_imagery_link'>上傳空拍影像</button><button class='btn btn-success' style='margin:3px' id='drone_imagery_analytics_link'>影像分析</button><button class='btn btn-default' style='margin:3px' id='drone_imagery_view_imaging_vehicles_link'>影像拍攝設備</button><button class='btn btn-default' style='margin:3px' id='download_phenotypes_drone_imagery_link'>下載影像資訊</button><button class='btn btn-default' style='margin:3px' id='export_drone_imagery_events'>匯出拍攝批次</button>";
</%perl>

    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>空拍影像</h4>", info_section_subtitle => '如果您覺得這些工具很有用，請引用 <a href="https://acsess.onlinelibrary.wiley.com/doi/full/10.1002/ppj2.20004" target=_blank>ImageBreed</a>', buttons_html => $buttons_html, icon_class => undef, col1_width_class => "col-sm-0", col2_width_class => "col-sm-12", info_section_id => "manage_drone_imagery_main" &>

</div>

<& /breeders_toolbox/drone_imagery/drone_imagery_analytics.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_analysis.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_export_imaging_events.mas &>
<& /analyses/store_new_analysis_values_and_model.mas &>

<div id="manage_drone_imagery_standard_process_div" style="display:none">

    <& /page/page_title.mas, title=>"管理空拍影像：正射影像標準處理流程" &>

    <div class="well well-sm">
        <center>
             <h4>請使用 Brave 或 Chrome 瀏覽器以正確顯示影像處理工具，未來將不再支援其他瀏覽器</h4>
             <h4><a href="https://www.youtube.com/channel/UC1FYqz6kz9pE72sSHhG7ocQ">空拍影像處理教學影片請點此連結</a></h4>
        </center>
    </div>

    <&| /util/workflow.mas, id=> "manage_drone_imagery_standard_process_workflow" &>
        <&| /util/workflow.mas:step, title=> "簡介" &>
            <& /page/page_title.mas, title=>"此流程將引導您對空拍影像波段應用標準處理程序" &>
            <p>您可以在此選取一個已上傳的影像波段，完整執行從處理到儲存小區影像的流程。
            這將需要手動步驟，例如影像旋轉、裁切和小區多邊形樣板製作。
            完成一個影像波段的處理後，您可以將其套用到所有其他影像波段及計算出的植生指數。</p>
            <br/><br/>
            <center>
            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">下一步</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "影像波段" &>
            <& /page/page_title.mas, title=>"選擇一個影像波段" &>

            <div class="well well-sm">
                <p>請選擇一個影像波段來執行流程。
                建議選擇對比度高的波段，例如近紅外光 (NIR) 波段。
                如果影像太暗，您可以在下方選擇將影像增亮（僅用於輔助標準流程）。</p>
            </div>

            <div class="well well-sm">
                <div class="panel panel-default">
                    <div class="panel-body">
                   
                        <table class="table table-bordered table-hover" id="manage_drone_imagery_standard_process_drone_run_bands_table">
                            <thead>
                                <tr>
                                    <th>選擇</th>
                                    <th>影像波段名稱</th>
                                    <th>波段描述</th>
                                    <th>波段類型</th>
                                    <th>拍攝批次名稱</th>
                                    <th>拍攝批次描述</th>
                                    <th>拍攝日期</th>
                                    <th>田間試驗名稱</th>
                                    <th>田間試驗描述</th>
                                </tr>
                            </thead>
                        </table>

                        <hr>
                        <div class="form-horizontal">
                            <div class="form-group form-group-sm">
                             
                                <label class="col-sm-6 control-label">是否增亮影像？（僅在影像非常暗時，用於輔助完成標準流程）： </label>
                                <div class="col-sm-6">
                                    <select class="form-control" id="manage_drone_imagery_standard_process_brighten_image_option">
                                        <option value=0>否</option>
                                        <option value=1>是</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <br/>

                        <center>
                        <button class="btn btn-primary" id="manage_drone_imagery_standard_process_drone_run_band_step">下一步</button>
                        </center>
                    </div>
                </div>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "使用 GCP" &>
            <& /page/page_title.mas, title=>"使用地面控制點 (GCPs) 自動化整個標準流程" &>

            <div class="well well-sm">
                <p>如果此田間試驗先前的拍攝批次已經完成了標準流程，則該批次可用於自動化此新拍攝批次的其餘流程。</p>
                <p>如果先前的拍攝批次定義了地面控制點 (GCPs)，則 GCP 可用於自動化此新拍攝批次的標準流程。</p>
            </div>

            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">此田間試驗是否有先前的拍攝批次已完成標準流程？： </label>
                    <div class="col-sm-6">
                        <select class="form-control" id="manage_drone_imagery_standard_process_ground_control_points_option">
                            <option value="No">否</option>
                            <option value="Yes">是，且已定義地面控制點 (GCPs)。</option>
                            <option value="Yes_camera_rig">是，且使用相同的拍攝角度。</option>
                            </select>
                    </div>
                </div>
            </div>

            <div id="manage_drone_imagery_standard_process_ground_control_points_select_div" style="display:none">
               
                <div class="well well-sm">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">選擇要作為樣板的空拍批次： </label>
                                <div class="col-sm-6">
                                    <div id="manage_drone_imagery_standard_process_ground_control_points_select"></div>
                                </div>
                            </div>
                            <br/><br/>
                            <hr>

                            <div class="well well-sm">
                                <ul>
                                    <li>點擊下方影像中的地面控制點 (GCPs) 並儲存。</li>
                                    <li>請點擊並儲存至少三個點。<b>GCP 的名稱在不同拍攝批次之間必須一致！</b></li>
                                    <li>為獲得最佳效果，請使用田間四個角落的地面控制點。</li>
                                    <li>一旦繪製出計算後的多邊形樣板，您可以拖曳<b>黑點</b>來重新定位樣板。</li>
                                    <li>您可以縮小瀏覽器顯示比例以容納所有圖片 (Ctrl + -)。</li>
                                </ul>
                            </div>

                            <div class="well well-sm">
                                <div id="project_drone_imagery_standard_process_ground_control_points_saved_div"></div>

                                <br/><br/>
                                <center>
                                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_step">繪製計算出的小區多邊形</button>
                                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_step_confirm">確認並儲存</button>
                                </center>
                            </div>

                            <div id="project_drone_imagery_standard_process_ground_control_points_info_div"></div>

                            <div id="project_drone_imagery_standard_process_ground_control_points_loading_div"><img src="/img/wheel.gif" /></div>

                            <div id="project_drone_imagery_standard_process_ground_control_points_svg_div"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="manage_drone_imagery_standard_process_previous_camera_rig_select_div" style="display:none">
                <div class="well well-sm">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">注意：這僅適用於溫室或具有拍攝角度且拍攝大範圍實驗的情況。選擇要作為樣板的空拍批次。將應用相同的旋轉、裁切和小區多邊形樣板： </label>
                                <div class="col-sm-6">
                                    <div id="manage_drone_imagery_standard_process_previous_camera_rig_select"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <center>
                    <button class="btn btn-primary" id="manage_drone_imagery_standard_process_previous_camera_rig_step_confirm">確認並儲存</button>
                    </center>
                </div>
            </div>
            <div id="manage_drone_imagery_standard_process_previous_geotiff_params_div" style="display:none">
         
                <div class="well well-sm">
                    <div class="panel panel-default">
                        <div class="panel-body">

                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">選擇要作為樣板的空拍批次。將應用相同的旋轉和小區多邊形樣板： </label>
                                    <div class="col-sm-6">
                                        <div id="manage_drone_imagery_standard_process_geotiff_params_select"></div>
                                    </div>
                                </div>
                            </div>

                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="manage_drone_imagery_standard_process_previous_geotiff_params_form" name="manage_drone_imagery_standard_process_previous_geotiff_params_form" action="/drone_imagery/standard_process_previous_geotiff" >
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">WGS84/UTM GeoTIFF (.tif): (尺寸應與上傳的反射率地圖相同)</label>
                                    <div class="col-sm-6" >
                                        <input type="file" id="manage_drone_imagery_standard_process_geotiff_params_geotiff" name="manage_drone_imagery_standard_process_geotiff_params_geotiff" encoding="multipart/form-data" />
                                    </div>
                                </div>
                                <div class="form-group">
                                     <label class="col-sm-6 control-label">GeoTIFF 類型：</label>
                                    <div class="col-sm-6" >
                                        <select class="form-control" id="manage_drone_imagery_standard_process_geotiff_params_type" name="manage_drone_imagery_standard_process_geotiff_params_type">
                                            <option value="single">單波段 GeoTIFF</option>
                                            <option value="rgb">RGB GeoTIFF</option>
                                       </select>
                                    </div>
                               </div>
                                <input type="hidden" name="manage_drone_imagery_standard_process_geotiff_params_previous_drone_run_project_id" id="manage_drone_imagery_standard_process_geotiff_params_previous_drone_run_project_id" value="" />
                                <input type="hidden" name="manage_drone_imagery_standard_process_geotiff_params_drone_run_project_id" id="manage_drone_imagery_standard_process_geotiff_params_drone_run_project_id" value="" />
                                <input type="hidden" name="manage_drone_imagery_standard_process_geotiff_params_angle" id="manage_drone_imagery_standard_process_geotiff_params_angle" value="" />
                                <input type="hidden" name="manage_drone_imagery_standard_process_geotiff_params_time_cvterm_id" id="manage_drone_imagery_standard_process_geotiff_params_time_cvterm_id" value="" />
                            </form>

                           <center>
                            <button class="btn btn-primary" id="manage_drone_imagery_standard_process_geotiff_params_confirm">確認並前往下一步</button>
                            </center>
                        </div>
                    </div>
                </div>
            </div>
            <div id="manage_drone_imagery_standard_process_ground_control_points_skip_div" style="display:none">
                <center>
                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_ground_control_points_skip_step">略過並前往下一步</button>
                </center>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "旋轉" &>
            <& /page/page_title.mas, title=>"旋轉您選擇的影像波段" &>

            <div class="well well-sm">
                <ul>
                    <li>在此您可以對影像進行旋轉。</li>
                    <li>您可以縮小瀏覽器顯示比例以容納所有圖片 (Ctrl + -)。</li>
                    <li>您的影像應該要精確地保持行與行平行對齊。</li>
                    <li>根據您的田間試驗設計，需要確認第一個小區（如第 1 號小區）位於影像的左上角或右上角。</li>
                </ul>
            </div>

            <div class="well well-sm">

                <form class="form-horizontal">
                    <div class="form-group form-group-sm">
                        <label class="col-sm-6 control-label">逆時針旋轉角度（使用左右鍵微調）： </label>
                        <div class="col-sm-6">
                            <input type="range" min="-180" max="180" step="0.01" id="drone_imagery_standard_process_rotate_degrees_input" name="drone_imagery_standard_process_rotate_degrees_input" value="0.00"><div id="drone_imagery_standard_process_rotate_degrees_input_text"></div>
                        </div>
                   </div>
                </form>

                <button class="btn btn-default" id="drone_imagery_standard_process_rotate_stitched_crosshairs">繪製十字準線輔助</button>

                 <hr>
                <div id="manage_drone_imagery_standard_process_rotate_step_confirm_div" style="display:none">
                    <button class="btn btn-primary" id="manage_drone_imagery_standard_process_rotate_step">儲存旋轉後的影像並前往下一步</button>
                </div>
                <div id="manage_drone_imagery_standard_process_rotate_step_finish_div" style="display:none">
                    <button class="btn btn-primary" id="manage_drone_imagery_standard_process_rotate_step_finish">儲存旋轉後的影像並完成標準流程</button>
                </div>
            </div>

            <div id="manage_drone_imagery_standard_process_rotate_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <div id="drone_imagery_standard_process_rotate_original_stitched_div"></div>

        </&>
        <&| /util/workflow.mas:step, title=> "裁切" &>
            <& /page/page_title.mas, title=>"裁切您的影像波段至特定關注區域" &>

            <div class="well well-sm">
                <ul>
                    <li>在此您可以對拼接好的正射影像進行粗略裁切，僅保留實際田間試驗範圍。</li>
                    <li>您可以縮小瀏覽器顯示比例以容納所有圖片 (Ctrl + -)。</li>
                    <li>在影像中點擊四個點以形成一個四邊形。</li>
                    <li>僅最後繪製的多邊形會被用於裁切。</li>
                </ul>
                <br/>
                <button class="btn btn-primary" id="manage_drone_imagery_standard_process_cropping_step">儲存並前往下一步</button>
            </div>

            <div id="manage_drone_imagery_standard_process_crop_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <canvas id="drone_imagery_standard_process_crop_original_stitched_div"></canvas>

            <hr>
            <div class="well well-sm">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label">此田間試驗先前使用的影像裁切設定： </label>
                                 <div class="col-sm-6">
                                    <div id="plot_polygons_standard_process_previously_saved_image_cropping_templates">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <button class="btn btn-primary" id="drone_imagery_standard_process_cropping_use_previous_cropping">使用影像裁切設定</button>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "閾值處理" &>
            <& /page/page_title.mas, title=>"對影像波段進行閾值處理以移除背景" &>

            <div class="well">
                <&| /page/info_section.mas, title => '使用百分比閾值移除背景', collapsible=>1, collapsed => 0, subtitle=> '透過指定百分比閾值來移除背景' &>
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <div class="row">
                                 <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-6 control-label">捨棄最低百分比的像素值： </label>
                                        <div class="col-sm-6">
                                           <input class="form-control" id="drone_imagery_standard_process_remove_background_lower_threshold_percentage" name="drone_imagery_standard_process_remove_background_lower_threshold_percentage" type="number" max="99" min="0" placeholder="例如：最低 10% 的像素值 (最小 0, 最大 100)" value=25 disabled/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                         <label class="col-sm-6 control-label">捨棄最高百分比的像素值： </label>
                                        <div class="col-sm-6">
                                            <input class="form-control" id="drone_imagery_standard_process_remove_background_upper_threshold_percentage" name="drone_imagery_standard_process_remove_background_upper_threshold_percentage" type="number" max="99" min="0" placeholder="例如：最高 10% 的像素值 (最小 0, 最大 100)" value=25 disabled/>
                                        </div>
                                    </div>
                                 </div>
                            </div>
                            <hr>

                             <input type="checkbox" id="drone_imagery_standard_process_remove_background_upper_threshold_percentage_change_button">&nbsp;&nbsp;&nbsp;&nbsp; 更改閾值
                        </div>
                    </div>
                </&>
            </div>

            <center>
                <button id="drone_imagery_standard_process_remove_background_defined_percentage_submit" class="btn btn-primary">套用閾值</button>
            </center>

            <hr>

            <div id="manage_drone_imagery_standard_process_remove_background_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <div class="well well-sm">
                <&| /page/info_section.mas, title => '像素值直方圖', collapsible=>1, collapsed => 0, subtitle=> '像素值直方圖' &>
                    <center>
                        <canvas id="drone_imagery_standard_process_remove_background_histogram_div"></canvas>
                    </center>
                 </&>
            </div>

            <div class="well well-sm">
                <&| /page/info_section.mas, title => '去除噪點後的原始影像', collapsible=>1, collapsed => 0, subtitle=> '去除噪點後的原始影像' &>
                    <center>
                        <canvas id="drone_imagery_standard_process_remove_background_original"></canvas>
                    </center>
                </&>
            </div>

        </&>
        <&| /util/workflow.mas:step, title=> "小區多邊形" &>
            <& /page/page_title.mas, title=>"定義相對於田間配置的小區多邊形" &>

            <& /page/detail_page_2_col_section.mas, info_section_collapsible=>1, info_section_collapsed=>0, info_section_title => "<h4 style='display:inline'>產生多邊形樣板工具</h4>", info_section_subtitle => '在影像上覆蓋均勻網格。', icon_class => "glyphicon glyphicon-th-large", info_section_id => "manage_drone_imagery_standard_process_generate_plot_polygons_section" &>

            <div class="well well-sm">
                <div id="drone_imagery_standard_process_plot_polygons_top_section"></div>

                <button id="drone_imagery_standard_process_plot_polygons_clear" class="btn btn-danger">清除所有多邊形並重新開始製作樣板</button>
                <br/><br/>
                <button id="drone_imagery_standard_process_plot_polygons_get_distance" class="btn btn-default">測量點與點之間的距離</button>
                <button id="drone_imagery_standard_process_plot_polygons_switch_image_url" class="btn btn-default">切換原始影像與去背影像</button>
            </div>

            <div id="manage_drone_imagery_standard_process_plot_polygons_load_div">
                <img src="/img/wheel.gif" />
            </div>

            <div id="drone_imagery_standard_process_plot_polygons_original_stitched_div_svg"></div>

            <hr>
            <div class="well well-sm">

                <div id="drone_imagery_standard_process_generated_polygons_table_header_div"></div>

                 <div class="panel panel-default"><div class="panel-body">
                    <h3>(選項 1)</h3>

                    <&| /page/info_section.mas, title => '自動將小區編號分配給多邊形編號', collapsible=>1, collapsed => 1, subtitle=> '自動分配小區編號的介面。' &>
                        <div class="well well-sm">
                            <div id="drone_imagery_standard_process_generated_polygons_div">請先完成上方的樣板製作</div>
                        </div>
                    </&>
                </div></div>

                <div class="panel panel-default"><div class="panel-body">
                    <h3>(選項 2)</h3>

                    <&| /page/info_section.mas, title => '上傳試算表檔案以將小區編號分配給多邊形編號', collapsible=>1, collapsed => 1, subtitle=> '上傳分配編號的試算表。' &>
                        <div class="well well-sm">
                            <div id="drone_imagery_standard_process_generated_polygons_spreadsheet_div">
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <ul>
                                            <li>如果選項 1 無法符合您的田間試驗，選項 2 和 3 提供更大的彈性。</li>
                                            <li>上傳一個包含以下三欄的 <b>XLS</b> 檔案：<b>polygon_number, plot_number, field_trial</b>
                                              <ul>
                                                    <li><b>polygon_number</b>: 樣板製作過程中產生的多邊形編號。這些編號在樣板影像中可見。</li>
                                                    <li><b>plot_number</b>: 要分配給該多邊形的小區編號。田間配置圖位於本頁底部，可在此確認可用的小區編號。</li>
                                                    <li><b>field_trial</b>: 該小區編號所屬的田間試驗。相同的小區編號（如 101）可能存在於不同的試驗中，此欄位用於區分。</li>
                                                </ul>
                                            </li>
                                            <li>如果您想跳過某個產生的多邊形編號，只需在試算表中不包含它即可。</li>
                                         </ul>
                                    </div>
                                </div>
                               <div class="panel panel-default">
                                    <div class="panel-body">
                                        <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="drone_imagery_plot_polygons_spreadsheet_upload_form" name="drone_imagery_plot_polygons_spreadsheet_upload_form">
                                            <div class="form-group form-group-sm">
                                                <label class="col-sm-3 control-label">試算表上傳 (.xls): </label>
                                                <div class="col-sm-9">
                                                    <input class="form-control" id="drone_imagery_plot_polygons_spreadsheet_upload" name="drone_imagery_plot_polygons_spreadsheet_upload" type="file" encoding="multipart/form-data" />
                                                    <input id="drone_imagery_plot_polygons_spreadsheet_upload_stock_polygons" name="drone_imagery_plot_polygons_spreadsheet_upload_stock_polygons" type="hidden" />
                                                </div>
                                            </div>
                                        </form>

                                         <div id="drone_imagery_plot_polygons_spreadsheet_upload_form_response_div"></div>

                                        <button class="btn btn-primary" id="drone_imagery_plot_polygons_spreadsheet_upload_button" name="drone_imagery_plot_polygons_spreadsheet_upload_button">產生分配 (不儲存)</button>&nbsp;&nbsp;&nbsp;<button class="btn btn-primary" name="drone_imagery_standard_process_plot_polygons_submit_bottom">完成並將多邊形儲存至小區</button>
                                     </div>
                                </div>
                            </div>
                      </div>
                    </&>
                </div></div>

                <div class="panel panel-default"><div class="panel-body">
                    <h3>(選項 3)</h3>

                    <&| /page/info_section.mas, title => '手動將小區編號分配給多邊形編號', collapsible=>1, collapsed => 1, subtitle=> '手動分配編號的表格輸入。' &>
                        <div class="well well-sm">
                            <div id="drone_imagery_standard_process_generated_polygons_table">請先完成上方的樣板製作</div>
                        </div>
                    </&>
                </div></div>

            </div>

            <hr>
            <div class="well well-sm">
                <div id="drone_imagery_standard_process_trial_layout_div_0"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_1"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_2"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_3"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_4"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_5"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_6"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_7"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_8"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_9"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_10"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_11"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_12"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_13"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_14"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_15"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_16"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_17"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_18"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_19"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_20"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_21"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_22"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_23"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_24"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_25"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_26"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_27"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_28"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_29"></div>
                <div id="drone_imagery_standard_process_trial_layout_div_30"></div>
            </div>

         </&>
        <&| /util/workflow.mas:step, title=> "應用" &>
            <& /page/page_title.mas, title=>"將相同的步驟應用於此拍攝批次中的其他影像波段" &>

            <div class="well well-sm">
                <ul>
                    <li>在此您可以將前面步驟 1 到 6 的操作，應用到此拍攝批次中的其他影像波段。</li>
                    <li>閾值處理將動態完成，自動移除前 20% 和後 20% 的像素值。</li>
                </ul>
            </div>

            <div class="well well-sm">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <table class="table table-bordered table-hover" id="manage_drone_imagery_standard_process_drone_run_bands_apply_table">
                            <thead>
                                <tr>
                                    <th>選擇</th>
                                    <th>影像波段名稱</th>
                                    <th>波段描述</th>
                                    <th>波段類型</th>
                                    <th>拍攝批次名稱</th>
                                    <th>拍攝批次描述</th>
                                    <th>拍攝日期</th>
                                    <th>田間試驗名稱</th>
                                    <th>田間試驗描述</th>
                                </tr>
                            </thead>
                        </table>

                        <br/>

                        <center>
                        <button class="btn btn-primary" id="manage_drone_imagery_standard_process_drone_run_band_apply_step">下一步</button>
                        </center>
                    </div>
                </div>
            </div>
        </&>
        <&| /util/workflow.mas:step, title=> "指數" &>
            <& /page/page_title.mas, title=>"建立並將這些步驟應用於植生指數" &>

            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">要應用的植生指數： </label>
                    <div class="col-sm-6">
                        <input name="drone_imagery_standard_process_apply_indices_select" value="TGI" type="checkbox" checked> 三角綠度指數 (Triangular Greenness Inde, TGI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="VARI" type="checkbox" checked> 可見光大氣抵抗指標(Visible Atmospherically Resistant Index, VARI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="NDVI" type="checkbox" checked> 常態化差異植生指標(Normalized Difference Vegetation Index, NDVI) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="NDRE" type="checkbox" checked> 歸一化差異紅邊植生指數 (Normalized Difference Red Edge Index, NDRE) <br/>
                        <input name="drone_imagery_standard_process_apply_indices_select" value="CCC" type="checkbox" checked> 冠層覆蓋度 Canopeo 演算法 (Canopy Coverage Canopeo Algorithm, CC) <br/>
                    </div>
                 </div>
            </form>

            <br/>

            <center>
            <button type="button" class="btn btn-primary" id="manage_drone_imagery_standard_process_indices_step">下一步</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "外表型" &>
            <& /page/page_title.mas, title=>"計算所有小區多邊形影像的外表型數據" &>

            <form class="form-horizontal">
                <div class="well well-sm">
                    <div class="form-group form-group-sm">
                       <label class="col-sm-4 control-label">要計算並儲存至資料庫的區域統計數據： </label>
                        <div class="col-sm-8">
                            <input name="drone_imagery_standard_process_phenotypes_select" value="zonal" type="checkbox" checked disabled> 區域統計：非零像素計數、總像素和、平均像素值、調和平均值、中位數像素值、變異數、標準差、母體標準差、最小值、最大值、少數像素值、少數像素計數、多數像素值、多數像素計數、像素多樣性計數 <br/>
                         </div>
                    </div>
                </div>
                <div class="well well-sm">
                    <input type="checkbox" id="drone_imagery_standard_process_phenotypes_margin_button">&nbsp;&nbsp;&nbsp;&nbsp;
                    更改邊距數值
                    <hr>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-8 control-label">計算小區多邊形 上/下 的緩衝邊距 (%)： </label>
                                <div class="col-sm-4">
                                     <input class="form-control" id="drone_imagery_standard_process_phenotypes_margin_top_bottom" name="drone_imagery_standard_process_phenotypes_margin_top_bottom" type="number" value=5 disabled/>
                                </div>
                            </div>
                         </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-8 control-label">計算小區多邊形 左/右 的緩衝邊距 (%)： </label>
                                <div class="col-sm-4">
                                    <input class="form-control" id="drone_imagery_standard_process_phenotypes_margin_left_right" name="drone_imagery_standard_process_phenotypes_margin_left_right" type="number" value=5 disabled/>
                                </div>
                            </div>
                        </div>
                    </div>

                     <hr>

                    <div id="drone_imagery_standard_process_phenotypes_margin_visual_div_svg"><div class="well well-sm"><p>載入中...請稍候...</p></div></div>
                </div>
                <div class="well well-sm">
                    <div class="form-group form-group-sm">
                       <label class="col-sm-9 control-label">將相同的標準流程應用於所有使用相同相機設備的上傳拍攝批次（僅適用於固定式相機，例如溫室或受控環境）： </label>
                        <div class="col-sm-3">
                            <select class="form-control" id="drone_imagery_standard_process_camera_rig_apply_select">
                                 <option value="No">否</option>
                                <option value="Yes">是</option>
                            </select>
                       </div>
                    </div>
                </div>
            </form>
            <br/>

            <div id="drone_imagery_standard_process_week_term_div"></div>

            <center>
            <button type="button" class="btn btn-info" id="manage_drone_imagery_standard_process_phenotypes_step">完成</button>
            </center>
        </&>
    </&>

</div>

<& /breeders_toolbox/drone_imagery/standard_process_raw_images.mas &>

<div id="project_drone_imagery_ground_control_points_div" style="display:none">

    <& /page/page_title.mas, title=>"管理空拍影像：儲存地面控制點 (GCPs)" &>

    <div id="project_drone_imagery_ground_control_points_title_div"></div>

    <div class="well well-sm">
        <ul>
            <li>點擊下方影像中的地面控制點 (GCPs) 並儲存。</li>
            <li>請點擊並儲存至少三個點。<b>GCP 的名稱在不同拍攝批次之間必須一致！</b></li>
            <li>標準流程完成後，您可以切換至其他影像波段（例如藍光、綠光、紅光、NIR、BGR）。</li>
            <li>您可以縮小瀏覽器顯示比例以容納所有圖片 (Ctrl + -)。</li>
        </ul>
    </div>

    <div id="project_drone_imagery_ground_control_points_next_buttons" style="display:none">
        <button class="btn btn-default" id="project_drone_imagery_ground_control_points_previous_image">檢視上一種影像類型</button>
        <button class="btn btn-default" id="project_drone_imagery_ground_control_points_next_image">檢視下一種影像類型</button>
        <br/><br/>
    </div>

    <div class="well well-sm">
        <div id="project_drone_imagery_ground_control_points_saved_div"></div>
    </div>

    <div id="project_drone_imagery_ground_control_points_image_type_div"></div>
    <div id="project_drone_imagery_ground_control_points_info_div"></div>

    <div id="project_drone_imagery_ground_control_points_loading_div"><img src="/img/wheel.gif" /></div>

    <div id="project_drone_imagery_ground_control_points_svg_div"></div>

</div>

<div class="modal fade" id="project_drone_imagery_ground_control_points_form_dialog" name="project_drone_imagery_ground_control_points_form_dialog" tabindex="-1" role="dialog" aria-labelledby="saveGroundControlPointsDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="saveGroundControlPointsDialog">儲存地面控制點</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">地面控制點名稱（若使用相同名稱可覆蓋。<b>不同拍攝批次間名稱必須一致！</b>）： </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_name" name="project_drone_imagery_ground_control_points_form_input_name" type="text" placeholder="例如：西北角, 或 點 1" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">緯度 (選填)： </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_latitude" name="project_drone_imagery_ground_control_points_form_input_latitude" type="text" />
                     </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">經度 (選填)： </label>
                    <div class="col-sm-6">
                         <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_longitude" name="project_drone_imagery_ground_control_points_form_input_longitude" type="text" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">X 座標： </label>
                     <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_x_pos" name="project_drone_imagery_ground_control_points_form_input_x_pos" type="text" />
                    </div>
                </div>
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">Y 座標： </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="project_drone_imagery_ground_control_points_form_input_y_pos" name="project_drone_imagery_ground_control_points_form_input_y_pos" type="text" />
                    </div>
                 </div>
            </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="project_drone_imagery_ground_control_points_form_save">儲存 GCP</button>
        <button type="button" class="btn btn-default" data-dismiss="modal">關閉</button>
      </div>
    </div>
  </div>
</div>

<div id="manage_drone_imagery_standard_process_raw_images_div" style="display:none">

    <& /page/page_title.mas, title=>"管理空拍影像：原始影像標準處理流程" &>

    <&| /util/workflow.mas, id=> "manage_drone_imagery_standard_process_raw_images_workflow" &>
        <&| /util/workflow.mas:step, title=> "簡介" &>
            <& /page/page_title.mas, title=>"此流程將引導您對空拍影像波段應用標準處理程序" &>

            <div class="well well-sm">
                <p>此流程將允許您手動分配小區多邊形至原始影像。</p>
            </div>

            <br/><br/>
            <center>
            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;">下一步</button>
            </center>
        </&>
        <&| /util/workflow.mas:step, title=> "小區多邊形" &>
            <& /page/page_title.mas, title=>"手動分配小區多邊形至原始影像" &>

            <div class="well well-sm">
                <ul>
                    <li>(1) 從下方網格中選擇一張影像並調整旋轉。</li>
                    <li>(2) 點擊四個角落以包圍一組感興趣的小區。或者，貼上先前使用的樣板。</li>
                    <li>(3) 在繪製表格中輸入對應於繪製小區多邊形的小區編號。</li>
                    <li>(4) 點擊分配小區多邊形以儲存。重複步驟 1 到 4 直到所有小區都已分配影像。</li>
                </ul>
            </div>
<div class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-2 control-label">點擊原始影像堆疊： </label>
                     <div class="col-sm-10">
                        <div id="drone_imagery_standard_process_raw_images_image_id_select_div"></div>
                    </div>
                </div>
            </div>
            <hr>

            <canvas id="drone_imagery_standard_process_raw_images_show"></canvas>
            <canvas id="drone_imagery_standard_process_raw_images_show_another_image"></canvas>
            <canvas id="drone_imagery_standard_process_raw_images_show_another_image_second"></canvas>

            <hr>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_in_place" onclick="return false;">貼上先前使用的小區多邊形</button>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_view_image" onclick="return false;">同時檢視另一張影像</button>
            <button class="btn btn-default btn-sm" id="drone_imagery_standard_process_raw_images_paste_previous_polygon_view_image_second" onclick="return false;">同時檢視另一張影像</button>

            <hr>
            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">逆時針旋轉角度： </label>
                    <div class="col-sm-6">
                        <input class="form-control" id="drone_imagery_standard_process_raw_images_rotate_degrees_input" name="drone_imagery_standard_process_raw_images_rotate_degrees_input" type="text" placeholder="旋轉角度數值" value="0.00"/>
                    </div>
                </div>
            </form>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_rotate_image" onclick="return false;">旋轉影像</button>
            <hr>

            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">已訓練的 Mask R-CNN 模型： </label>
                    <div class="col-sm-6">
                        <div id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_models_div"></div>
                    </div>
                </div>
            </form>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_predict_button" onclick="return false;">預測遮罩</button>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_retrain_mask_rcnn_modal_button" onclick="return false;">重新訓練 Mask R-CNN</button>
            <hr>

            <hr>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_save_polygon" onclick="return false;">儲存小區多邊形</button>
            <button class="btn btn-primary btn-sm" id="drone_imagery_standard_process_raw_images_paste_polygon" onclick="return false;">貼上小區多邊形</button>
            <button class="btn btn-danger btn-sm" id="drone_imagery_standard_process_raw_images_clear_polygon" onclick="return false;">重新開始</button>
             <hr>

            <hr>
            <form class="form-horizontal">
                <div class="form-group form-group-sm">
                    <label class="col-sm-6 control-label">先前使用的小區多邊形： </label>
