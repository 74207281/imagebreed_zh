<%doc>

=head1 NAME

/breeders_toolbox/trial.mas - a mason component to display a trial detail page

=head1 AUTHOR

=cut

</%doc>

<%args>
$trial_id
$trial_name
$private_company_id
$private_company_name
$private_company_project_is_private
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name => ""
$main_production_site_url => undef
$year => undef
$trial_type => undef
$trial_type_id => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$user_can_modify => undef
$has_plant_entries => undef
$has_subplot_entries => undef
$has_tissue_sample_entries => undef
$hidap_enabled => undef
$folder_name => undef
$folder_id => undef
$plants_per_plot => undef
$has_expression_atlas => undef
$expression_atlas_url => undef
$site_project_name => undef
$sgn_session_id => undef
$user_name => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$has_col_and_row_numbers => undef
$identifier_prefix => 'SGN'
$plot_width => undef
$plot_length => undef
$field_size => undef
$field_trial_is_planned_to_be_genotyped => undef
$field_trial_is_planned_to_cross => undef
$trial_stock_type => undef
$management_factor_types => ()
$trial_owner => undef
$latest_trial_activity => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial03152022', 'moment_min', 'daterangepicker' ] &>

%  my $project_is_private = $private_company_project_is_private ? 'True' : 'False';

<br/>

<& /page/page_title.mas, title=>"試驗詳細資料：".$trial_name &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>試驗詳細資料</h4>", info_section_subtitle => '檢視並編輯有關此實驗的基本資訊。', buttons_html => '<button class="btn btn-primary btn-sm" id="edit_trial_details" style="margin:3px">編輯試驗詳細資料</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "trial_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, trial_type => $trial_type, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, plot_width => $plot_width, plot_length => $plot_length, field_size => $field_size, field_trial_is_planned_to_be_genotyped => $field_trial_is_planned_to_be_genotyped, field_trial_is_planned_to_cross => $field_trial_is_planned_to_cross, folder_name => $folder_name, folder_id => $folder_id, identifier_prefix => $identifier_prefix, trial_stock_type => $trial_stock_type, trial_owner => $trial_owner, latest_trial_activity => $latest_trial_activity, company_id => $private_company_id, company_name => $private_company_name, company_project_is_private => $project_is_private  &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, trial_name => $trial_name, breeding_program_name => $breeding_program_name, location_name => $location_name, year => $year, trial_type => $trial_type, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, folder_id => $folder_id, design_name => $design_name, has_plant_entries => $has_plant_entries, phenotypes_fully_uploaded => $phenotypes_fully_uploaded, user_can_modify => $user_can_modify, user_name => $user_name, info_section_title => "<h4 style='display:inline'>試驗狀態</h4>", info_section_subtitle => '檢視此試驗的進度。', icon_class => "glyphicon glyphicon-forward", info_section_id => "trial_status_section" &>

% my $barcode_section_title = '';
% if ($trial_stock_type eq 'family_name') {
%     $barcode_section_title = '為此試驗中的小區、植株或家族名稱產生條碼標籤。';
% } elsif ($trial_stock_type eq 'cross') {
%     $barcode_section_title = '為此試驗中的小區、植株或雜交唯一識別碼產生條碼標籤。';
% } else {
%     $barcode_section_title = '為此試驗中的小區、植株或種原產生條碼標籤。';
% }
<div class="row">
    <div class="col-sm-6">
        <& /page/detail_page_3_col_section.mas, icon_class => "glyphicon glyphicon-qrcode", title => $barcode_section_title, button_id => "generate_trial_barcode_link" &>
    </div>
    <div class="col-sm-6">
        <& /page/detail_page_3_col_section.mas, icon_class => "glyphicon glyphicon-pencil", title => "直接將此試驗的表型數據記錄到資料庫。", button_id => "direct_phenotyping_link" &>
    </div>
</div>

% my $subtitle = '檢視並編輯實驗的空間配置。同時檢視已分析表型性狀的熱圖。';
% my $layout_buttons = '';
% if ($has_col_and_row_numbers){
%     $layout_buttons = '<h3><span class="glyphicon glyphicon-ok-sign text-success"></span>&nbsp;&nbsp;&nbsp;此實驗已上傳空間配置資訊！</h3><button class="btn btn-success btn-sm" style="margin:3px" id="gps_field_map_link">前往地理田間配置</button><button class="btn btn-primary btn-sm" style="margin:3px" id="edit_field_map_link">編輯田間配置</button><button class="btn btn-default btn-sm" style="margin:3px" id="trial_fieldmap_download_layout_button">下載空間配置</button><button class="btn btn-danger btn-sm" id="delete_field_map_hm_link" style="margin:3px">刪除空間配置</button><button class="btn btn-default btn-sm" style="margin:3px" data-toggle="modal" data-target="#fieldmap_usage_modal">使用說明 <span class="glyphicon glyphicon-question-sign"></span></button>';
% } else {
%    $layout_buttons = '<h3><span class="glyphicon glyphicon-remove-sign text-danger"></span>&nbsp;&nbsp;&nbsp;此實驗尚未擁有空間配置資訊！</h3><button class="btn btn-success btn-sm" style="margin:3px" id="gps_field_map_link">前往地理田間配置</button><button class="btn btn-primary btn-sm" style="margin:3px" id="heatmap_upload_trial_coords_link">上傳空間配置</button><button class="btn btn-primary btn-sm" style="margin:3px" id="edit_field_map_link">編輯田間配置</button><button class="btn btn-default btn-sm" style="margin:3px" data-toggle="modal" data-target="#fieldmap_usage_modal">使用說明 <span class="glyphicon glyphicon-question-sign"></span></button>';
% }

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>田間配置工具與表型熱圖</h4>", info_section_subtitle => $subtitle, buttons_html => $layout_buttons, icon_class => "glyphicon glyphicon-th", info_section_id => "pheno_heatmap" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, trial_name => $trial_name, info_section_title => "<h4 style='display:inline'>實驗設計</h4>", info_section_subtitle => '檢視並新增實驗設計資訊。新增植株條目和組織樣本條目。', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="trial_download_layout_button">下載配置</button> <button class="btn btn-sm btn-default" style="margin:3px" id="trial_upload_seedlot_button" >上傳試驗種植的種子批</button> <button class="btn btn-sm btn-default" style="margin:3px" id="trial_upload_plot_gps_button" >上傳 GPS 座標</button> <button class="btn btn-sm btn-default" style="margin:3px" id="trial_detail_page_add_treatment">新增管理因子</button> <button class="btn btn-sm btn-default" style="margin:3px" id="trial_detail_page_change_accessions">變更種原</button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "trial_design_section", has_plant_entries => $has_plant_entries, has_subplot_entries => $has_subplot_entries, has_tissue_sample_entries => $has_tissue_sample_entries, trial_stock_type => $trial_stock_type &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>基因組關係矩陣</h4>", info_section_subtitle => '檢視此試驗中種原間的基因組關係。', buttons_html => "<button class='btn btn-sm btn-primary' style='margin:3px' name='upload_genotyping_data_link'>建立基因組關係矩陣</button><button class='btn btn-sm btn-default' style='margin:3px' id='trial_genomic_relationships_link_button'>連結基因組關係矩陣</button>", icon_class => "glyphicon glyphicon-random", info_section_id => "trial_detail_genomic_relationships", &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>表型摘要統計</h4>", info_section_subtitle => '檢視並下載已上傳的表型數據。', buttons_html => "<button class='btn btn-sm btn-primary' style='margin:3px' id='trial_download_phenotypes_button'>下載試驗表型數據</button>", icon_class => "glyphicon glyphicon-equalizer", info_section_id => "trial_detail_traits_assayed", has_expression_atlas => $has_expression_atlas, trial_name => $trial_name, expression_atlas_url => $expression_atlas_url, site_project_name => $site_project_name, sgn_session_id => $sgn_session_id, user_name => $user_name, main_production_site_url => $main_production_site_url, trial_stock_type => $trial_stock_type &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>分析工具</h4>", info_section_subtitle => '執行相關性分析、空間校正、時間序列繪圖等。', icon_class => "glyphicon glyphicon-signal", info_section_id => "trial_analysis_tools", hidap_enabled => $hidap_enabled, main_production_site_url => $main_production_site_url, breeding_program_name => $breeding_program_name, folder_name => $folder_name, trial_name => $trial_name &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>氣象數據</h4>", info_section_subtitle => '檢視此地點的降雨量、溫度、光照強度及其他氣象數據。', icon_class => "glyphicon glyphicon-cloud", info_section_id => "trial_weather_data", location_name => $location_name, location_id => $location_id, planting_date => $planting_date, harvest_date => $harvest_date &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>上傳數據檔案</h4>", info_section_subtitle => '使用 Excel 或 Android Fieldbook 收集表型數據。也可上傳此試驗的任何額外檔案。', icon_class => "glyphicon glyphicon-cloud-upload", info_section_id => "trial_upload_files", trial_stock_type => $trial_stock_type &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>計算新表型</h4>", info_section_subtitle => '計算衍生性狀或從植株表型計算小區表型。', icon_class => "glyphicon glyphicon-floppy-save", info_section_id => "compute_derived_traits" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>土壤數據</h4>", info_section_subtitle => '檢視並上傳此試驗的土壤數據。', icon_class => "glyphicon glyphicon-info-sign", buttons_html => "<button class='btn btn-sm btn-primary' style='margin:3px' id='trial_upload_soil_data_button' >上傳土壤數據</button>", info_section_id => "trial_soil_data_section"&>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>此實驗的 JBrowse 基因組比對</h4>", info_section_subtitle => '檢視此試驗中種原的 JBrowse 比對。', icon_class => "glyphicon glyphicon-align-left", info_section_id => "trial_jbrowse_data" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>實驗連結</h4>", info_section_subtitle => '檢視連結到此實驗的其他實驗、雜交和基因型分析盤。', icon_class => "glyphicon glyphicon-link", info_section_id => "trial_linkage_section" &>

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>刪除實驗數據</h4>", info_section_subtitle => '從資料庫中刪除表型、田間配置和/或整個實驗。', icon_class => "glyphicon glyphicon-trash", info_section_id => "trial_deletion_section" &>

% my $data_agreement_link = '<button class="btn btn-sm btn-primary" disabled style="margin:3px">新增/編輯數據協議</button>';
% if ($user_can_modify) { $data_agreement_link = '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_data_agreement">新增/編輯數據協議</button>';
% }

<& /page/detail_page_2_col_section.mas, trial_id => $trial_id, info_section_title => "<h4 style='display:inline'>數據協議授權</h4>", info_section_subtitle => '檢視並編輯此實驗的公開數據協議。', icon_class => "glyphicon glyphicon-inbox", info_section_id => "trial_data_agreement_section", buttons_html => $data_agreement_link &>

<& /breeders_toolbox/folder/folder_set.mas, project_type => 'field_trial', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, project_type => 'field_trial', company_id => $private_company_id, company_name => $private_company_name, company_project_is_private => $project_is_private &>
<& /breeders_toolbox/trial/edit_trial_details_dialog.mas, trial_name => $trial_name, breeding_program => $breeding_program_id, location => $location_id, year => $year, trial_type => $trial_type, trial_type_id => $trial_type_id, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, field_size => $field_size, plot_width => $plot_width, plot_length => $plot_length, field_trial_is_planned_to_be_genotyped => $field_trial_is_planned_to_be_genotyped, field_trial_is_planned_to_cross => $field_trial_is_planned_to_cross, company_id => $private_company_id, company_name => $private_company_name, company_project_is_private => $project_is_private &>

<& /breeders_toolbox/trial/generate_trial_barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", trial_stock_type => $trial_stock_type &>
<& /breeders_toolbox/trial/download_fieldmap_dialog.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/trial/edit_fieldMap.mas, trial_id => $trial_id, trial_name => $trial_name, trial_stock_type => $trial_stock_type &>
<& /breeders_toolbox/trial/trial_coords_upload_dialogs.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/trial/download_layout_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, has_subplot_entries => $has_subplot_entries &>
<& /breeders_toolbox/trial/add_trial_used_seedlots.mas, trial_id => $trial_id &>
<& /breeders_toolbox/trial/upload_plot_gps_dialogs.mas, trial_id => $trial_id &>
<& /breeders_toolbox/trial/add_subplots_per_plot.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/trial/add_plants_per_plot.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/trial/add_plants_per_subplot.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/trial/add_trial_treatment_dialogs.mas, management_factor_types => $management_factor_types &>
<& /breeders_toolbox/trial/change_plot_accessions_dialogs.mas, trial_id => $trial_id &>
<& /breeders_toolbox/trial/download_phenotypes_dialog.mas, trial_ids => $trial_id, dialog_name => $trial_name, dialog_type => 'Trial' &>

<& /breeders_toolbox/upload_phenotype_spreadsheet.mas &>
<& /fieldbook/upload_phenotype_fieldbook.mas &>
<& /breeders_toolbox/upload_phenotype_datacollector.mas &>

<& /breeders_toolbox/trial/create_datacollector_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, trial_stock_type => $trial_stock_type &>
<& /fieldbook/create_fieldbook_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, trial_stock_type => $trial_stock_type &>
<& /breeders_toolbox/trial/create_spreadsheet_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, trial_stock_type => $trial_stock_type &>
<& /breeders_toolbox/trial/set_phenotypes_fully_uploaded.mas, trial_id => $trial_id &>
<& /breeders_toolbox/trial/upload_soil_data_dialogs.mas, trial_id => $trial_id, trial_name => $trial_name &>

<& /breeders_toolbox/add_data_agreement_dialogs.mas, trial_id => $trial_id &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>


<script defer="defer">

jQuery(document).ready(function () {

    var can_modify = '<% $user_can_modify %>';
    // alert('can modify: '+can_modify);
    if (can_modify === '0') {
      jQuery('#edit_trial_details').prop('disabled', true);
    }

    jQuery('#edit_trial_details').click(function(){

        jQuery('#trial_details_edit_dialog').modal("show");

        edit_trial_details();

    });

    trial_detail_page_setup_dialogs();

  jQuery('#delete_breeding_program_trial_association_link').click(
     function() {
        var trial_id = get_trial_id();

	var yes = confirm("您確定要將此試驗從育種計畫中移除嗎？");
	if (yes) {
            jQuery.ajax( {
		url: '/breeders/program/remove/<% $breeding_program_id %>/'+trial_id,
		data: { },
		async: false,
		success: function(response) {
		}
	    });
	}
    });

    jQuery('#custom_barcode').click(function () {
        location.href = '/tools/label_designer';
    });

    jQuery('#direct_phenotyping_link').click(function () {
        var  id = <% $trial_id %>;
        location.href = '/breeders/trial_phenotyping?trial_id=' + id + '';
    });

    jQuery('#gps_field_map_link').click(function () {
        var  id = <% $trial_id %>;
        window.open('/tools/fieldmap?trial_id=' + id ,'_blank');
    });
});

</script>