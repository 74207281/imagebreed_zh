<%args>
$user_id => undef
</%args>

<& /util/import_css.mas, paths => [
    'leaflet.css',
    'leaflet.extra-markers.min.css',
    'esri-leaflet-geocoder.css'
] &>

<& /page/page_title.mas, title=>"管理地點" &>

<div class="container-fluid">

<&| /page/info_section.mas, title=>'地點列表',  collapsible=>1, collapsed=>0, subtitle=>'[<a id="upload_locations_link">上傳新地點</a>]' &>

<& /breeders_toolbox/location_table.mas, user_id=>$user_id &>

</&>

<&| /page/info_section.mas, title => '複製地點至清單', collapsible=>1, collapsed=>0, subtitle=>'<i>將列表中的地點名稱複製到新清單或現有清單</i>'&>
<br>
<div style="text-align:right" id="locations_to_list_menu"></div>
<div id="location_names" style="display: none;"></div>
</&>

<&| /page/info_section.mas, title=>'地點地圖',  collapsible=>1, collapsed=>0 &>

<& /breeders_toolbox/location_map.mas, user_id=>$user_id &>

</&>

</div>