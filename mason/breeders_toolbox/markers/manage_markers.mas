<%doc>

=head1 NAME

/breeders_toolbox/markers/manage_markers.mas - a mason component to display markerset info, add new markersets and add filtering parameters in markersets

=head1 AUTHOR

Titima Tantikanjana <tt15@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables','CXGN.BreedersToolbox.MarkerSet03152022'] &>

<& /page/page_title.mas, title=>'管理標記集(Manage Markersets)' &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>您的標記集(Your Markersets)</h4>", info_section_subtitle => '檢視您的標記集資訊', buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_new_markerset_button">新增標記集(Add New Markerset)</button><button class="btn btn-sm btn-primary" style="margin:3px" id="add_marker_dosage_button">新增標記至標記集(Add Markers to Markerset)</button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "marker_set_summary_section" &>

<& /page/detail_page_3_col_section.mas, icon_class => "glyphicon glyphicon-search", title => "使用標記集搜尋具特定基因型的品系(Using markerset to search for accessions with specific genotype.)", button_id => "accession_search_link", button_text => "前往(Go)" &>


<div class="modal fade" id="add_markerset_dialog" name="add_markerset_dialog" tabindex="-1" role="dialog" aria-labelledby="addMarkerSetDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMarkerSetDialog">新增標記集(Add New Markerset)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-1">
                        </div>
                        <div class="col-sm-12 well">
                            <div class="row">
                                <div class="col-sm-11">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">標記集名稱：</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="new_marker_set" placeholder="輸入標記集名稱">
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">基因型分析協定：</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <select class="form-control" id="selected_protocol">
                                                        </select>
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">資料類型：</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <select class="form-control" id="genotyping_data_type">
                                                        <option value="">選取基因型分析資料類型</option>
                                                        <option value="SNP">SNP</option>
                                                        <option value="Dosage">劑量(Dosage)</option>
                                                        <option value="Download">下載(Download)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">描述：</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="marker_set_desc" placeholder="輸入描述">
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="save_marker_set" id="save_marker_set">新增標記集(Add Markerset)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_marker_dosage_dialog" name="add_marker_dosage_dialog" tabindex="-1" role="dialog" aria-labelledby="addMarkerDosageDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMarkerDosageDialog">新增標記至標記集(Add Markers to Markerset)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-1">
                        </div>
                        <div class="col-sm-12 well">
                            <div class="row">
                                <div class="col-sm-11">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-sm-4">標記集名稱：</label>
                                            <div class="col-sm-8">
                                                <div class="input-group">
                                                    <select class="form-control" id="selected_marker_set1">
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_download_section" style="display:none">
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">標記名稱：</label>
                                                <div class="col-sm-8">
                                                    <textarea class="form-control" id="marker_name_download" placeholder="若要新增多個標記，請以換行分隔標記名稱。"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_dosage_section" style="display:none">
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">標記名稱：</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="marker_name_dosage" placeholder="輸入標記名稱">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">等位基因劑量(Allele Dosage)：</label>
                                                <div class="col-sm-8" >
                                                    <div class="input-group">
                                                        <select class="form-control" id="allele_dosage">
                                                            <option value="">選取等位基因劑量</option>
                                                            <option value="0">0</option>
                                                            <option value="1">1</option>
                                                            <option value="2">2</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id = "markerset_snp_section" style="display:none">
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">標記名稱：</label>
                                                <div class="col-sm-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="marker_name_snp" placeholder="輸入標記名稱">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-sm-4">指定等位基因：</label>
                                                <div class="col-sm-4" >
                                                    <div class="input-group">
                                                        <select class="form-control" id="allele_1">
                                                            <option value="">選取等位基因 1</option>
                                                            <option value="A">A</option>
                                                            <option value="C">C</option>
                                                            <option value="G">G</option>
                                                            <option value="T">T</option>
                                                        </select>
                                                        <select class="form-control" id="allele_2">
                                                            <option value="">選取等位基因 2</option>
                                                            <option value="A">A</option>
                                                            <option value="C">C</option>
                                                            <option value="G">G</option>
                                                            <option value="T">T</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="add_marker" id="add_marker">新增標記(Add Marker)</button>
            </div>
        </div>
    </div>
</div>
