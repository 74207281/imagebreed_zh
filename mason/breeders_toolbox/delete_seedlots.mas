
<%args>
$user_role => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>


  <&| /page/info_section.mas, title=>"使用清單刪除種子批次(Delete seedlots using a list)",  collapsible => 1, collapsed=>1 &>


% if ($user_role eq "curator" ) {
    <div style="margin-left:20px">


      <p><strong>從資料庫中選取「seedlot」類型的清單進行刪除</strong></p>
      備註：
      <ul><li>僅未與雜交或試驗關聯的種子批次才能被刪除。</li>
	<li>刪除種子批次無法復原。</li>
      </ul>
      <form class="form-horizontal" role="form" method="post" id="delete_seedlots_form" name="delete_seedlots_form">
        <div class="form-group">
	  <div style="width:300px;margin-left:40px;margin-top:30px;" id="seedlots_to_delete_html">
	  </div>
	</div>
      </form>
      <br /><br />
      <button type="button" class="btn btn-primary" name="delete_seedlots_submit" id="delete_seedlots_submit">刪除種子批次(Delete Seedlots)</button>
    </div>
</div>

%}
% else {

您需要登入，或者您沒有足夠的權限使用清單刪除種子批次。

%}
</&>

<div class="modal fade" id="delete_seedlots_modal" name="delete_seedlots_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">驗證刪除種子批次(Seedlot Deletion Verify)</h4>
            </div>
            <div class="modal-body">
              <div class="container-fluid">
		<div id="seedlot_deletion_verify">
                </div>
	      </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="delete_seedlots_confirm" id="delete_seedlots_confirm">刪除綠色標示項目(Delete green elements)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(window).ready( function() {
    jQuery("#seedlots_to_delete_html").append(list.listSelect("seedlots_to_delete_html_select", [ 'seedlots' ], 'None', undefined, undefined));
});

jQuery('#delete_seedlots_submit').click( function() {
   var list_id = jQuery('#seedlots_to_delete_html_select_list_select').val();
   if (list_id === "") { alert("請選取清單"); return; }
   verify_seedlot_deletion(list_id).then(function(r) { display_seedlot_deletion_info(r) }, function(r) { alert("錯誤！")});
});

jQuery('#delete_seedlots_confirm').click( function() {
    var list_id = jQuery('#seedlots_to_delete_html_select_list_select').val();
    if (list_id) {
        delete_seedlots(list_id).then( function(r) { alert(r.delete_count+" 個項目已被刪除"); }, function(r) { alert('發生錯誤'); });
    }
});

function verify_seedlot_deletion(list_id) {

   return jQuery.ajax( {
        url: '/ajax/seedlots/verify_delete_by_list?list_id='+list_id,
    });
}

function delete_seedlots(list_id) {
   return jQuery.ajax( {
       url: '/ajax/seedlots/confirm_delete_by_list?list_id='+list_id,
   });
}

function display_seedlot_deletion_info(r) {
    jQuery('#delete_seedlots_modal').modal('show');

    var ok = r.ok;
    var errors = r.errors;

    var html = "";

    for (const n of ok) {
        html += "<li class='list-group-item list-group-item-success'>"+n+"</li>";
    }

    for (const n of errors) {
       html += "<li class='list-group-item list-group-item-danger' >"+n[0]+" ("+n[1]+")</li>";
    }

    html += "</ul>";

    if (ok.length === 0) {
        html += '<br /><img src="/static/documents/img/info_icon.png"> 沒有任何項目可以被刪除。';
        jQuery('#delete_seedlots_confirm').prop('disabled', true);
    }
    else {
        jQuery('#delete_seedlots_confirm').prop('disabled', false);
    }

    jQuery('#seedlot_deletion_verify').html(html);

}

</script>
