<%args>
$facilities
</%args>


<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial08232022' ] &>

<div class="modal fade" id="create_genotyping_project_dialog" name="create_genotyping_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createGenotypingProjectdialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="createGenotypingProjectdialog">新增基因分型專案(Add New Genotyping Project)</h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "add_genotyping_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> "簡介(Intro)" &>
                            <& /page/page_title.mas, title=>"基因分型專案(Genotyping Project)" &>
                            <p>基因分型專案可用於將一系列基因分型盤與基因分型資料分組。若您有配合的廠商專案，基因分型專案名稱應與其一致。</p>
                            <hr>
                            <center>
                                <button id="next_step_add_new_genotyping_project" class="btn btn-primary" onclick="Workflow.complete(this);">前往下一步(Go to Next Step)</button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_genotyping_project_form" id="create_genotyping_project_form">
                            <&| /util/workflow.mas:step, title=> "新增基因分型專案(Add a Genotyping Project)" &>
                            <& /page/page_title.mas, title=>"輸入基因分型專案基本資訊(Enter Basic Information about the Genotyping Project)" &>
                                <br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型專案名稱：</label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="new_genotyping_project_name" name="new_genotyping_project_name" type="text" placeholder="若有配合的廠商專案應與其一致"/>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">基因分型實驗室/設施：</label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_project_facility_select" name="genotyping_project_facility_select">
%  foreach my $facility (@$facilities) {
                                            <option value="<% $facility %>"><% $facility %></option>
%  }
                                        </select>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">資料類型：</label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="data_type">
                                            <option value="">選擇資料類型</option>
                                            <option value="snp">SNP</option>
                                            <option value="ssr">SSR</option>
                                        </select>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">育種計畫：</label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_breeding_program_select_div"></span>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">年份：</label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_year_select_div"></span>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">資料產生位置 (可選)：</label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_location_select_div"></span>
                                    </div>
                                </div><br/><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">描述：</label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="genotyping_project_description" name="genotyping_project_description" maxlength="250"></textarea>
                                    </div>
                                </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="add_new_genotyping_project_submit" id="add_new_genotyping_project_submit">送出(Submit)</button>
                                </center>
                            </&>
                        </form>
                        <&| /util/workflow.mas:complete, title=> "完成(Complete)" &>
                            <& /page/page_title.mas, title=>"完成！您的基因分型專案已儲存至資料庫(Finished! Your Genotyping Project is Now in the Database)" &>
                            <ul>
                                <li>您可以繼續在剛建立的基因分型專案中新增基因分型盤及/或基因分型資料。</li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_new_genotyping_project_close_modal" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    get_select_box("locations", "genotyping_project_location_select_div", {'id': 'genotyping_project_location_select', 'name': 'genotyping_project_location_select'});
    get_select_box("breeding_programs", "genotyping_project_breeding_program_select_div", {'id': 'genotyping_project_breeding_program_select', 'name': 'genotyping_project_breeding_program_select'});
    get_select_box("years", "genotyping_project_year_select_div", {'auto_generate': 1, 'id': 'genotyping_project_year_select', 'name': 'genotyping_project_year_select'});

    jQuery('#add_new_genotyping_project_submit').click(function() {

        var project_name = jQuery("#new_genotyping_project_name").val();
        if (!project_name) {
            alert("請輸入基因分型專案名稱");
            return;
        }

        var project_facility = jQuery("#genotyping_project_facility_select").val();

        var data_type = jQuery("#data_type").val();
        if (!data_type) {
            alert("請選擇資料類型");
            return;
        }

        var project_breeding_program = jQuery("#genotyping_project_breeding_program_select").val();
        if (!project_breeding_program) {
            alert ("請選擇育種計畫");
            return;
        }

        var project_year = jQuery("#genotyping_project_year_select").val();
        if (!project_year) {
            alert ("請選擇年份");
            return;
        }

        var project_description = jQuery("#genotyping_project_description").val();
        if (!project_description) {
            alert ("請輸入描述");
            return;
        }

        var project_location = jQuery("#genotyping_project_location_select").val();

        jQuery.ajax({
            url: '/ajax/breeders/add_genotyping_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': project_name,
                'project_breeding_program': project_breeding_program,
                'project_facility': project_facility,
                'data_type': data_type,
                'project_year': project_year,
                'project_description': project_description,
                'project_location': project_location
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
//                    refreshGenotypingTrialJsTree(0);

                    var upload_genotyping_data_trial_table = jQuery('#upload_genotyping_data_project_search_results').DataTable({
                        'destroy': true,
                        'ajax':'/ajax/genotyping_data/projects?select_checkbox_name=upload_genotyping_data_project_select'
                    });

                    Workflow.focus("#add_genotyping_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_genotyping_project_workflow");
                    jQuery("#working_modal").modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert('儲存基因分型專案時發生錯誤。');
                jQuery('#create_genotyping_project_dialog').modal("hide");
            },
        });
    });

    jQuery("#add_new_genotyping_project_close_modal").click(function(){
        jQuery('#create_genotyping_project_dialog').modal('hide');
        jQuery(".modal-backdrop").remove();
    });

});


</script>
