<%args>
$trial_id
</%args>

<input type="checkbox" id="project_genotype_data_forbid_cache"> 重新整理結果
<hr>

<div style="overflow:scroll">
    <table id="genotyping_data_project_genotype_data" width="100%" class="table table-hover table-striped">
        <thead>
            <tr>
                <th>協定(Protocol)</th>
                <th>樣本名稱(Sample Name)</th>
                <th>樣本類型(Sample Type)</th>
                <th>品系名稱(Accession Name)</th>
                <th>同義詞(Synonyms)</th>
                <th>描述(Description)</th>
                <th>標記評分數量(Number of Marker Scores)</th>
                <th>IGD 編號(IGD Number)</th>
                <th>下載(Download)</th>
            </tr>
        </thead>
    </table>
</div>

<script>

jQuery(document).ready(function () {
   var genotypes_data_table = jQuery('#genotyping_data_project_genotype_data').DataTable({
       'destroy' : true,
       'searching' : false,
       'ordering'  : false,
       'processing': true,
       'serverSide': true,
       'lengthMenu': [ 10, 50, 100, 2000 ],
       'ajax': '/ajax/genotyping_data/search?genotyping_data_project_id_list=<% $trial_id %>',
   });

   jQuery("#project_genotype_data_forbid_cache").change(function(){
      if (jQuery(this).is(":checked")) {
       var genotypes_data_table = jQuery('#genotyping_data_project_genotype_data').DataTable({
           'destroy' : true,
           'searching' : false,
           'ordering'  : false,
           'processing': true,
           'serverSide': true,
           'lengthMenu': [ 10, 50, 100, 2000 ],
           'ajax': '/ajax/genotyping_data/search?genotyping_data_project_id_list=<% $trial_id %>&forbid_cache=1',
       });
     }
   });
});

</script>
