
<%args>
</%args>

<%doc>

=head1 NAME

/mason/analytics_protocols/index.mas - show user-specific analytics in the system

=head1 DESCRIPTION

Displays a page with a table of all the analytics run by the currently logged in user.

=head1 AUTHOR

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ], entries => [] &>

<& /page/page_title.mas, title => "您的分析實驗方案(Your Analytics Protocols)" &>

<button class='btn btn-default' style='margin:3px;float:right' id='drone_imagery_analytics_merge_results_link'>合併分析結果(Merge Analytics Results)</button><button class='btn btn-success' style='margin:3px;float:right' id='drone_imagery_analytics_link'>執行無人機影像分析(Run Drone Imagery Analytics)</button><br />
<hr>

<& /breeders_toolbox/drone_imagery/drone_imagery_analytics.mas &>
<& /analytics_protocols/analytics_protocols_merge_results_dialogs.mas &>

<div class="well">
    <table class="table table-bordered table-hover" id="analytics_protocols_by_user_table">
        <thead>
            <tr>
                <th>分析實驗方案名稱(Analytics Protocol Name)</th>
                <th>描述(Description)</th>
                <th>類型(Type)</th>
                <th>建立日期(Create Date)</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analytics_protocols_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analytics_protocols/by_user' }
    });
});
</script>
