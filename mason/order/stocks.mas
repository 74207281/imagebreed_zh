
<%args>
$role => "stock_orderer"
$check_vendor_role
</%args>

<& /util/import_javascript.mas, classes => [] &>

<& /page/page_title.mas, title => "您的訂單(Your Orders)" &>

<a href="/catalog/view"><button class="btn btn-primary btn-sm">前往目錄頁面（僅限供應商）(Go to Catalog Page (Vendors Only))</button></a>
<hr>

% if ($check_vendor_role == 1) {
    <&| /page/info_section.mas, title => '管理目前訂單(Manage Current Orders)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_current_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, title => '已完成訂單(Completed Orders)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_completed_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

% if ($check_vendor_role != 1) {
    <&| /page/info_section.mas, title => '您的目前訂單(Your Current Orders)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_current_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>訂單編號(Order Number)</th>
                                    <th>提交日期(Submitted Date)</th>
                                    <th>品項(Items)</th>
                                    <th>狀態(Status)</th>
                                    <th>訂單發送至(Send Order to)</th>
                                    <th>供應商備註(Comments from Vendor)</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, title => '您的已完成訂單(Your Completed Orders)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_completed_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>訂單編號(Order Number)</th>
                                    <th>提交日期(Submitted Date)</th>
                                    <th>品項(Items)</th>
                                    <th>狀態(Status)</th>
                                    <th>完成日期(Completed Date)</th>
                                    <th>處理人員(Processed by)</th>
                                    <th>供應商備註(Comments from Vendor)</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<div class="modal fade" id="update_order_dialog" name="update_order_dialog" tabindex="-1" role="dialog" aria-labelledby="updateOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateOrderDialog">更新訂單(Update Order)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="update_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button id="update_order_button" type="button" class="btn btn-primary" >更新(Update)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update_saved_dialog" name="update_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="updateSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateSavedDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        訂單已更新。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_update_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

$(window).ready( function() {

    jQuery('#user_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/current',
    });

    jQuery('#user_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/completed',
    });

    jQuery('#vendor_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_current_orders',
        columns: [
            { title: "訂單編號(Order Number)", "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: "訂購人(Ordered by)", "data": "order_from_name" },
            { title: "提交日期(Submitted Date)", "data": "create_date" },
            { title: "品項(Items)", "data": "item_list" },
            { title: "狀態(Status)", "data": "order_status" },
            { title: "備註(Comments)", "data": "contact_person_comments" },
            { title: "更新(Update)", "data": "null", "render": function ( data, type, row ) { return "<a onclick='updateOrder(\""+row.order_id+"\", \""+row.order_from_name+"\")' >更新(Update)</a>"; } },
        ]
    });

    jQuery('#vendor_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_completed_orders',
        columns: [
            { title: "訂單編號(Order Number)", "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: "訂購人(Ordered by)", "data": "order_from_name" },
            { title: "提交日期(Submitted Date)", "data": "create_date" },
            { title: "品項(Items)", "data": "item_list" },
            { title: "狀態(Status)", "data": "order_status" },
            { title: "完成日期(Completion Date)", "data": "completion_date" },
            { title: "備註(Comments)", "data": "contact_person_comments" },
        ]
    });

    jQuery('#update_order_button').click( function() {
        var order_id = jQuery('#update_order_id').val();
        var new_order_status = jQuery('#update_order_status').val();
        if (!new_order_status) {
            alert ("請選取狀態(Please select a status)");
            return;
        }
        var contact_person_comments = jQuery('#contact_person_comments').val();

        jQuery.ajax({
            url: '/ajax/order/update',
            data : {
                'order_id' : order_id,
                'new_status': new_order_status,
                'contact_person_comments': contact_person_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_saved_dialog').modal('show');
                    jQuery('#update_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert('更新訂單時發生錯誤(An error occurred updating the order)');
            }
        });
    });

    jQuery("#dismiss_update_saved_dialog").click(function(){
        location.reload();
    });


});

function updateOrder(order_id, order_from_name){
    var html = '';
    html += '<form class="form-horizontal"><div class="form-group"><label class="col-sm-3 control-label">訂單編號(Order Number)：</label><div class="col-sm-9" ><input class="form-control" id="update_order_id" name="update_order_id" value="'+order_id+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">訂購人(Ordered by)：</label><div class="col-sm-9" ><input class="form-control" id="ordered_by_name" name="ordered_by_name" value="'+order_from_name+'" disabled></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">狀態(Status)：</label><div class="col-sm-9" ><select class="form-control" id="update_order_status" name="update_order_status"><option disabled value="" selected hidden>請選取狀態(Select a status)</option>';
    html += '<option value='+"being_processed"+'>'+"處理中(being_processed)"+'</option>';
    html += '<option value='+"shipped"+'>'+"已出貨(shipped)"+'</option>';
    html += '<option value='+"completed"+'>'+"已完成(completed)"+'</option>';
    html += '<option value='+"cancelled"+'>'+"已取消(cancelled)"+'</option>';
    html += '</select></div></div>';
    html += '<div class="form-group"><label class="col-sm-3 control-label">備註(Comments)：</label><div class="col-sm-9" ><input class="form-control" id="contact_person_comments" placeholder="選填(Optional)"></div></div></form>'

    jQuery('#update_order_div').html(html);
    jQuery('#update_order_dialog').modal('show');

}

</script>
