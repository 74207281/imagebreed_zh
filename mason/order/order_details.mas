<%args>

$order_id
$order_from
$create_date
$item_list
$order_to
$order_status
$comments

</%args>


<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables'] &>

<& /page/page_title.mas, title => "訂單編號 $order_id 詳情(Details for Order Number: $order_id)" &>

<&| /page/info_section.mas, title=>"詳情(Details)",  collapsible => 1, collapsed=>0 &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <table class="table table-bordered table-hover">
                        <tr><td><b>訂購人(Ordered by)</b></td><td><% $order_from %></td></tr>
                        <tr><td><b>提交日期(Submitted Date)</b></td><td><% $create_date %></td></tr>
                        <tr><td><b>品項(Items)</b></td><td><% $item_list %></td></tr>
                        <tr><td><b>訂單發送至(Sent Order to)</b></td><td><% $order_to %></td></tr>
                        <tr><td><b>狀態(Status)</b><td><% $order_status %></td></tr>
                        <tr><td><b>供應商備註(Comments from Vendor)</b></td><td><% $comments %></td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>
