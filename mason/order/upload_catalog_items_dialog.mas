<%args>

</%args>


<div class="modal fade" id="upload_catalog_items_dialog" name="upload_catalog_items_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsDialog">上傳目錄品項(Upload Catalog Items)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>'範本資訊(Template Information)' &>
                        <p>
                            <b>檔案格式資訊(File Format Information)</b>
                            <br>
                            <a id="upload_catalog_items_format">試算表格式(Spreadsheet Format)</a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_catalog_items_form" name="upload_catalog_items_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">上傳檔案 (.xls 或 .xlsx)：</label>
                                <div class="col-sm-9">
                                    <input type="file" name="catalog_items_upload_file" id="catalog_items_upload_file" encoding="multipart/form-data" />
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
                <button type="button" class="btn btn-primary" name="upload_catalog_items_submit" id="upload_catalog_items_submit">上傳檔案(Upload File)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_error_display" name="upload_catalog_items_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsErrorDialog">上傳目錄品項檔案錯誤(Upload Catalog Items File Error)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="catalog_items_saved_dialog_message" name="catalog_items_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="catalogItemsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="catalogItemsSavedDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        目錄品項已成功儲存。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_catalog_items_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉並重新整理(Close & Reload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_format_dialog" name="upload_catalog_items_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsFormatDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsFormatDialog">範本資訊(Template Information)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>目錄品項可以透過 Excel 檔案（.xls 或 .xlsx）進行上傳(Catalog Items may be uploaded in an Excel file)</b>
                    <br>
                    <b>標題列(Header)：</b>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>item_name</td>
                                <td>type</td>
                                <td>category</td>
                                <td>description</td>
                                <td>material_source</td>
                                <td>breeding_program</td>
                                <td>availability</td>
                                <td>contact_person_username</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>必填欄位(Required columns)：</b>
                    <ul>
                        <li><b>item_name:</b>品項名稱必須已存在於資料庫中。</li>
                        <li><b>type:</b>必須為以下之一（single item, set of items）。此欄位可自訂，請聯絡我們。</li>
                        <li><b>category:</b>必須為以下之一（released variety, pathogen assay, control）。此欄位可自訂，請聯絡我們。</li>
                        <li><b>description:</b>請描述每個品項的主要特徵。</li>
                        <li><b>material_source:</b>必須為以下之一（OrderingSystemTest, Sendusu）。此欄位可自訂，請聯絡管理員。</li>
                        <li><b>breeding_program:</b>育種計畫必須已存在於資料庫中。</li>
                        <li><b>availability:</b>必須為以下之一（in stock, out of stock, available in 3 months）。此欄位可自訂，請聯絡我們。</li>
                        <li><b>contact_person_username:</b>請指明每個品項的聯絡人。聯絡人使用者名稱必須已存在於資料庫中。</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready( function() {

    jQuery("#upload_catalog_items_button").click(function(){

        jQuery("#upload_catalog_items_format").click(function(){
            jQuery("#upload_catalog_items_format_dialog").modal("show");
        });

        jQuery("#upload_catalog_items_dialog").modal("show");
    });


    jQuery("#upload_catalog_items_submit").click(function(){
        var uploadFile = jQuery("#catalog_items_upload_file").val();
        jQuery('#upload_catalog_items_form').attr("action", "/ajax/catalog/upload_items");
        if (uploadFile === ''){
            alert("請選取檔案(Please select a file)");
            return;
        }
        jQuery("#upload_catalog_items_form").submit();
        jQuery("#upload_catalog_items_dialog").modal("hide");
    });

    jQuery("#upload_catalog_items_form").iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_catalog_items_error_display tbody").html('');
                jQuery("#upload_catalog_items_error_display tbody").append(response.error_string);
                jQuery("#upload_catalog_items_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#catalog_items_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_catalog_items_saved_dialog").click(function(){
        location.reload();
    });

});


</script>
