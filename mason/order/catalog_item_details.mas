<%args>
$item_id
$item_name
$species
$item_type
$category
$description
$material_source
$breeding_program
$program_id
$availability
$contact_person_username
$item_prop_id
$check_vendor_role
$image
$selected_image_id => undef
$main_page
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables'] &>

<& /page/page_title.mas, title => "目錄品項詳情(Catalog Item Details)：$item_name" &>

<&| /page/info_section.mas, title=>"詳情(Details)",  collapsible => 1, collapsed=>0 &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <table class="table table-bordered table-hover">
                        <tr><td><b>物種(Species)</b></td><td><% $species %> </td></tr>
                        <tr><td><b>品項類型(Item Type)</b></td><td><% $item_type %> </td></tr>
                        <tr><td><b>類別(Category)</b></td><td><% $category %></td></tr>
                        <tr><td><b>說明(Description)</b></td><td><% $description %></td></tr>
                        <tr><td><b>材料來源(Material Source)</b><td><% $material_source %></td></tr>
                        <tr><td><b>育種計畫(Breeding Program)</b></td><td><% $breeding_program %></td></tr>
                        <tr><td><b>供貨狀態(Availability)</b></td><td><% $availability %></td></tr>
                        <tr><td><b>聯絡人使用者名稱(Contact Person Username)</b></td><td><% $contact_person_username %></td></tr>
                        <tr><td><b>主要詳情頁面(Main Detail Page)</b></td><td><% $main_page %></td></tr>
                    </table>
                </div>
                <div class="col-sm-6">
                    <br /><br />
% if ($selected_image_id) {
                    <% $image %>
% }
                    <br /><br />
                </div>
            </div>
        </div>
    </div>
</&>

% if ($check_vendor_role == 1) {
    <&| /page/info_section.mas, title => '編輯或移除目錄品項(Edit or Remove Catalog Item)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <button id="edit_catalog_item_link" class="btn btn-primary btn-sm">編輯目錄品項(Edit Catalog Item)</button>
                    <button id="delete_catalog_item_button" class="btn btn-primary btn-sm">刪除目錄品項(Delete Catalog Item)</button>
                </div>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title => '新增或移除圖片(Add or Remove Image)', collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "catalog_item_images_table" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<div class="modal fade" id="delete_item_success_dialog" name="order_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="deleteItemSuccessDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="deleteItemSuccessDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        目錄品項已刪除。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_deleted_message_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_image_message_dialog" name="add_image_message_dialog" tabindex="-1" role="dialog" aria-labelledby="addImageMessageDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addImageMessageDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        圖片已成功新增。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_add_image_message_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉並重新整理(Close & Reload)</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="remove_image_message_dialog" name="remove_image_message_dialog" tabindex="-1" role="dialog" aria-labelledby="removeImageMessageDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="removeImageMessageDialog">成功(Success)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        已從目錄品項中移除圖片。
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_remove_image_message_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉並重新整理(Close & Reload)</button>
            </div>
        </div>
    </div>
</div>

<& /order/edit_catalog_details_dialog.mas, item_name => $item_name, item_id => $item_id, species => $species, item_type => $item_type, category => $category, description => $description, material_source => $material_source, breeding_program => $breeding_program, program_id => $program_id, availability => $availability, contact_person_username => $contact_person_username, item_prop_id => $item_prop_id  &>


<script>

jQuery(document).ready( function() {

    var selected_image_id = "<% $selected_image_id %>";

    var item_images_table = jQuery('#catalog_item_images_table').DataTable( {
            'autoWidth': false,
            'order': false,
            'searching': false,
            'ajax': '/ajax/catalog/image_list/' + <% $item_id %>,
            'columns': [
                { title: "名稱(Name)", "data": "image_name" },
                { title: "圖片(Image)", "data": "small_image" },
                { title: "說明(Description)", "data": "image_description"},
                { title: "新增或移除圖片(Add or Remove Image)", "data": "null", "render": function ( data, type, row ) {
                    if (row.image_id == selected_image_id) {
                        return "<a onclick='removeImage()' >移除(Remove)</a>"
                    } else {
                        return "<a onclick='addImage(\""+row.image_id+"\")' >新增(Add)</a>"
                    }
                }},
            ],
    });

    jQuery('#delete_catalog_item_button').click( function() {
        var response = confirm('確定要刪除此目錄品項嗎？此操作無法復原。(Really delete this catalog item? This action cannot be undone.)');
        if (response) {
            jQuery.ajax({
                url: '/ajax/catalog/delete',
                dataType: "json",
                type: 'POST',
                data : {'item_prop_id' : <% $item_prop_id %>},
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        jQuery('#delete_item_success_dialog').modal('show');
                    }
                    if (response.error_string) {
                        alert(response.error_string);
                    }
                }
            });
        }
    });

    jQuery("#dismiss_deleted_message_dialog").click(function(){
        location.reload();
    });

});


function addImage(image_id){

    var item_name = '<% $item_name %>';
    var item_prop_id = '<% $item_prop_id %>';
    var image_id = image_id;

    jQuery.ajax({
        url: '/ajax/catalog/edit_image',
        dataType: "json",
        type: 'POST',
        data : {
            'item_name': item_name,
            'item_prop_id': item_prop_id,
            'image_id': image_id
        },

        beforeSend: function(response){
            jQuery('#working_modal').modal('show');
        },
        success: function(response) {
            jQuery('#working_modal').modal('hide');
            if (response.success == 1) {
                jQuery('#add_image_message_dialog').modal('show');
            }
            if (response.error_string) {
                alert(response.error_string);
            }
        },
        error: function(response){
            jQuery('#working_modal').modal('hide');
            alert('新增圖片時發生錯誤(An error occurred adding image)');
        }
    });

    jQuery("#dismiss_add_image_message_dialog").click(function(){
        location.reload();
    });

}


function removeImage(){

    var item_name = '<% $item_name %>';
    var item_prop_id = '<% $item_prop_id %>';
    var image_id = undefined;

    jQuery.ajax({
        url: '/ajax/catalog/edit_image',
        dataType: "json",
        type: 'POST',
        data : {
            'item_name': item_name,
            'item_prop_id': item_prop_id,
            'image_id': image_id
        },
        beforeSend: function(response){
            jQuery('#working_modal').modal('show');
        },
        success: function(response) {
            jQuery('#working_modal').modal('hide');
            if (response.success == 1) {
                jQuery('#remove_image_message_dialog').modal('show');
            }
            if (response.error_string) {
                alert(response.error_string);
            }
        },
        error: function(response){
            jQuery('#working_modal').modal('hide');
            alert('移除圖片時發生錯誤(An error occurred removing image)');
        }
    });

    jQuery("#dismiss_remove_image_message_dialog").click(function(){
        location.reload();
    });

}


</script>
