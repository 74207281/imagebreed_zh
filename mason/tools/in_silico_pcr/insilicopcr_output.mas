<%args>
$errors => ''
$blast_res => ''
$pcr_seq => ''
$gel_url => ''
</%args>

<& /page/page_title.mas, title=>"電子 PCR 結果(In Silico PCR Results)" &>
<br>
<center>
  <&| /page/info_section.mas, title=>"模擬電泳膠圖(In Silico Gel)", collapsible=>1, collapsed=>0 &>
  <img class="img-thumbnail" src=<% $gel_url %>>
  </&>
  <&| /page/info_section.mas, title=>"BLAST 結果(BLAST Results)", collapsible=>1, collapsed=>1 &>
  <pre class="text-left"><% $blast_res %></pre>
  </&>
  <br><br>
  <&| /page/info_section.mas, title=>"放大片段(Amplified Fragments)", collapsible=>1, collapsed=>0 &>
  <pre class="text-left"><% $pcr_seq %></pre>
  </&>
</center>
