<%args>
    $content => ''
    $sha1
    $bulk_download_stats
    $bulk_download_success
</%args>

<& /page/page_title.mas, title=>"特徵下載摘要(Feature Download Summary)" &>

% if($bulk_download_success) {
    您的查詢已成功執行(Your query was successful)。<br>
<div id="bulk_download_stats">
<% $bulk_download_stats %>
</div>
下載為(Download as) <a href="/bulk/feature/download/<% $sha1 %>.fasta">Fasta 檔案</a>
% } else {
    您的查詢未包含任何有效的識別碼，請重試(Your query did not contain any valid identifiers. Please try again)。
% }
