
<%args>
$mode => ''
$debug => ''
</%args>

<%perl>
my %modes = ( clone_search => 0,  microarray=>1,  unigene=>2, bac=>3, bac_end=>4, genes=>5, feature=>6, converter=>7, ftp=>8, );
if (!$mode) { $mode="clone_search";}
if (!exists($modes{$mode})) { $mode = "clone_search"; }
</%perl>

<& /util/import_javascript.mas, classes => [ 'jqueryui' ] &>

<& /page/page_title.mas, title=>"批次下載(Bulk Download)" &>

<script>
  jQuery(function() {

    jQuery( "#tabs" ).tabs({
      //show: { effect: 'blind', duration: 800},
      active: <% $modes{$mode} %>,
      beforeLoad: function( event, ui ) {
        ui.jqXHR.error(function() {
          ui.panel.html(
            "無法載入此分頁，我們將盡快修復此問題(Couldn't load this tab. We'll try to fix this as soon as possible)。" );
        });
      }

  });
  });
</script>


<div id="tabs">
  <ul>
    <li><a href="/tools/bulk/tabs/clone_tab">選殖株(Clones)</a></li>
    <li><a href="/tools/bulk/tabs/array_tab">微陣列(Arrays)</a></li>
    <li><a href="/tools/bulk/tabs/unigene_tab">單一基因群(Unigenes)</a></li>
    <li><a href="/tools/bulk/tabs/bac_end_tab">BAC 末端(BAC ends)</a></li>
    <li><a href="/tools/bulk/tabs/gene_tab">基因(Genes)</a></li>
    <li><a href="/tools/bulk/tabs/feature_tab">特徵(Features)</a></li>
    <li><a href="/tools/bulk/tabs/converter_tab">轉換器(Converter)</a></li>
    <li><a href="/tools/bulk/tabs/ftp_tab">FTP 下載(FTP)</a></li>
  </ul>
</div>
</div>
