
<%args>

</%args>

<& /util/import_javascript.mas, classes => [ ], entries => ['mixedmodels' ] &>

<script src="https://cdn.jsdelivr.net/npm/vega@3"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@2"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@3"></script>


<& /page/page_title.mas, title=>"混合模型分析(Mixed Model Analysis)" &>

<& /analyses/store_new_analysis_values_and_model.mas &>

<div id="mixedmodel_tool">
</div>


<style>
  .factor {
  z-index:4;
  border-style:solid;
  border-radius:8px;
  width:200px;
  height:100;
  border-color:#337ab7;
  background-color:#337ab7;
  color:white;
  margin:4px
  }
  .factor_panel {
  min-height:100px;
  height:auto;
  margin-top:0px;
  border-style:dotted;
  border-width:5px;
  color:grey;
  background-color:lightyellow;
  }
  .factor_interaction_panel {
  border-style:dotted;
  border-width:0px;
  margin-top:20px;
  height:auto;
  z-index:1;
  }
  .model_bg {
  margin-left:30px;
  margin-right:30px;
  background-color:#DDEEEE;
  min-height:80px;
  padding-top:10px;
  padding-left:10px;
  padding-bottom:10px;
  border-radius:8px;
  }
</style>

<div class="container">
  <div class="row">

    <div style="margin:20px;margin-left:auto;margin-right:auto;padding:10px;border:1px;border-style:dotted;width:60%;text-align:center">
      注意：混合模型工具正在測試中。歡迎提供意見回饋，但請勿在正式環境中使用。(Note: The Mixed Model Tool is in testing. Please provide feedback but do not use in production setting.)
    </div>

    <div class="col-md-12">


      <div class="container-fluid">

        <&| /util/workflow.mas, id=> "mixed_model_analysis_workflow" &>
          <&| /util/workflow.mas:step, title=> "選擇資料集(Choose Dataset)" &>
            <& /page/page_title.mas, title=>"選擇用於分析的資料集(Choose the dataset for your analysis)" &>


	      1. 選擇資料集(1. Choose a dataset)

	      <span style="width:240px" id="mixed_model_dataset_select">
	      </span>
	      <div>
		<div style="float:right">
		  <button class="btn btn-main" id="mixed_model_analysis_prepare_button" 	onclick="Workflow.complete(this);">選擇資料集並繼續(Choose Dataset and continue)</button>
		</div>
	      </div>
	      <br />
	      <br />

</&>

<&| /util/workflow.mas:step, title=> "選擇應變數(Choose Dependent Variable)" &>
  <& /page/page_title.mas, title=>"選擇用於分析的應變數(Choose the dependent variable for your analysis)" &>


    <div id="dependent_variable" style="margin-bottom:50px">
    </div>

    <div id="trait_histogram">
      [直方圖(Histogram)]
    </div>

    <div>
      <div style="float:right">
	<button class="btn btn-main" id="mixed_model_analysis_fishished_choose_variable" 	onclick="Workflow.complete(this);">下一步(Next step)</button>
      </div>
    </div>
</&>


<&| /util/workflow.mas:step, title=> "建立模型(Build Model)" &>
  <& /page/page_title.mas, title=>"建立混合模型(Build mixed model)" &>

    <div class="model_bg" >
      <div id="model_string" style="margin-top:10px;margin-bottom:10px;text-align:center;font-weight:bold">[模型將以 lme4 格式顯示於此 / model will appear here in lme4 format]</div>
      <!--  button id="store_model_formula" class="btn btn-default btn-sm">Save model</button -->
    </div>



    <hr />
    <div class="container">
      <div class="row">
        <div id="left-margin" class="col-md-2"></div>
	<div class="col-md-4">
	  <div class="panel panel-default" style="border-width:0px">
	    <div class="panel panel-header" style="border-width:0px">可用因子(Available Factors)</div>
	    <hr />
            <div id="factors" class="panel panel-body" style="border-style:dotted;border-width:0px;">
	      [ 請先選擇資料集與應變數 / Choose dataset and dependent variable first ]
            </div>
          </div>
	</div>
        <div class="col-md-4">
          <div  id="fixed_factors_panel" style="border-width:0;" class="panel panel-default">
	    <div class="panel-header">固定效應因子(Fixed factors)</div>
	    <div id="fixed_factors" class="panel-body factor_panel">

	      <!-- style="background-color:lightyellow;min-height:100px;height:auto;border-style:dotted;border-width:5px;color:grey" --></div>

          </div>
	  <div id="interaction_factor_collection_panel" class="panel panel-default factor_interaction_panel">
	    <!-- style="border-style:dotted;border-width:0px;margin-top:20px;height:auto;z-index:1" -->
            <div class="panel-header">
	      具交互作用的固定效應因子(Fixed factors with interaction)<br />
              <button  id="add_interaction_factor_button">新增交互作用(Add new interaction)</button>
	    </div>
	    <div id="interaction_factors_collection" name="interaction_factors_collection" class="panel-body">
	    </div>
          </div>
	  <div id="variable_slope_intersect_collection_panel" class="panel panel-default factor_interaction_panel">

	    <!--    style="border-style:dotted;border-width:0px;margin-top:20px;height:auto;z-index:1" -->

            <div class="panel-header">
              具可變斜率/截距的固定效應因子(Fixed factors with variable slope/intersects)<br />
              <button  id="add_variable_slope_intersect_button">新增可變斜率/截距(Add new variable slope/intersect)</button>
	    </div>
	    <div id="variable_slope_intersect_collection" class="panel-body">

	    </div>
	  </div>

	  <div style="height:30">&nbsp;</div>
          <div id="random_factors_panel" class="panel panel-default" style="border-width:0px">
            <div class="panel-header">隨機效應因子(Random factors)</div>
	    <div id="random_factors" class="panel-body factor_panel">

	      <!-- style="background-color:lightyellow;min-height:100px;height:auto;border-style:dotted;border-width:5px;color:grey" -->
            </div>
          </div>
	</div>
      </div>
    </div>

    <br />
    <div id="tempfile" style="display:none" >
    </div>

    <div>
      <div style="float:right">
	<button style="position:relative;" id="run_mixed_model_button" class="btn btn-main" 	onclick="Workflow.complete(this)" >執行分析並前往下一步(Run analysis and go to next step)</button>
      </div>
    </div>
    <hr />

</&>

<&| /util/workflow.mas:step, title=> "結果(Results)" &>

<& /page/page_title.mas, title=>"分析結果(Analysis Results)" &>

  <div>
    <ul class="nav nav-tabs">
      <li class="active"><a data-toggle="tab" id="adjusted_blups_tab_link" href="#adjusted_blups_tab">調整後平均值 (BLUPs) / Adjusted means (BLUPs)</a></li>
      <li><a data-toggle="tab" id="blups_tab_link" href="#blups_tab">BLUPs</a></li>
      <li><a data-toggle="tab" id="adjusted_blues_tab_link" href="#adjusted_blues_tab">調整後平均值 (BLUEs) / Adjusted means (BLUEs)</a></li>
      <li><a data-toggle="tab" id="blues_tab_link" href="#blues_tab">BLUEs</a></li>
    </ul>
    <div class="tab-content">
      <div id="adjusted_blups_tab" class="tab-pane fade in active">
	<br />
	  <button id="open_store_adjusted_blups_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="adjusted_means">儲存調整後平均值(Save adjusted means)</button>

	  <!-- button class="btn btn-primary">Download</button -->
	  <br />
	  <div id="mixed_models_adjusted_blups_results_div">[載入中...(loading...)]</div>
      </div>

      <div id="blups_tab" class="tab-pane fade">
	<br />
	<button id="open_store_blups_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blup" data-target="#generic_save_analysis_dialog">儲存 BLUPs(Save BLUPs)</button>
	<div id="mixed_models_blups_results_div">[無法使用(not available)]</div>
      </div>

      <div id="adjusted_blues_tab" class="tab-pane fade">
	<br />
	<button id="open_store_adjusted_blues_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blues">儲存調整後 BLUEs(Save adjusted BLUEs)</button>

	<div id="mixed_models_adjusted_blues_results_div">[載入中...(loading...)]</div>
      </div>

      <div id="blues_tab" class="tab-pane fade">
	<br />
	<button id="open_store_blues_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blues">儲存 BLUEs(Save BLUEs)</button>

	<div id="mixed_models_blues_results_div">[載入中...(loading...)]</div>
      </div>
    </div> <!-- results_tab div -->
  </div>

</&>

</&>

<script>

$(document).ready( function() {
var mixedmodels = window.jsMod['mixedmodels'].init("mixedmodels");
});

</script>
