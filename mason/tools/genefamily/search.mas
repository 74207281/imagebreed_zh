
<%doc>

</%doc>

<%args>
$dataset
$genefamily_id => undef
$member_id => undef
$action => undef
</%args>

<& /page/page_title.mas, title=>'基因家族搜尋(Gene family search)' &>

<%perl>

use SGN::Genefamily;
use Bio::Seq;

my  $DIR = $c->get_conf('genefamily_dir'); # '/home/mueller/dutch_tomato_assembly/tomato_ara_rice_comparison/';
if (!$action) { $action = "input"; }
if ($genefamily_id eq '') { $genefamily_id=0; }

if ($action eq 'detail') {
    my $gf = SGN::Genefamily->new(
        name      => "ORTHOMCL$genefamily_id",
        dataset   => $dataset,
        files_dir => $DIR,
       );

    my $seq_data ="";
    my $fasta_data = "";
    my $tree_data = "";
    my $annot_data = "";
    my $exp_data = "";

    my $align_link_disabled = "";
    my $fasta_link_disabled = "";
    my $tree_link_disabled = "";
    my $exp_link_disabled = "";

    my $errors = "";
    my $big_errors = 0;
    eval {
      $seq_data = $gf->get_alignment();
    };
    if ($@) {
      $errors .= "無可用的比對資料。(Alignment data not available.) ";
      $big_errors++;
      $align_link_disabled="disabled";
    }
    eval {
      $fasta_data = $gf->get_fasta();

    };
    if ($@) {
      $errors .= "無可用的序列資料。(Sequence data not available.) ";
      $big_errors++;
      $fasta_link_disabled = "disabled";
    }
    eval {
      $tree_data = $gf->get_tree();
    };
    if ($@) {
      $errors .= "無可用的演化樹資料。(Tree data not available.) ";
      $tree_link_disabled = "disabled"
    }
    eval {
      $annot_data = $gf->get_annotation();
    };
    if ($@) {
      $errors .= "無可用的註釋資料。(Annotation data not available.) ";
      $annot_data = "(無可用的註釋資料 No annotation data available)";
    }
    eval {
      $errors .= "無可用的表現量資料。(Expression data not available.) ";
      $exp_data = $gf->get_expression();
    };
    if ($@) {
      $exp_link_disabled = "disabled";
    }

    if ($big_errors > 0) { 
      $errors = "此家族似乎不存在！(This family does not seem to exist!)\n";
    }

</%perl>

<h1>家族 <% $genefamily_id %> 詳細資訊(Family detail for family <% $genefamily_id %>)</h1>
<table><tr><td>家族(Family)：<b><% $genefamily_id %></b></td><td><% $annot_data %></td></tr>
  <tr><td colspan="2">備註(Note)：<% $errors %></td></tr>
</table>
<table><tr>
    <hr>
    <td>檢視(View)</td>
    <td>
      <form name="alignment_viewer_form" method="POST" action="/tools/align_viewer/index.pl">
	<input type="hidden" name="seq_data" value="<% $seq_data %>" />
	<input type="submit" value="比對(Alignment)" <% $align_link_disabled %> />
	<input type="hidden" name="format" value="fasta" />
      </form>
    </td>

    <td>
      <form name="tree_browser_form" method="post" action="/tools/tree_browser/index.pl">
	<input type="hidden" name="" value="<% $tree_data %>" />
	<input type="submit" value="演化樹(Tree)" <% $tree_link_disabled %> />
      </form>
    </td>



    </tr>
</table>
<hr>
<table><tr><td>
FASTA 格式序列(Sequences in fasta)：</td><td>
<form name="tree_browser_unaligned" method="post" action="/tools/align_viewer/index.pl">
  <input type="hidden" name="seq_data" value="<% $fasta_data %>" />
  <input type="hidden" name="format" value="fasta_unaligned" />
  <input type="submit" value="進行比對(Align)" />
</form>

<td></tr>
<td colspan="2">
      <pre><% $fasta_data %></pre>
</td></tr></table>

<%perl>
}

if ($action eq 'search' && $member_id) {
    die 'must provide dataset' unless $dataset;
    my $member_file = catfile($DIR,$dataset,'genefamily_defs.txt');
    open (my $F, "<", $member_file) || die "can't open family file $member_file";
    my $family_nr = 0;
    my $found = 0;
    while(<$F>) {
	
	if ($_=~/\b$member_id\b/i) {
	    $found=1;
	    last();
	}
	$family_nr++;
    }


    if ($found) {
</%perl>

        <form name="genefamily_display_form">
        在資料集 <b><% $dataset %></b> 中，序列 <% $member_id %> 位於家族 <% $family_nr %>。(In dataset <b><% $dataset %></b>, sequence <% $member_id %> is in family <% $family_nr %>.)
        <input type="hidden" name="genefamily_id" value="<% $family_nr %>" />
	<input type="hidden" name="dataset" value="<% $dataset %>" />
	  <input type="hidden" name="action" value="detail" />
	  <input type="submit" name="view_family" value="檢視家族 <% $family_nr %> (view family <% $family_nr %>)" />
        </form>

%   }
%   else {
        在任何家族中皆未找到 <% $member_id %>。(<% $member_id %> was not found in any family.)
%	return;
%   }
%}

<%perl>
my @datasets = SGN::Genefamily->get_available_datasets($DIR);

my $select = '<select name="dataset">';
my $selected = "";
foreach my $d (@datasets) {
  if ($d eq $dataset) { $selected="selected=\"selected\" "; }
  else { $selected= ""; }
  $select .= qq | <option value="$d" $selected>$d</option> |;
}
$select .= "</select>";

if ($action eq 'input')  {

</%perl>

	  <table>
	    <tr><td colspan="2">若您知道基因家族 ID，請於下方輸入。(If you know the ID of your gene family, enter it below.)</td></tr>
	    <tr><td>基因家族 ID(Genefamily id)</td><td>
		<form name="genefamily_detail_form">
		  <input name="genefamily_id" size="10" />（數字 a number）
		  <input type="hidden" name="action" value="detail" />
		  <% $select %>
		  <input type="submit" value="詳細資訊(Details)" />
		</form>
	    </td></tr>
	    <tr><td colspan="2"><b>— 或(OR) —</b></td></tr>
	    <tr><td colspan="2">若您知道成員 ID，可搜尋對應的家族：(if you know a member ID, search for the corresponding family:)</td></tr>
	    <tr><td>成員 ID(Member id)</td><td>
	      <form name="member_search_form">
		<input name="member_id" size="10" /> (e.g. At1g01060)
		<input type="hidden" name="action" value="search" />
		<% $select %>
		<input type="submit" value="搜尋(Search)" />
	      </form>
</td>
</tr>
</table>

% }

<%init>
use File::Spec::Functions;
</%init>
