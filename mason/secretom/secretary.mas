<& /page/page_title.mas, title => '<span class="secretary">SecreTary</span>: 分泌蛋白之計算預測(Computational prediction of secreted proteins)' &>

<& /secretom/secretary/nav.mas, curr_page => 'tool' &>

<&| /page/info_section.mas, title => '提交序列(Submit Sequences)' &>
  
<form id="secretary_input" method="post" action="/secretom/secretary/run" name="secretary" enctype="multipart/form-data">
    <div class="examples">
      <input type="submit" onclick="set_secretary_example_inputs(); return false;" value="顯示輸入範例(Show Input Example)" />
      <input class="reset" type="reset" name="reset" value="清除表單(Clear form)" />
    </div>

    <label for="sequence_input_text">以 FASTA 格式貼上一或多個蛋白質序列(Paste one or more protein sequences in FASTA format)</label>
    <textarea id="sequence_input_text" name="sequence" rows="10" cols="100"></textarea>

    <table><tr>
      <td>
       <label for="sequence_input_file">及／或上傳蛋白質序列的 FASTA 檔案(And/or upload a FASTA file of protein sequences)</label><br />
       <input style="margin: 0.8em 1em"   id="sequence_input_file" type="file" name="sequence_file" />
      </td>

      <td>

	<input id="st_out_in_browser" type="radio" name="st_output_action" value="st_out_in_browser" checked="checked"/>在瀏覽器中顯示結果(Show results in browser)。<br/>
	<input id="st_out_download" type="radio" name="st_output_action" value="st_out_download" />下載結果(Download results)。<br />

       <input type="checkbox" value="sort_by_score" name="sort" id="sort_by_score">
         <label for="sort_by_score">依分數排序(Sort by score)</label>
       <br />
       <input type="checkbox" value="show_only_sp" name="show_only_sp" id="show_only_sp">
         <label for="show_only_sp">僅顯示預測的訊息胜肽(Show predicted signal peptides only)</label>
      </td>

      <td>
       <input class="submit" type="submit" name="submit" onclick="return validate_form()" value="提交(Submit)" />
      </td>

    </tr></table>
  </form>
</&>

<&| /page/info_section.mas, title => '其他工具(Other tools)' &>
  <ul>
  <li><a href="http://www.cbs.dtu.dk/services/SignalP">SignalP</a></li>
  <li><a href="http://www.predisi.de">PrediSi</a></li>
  <li><a href="http://rpsp.bioinfo.pl/">Rapid Prediction of Signal Peptides (RPSP)</a></li>
  <li><a href="http://phobius.sbc.su.se/">Phobius</a></li>
  <li><a href="http://urgi.versailles.inra.fr/predotar/predotar.html">Predotar</a></li>
  </ul>
</&>

<script language="javascript">

var seq_input = document.getElementById('sequence_input_text');
var seq_file_input = document.getElementById('sequence_input_file');
function set_secretary_example_inputs() {
        seq_input.value = ">AT1G73440.1  \nMARGESEGESSGSERESSSSSSGNESEPTKGTISKYEKQRLSRIAENKARLDALGISKAAKALLSPSPVSKKRRVKRNSGEEDDDYTPVIADGDGDEDDDEVEEIDEDEEFLCKRKNKSSASKRKVSSRKILNTSVSLGEDDDDLDKAIALSLQGSVAGSDKEAATMKKKRPELMSKTQMTQDELVMYFCQFDEGGKGFITLRDVAKMATVHDFTWTEEELQDMIRCFDMDKDGKLSLDEFRKIVSRCRMLKGS* \n>AT1G75120.1 AI22=119.545 Gravy22=0.5864 nR=2 nS=0 nT=0 nDRQPEN=6 Nitrogen=31 Oxygen=27 \* \n>AT1G17600.1 AI22=61.818 Gravy22=-0.2273 nR=2 nS=5 nT=0 nDRQPEN=6 Nitrogen=29 Oxygen=34 \* \n";
}

function validate_form() {
  if( seq_input.value || seq_file_input.value )
        return true;

  alert('未輸入序列，請貼上或上傳序列資料以執行 SecreTary。(No sequence entered, please paste or upload sequence data to run SecreTary.)');
  return false;
}

</script>
