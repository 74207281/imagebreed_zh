<%args>
  $data
  $query
  $headings
  $csv_download
</%args>

<& /page/page_title.mas, title => 'SecreTary SignalP TargetP 結果搜尋(SecreTary SignalP TargetP Result Search)' &>

<h3 style="text-align: center">搜尋條件(Searched for)："<% $query |h%>"</h3>

<&| /page/info_section.mas, title => '結果(Results)', subtitle => @$data." 筆結果(results) &mdash; ".qq|<a href="$csv_download">[下載試算表(Download spreadsheet)]</a>| &>

%  if( @$data ) {
%    foreach my $row ( @$data ) {
%       $row->[0] = link_identifier( $row->[0] ) || $row->[0];
%       $row->[1] =~ s/^\s*\|\s*//;
   <&| /page/info_section.mas, title => '匹配(Hit): '.$row->[0], is_subsection => 1 &>
     <% $table->( $row, [ 0,2,3 ] ) %> 
     <% $table->( $row, [ 1 ] ) %> 
     <% $table->( $row, [ 4,5,6 ] ) %>
	<% $table->( $row, [ 7,8,9 ] ) %>
	<% $table->( $row, [ 10 ] ) %> 
	  <% $table->( $row, [ 11,12 ] ) %>
   </&>
%    } 
%  } else {
   <h3 style="text-align: center">找不到符合 "<% $query |h %>" 的結果(No results found matching "<% $query |h %>")。</h3>
%  }

</&>

<%init>
use List::MoreUtils qw/ mesh /;
use CXGN::Page::FormattingHelpers qw/ info_table_html /;
use CXGN::Tools::Identifiers qw/ link_identifier /;

my $table = sub {
    my ( $row, $order, %other ) = @_;

    my @row = @{$row}[ @$order ];
    my @h = @{$headings}[ @$order ];

    return info_table_html( mesh( @h, @row ),  __multicol => 5, __border => 0, %other );

};

</%init>
