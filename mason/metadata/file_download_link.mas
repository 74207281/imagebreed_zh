<%args>
  $file
</%args>
% my $stat = $file->stat;
% if( $stat ) {
<a href="/metadata/file/<% $file->file_id |u %>/download">
   <% $file->basename |h %> (<% Number::Bytes::Human::format_bytes( $stat->size ) %>b)
</a>
% } else {
<span class="ghosted" style="cursor: pointer" title="檔案暫時無法使用(file temporarily unavailable)"><% $file->basename |h %> (暫時無法使用 / temporarily unavailable)</span>\
%}
<%once>
  use Number::Bytes::Human;
</%once>
