
            
<& /page/page_title.mas, title=>"快速建立帳號(Quick Create Account)" &>

<div id="quick_create_account_input_form_div">
  <form id="quick_create_account_input_form" method="post" action="/user/quick_create_account">
    
    <table cellpadding="4" cellspacing="4" width="80%" align="center">
      <tr><td colspan="2"><b>管理者可使用此表單為新使用者建立帳號。<br />&nbsp;</b></td></tr>
      <tr><td style="width:30%">名字(First Name)</td><td><input class="form-control" type="text" name="first_name" value=""></td></tr>
      <tr><td>姓氏(Last Name)</td><td><input class="form-control" type="text" name="last_name" value=""></td></tr>
      <tr><td>使用者名稱（至少 7 個字元）(Username)</td><td><input class="form-control" type="text" name="username" value=""></td></tr>
      <tr><td>密碼（至少 7 個字元）(Password)</td><td><input class="form-control" type="password" name="password" value=""></td></tr>
      <tr><td>確認密碼(Confirm Password)</td><td><input class="form-control" type="password" name="confirm_password" value=""></td></tr>
      <tr><td>電子郵件地址(Email Address)</td><td><input class="form-control" type="text" name="confirm_email" value=""></td></tr>
      <tr><td>使用者類型(User Type)</td><td>
        <select class="form-control" name="user_type" id="quick_create_account_user_type">
          <option value="curator">策展人 (Curator)</option>
          <option value="submitter" selected>提交者 (Submitter)</option>
          <option value="user">一般使用者 (User)</option>
          <option value="sequencer">定序者 (Sequencer)</option>
        </select>
      </td></tr>
      <tr><td>所屬公司/組織(Company)</td><td>
        <div id="quick_create_account_company_div"></div>
      </td></tr>
      <tr><td>&nbsp;</td></tr>
      <tr><td colspan="2" align="center">
	  <button class="btn btn-primary" id="create_account" name="create_account" type="button">儲存(Save)</button>
      </td></tr>
    </table>
</form>
</div>

<script>
   jQuery(document).ready(function() { 
      get_select_box('private_companies', 'quick_create_account_company_div', { 'name': 'private_company_id', 'id': 'quick_create_account_private_company_id' });

      jQuery('#create_account').click( function() {
         var form_data = jQuery('#quick_create_account_input_form').serialize();
         jQuery.ajax( { 
            url : '/ajax/user/quick_create_account',
            data: form_data,
            success: function(r) { 
              if (r.error) { alert(r.error); }
              else { 
                jQuery('#quick_create_account_input_form_div').html(r.html);
              }
            }
         });
      });
   });
</script>
