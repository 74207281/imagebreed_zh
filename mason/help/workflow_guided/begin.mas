<%args>
$breeding_programs
$locations
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$timestamp
$facilities => ()
$management_factor_types => ()
$design_types => ()
</%args>


<& /util/import_javascript.mas, classes => [ 'CXGN.GuidedHelp', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.AddTrial03152022', 'CXGN.BreedersToolbox.UploadTrial03152022', 'CXGN.BreedersToolbox.Trial03152022', 'CXGN.Trial03152022', 'CXGN.BreedersToolbox.GenotypingTrial08232022', 'CXGN.BreedersToolbox.Accessions03152022', 'CXGN.BreedersToolbox.UploadPedigrees03152022', 'CXGN.BreedersToolbox.Crosses03152022', 'CXGN.BreedersToolbox.FieldBook03152022', 'CXGN.BreedersToolbox.UploadPhenotype03152022', 'CXGN.TrialTreeFolders03152022' ] &>

<div class="panel panel-default">
    <div class="panel-body">
        <& /page/page_title.mas, title=>"剛接觸本資料庫嗎？(New to the database?)" &>

        <center>
        <button class="btn btn-primary btn-block" id="guided_help_begin_button">讓我們來協助您！(Let us help!)<br/>點擊此按鈕開始指引式說明。(Click this button to begin our guided help.)</button>
        </center>
    </div>
</div>

<div class="modal fade" id="guided_help_begin_dialog" name="guided_help_begin_dialog" tabindex="-1" role="dialog" aria-labelledby="guidedHelpBeginDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="guidedHelpBeginDialog">您對什麼感興趣？(What are you interested in?) <a href="https://solgenomics.github.io/sgn">一般說明(For General Help)</a></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-cloud-upload"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>將儲存在電腦 Excel 中的田間試驗上傳至資料庫(Upload an experimental field trial into the database that you have saved on your computer in Excel)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_trial_link" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon glyphicon-flash"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>在資料庫中設計全新的田間試驗(Design a completely new experimental field trial in the database)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="add_project_link" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-list-alt"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>將您可用的種子庫存記錄至資料庫中(Catalog your available seed inventory into the database)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_seedlot_inventory_button" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-book"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>將儲存在電腦 Excel 中的表型數據上傳至資料庫(Upload phenotypic data into the database that you have saved on your computer in Excel)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_upload_phenotypes_button" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-flag"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>規劃組織取樣(Plan tissue sampling)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="tissue_sample_guided_help" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-random"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>將雜交組合與雜交資訊上傳至資料庫(Upload crosses and crossing information into the database)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_crosses_link" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-tags"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>列印實驗條碼標籤（適用於田間小區、植株或組織樣本，或 96 孔板與組織樣本）(Print barcode labels for my experiment (for your plots or plants or tissue samples in the field, or for your 96 well plate and tissue samples))</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_barcode_trial_button" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-blackboard"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>跨試驗分析表型表現(Analyze phenotypic performance across trials)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button id="guided_help_trial_comparison_button" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-th"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>為基因分型實驗準備 96 或 384 孔板(Prepare a 96 or 384 well plate for a genotyping experiment)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="create_genotyping_trial_link" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="well">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <span style="font-size:2.5em;" class="glyphicon glyphicon-map-marker"></span>
                                    </div>
                                    <div class="col-sm-7">
                                        <h4>上傳 VCF 基因型數據(Upload VCF genotypic data)</h4>
                                    </div>
                                    <div class="col-sm-2">
                                        <button name="upload_genotyping_data_link" class="btn btn-primary btn-sm">前往(Go)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_guided_help_begin_dialog" type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<& /help/workflow_guided/tissue_sample_help.mas &>

<& /help/workflow_guided/seedlot_inventory_modal.mas, timestamp=>$timestamp &>
<& /help/workflow_guided/phenotype_upload_modal.mas &>
<& /help/workflow_guided/trial_barcoding_modal.mas &>
<& /help/workflow_guided/trial_comparison_modal.mas &>

<& /breeders_toolbox/trial/trial_upload_dialogs.mas, breeding_programs=>$breeding_programs, locations=>$locations, design_types => $design_types &>
<& /breeders_toolbox/trial/trial_create_dialogs.mas, locations => $locations, breeding_programs => $breeding_programs, management_factor_types => $management_factor_types, design_types => $design_types &>

<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas &>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities=>$facilities &>

<& /breeders_toolbox/upload_seedlots_inventory_dialogs.mas &>
<& /breeders_toolbox/upload_seedlots_dialogs.mas &>
<& /breeders_toolbox/add_seedlot_dialogs.mas, timestamp=>$timestamp &>
<& /breeders_toolbox/add_accessions_dialogs.mas, preferred_species=>$preferred_species, editable_stock_props=>$editable_stock_props, editable_stock_props_definitions=>$editable_stock_props_definitions &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
<& /breeders_toolbox/cross/add_cross_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
<& /breeders_toolbox/cross/add_crossing_trial_dialogs.mas, programs=>$breeding_programs, locations=>$locations &>
