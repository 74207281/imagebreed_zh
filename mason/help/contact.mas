<%args>
$contact_form_human_answer => ''
$contact_form_human_question => ''
$website_name => ''
$email_address_to_display => ''
</%args>

<& "/page/page_title.mas", title => "聯絡 $website_name(Contact $website_name)" &>

<div class="container-fluid">
    <div class="well">

    <div id="contact_form_return_message">
    </div>

% #The form
  <form class="form-horizontal" name="contactForm">

% #Uses Perl to print out the fields with similar HTML tags
<%perl>
my $infoNeeded = ["name", "email", "subject", ];
my $info_labels = {
    name => "姓名(Name)",
    email => "電子郵件(Email)",
    subject => "主旨(Subject)",
};
</%perl>

% foreach my $info_category (@$infoNeeded) {
    <div class="form-group">
      <label class="col-sm-2 control-label"><% $info_labels->{$info_category} %>* :
      </label>
      <div class="col-sm-10">
        <input type="text" class="form-control" value="" name="<% $info_category %>"></input>
      </div>
    </div>
% }

    <div class="form-group">
      <label class="col-sm-2 control-label">內文(Body)* :
      </label>
      <div class="col-sm-10">
        <textarea rows="12" class="form-control" name="body"></textarea>
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label">請計算(What is) <br/><% $contact_form_human_question %>?* :
      </label>
      <div class="col-sm-10">
        <input type="text" class="form-control" value="" name="contact_form_human_answer"></input>
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label"></label>
      <div class="col-sm-10">
        <h5 valign="middle" style="color:red; font-size:90%; font-style:italic;">標有 <% '"*"' |h %> 的欄位為必填欄位。(Fields Marked With <% '"*"' |h %> Are Required.)</h5>
      </div>
    </div>
    <hr>
    <button style="float:right" type="submit" class="btn btn-primary btn-lg" id="contact_form_submit">送出(Submit)</button>
    <br/><br/>

  </form>
  </div>

  </div>
</div>

<div class="modal fade" id="submit_contact_form_response" name="submit_contact_form_response" tabindex="-1" role="dialog" aria-labelledby="submitContactResponseDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="submitContactResponseDialog">聯絡表單(Contact Form)</h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="submit_contact_form_response_message">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">關閉(Close)</button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

    jQuery('#contact_form_submit').on('click',function (e){
        var subject = jQuery('input[name="subject"]').val();
        var name = jQuery('input[name="name"]').val();
        var email = jQuery('input[name="email"]').val();
        var body = jQuery('textarea[name="body"]').val();
        var challenge_answer = jQuery('input[name="contact_form_human_answer"]').val();
        if (challenge_answer != <% $contact_form_human_answer %>){
            jQuery('#submit_contact_form_response_message').html("請回答簡單的數學問題以證明您是人類。(Please prove you are a human by answering the simple math question.)");
            jQuery('#submit_contact_form_response').modal('show');
        } else if (subject == '' || !subject){
            jQuery('#submit_contact_form_response_message').html("主旨為必填項。請填寫此欄位。(Subject is required. Please fill in this field.)");
            jQuery('#submit_contact_form_response').modal('show');
        } else if (name == '' || !name){
            jQuery('#submit_contact_form_response_message').html("姓名為必填項。請填寫此欄位。(Name is required. Please fill in this field.)");
            jQuery('#submit_contact_form_response').modal('show');
        } else if (email == '' || !email){
            jQuery('#submit_contact_form_response_message').html("電子郵件為必填項。請填寫此欄位。(Email is required. Please fill in this field.)");
            jQuery('#submit_contact_form_response').modal('show');
        } else if (body == '' || !body){
            jQuery('#submit_contact_form_response_message').html("內文為必填項。請填寫此欄位。(Body is required. Please fill in this field.)");
            jQuery('#submit_contact_form_response').modal('show');
        } else {
            jQuery.ajax ( {
                url : '/ajax/contact/submit',
                type: "POST",
                beforeSend: function(){
                    jQuery('#working_modal').modal('show');
                },
                data: {
                    "title": subject,
                    "body": body + '\n\nFrom: ' + name + '\nEmail: ' + email,
                    "security_answer": <% $contact_form_human_answer %>,
                    "security_attempt": challenge_answer
                },
                success: function(response){
                    //console.log(response);
                    jQuery('#working_modal').modal('hide');
                    var html = '';
                    var html_return;
                    if (response.error){
                        html = response.error;
                        html_return = '<div class="panel panel-danger"><div class="panel-heading">錯誤(Error)</div><div class="panel-body">'+html+'</div></div>';
                    } else {
                        html = "感謝您的來信。我們將盡快回覆您。(Thank you for your message. We will reply as soon as possible.)";
                        html_return = '<div class="panel panel-success"><div class="panel-heading">成功(Success)</div><div class="panel-body">'+html+'</div></div>';
                    }
                    jQuery('#contact_form_return_message').html(html_return);
                    jQuery('#submit_contact_form_response_message').html(html);
                    jQuery('#submit_contact_form_response').modal('show');
                },
                error: function(response){
                    console.log(response);
                    jQuery('#working_modal').modal('hide');
                    var html = "傳送訊息時發生錯誤！請與我們聯繫。(Error posting message! Please contact us.) : "+response;
                    var html_return = '<div class="panel panel-danger"><div class="panel-heading">錯誤(Error)</div><div class="panel-body">'+html+'</div></div>';
                    jQuery('#contact_form_return_message').html(html_return);
                    jQuery('#submit_contact_form_response_message').html(html);
                    jQuery('#submit_contact_form_response').modal('show');
                }
            });
        }
        e.preventDefault();
    });

});

</script>
