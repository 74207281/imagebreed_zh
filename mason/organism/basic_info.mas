
<%doc>

</%doc>

<%args>
$name
$common_name
$taxon => ''
$description => ''
@synonyms => ()
</%args>

<%perl>
$name = $name.($taxon ? " ($taxon)" : '');
my $synonym_list = join ", ", @synonyms;
</%perl>


<& /page/info_table.mas,     
   data => [ '學名(Scientific Name)' => $name,
             '俗名(Common name)'     => $common_name,
             '描述(Description)'     => $description,
             '同義詞(Synonyms)'        => $synonym_list ],
  border => 0,
	       
&>


