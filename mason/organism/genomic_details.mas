
<%args>
$ploidy => ''
$genome_size => ''
$chromosome_number => ''
$loci => ''
$maps => ''
</%args>

<& /page/info_table.mas, data=> [
  '倍性(Ploidy)'              => $ploidy,
  '基因組大小(Genome size)'       => $genome_size,
  '染色體數(Chromosome number)' => $chromosome_number,
  '可用基因座(Available loci)'    => $loci,
  '可用圖譜(Available maps)'    => $maps,
  
],
  border => 0,
&>
    

