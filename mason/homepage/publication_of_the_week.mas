<%doc>

=head1 NAME 

publication_of_the_week.mas - a mason module to display an html section with news, read from a file.

=head1 DESCRIPTION

The module does not require any parameters. If the file read does not succeed, an error message is displayed.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%perl>

use strict;
use File::Spec;
use CXGN::Tools::File;

my $publications = "本週精選出版物目前無法取得(The publication of the week is currently unavailable)。<br /><br />";

eval {

 $publications = CXGN::Tools::File::get_sections(File::Spec->catfile($c->get_conf('homepage_files_dir'), "publications.txt"));

};

</%perl>

<!--
<div class="boxbgcolor1" style="margin:0px;">
<div class="boxheading">精選出版物(Featured Publication)</div>
<div class="boxcontent"><% $publications %>
<a href="oldpublications.pl">查看所有出版物(See all publications)...</a></div>
-->

<h4>精選出版物(Featured Publication)</h4>
<% $publications %>
<button class="btn btn-info btn-sm" onclick='location.href="/oldpublications.pl"'>查看所有出版物(See all publications)...</button>
