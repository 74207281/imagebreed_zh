<%init>
use File::Slurp qw/slurp/;
use strict;
</%init>
<%perl>
my $url = $c->get_conf('static_datasets_url')."/images/iotw/desc.txt";
my $path = $c->get_conf('static_datasets_path')."/images/iotw/desc.txt";
my $IOTW = "(目前無可用圖像 / no image currently available)";
eval {
 $IOTW = slurp($path);
};

</%perl>

