<%args>
$stock_id
$map_html => undef
</%args>

% print $map_html;

<table class="table table-hover table-bordered" id="stock_direct_genotypes_datatable">
    <thead>
        <tr>
            <th>基因型鑑定專案名稱(Genotyping Data Project Name)</th>
            <th>基因型鑑定專案描述(Genotyping Data Project Description)</th>
            <th>實驗協定名稱(Protocol Name)</th>
            <th>基因型描述(Genotype Description)</th>
            <th>下載(Download)</th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#stock_genotypes_section_onswitch').one("click", function() {
        var stock_genotypes_table = jQuery('#stock_direct_genotypes_datatable').DataTable({
            'destroy' : true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            "scrollX": true,
            'ajax': '/stock/<% $stock_id %>/datatables/genotype_data'
        });
    });

});

</script>
