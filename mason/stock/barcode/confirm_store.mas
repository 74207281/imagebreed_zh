<%doc>

=head1 NAME

stock/barcode/confirm_store.mas - a mason component for displaying message after attempting to store stock phenotyping data.

=AUTHOR

Naama Menda <nm249@cornell.edu>

=cut

</%doc>

<%args>

$error => undef
$data => undef # formatted data to be printed on confirmation page
$feedback_email => undef
$message => undef

</%args>

<%perl>

</%perl>

<& /page/page_title.mas, title => "儲存已上傳的條碼資料(Store uploaded barcode data)" &>
<&| /page/info_section.mas, title => "上傳狀態(Upload status)" &>
    <h4><div> <% $error %> </div></h4>
    <div> <% $message %></div>
  </form>
</&>
