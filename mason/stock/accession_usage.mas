<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title=>'種原使用情形(Accession Usage)' &>

<&| /page/info_section.mas, title => '試驗中的種原使用情形(Accession Usage for Trials)', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_trials" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>種原名稱(Accession Name)</th>
    <th>試驗數量(Number of Trials)</th>
    <th>總小區數(Total Number of Plots)</th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => '作為母本的種原使用情形(Accession Usage as Female Parent)', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_female" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>種原名稱(Accession Name)</th>
    <th>後代數量(Number of Progenies)</th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => '作為父本的種原使用情形(Accession Usage as Male Parent)', collapsible=>1, collapsed=>1 &>

<table id="accession_usage_male" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th>種原名稱(Accession Name)</th>
    <th>後代數量(Number of Progenies)</th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => '種原表型表現(Accession Phenotype Performance)', collapsible=>1, collapsed=>0 &>

<div class="well">
    <div class="panel panel-default">
        <div class="panel-body">

            <table id="accession_usage_phenotypes" class='table table-bordered table-hover'>
                <thead>
                    <tr>
                        <th>種原(Accession)</th>
                        <th>觀測變數(Observation Variable)</th>
                        <th>平均值(Mean)</th>
                        <th>最小值(Min)</th>
                        <th>最大值(Max)</th>
                        <th>標準差(Std Dev)</th>
                        <th>變異係數(CV)</th>
                        <th>計數(Count)</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

</&>

<script>

jQuery(document).ready(function(){

  jQuery('#accession_usage_trials').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_trials'
  });


  jQuery('#accession_usage_female').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_female'
  });


  jQuery('#accession_usage_male').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_male'
  });

  var stock_table = jQuery('#accession_usage_phenotypes').DataTable({
      'destroy' : true,
      'searching' : false,
      'ordering'  : false,
      'processing': true,
      'serverSide': true,
      'lengthMenu': [10,20,50,100,1000,5000],
      'ajax': { 'url':  '/ajax/accession_usage_phenotypes?display=plots_accession' }
  });

});

</script>
