
<%args>
$stock_id
</%args>

<& /util/import_javascript.mas,
  entries => ["sequenced_accessions"]
&>

<div class="modal fade" id="edit_sequencing_info_dialog" role="dialog">
    <div class="modal-dialog" role="modal">
        <div class="form-search">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><div aria-hidden="true">&times;</div></button>
                    <h5 class="modal-title">輸入種原定序資訊(Enter sequencing info for accession)：</h5>
                </div> <!-- modal-header -->
                <form id="sequencing_info_form" class="form-horizontal">
                    <div class="modal-body">
                        <div class="row">
                            <label class="col-sm-3 control-label">機構/組織(Organization)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" alt="Organization" placeholder="定序機構/組織(Sequencing organization)" name="organization" id="organization" size="30" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">年份(Year)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="定序年份(Sequencing year)" name="sequencing_year" id="sequencing_year" size="6" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">網站(Website)：</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <span class="input-group-addon" id="https-prefix">https:&sol;&sol;</span>
                                    <input type="text" class="form-control" placeholder="網站(Website)" aria-label="https-prefix" aria-describedby="https-prefix" name="website"  id="website" size="10" />
                                </div>
                            </div> <!-- input-group -->
                            <br />
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">聯絡電子郵件(Contact email)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="聯絡電子郵件(Contact email)" name="contact_email"  id="contact_email" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">Genbank 種原編號(Genbank accession)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="Genbank 種原編號(Genbank Accession)" name="genbank_accession"  id="genbank_accession" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">資助機構(Funding agency)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="資助機構/組織(Funding organization)" name="funded_by"  id="funded_by" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">資助機構專案 ID(Funding agency project id)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="資助機構專案 ID(Funding organization project ID)"  name="funder_project_id" id="funder_project_id" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">JBrowse 連結(JBrowse link)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="JBrowse 連結(Jbrowse link)" name="jbrowse_link" id="jbrowse_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">BLAST 連結(BLAST link)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="BLAST 連結(BLAST link)" name="blast_link" id="blast_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">FTP 連結(FTP link)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="FTP 連結(FTP link)" name="ftp_link" id="ftp_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label">NCBI 連結(NCBI link)：</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="NCBI 連結(NCBI link)" name="ncbi_link" id="ncbi_link" size="20" /><br />
                            </div>
                        </div>                        
                        <div>
                            <input type="hidden" id="sequencing_status_stock_id"  name="sequencing_status_stock_id" value="<% $stock_id %>" />
                            <input type="hidden" id="stockprop_id"  name="stockprop_id" />
                        </div>
                    </div> <!-- modal-body -->
                    <div class="modal-footer">
                        <button type="submit"  class="btn btn-primary">儲存變更(Save Changes)</button>
                        <button id="dismiss_sequencing_info_dialog" type="button" class="btn btn-secondary" >關閉(Close)</button>
                    </div> <!-- modal-footer -->
                </form> <!-- sequencing_info form -->
            </div> <!-- modal-content -->
        </div> <!-- form-search -->
    </div> <!-- modal-dialog -->
</div> <!-- modal -->

<table id="sequenced_stocks_table" class="display" style="width:100%">
    <thead>
        <tr>
            <th>種原(Accession)</th>
            <th>年份(Year)</th>
            <th>機構/組織(Organization)</th>
            <th>網站(Website)</th>
            <th>分析(Analyze)</th>
            <th>管理(Manage)</th>
        </tr>
    </thead>
</table>

<div id="sequenced_stocks_div">
</div>

<script>
jQuery(window).ready( function() {
    var sequenced_stocks = window.jsMod['sequenced_accessions'].init("sequenced_stocks_div", <% $stock_id %>);
});
</script>


<br />
